{
	"name": "web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"build:captive": "vite build --config captive/vite.config.ts",
		"build:board": "BUILD_TARGET=board VITE_BUILD_TARGET=board vite build",
		"preview": "wrangler pages dev .svelte-kit/cloudflare --port 4173",
		"prepare": "bun install --cwd ../.dependency/blueclaw/protocol && svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "bun test tests/unit tests/conventions",
		"test:unit": "bun test tests/unit",
		"test:e2e": "./scripts/e2e.sh",
		"generate:protocol": "bun run scripts/generate-capability-protocol.ts",
		"report:plugin-tools": "bun run scripts/plugin-tool-provenance.ts --json",
		"test:api": "./scripts/test-against-local-plane.sh tests/api",
		"test:transfer": "./scripts/test-against-local-plane.sh tests/transfer",
		"test:messenger-gateway": "./scripts/test-against-local-plane.sh tests/messenger-gateway",
		"pilot": "monkeys run @pilot bun run tests/pilot/run-pilot.ts",
		"pilot:summary": "bun run tests/pilot/summarize-pilot.ts",
		"test:unit:pilot": "bun test tests/unit/pilot",
		"gen": "wrangler types"
	},
