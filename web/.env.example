# Copy to web/.env. Every value here is fake, and none of it is a secret.
#
# This file is for local development only. The central plane lives in the
# repository root .env, because bun scripts and the dev server read the project
# credentials from there: bun --env-file=../.env run scripts/<name>.ts

# Where `bun run dev` proxies /attendance/api, /calendar/api and the rest.
VITE_ADMIND_TARGET=http://127.0.0.1:18080

# Hostnames the dev server answers on, beyond localhost.
VITE_ALLOWED_HOSTS=dev.example.test

# Mock flags are for device-backed screens that have no Supabase path yet. Each
# needs VITE_DEV_USER_EMAIL, and /auth/session must answer authenticated: true
# before the page means anything. Prefer the real central plane where one
# exists: supabase db reset, then sign in.
VITE_DEV_USER_EMAIL=member1@example.com
VITE_DEV_USER_ROLE=admin
