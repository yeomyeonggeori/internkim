<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/attendance_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/attendance_widget_background"
    android:padding="16dp">

    <TextView
        android:id="@+id/attendance_widget_failure"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:maxLines="3"
        android:textColor="@color/attendance_widget_text_secondary"
        android:textSize="15sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/attendance_widget_today"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/attendance_widget_worked"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/attendance_widget_text"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/attendance_widget_whereabouts"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="end"
                android:maxLines="1"
                android:textColor="@color/attendance_widget_text_secondary"
                android:textSize="15sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="8dp" />

        <ImageView
            android:id="@+id/attendance_widget_day_bar"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:importantForAccessibility="no"
            android:scaleType="fitXY" />

        <LinearLayout
            android:id="@+id/attendance_widget_marks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/attendance_widget_mark_in_icon"
                style="@style/AttendanceWidgetMarkIcon"
                android:src="@drawable/attendance_widget_icon_mark_in" />

            <TextView
                android:id="@+id/attendance_widget_mark_in"
                style="@style/AttendanceWidgetMark" />

            <ImageView
                android:id="@+id/attendance_widget_mark_out_icon"
                style="@style/AttendanceWidgetMarkIcon"
                android:layout_marginStart="10dp"
                android:src="@drawable/attendance_widget_icon_mark_out" />

            <TextView
                android:id="@+id/attendance_widget_mark_out"
                style="@style/AttendanceWidgetMark" />

            <ImageView
                android:id="@+id/attendance_widget_mark_location_icon"
                style="@style/AttendanceWidgetMarkIcon"
                android:layout_marginStart="10dp"
                android:src="@drawable/attendance_widget_icon_pin" />

            <TextView
                android:id="@+id/attendance_widget_mark_location"
                style="@style/AttendanceWidgetMark"
                android:ellipsize="end" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/attendance_widget_refusal_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                style="@style/AttendanceWidgetMarkIcon"
                android:src="@drawable/attendance_widget_icon_warning" />

            <TextView
                android:id="@+id/attendance_widget_refusal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/attendance_widget_refusal"
                android:textSize="14sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/attendance_widget_primary"
                style="@style/AttendanceWidgetButton"
                android:background="@drawable/attendance_widget_button_prominent">

                <ImageView
                    android:id="@+id/attendance_widget_primary_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="6dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/attendance_widget_icon_clock_in" />

                <TextView
                    android:id="@+id/attendance_widget_primary_label"
                    style="@style/AttendanceWidgetButtonLabel"
                    android:text="@string/attendance_widget_clock_in"
                    android:textColor="@color/attendance_widget_on_accent" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/attendance_widget_other"
                style="@style/AttendanceWidgetButton"
                android:layout_marginStart="8dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/attendance_widget_other_label"
                    style="@style/AttendanceWidgetButtonLabel"
                    android:text="@string/attendance_widget_other_location" />

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_marginStart="4dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/attendance_widget_icon_chevron_right" />
            </LinearLayout>

            <TextView
                android:id="@+id/attendance_widget_notice"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/attendance_widget_notice"
                android:gravity="center"
                android:maxLines="2"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/attendance_widget_choose_in_settings"
                android:textColor="@color/attendance_widget_text"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/attendance_widget_picker"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/attendance_widget_where"
                android:textColor="@color/attendance_widget_text_secondary"
                android:textSize="15sp" />

            <LinearLayout
                android:id="@+id/attendance_widget_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingTop="4dp"
                android:paddingEnd="0dp"
                android:paddingBottom="4dp">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_marginEnd="3dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/attendance_widget_icon_chevron_left" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/attendance_widget_back"
                    android:textColor="@color/attendance_widget_text_secondary"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView android:id="@+id/attendance_widget_pick_0" style="@style/AttendanceWidgetPick" />
                <TextView android:id="@+id/attendance_widget_pick_1" style="@style/AttendanceWidgetPick" android:layout_marginStart="6dp" />
                <TextView android:id="@+id/attendance_widget_pick_2" style="@style/AttendanceWidgetPick" android:layout_marginStart="6dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/attendance_widget_pick_row_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView android:id="@+id/attendance_widget_pick_3" style="@style/AttendanceWidgetPick" />
                <TextView android:id="@+id/attendance_widget_pick_4" style="@style/AttendanceWidgetPick" android:layout_marginStart="6dp" />
                <TextView android:id="@+id/attendance_widget_pick_5" style="@style/AttendanceWidgetPick" android:layout_marginStart="6dp" />
            </LinearLayout>
        </LinearLayout>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="@string/attendance_widget_back"
            android:textSize="15sp"
            android:visibility="invisible" />
    </LinearLayout>
</FrameLayout>
