	"cleanup": [
		{
			"update": "organization",
			"where": { "id": "000000a0-0000-0000-0000-000000000001" },
			"set": { "importance": "high", "owner_id": "000000ee-0000-0000-0000-000000000001" }
		},
		{
			"update": "organization",
			"where": { "id": "000000a0-0000-0000-0000-000000000004" },
