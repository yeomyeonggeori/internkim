{
	"name": "crm-multi-update-asks-for-owner",
	"instruction": "견본 물산이랑 예시 협력 기관 두 곳 다 중요도를 낮음으로 내리고, 두 곳 담당자도 새 담당자로 바꿔줘.",
	"assertions": [
		{
			"table": "organization",
			"where": { "id": "000000a0-0000-0000-0000-000000000001" },
			"expect": { "importance": "low", "owner_id": "000000ee-0000-0000-0000-000000000001" }
		},
		{
			"table": "organization",
			"where": { "id": "000000a0-0000-0000-0000-000000000004" },
			"expect": { "importance": "low", "owner_id": "000000ee-0000-0000-0000-000000000001" }
		},
		{ "waitingForAnswer": { "mentions": ["담당자"] } }
