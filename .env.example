# Copy to .env at the repository root. Every value here is fake.
#
# The internkim CLI loads ./.env then ../.env by itself. Everything else is
# handed the file:
#
#   set -a && . .env && set +a
#
# which is what a bun script under web/ and a wrangler deploy both need.
#
# Device and host settings are not here. A device gets them from provisioning,
# and a company's own host box is documented in host/README.md.

# --- Central plane -----------------------------------------------------------
# The Supabase project the web app and web/scripts talk to. The secret key is a
# server-side key: it belongs on this machine and in Cloudflare Pages secrets,
# never in a build.
SUPABASE_URL=https://abcdefghijklmnopqrst.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_0000000000000000000000
SUPABASE_SECRET_KEY=sb_secret_00000000000000000000000000

# --- Web app runtime ---------------------------------------------------------
# hooks.server.ts injects these into the page, so a change takes effect on the
# next request rather than the next build.
CLOUDFLARE_DOMAIN=example.test
GATEWAY_URL=https://gateway.example.test
VAPID_PUBLIC_KEY=BAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
VAPID_PRIVATE_KEY=0000000000000000000000000000000000000000000
VAPID_SUBJECT=mailto:ops@example.test
INTERNKIM_REGISTER_SECRET=register-secret-0000

# --- Cloudflare --------------------------------------------------------------
# Pages deploys and hostname attachment. The token needs Pages edit rights.
CLOUDFLARE_API_TOKEN=cloudflare-api-token-0000000000000000000
CLOUDFLARE_ACCOUNT_ID=00000000000000000000000000000000

# --- Release publishing ------------------------------------------------------
# `internkim deploy` and `internkim release publish` upload to R2. With
# PUBLISHER=wrangler the R2 keys go unused and the wrangler OAuth session is
# what authenticates; with PUBLISHER=s3 it is the other way round.
INTERNKIM_RELEASE_R2_BUCKET=internkim-releases
INTERNKIM_RELEASE_R2_PUBLISHER=wrangler
INTERNKIM_RELEASE_PUBLIC_BASE_URL=https://updates.example.test
INTERNKIM_RELEASE_R2_ACCESS_KEY_ID=0000000000000000000000000000000
INTERNKIM_RELEASE_R2_SECRET_ACCESS_KEY=00000000000000000000000000000
INTERNKIM_RELEASE_DOWNLOAD_TOKEN=download-token-0000
INTERNKIM_RELEASE_SIGNING_KEY=release-signing-key-0000

# --- Fleet and devices -------------------------------------------------------
# INTERNKIM_DOMAIN overrides the compiled-in zone and everything else derives
# from it. The console password is the physical login on a board being set up.
INTERNKIM_DOMAIN=example.test
INTERNKIM_FLEET_SECRET=fleet-secret-0000
INTERNKIM_CONSOLE_PASSWORD=console-password-0000
INTERNKIM_ADMIN_EMAIL=ops@example.test

# --- Models ------------------------------------------------------------------
# Remote inference for tooling run from here. A device reaches a model through
# capabilityd instead.
OPENROUTER_API_KEY=sk-or-v1-00000000000000000000000000000000000000000000000000

# --- LLM gateway worker ------------------------------------------------------
# The management key mints and revokes the per-device tokens, so it stays on an
# operator machine and never reaches a device. Wrangler reads these under the
# same names when the worker is deployed.
OPENROUTER_MANAGEMENT_KEY=sk-or-v1-0000000000000000000000000000000000000000000000000
GATEWAY_ADMIN_TOKEN=gateway-admin-token-0000
GATEWAY_SHARED_SECRET=gateway-shared-secret-0000

# --- Messenger connectors ----------------------------------------------------
# Only for a company running that messenger.
INTERNKIM_SLACK_BOT_TOKEN=xoxb-000000000000-000000000000-000000000000000000000000
INTERNKIM_SLACK_APP_TOKEN=xapp-1-A00000000-0000000000000-0000000000000000000000
INTERNKIM_SIGNAL_ACCOUNT=+10000000000
INTERNKIM_SIGNAL_JSONRPC_URL=http://127.0.0.1:8080/api/v1/rpc
