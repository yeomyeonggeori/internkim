# Copy to .env at the repository root. Every value here is fake.
#
# The internkim CLI loads ./.env then ../.env by itself. Everything else is
# handed the file:
#
#   set -a && . .env && set +a
#
# which is what a bun script under web/ and a wrangler deploy both need.
#
# Device and host settings are not here. A device gets them from provisioning,
# and a company's own host box is documented in host/README.md.

# --- Central plane ---------------------------------------------------------------
# the Supabase project URL; required across the relay, host bring-up, the web app and the gateway worker, and used by web/scripts' one-off ops scripts
SUPABASE_URL=https://abcdefghijklmnopqrst.supabase.co
# the Supabase project's publishable (anon) key; required across the relay, host bring-up, the web app and the gateway worker, and used by web/scripts' one-off ops scripts
SUPABASE_PUBLISHABLE_KEY=sb_publishable_0000000000000000000000
# the Supabase project's service-role secret key, used by web/scripts' one-off ops scripts and integration tests; never in a build
SUPABASE_SECRET_KEY=sb_secret_00000000000000000000000000

# --- Web app runtime -------------------------------------------------------------
# the zone the web app treats as home when redirecting a company hostname, and the CLI's fallback zone when INTERNKIM_DOMAIN is unset; falls back to the compiled-in default zone
CLOUDFLARE_DOMAIN=example.test
# the Cloudflare gateway worker's URL a company's relay and the web app's public-API caller reach it through; unset means no gateway
GATEWAY_URL=https://gateway.example.test
# the bearer token the web app's public-API gateway caller and the connection-gateway worker's admin endpoints share
GATEWAY_ADMIN_TOKEN=gateway-admin-token-0000
# the VAPID public key injected into the page for push-notification subscription; the matching private key lives in Supabase Vault, not the environment
VAPID_PUBLIC_KEY=BAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
# the shared secret a device presents to the fleet registration API (the older device-fleet path's Cloudflare Pages KV binding, web/src/routes/api/fleet and api/register)
INTERNKIM_REGISTER_SECRET=register-secret-0000

# --- Cloudflare ------------------------------------------------------------------
# a Cloudflare API token with Pages edit rights, used to provision an SSH Access service token and implicitly by Wrangler for Pages deploys
CLOUDFLARE_API_TOKEN=cloudflare-api-token-0000000000000000000
# the Cloudflare account ID for R2 release uploads, falling back from INTERNKIM_RELEASE_R2_ACCOUNT_ID
CLOUDFLARE_ACCOUNT_ID=00000000000000000000000000000000

# --- Release publishing ----------------------------------------------------------
# the R2 bucket releases are uploaded to
INTERNKIM_RELEASE_R2_BUCKET=internkim-releases
# which uploader publishes a release to R2: "wrangler" (OAuth session, R2 keys unused) or "s3" (R2 keys used)
INTERNKIM_RELEASE_R2_PUBLISHER=wrangler
# the public base URL published releases are served from
INTERNKIM_RELEASE_PUBLIC_BASE_URL=https://updates.example.test
# the R2 access key ID used when publishing a release with PUBLISHER=s3
INTERNKIM_RELEASE_R2_ACCESS_KEY_ID=0000000000000000000000000000000
# the R2 secret access key used when publishing a release with PUBLISHER=s3
INTERNKIM_RELEASE_R2_SECRET_ACCESS_KEY=00000000000000000000000000000
# the bearer token required to download a published OTA release, read by internal/cli's release-publish and setup flows
INTERNKIM_RELEASE_DOWNLOAD_TOKEN=download-token-0000
# the key a release manifest is signed with when published
INTERNKIM_RELEASE_SIGNING_KEY=release-signing-key-0000

# --- Fleet and devices -----------------------------------------------------------
# overrides the CLI's compiled-in zone; everything else (the API URL, hostnames) derives from it
INTERNKIM_DOMAIN=example.test
# overrides the fleet-registration API base URL the CLI's loadConfig derives from the zone by default
INTERNKIM_API_URL=https://example.test
# the shared fleet secret internal/cli/target_context.go reads when a device target's own secret is unset
INTERNKIM_FLEET_SECRET=fleet-secret-0000
# the console password used for a Jetson's physical login during setup/flashing
INTERNKIM_CONSOLE_PASSWORD=console-password-0000
# the console/admin sign-in email the CLI's setup flow and the CRUD/delete/matrix e2e specs use
INTERNKIM_ADMIN_EMAIL=ops@example.test

# --- Models ----------------------------------------------------------------------
# the OpenRouter API key for remote model inference from tooling run on this machine; also read by internal/llmbackend's live OpenRouter test and tools/verify-graphiti-local
OPENROUTER_API_KEY=sk-or-v1-00000000000000000000000000000000000000000000000000
