#!/bin/bash
# gas-call — POST to the Apps Script bridge the user deployed, so the agent
# can create / edit Workspace items as the user without passing shell
# command substitution that zeroclaw's security layer blocks.
#
# Usage:
#   gas-call <action> key=value [key=value ...]
#
# Examples:
#   gas-call slides.create title="ZeroClaw 활용 가이드"
#   gas-call gmail.send to=me@example.com subject=Hi body="hello"
#   gas-call drive.import_pptx title="Deck" pptx=/tmp/deck.pptx
#
# File upload: for binary content, use a key whose value looks like a file
# path. Supported keys (auto base64-encoded into the `data` form field):
#   pptx=<path>   docx=<path>   xlsx=<path>
#
# On *.create actions the bot's service-account email is auto-added as
# share_to so follow-up edits via gws-bot succeed — unless the caller
# explicitly passes their own share_to.

set -eu

if [ "$#" -lt 1 ]; then
  echo "Usage: gas-call <action> key=value [key=value ...]" >&2
  exit 1
fi

ACTION="$1"
shift

WEBHOOK_FILE=/root/.internkim/secrets/gas-webhook-url
SA_EMAIL_FILE=/root/.internkim/env/sa-email

if [ ! -r "$WEBHOOK_FILE" ]; then
  echo "gas-call: webhook URL missing at $WEBHOOK_FILE — run internkim setup" >&2
  exit 1
fi

WEBHOOK_URL=$(cat "$WEBHOOK_FILE")

user_passed_share_to=0
for pair in "$@"; do
  case "$pair" in
    share_to=*) user_passed_share_to=1 ;;
  esac
done

CURL_ARGS=(--data-urlencode "action=$ACTION")

case "$ACTION" in
  *.create|drive.import_pptx|drive.import_docx|drive.import_xlsx)
    if [ "$user_passed_share_to" -eq 0 ] && [ -r "$SA_EMAIL_FILE" ]; then
      CURL_ARGS+=(--data-urlencode "share_to=$(cat "$SA_EMAIL_FILE")")
    fi
    ;;
esac

TMP_B64=""
cleanup() { [ -n "$TMP_B64" ] && rm -f "$TMP_B64"; }
trap cleanup EXIT

for pair in "$@"; do
  key="${pair%%=*}"
  value="${pair#*=}"
  case "$key" in
    pptx|docx|xlsx|file|file_path|path|upload)
      if [ ! -r "$value" ]; then
        echo "gas-call: cannot read file '$value' for $key" >&2
        exit 1
      fi
      TMP_B64=$(mktemp /tmp/gas-call.XXXXXX.b64)
      base64 -w0 < "$value" > "$TMP_B64"
      CURL_ARGS+=(--data-urlencode "data@$TMP_B64")
      ;;
    *)
      CURL_ARGS+=(--data-urlencode "$pair")
      ;;
  esac
done

curl -fsSL "$WEBHOOK_URL" "${CURL_ARGS[@]}"
