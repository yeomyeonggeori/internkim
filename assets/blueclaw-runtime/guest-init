#!/usr/bin/env bash
set -euo pipefail

export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

log_guest_init() {
  echo "guest-init: $*" >/dev/console
}

shutdown_guest() {
  if command -v poweroff >/dev/null 2>&1; then
    poweroff -f
  fi
  echo o >/proc/sysrq-trigger 2>/dev/null || exit 1
}

ensure_blueclaw_account() {
  if ! grep -q '^blueclaw:' /etc/passwd; then
    log_guest_init "missing blueclaw user in rootfs"
    exit 1
  fi
  if ! grep -q '^blueclaw:' /etc/group; then
    log_guest_init "missing blueclaw group in rootfs"
    exit 1
  fi
}

ensure_workspace_directory() {
  if mkdir -p "$1" 2>/dev/null; then
    return 0
  fi
  local component="$1"
  while [ "$component" != "/workspace" ] && [ "$component" != "/" ]; do
    if [ -e "$component" ] && [ ! -d "$component" ]; then
      log_guest_init "quarantining non-directory $component"
      mv "$component" "$component.broken.$(date +%s)" || rm -f "$component"
    fi
    component="$(dirname "$component")"
  done
  mkdir -p "$1"
}

prepare_blueclaw_workspace() {
  local workspaceDirectory
  for workspaceDirectory in \
    /workspace/.blueclaw/postgres/data \
    /workspace/.blueclaw/graphiti \
    /workspace/.blueclaw/logs \
    /workspace/.blueclaw/blobs \
    /workspace/.blueclaw/config \
    /workspace/.blueclaw/migrations \
    /workspace/.blueclaw/runtime \
    /workspace/.blueclaw/tmp \
    /workspace/circles/staff \
    /workspace/circles/c-level \
    /workspace/circles/representative \
    /workspace/circles/admin \
    /workspace/circles/hr-compensation \
    /workspace/private/people \
    /workspace/shared/public \
    /workspace/shared/cache/dependencies \
    /workspace/shared/cache/dependencies/bun; do
    ensure_workspace_directory "$workspaceDirectory"
  done

  rmdir /workspace/.blueclaw/graphiti/kuzu 2>/dev/null || true

  chown blueclaw:blueclaw /workspace /workspace/.blueclaw
  chown -R blueclaw:blueclaw \
    /workspace/circles \
    /workspace/private \
    /workspace/shared \
    /workspace/.blueclaw/graphiti \
    /workspace/.blueclaw/logs \
    /workspace/.blueclaw/blobs \
    /workspace/.blueclaw/config \
    /workspace/.blueclaw/migrations \
    /workspace/.blueclaw/runtime \
    /workspace/.blueclaw/tmp
  chmod 0755 /workspace /workspace/.blueclaw
  chmod 0711 /workspace/circles /workspace/private /workspace/private/people
  chmod 0755 /workspace/shared /workspace/shared/public
  chmod 0750 /workspace/.blueclaw/config
  chmod 0770 \
    /workspace/.blueclaw/graphiti \
    /workspace/.blueclaw/logs \
    /workspace/.blueclaw/blobs \
    /workspace/.blueclaw/migrations \
    /workspace/.blueclaw/runtime \
    /workspace/.blueclaw/tmp
  find /workspace/.blueclaw/config -type f -exec chmod 0640 {} +
}

seed_blueclaw_bun_cache() {
  if [ ! -d /opt/blueclaw/bun-cache ]; then
    return
  fi
  if [ -n "$(ls -A /workspace/shared/cache/dependencies/bun 2>/dev/null)" ]; then
    return
  fi
  cp -a /opt/blueclaw/bun-cache/. /workspace/shared/cache/dependencies/bun/
  chown -R blueclaw:bc_shared /workspace/shared/cache/dependencies/bun 2>/dev/null \
    || chown -R blueclaw:blueclaw /workspace/shared/cache/dependencies/bun
  chmod -R g+rwX /workspace/shared/cache/dependencies/bun
}

sync_blueclaw_posix_policy() {
  if [ -x /usr/local/bin/blueclaw-posix-helper ] && [ -s /workspace/.blueclaw/config/policy.json ]; then
    /usr/local/bin/blueclaw-posix-helper sync \
      --policy /workspace/.blueclaw/config/policy.json \
      --workspace /workspace >/workspace/.blueclaw/logs/posix-sync.log 2>&1 || true
  fi
}

check_blueclaw_posix_helper() {
  if ! /usr/local/bin/blueclaw-posix-helper capabilities >/workspace/.blueclaw/logs/posix-helper-root-preflight.log 2>&1; then
    log_guest_init "posix helper root preflight failed"
    exit 1
  fi
  if ! su -s /bin/bash blueclaw -c '/usr/local/bin/blueclaw-posix-helper capabilities' >/workspace/.blueclaw/logs/posix-helper-blueclaw-preflight.log 2>&1; then
    log_guest_init "posix helper is not executable by blueclaw"
    exit 1
  fi
}

run_postgres_sql() {
  timeout 30s su -s /bin/bash postgres -c "$postgres_bindir/psql -h /workspace/.blueclaw/postgres -p 5432 -U postgres -d template1 -tAc \"$1\""
}

wait_for_postgres_sql() {
  for _ in $(seq 1 120); do
    if run_postgres_sql "SELECT 1" >/dev/null 2>&1; then
      return 0
    fi
    sleep 1
  done
  log_guest_init "postgres SQL readiness timed out"
  exit 1
}

wait_for_postgres_socket() {
  for _ in $(seq 1 120); do
    if timeout 5s "$postgres_bindir/pg_isready" -h /workspace/.blueclaw/postgres -p 5432 -U postgres -d template1 >/dev/null 2>&1; then
      return 0
    fi
    sleep 1
  done
  log_guest_init "postgres socket readiness timed out"
  exit 1
}

wait_for_graphiti_health() {
  local graphiti_process_id="$1"
  for attempt in $(seq 1 120); do
    if ! kill -0 "$graphiti_process_id" >/dev/null 2>&1; then
      log_guest_init "graphiti exited before health at attempt $attempt"
      tail -n 80 /workspace/.blueclaw/logs/graphiti-memoryd.log >/dev/console 2>/dev/null || true
      return 1
    fi
    if curl --silent --fail --max-time 5 http://127.0.0.1:7791/health >/dev/null 2>&1; then
      log_guest_init "graphiti health ready"
      return
    fi
    sleep 1
  done
  log_guest_init "graphiti health readiness timed out"
  ps -ef | grep '[g]raphiti' >/dev/console 2>/dev/null || true
  tail -n 80 /workspace/.blueclaw/logs/graphiti-memoryd.log >/dev/console 2>/dev/null || true
  return 1
}

configure_outbound_network() {
  if ! ip link show eth0 >/dev/null 2>&1; then
    log_guest_init "outbound network disabled: eth0 is unavailable"
    return
  fi
  ip link set eth0 up
  ip link set eth0 mtu 1280
  ip addr replace 172.31.0.2/30 dev eth0
  ip route replace default via 172.31.0.1 dev eth0
  cat >/etc/resolv.conf <<'EOF'
nameserver 1.1.1.1
nameserver 8.8.8.8
EOF
}

blueclaw_binary_path() {
  local payload_binary_path="/workspace/.blueclaw/runtime/current/bin/blueclaw"
  if [ ! -x "$payload_binary_path" ]; then
    log_guest_init "missing executable Blueclaw runtime payload at $payload_binary_path"
    exit 1
  fi
  printf '%s\n' "$payload_binary_path"
}

trap 'status=$?; log_guest_init "failed at line $LINENO with status $status"; shutdown_guest' ERR

mountpoint -q /proc || mount -t proc proc /proc
mountpoint -q /sys || mount -t sysfs sysfs /sys
mountpoint -q /dev || mount -t devtmpfs devtmpfs /dev
mkdir -p /dev/pts
mountpoint -q /dev/pts || mount -t devpts devpts /dev/pts
mountpoint -q /run || mount -t tmpfs tmpfs /run
mountpoint -q /tmp || mount -t tmpfs tmpfs /tmp
mount -o remount,rw /
log_guest_init "base mounts ready"

ip link set lo up
log_guest_init "loopback ready"
configure_outbound_network
log_guest_init "network configured"

if ! mountpoint -q /workspace; then
  log_guest_init "workspace mount starting"
  mount -t ext4 /dev/vdb /workspace
fi

log_guest_init "workspace mounted"
ensure_blueclaw_account
log_guest_init "blueclaw account ready"
prepare_blueclaw_workspace
log_guest_init "workspace prepared"
sync_blueclaw_posix_policy
log_guest_init "posix policy synchronized"
seed_blueclaw_bun_cache
log_guest_init "bun cache seeded"
check_blueclaw_posix_helper
log_guest_init "posix helper ready"

chown -R postgres:postgres /workspace/.blueclaw/postgres
chown postgres:blueclaw /workspace/.blueclaw/postgres
chmod 0770 /workspace/.blueclaw/postgres

/usr/local/bin/blueclaw-guest-healthd -port 8082 >>/workspace/.blueclaw/logs/guest-healthd.log 2>&1 &
log_guest_init "guest health started"

postgres_bin="$(find /usr/lib/postgresql -path '*/bin/postgres' -type f | sort -V | tail -1)"
postgres_bindir="$(dirname "$postgres_bin")"
log_guest_init "postgres binary ready"

if [ ! -s /workspace/.blueclaw/postgres/data/PG_VERSION ]; then
  log_guest_init "postgres initdb starting"
  chown -R postgres:postgres /workspace/.blueclaw/postgres
  su -s /bin/bash postgres -c "$postgres_bindir/initdb -D /workspace/.blueclaw/postgres/data --encoding=UTF8 --locale=C.UTF-8" >>/workspace/.blueclaw/logs/postgres-init.log 2>&1
  log_guest_init "postgres initdb ready"
fi

log_guest_init "postgres launch starting"
su -s /bin/bash postgres -c "$postgres_bin -D /workspace/.blueclaw/postgres/data -k /workspace/.blueclaw/postgres -h 127.0.0.1 -p 5432" >>/workspace/.blueclaw/logs/postgres.log 2>&1 &
postgres_process_id="$!"
log_guest_init "postgres launched pid=$postgres_process_id"

wait_for_postgres_socket
log_guest_init "postgres socket ready"

chown postgres:blueclaw /workspace/.blueclaw/postgres
chmod 0770 /workspace/.blueclaw/postgres
wait_for_postgres_sql
log_guest_init "postgres SQL ready"

if ! run_postgres_sql "SELECT 1 FROM pg_roles WHERE rolname='blueclaw'" | grep -qx 1; then
  run_postgres_sql "CREATE ROLE blueclaw LOGIN"
fi
log_guest_init "postgres role ready"
if ! run_postgres_sql "SELECT 1 FROM pg_database WHERE datname='blueclaw'" | grep -qx 1; then
  run_postgres_sql "CREATE DATABASE blueclaw OWNER blueclaw"
fi
log_guest_init "postgres database ready"

/usr/local/bin/blueclaw-vsock-http-proxy -listen 127.0.0.1:18081 -host-cid 2 -host-port 7000 >>/workspace/.blueclaw/logs/vsock-http-proxy.log 2>&1 &
outbound_proxy_process_id="$!"

sync_guest_clock_once() {
  local remote_date remote_epoch local_epoch skew
  remote_date="$(curl --silent --head --max-time 5 http://127.0.0.1:18081/v1/capabilities 2>/dev/null | awk -F': ' 'tolower($1)=="date"{print $2}' | tr -d '\r')"
  [ -n "$remote_date" ] || return 1
  remote_epoch="$(date -u -d "$remote_date" +%s 2>/dev/null)" || return 1
  [ -n "$remote_epoch" ] || return 1
  local_epoch="$(date -u +%s)"
  skew=$((remote_epoch - local_epoch))
  [ "$skew" -lt 0 ] && skew=$((-skew))
  if [ "$skew" -ge 2 ]; then
    date -u -s "@$remote_epoch" >/dev/null
    log_guest_init "guest clock stepped ${skew}s to host time"
  fi
  return 0
}

for clock_sync_attempt in $(seq 1 15); do
  sync_guest_clock_once && break
  sleep 1
done
log_guest_init "guest clock synchronized"
(
  while true; do
    sleep 30
    sync_guest_clock_once || log_guest_init "guest clock sync attempt failed"
  done
) &

su -s /bin/bash blueclaw -c 'INTERNKIM_CAPABILITY_ENDPOINT=http://127.0.0.1:18081 BLUECLAW_GRAPHITI_KUZU_PATH=/workspace/.blueclaw/graphiti/kuzu BLUECLAW_GRAPHITI_LISTEN_ADDRESS=127.0.0.1 BLUECLAW_GRAPHITI_PORT=7791 /usr/local/bin/graphiti-memoryd' >>/workspace/.blueclaw/logs/graphiti-memoryd.log 2>&1 &
graphiti_process_id="$!"
log_guest_init "graphiti started pid=$graphiti_process_id"

wait_for_graphiti_health "$graphiti_process_id" &

blueclaw_binary="$(blueclaw_binary_path)"
su -s /bin/bash blueclaw -c "$blueclaw_binary -runtime /workspace/.blueclaw/config/runtime.json -policy /workspace/.blueclaw/config/policy.json" >>/workspace/.blueclaw/logs/blueclaw.log 2>&1 &
blueclaw_process_id="$!"
log_guest_init "blueclaw started"

/usr/local/bin/blueclaw-vsock-http-proxy -mode vsock-to-tcp -listen-vsock-port 8081 -target-tcp 127.0.0.1:8080 >>/workspace/.blueclaw/logs/guest-http-proxy.log 2>&1 &
inbound_proxy_process_id="$!"
log_guest_init "guest http proxy started"

wait -n "$postgres_process_id" "$graphiti_process_id" "$blueclaw_process_id" "$outbound_proxy_process_id" "$inbound_proxy_process_id"
shutdown_guest
