{
  "name": "presentation-lifecycle",
  "skillDirectoryPaths": ["../../assets/blueclaw-workspace/skills/presentation"],
  "allowedTools": ["conversation.history", "memory.search", "terminal.run", "file.read", "file.write", "file.edit", "file.delete", "file.deliver"],
  "initialToolNames": ["file.write", "terminal.run", "file.deliver"],
  "steps": [
    {
      "prompt": "'비용 테스트 발표자료'라는 제목의 3장짜리 HTML 발표자료를 만들어서 전달해줘. 내용은 목표, 진행 방식, 완료 조건이야.",
      "expectedToolCalls": ["file.write", "terminal.run", "file.deliver"],
      "expectedAttachments": [".html"],
      "expectedWorkspaceFiles": [
        {
          "pathGlob": "circles/staff/tmp/*/slides.html",
          "containsFragments": ["비용 테스트 발표자료", "목표", "진행 방식", "완료 조건"],
          "fragmentCounts": {"data-slide-role=": 3}
        }
      ],
      "expectedTaskStatus": "completed"
    },
    {
      "prompt": "방금 만든 발표자료의 마지막 장에 '고정 시드 41' 문구를 추가하고 수정본을 다시 전달해줘.",
      "expectedToolCalls": ["file.deliver"],
      "expectedAnyToolCalls": ["file.edit", "file.write"],
      "expectedAttachments": [".html"],
      "expectedWorkspaceFiles": [
        {
          "pathGlob": "circles/staff/tmp/*/slides.html",
          "containsFragments": ["고정 시드 41"],
          "fragmentCounts": {"data-slide-role=": 3}
        }
      ],
      "expectedTaskStatus": "completed"
    },
    {
      "prompt": "내 발표자료 파일 중 방금 만든 '비용 테스트 발표자료'를 찾아서 경로와 형식을 알려줘.",
      "expectedToolCalls": ["terminal.run"],
      "expectedReplyFragments": ["slides.html", "HTML"],
      "expectedTaskStatus": "completed"
    },
    {
      "prompt": "방금 찾은 '비용 테스트 발표자료' 파일과 작업 폴더를 삭제해줘.",
      "expectedToolCalls": ["file.delete"],
      "expectedEvents": ["confirmation.requested"],
      "expectedTaskStatus": "waiting_approval"
    },
    {
      "prompt": "발표자료 삭제 승인할게.",
      "expectedToolCalls": ["file.delete"],
      "expectedEvents": ["approval.executed"],
      "expectedEventCounts": [
        {"name": "tool.file.delete.result", "bodyFragment": "deleted", "count": 1}
      ],
      "forbiddenWorkspaceFiles": ["circles/staff/tmp/*"],
      "expectedTaskStatus": "completed"
    }
  ]
}
