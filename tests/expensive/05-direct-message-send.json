{
  "name": "direct-message-send",
  "skillDirectoryPaths": ["../../assets/blueclaw-workspace/skills/direct-message"],
  "allowedTools": ["conversation.history", "memory.search", "message.send", "schedule.create"],
  "capabilityToolNames": ["message.send", "schedule.create"],
  "capabilityToolDescriptors": [
    {"name": "message.send", "requiresApproval": true}
  ],
  "initialToolNames": ["message.send"],
  "steps": [
    {
      "prompt": "우경이에게 DM으로 '비용 테스트 메시지'라고 보내줘.",
      "expectedToolCalls": ["message.send"],
      "expectedEvents": ["confirmation.requested"],
      "expectedEventCounts": [
        {"name": "tool.message.send.requested", "bodyFragment": "\"personHint\":\"우경\"", "count": 1},
        {"name": "tool.message.send.requested", "bodyFragment": "\"message\":\"비용 테스트 메시지\"", "count": 1},
        {"name": "tool.message.send.result", "outputFragment": "approval_required", "count": 1}
      ],
      "expectedTaskStatus": "waiting_approval"
    },
    {
      "prompt": "DM 전송 승인할게.",
      "expectedToolCalls": ["message.send"],
      "expectedEvents": ["approval.executed"],
      "expectedEventCounts": [
        {"name": "tool.message.send.result", "outputFragment": "virtual-platform-message-001", "count": 1}
      ],
      "expectedTaskStatus": "completed"
    }
  ]
}
