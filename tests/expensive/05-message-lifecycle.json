{
 "name": "message-lifecycle",
 "requiresLLMD": true,
 "expectedLLMProvider": "openrouter",
 "skillDirectoryPaths": [
  "../../assets/blueclaw-workspace/skills/mattermost"
 ],
 "allowedTools": [
  "conversation.history",
  "memory.search",
  "message.context",
  "message.search",
  "message.send",
  "message.update",
  "message.delete"
 ],
 "capabilityToolNames": [
  "message.context",
  "message.search",
  "message.send",
  "message.update",
  "message.delete"
 ],
 "capabilityToolDescriptors": [
  {
   "name": "message.send",
   "requiresApproval": true
  },
  {
   "name": "message.update",
   "requiresApproval": true
  },
  {
   "name": "message.delete",
   "requiresApproval": true
  }
 ],
 "initialToolNames": [
  "message.send"
 ],
 "steps": [
  {
   "prompt": "이번 주 고객지원 회의 전에 다시 확인할 수 있도록 이 대화에 메모를 하나 남겨줘. 내용은 '고객지원 주간회의 자료가 준비됐습니다. 참석 전에 확인해주세요.'로 해줘.",
   "approvalAction": "approve",
   "expectedToolCalls": [
    "message.send"
   ],
   "expectedExactToolCallCounts": {
    "message.send": 1
   },
   "expectedEvents": [
    "confirmation.requested",
    "approval.pending_call",
    "approval.executed"
   ],
   "expectedEventCounts": [
    {
     "name": "tool.message.send.requested",
     "bodyFragment": "\"targetType\":\"currentThread\"",
     "count": 1,
     "exact": true,
     "advisory": true
    },
    {
     "name": "tool.message.send.requested",
     "bodyFragment": "고객지원 주간회의 자료가 준비됐습니다. 참석 전에 확인해주세요.",
     "count": 1,
     "exact": true
    },
    {
     "name": "tool.message.send.result",
     "outputFragment": "\"deliveryStatus\":\"sent\"",
     "count": 1,
     "exact": true
    }
   ],
   "expectedTaskStatus": "completed"
  },
  {
   "prompt": "방금 남긴 고객지원 주간회의 메모를 찾아서 '고객지원 월간회의 자료가 준비됐습니다. 참석 전에 확인해주세요.'로 고쳐줘.",
   "approvalAction": "approve",
   "expectedToolCalls": [
    "message.search",
    "message.update"
   ],
   "expectedExactToolCallCounts": {
    "message.update": 1
   },
   "expectedToolCallCounts": {
    "message.search": 1
   },
   "expectedEvents": [
    "confirmation.requested",
    "approval.pending_call",
    "approval.executed"
   ],
   "expectedEventCounts": [
    {
     "name": "tool.message.search.result",
     "outputFragment": "고객지원 주간회의 자료가 준비됐습니다.",
     "count": 1
    },
    {
     "name": "tool.message.update.requested",
     "bodyFragment": "고객지원 월간회의 자료가 준비됐습니다. 참석 전에 확인해주세요.",
     "count": 1,
     "exact": true
    },
    {
     "name": "tool.message.update.result",
     "outputFragment": "\"deliveryStatus\":\"updated\"",
     "count": 1,
     "exact": true
    }
   ],
   "expectedTaskStatus": "completed"
  },
  {
   "prompt": "이 대화에서 방금 수정한 고객지원 월간회의 메모를 찾아서 내용이 제대로 바뀌었는지 확인해줘.",
   "expectedToolCalls": [
    "message.search"
   ],
   "expectedToolCallCounts": {
    "message.search": 1
   },
   "expectedEventCounts": [
    {
     "name": "tool.message.search.result",
     "outputFragment": "고객지원 월간회의 자료가 준비됐습니다. 참석 전에 확인해주세요.",
     "count": 1
    }
   ],
   "expectedReplyFragments": [
    "고객지원 월간회의",
    "참석 전에 확인"
   ],
   "expectedTaskStatus": "completed"
  },
  {
   "prompt": "방금 확인한 고객지원 월간회의 메모를 찾아서 삭제해줘.",
   "approvalAction": "approve",
   "expectedToolCalls": [
    "message.search",
    "message.delete"
   ],
   "expectedExactToolCallCounts": {
    "message.delete": 1
   },
   "expectedToolCallCounts": {
    "message.search": 1
   },
   "expectedEvents": [
    "confirmation.requested",
    "approval.pending_call",
    "approval.executed"
   ],
   "expectedEventCounts": [
    {
     "name": "tool.message.search.result",
     "outputFragment": "고객지원 월간회의 자료가 준비됐습니다.",
     "count": 1
    },
    {
     "name": "tool.message.delete.result",
     "outputFragment": "\"deliveryStatus\":\"deleted\"",
     "count": 1,
     "exact": true
    }
   ],
   "expectedTaskStatus": "completed"
  },
  {
   "prompt": "이 대화에서 삭제한 고객지원 월간회의 메모가 더는 남아 있지 않은지 확인해줘.",
   "expectedToolCalls": [
    "message.search"
   ],
   "expectedToolCallCounts": {
    "message.search": 1
   },
   "expectedEventCounts": [
    {
     "name": "tool.message.search.result",
     "outputFragment": "\"messageIDs\":[]",
     "count": 1
    }
   ],
   "expectedReplyFragments": [
    "없"
   ],
   "expectedTaskStatus": "completed"
  }
 ]
}
