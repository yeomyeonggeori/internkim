{
  "name": "task-lifecycle",
  "skillDirectoryPaths": ["../../assets/blueclaw-workspace/skills/internkim-flow"],
  "allowedTools": ["conversation.history", "memory.search", "capability.invoke"],
  "capabilityToolNames": ["task.add", "task.list", "task.update", "task.delete"],
  "capabilityToolDescriptors": [
    {"name": "task.delete", "requiresApproval": true}
  ],
  "initialToolNames": ["capability.invoke"],
  "steps": [
    {
      "prompt": "내 업무로 '비용 테스트 회귀 확인'을 이번 주 금요일 마감으로 추가해줘.",
      "expectedToolCalls": ["task.add"],
      "expectedEventCounts": [
        {"name": "tool.capability.invoke.result", "bodyFragment": "비용 테스트 회귀 확인", "count": 1}
      ],
      "expectedTaskStatus": "completed"
    },
    {
      "prompt": "방금 추가한 업무 제목을 '비용 테스트 회귀 확인 완료 준비'로 수정해줘.",
      "expectedToolCalls": ["task.update"],
      "expectedEventCounts": [
        {"name": "tool.capability.invoke.requested", "bodyFragment": "비용 테스트 회귀 확인 완료 준비", "count": 1},
        {"name": "tool.capability.invoke.result", "bodyFragment": "비용 테스트 회귀 확인 완료 준비", "count": 1}
      ],
      "expectedTaskStatus": "completed"
    },
    {
      "prompt": "내 업무를 조회해서 방금 수정한 업무가 있는지 알려줘.",
      "expectedToolCalls": ["task.list"],
      "expectedReplyFragments": ["비용 테스트 회귀 확인 완료 준비"],
      "expectedTaskStatus": "completed"
    },
    {
      "prompt": "방금 확인한 '비용 테스트 회귀 확인 완료 준비' 업무를 삭제해줘.",
      "expectedToolCalls": ["task.delete"],
      "expectedEvents": ["confirmation.requested"],
      "expectedEventCounts": [
        {"name": "tool.capability.invoke.result", "bodyFragment": "approval_required", "count": 1}
      ],
      "expectedTaskStatus": "waiting_approval"
    },
    {
      "prompt": "삭제 승인할게.",
      "expectedToolCalls": ["task.delete"],
      "expectedEvents": ["approval.executed"],
      "expectedEventCounts": [
        {"name": "tool.capability.invoke.result", "bodyFragment": "deleted", "count": 1}
      ],
      "expectedTaskStatus": "completed"
    }
  ]
}
