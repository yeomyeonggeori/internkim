[Unit]
Description=internkim relay
Documentation=https://github.com/yeomyeonggeori/internkim/blob/main/host/README.md
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/internkim/relay.env
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
ExecStart=/usr/local/bin/internkim-relay
EnvironmentFile=/etc/internkim/relay.env
Environment=RELAY_STATE_DIR=/var/lib/internkim/relay
Restart=always
RestartSec=30s
User=internkim
Group=internkim
StateDirectory=internkim/relay
StateDirectoryMode=0750
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
