[Unit]
Description=internkim relay
Documentation=https://github.com/yeomyeonggeori/internkim/blob/main/host/README.md
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/internkim/relay.env

[Service]
ExecStart=/usr/local/bin/internkim-relay
EnvironmentFile=/etc/internkim/relay.env
Restart=always
RestartSec=5s
User=internkim
Group=internkim
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
