#!/usr/bin/env bash
# Two reasons the seed lives in a file rather than in an argument. A second
# import under a different seed derives different channel ids and lands a
# complete duplicate set of channels beside the originals, which is what
# happened to this company's first import. And an argument is visible to
# anyone who can run ps, while the seed alone signs as any person the import
# creates. The token travels the same way for the second reason.
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repository="$here/../.."
state="${BUZZ_STATE_DIRECTORY:-$repository/.local/buzz}"

seedPath="$state/key-seed"
credentialPath="$state/mattermost.env"
importer="$state/buzz-migrate"

# The relay picks a community from the Host header, so the address it is dialed
# on has to be the community's own host. Reaching the same process on
# 127.0.0.1 answers 404 to the websocket upgrade and nothing explains why.
communityHost="${BUZZ_COMMUNITY_HOST:-localhost:3000}"

for required in "$seedPath" "$credentialPath"; do
	if [[ ! -f $required ]]; then
		echo "missing $required — see host/buzz/README.md" >&2
		exit 1
	fi
done

if [[ ! -x $importer ]]; then
	echo "building the importer" >&2
	(cd "$repository" && go build -o "$importer" ./cmd/buzz-migrate)
fi

set -a
# shellcheck disable=SC1090
. "$credentialPath"
set +a

for name in MATTERMOST_URL MATTERMOST_TOKEN MATTERMOST_TEAM; do
	if [[ -z ${!name:-} ]]; then
		echo "$credentialPath sets no $name" >&2
		exit 1
	fi
done

tokenPath="$state/mattermost-token"
printf '%s\n' "$MATTERMOST_TOKEN" > "$tokenPath"
chmod 600 "$tokenPath"

# The messenger's store refuses a few content types outright, and those files
# go to the company's own asset bucket instead. Reaching it needs what the relay
# needs — an agent key that buys a session acting as the company's host, and the
# project it belongs to. Without all four the import still runs and says which
# files it left out.
#
# macOS ships bash 3.2, where an empty array expanded under `set -u` is an
# unbound variable rather than nothing, so the settings are held as a string
# that is word-split at the call.
agentKeyPath="$state/agent-key"
keepArguments=""
if [[ -f $agentKeyPath && -n ${INTERNKIM_APP_URL:-} && -n ${SUPABASE_URL:-} && -n ${SUPABASE_PUBLISHABLE_KEY:-} ]]; then
	keepArguments="-app-url $INTERNKIM_APP_URL -agent-key-path $agentKeyPath"
	keepArguments="$keepArguments -supabase-url $SUPABASE_URL"
	keepArguments="$keepArguments -supabase-publishable-key $SUPABASE_PUBLISHABLE_KEY"
fi

"$importer" \
	-mattermost-url "$MATTERMOST_URL" \
	-mattermost-token-path "$tokenPath" \
	-team "$MATTERMOST_TEAM" \
	-key-seed-path "$seedPath" \
	-buzz-database-url "${BUZZ_DATABASE_URL:-postgres://buzz:buzz_dev@127.0.0.1:5432/buzz?sslmode=disable}" \
	-buzz-admin "$here/buzz-admin" \
	-relay-url "ws://$communityHost" \
	-relay-http-url "http://$communityHost" \
	-community-host "$communityHost" \
	$keepArguments \
	"$@"
