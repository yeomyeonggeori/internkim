#!/usr/bin/env bash
# buzz-admin ships as a linux/arm64 binary next to the relay, so a mac runs it
# the same way the relay runs: in a container on the stack's own network, where
# `postgres` resolves.
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
relayDirectory="$here/../../.dependency/buzz-relay"
network="${BUZZ_NETWORK:-buzz_default}"
databaseURL="${DATABASE_URL:-postgres://buzz:buzz_dev@postgres:5432/buzz}"

exec docker run --rm --platform linux/arm64 \
	--network "$network" \
	-v "$relayDirectory:/opt/buzz:ro" \
	-e DATABASE_URL="$databaseURL" \
	debian:bookworm-slim /opt/buzz/buzz-admin "$@"
