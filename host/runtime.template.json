{
  "baseURL": "${BLUECLAW_BASE_URL}",
  "languageModel": {
    "defaultProvider": "direct",
    "direct": {
      "endpoint": "https://openrouter.ai/api/v1",
      "apiKeyPath": "${OPENROUTER_KEY_PATH}"
    }
  },
  "capabilities": {
    "unixSocketPath": "${CAPABILITY_SOCKET_PATH}",
    "timeoutSecond": 30
  },
  "database": {
    "driver": "postgres",
    "connectionString": "${DATABASE_URL}",
    "migrationDirectoryPath": "${MIGRATION_DIRECTORY_PATH}"
  },
  "agent": {
    "intake": { "enabled": true, "executionMode": "remote" },
    "defaultEffortLevel": "standard"
  },
  "connectors": {
    "chatd": {
      "endpoint": "${CHATD_ENDPOINT}",
      "enabledPlatforms": ["${MESSENGER_PLATFORM}"],
      "timeoutSecond": 30
    }
  },
  "logging": { "directoryPath": "${LOG_DIRECTORY_PATH}", "retentionDays": 7 },
  "terminal": {
    "mode": "native",
    "workspaceRootPath": "${WORKSPACE_ROOT_PATH}",
    "timeoutSecond": 120,
    "outputMaxBytes": 32768,
    "sessionMaxCount": 4,
    "allowNetwork": true
  },
  "scheduler": { "retentionCheckIntervalMinute": 60, "taskSchedulePollIntervalSecond": 30 }
}
