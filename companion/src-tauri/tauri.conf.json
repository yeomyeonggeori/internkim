{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "internkim",
	"version": "0.1.0",
	"identifier": "kim.intern.companion",
	"build": {
		"beforeDevCommand": "bun run dev",
		"beforeBuildCommand": "bun run build",
		"devUrl": "http://localhost:1420",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "internkim",
				"width": 460,
				"height": 600,
				"resizable": true,
				"minWidth": 360,
				"minHeight": 560,
				"visible": false
			},
			{
				"label": "browser-handoff-overlay",
				"title": "internkim Browser Handoff",
				"width": 520,
				"height": 72,
				"resizable": false,
				"decorations": false,
				"alwaysOnTop": true,
				"skipTaskbar": true,
				"visible": false
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": ["dmg", "msi", "appimage"],
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.png",
			"icons/icon.icns"
		],
		"externalBin": ["binaries/internkim-companion", "binaries/agent-browser"],
		"resources": {
			"../browser-extension": "browser-extension"
		},
		"macOS": {
			"signingIdentity": null
		}
	},
	"plugins": {
		"deep-link": {
			"desktop": {
				"schemes": ["internkim"]
			}
		},
		"shell": {
			"open": false
		}
	}
}
