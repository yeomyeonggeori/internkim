{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Intern Kim Companion",
	"version": "0.1.0",
	"identifier": "kim.intern.companion",
	"build": {
		"beforeDevCommand": "bun run dev",
		"beforeBuildCommand": "bun run build",
		"devUrl": "http://localhost:1420",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "Intern Kim Companion",
				"width": 460,
				"height": 600,
				"resizable": false,
				"visible": false
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": ["dmg", "msi", "appimage"],
		"externalBin": ["binaries/internkim-companion"],
		"macOS": {
			"signingIdentity": null
		}
	},
	"plugins": {
		"deep-link": {
			"desktop": {
				"schemes": ["internkim"]
			}
		},
		"shell": {
			"open": false
		}
	}
}
