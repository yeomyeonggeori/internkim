{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "main-capability",
	"description": "Main companion shell permissions",
	"windows": ["main"],
	"permissions": [
		"core:default",
		"core:event:default",
		"deep-link:default",
		"dialog:default",
		{
			"identifier": "shell:allow-execute",
			"allow": [
				{
					"name": "binaries/internkim-companion",
					"sidecar": true,
					"args": true
				}
			]
		},
		{
			"identifier": "shell:allow-spawn",
			"allow": [
				{
					"name": "binaries/internkim-companion",
					"sidecar": true,
					"args": true
				}
			]
		}
	]
}
