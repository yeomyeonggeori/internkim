{
  "manifest_version": 3,
  "name": "Intern Kim Companion Handoff",
  "version": "0.1.0",
  "description": "Shows a minimal completion button for Intern Kim browser handoffs.",
  "permissions": ["activeTab"],
  "host_permissions": ["http://127.0.0.1:7983/*"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ]
}
