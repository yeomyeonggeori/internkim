#!/usr/bin/env bash
set -euo pipefail

scriptDirectory="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repositoryRoot="$(cd "$scriptDirectory/.." && pwd)"

litertVersion="${LITERT_LM_VERSION:-v0.10.2}"
buildHost="${LITERT_LM_BUILD_HOST:-}"
buildUser="${LITERT_LM_BUILD_USER:-internkim}"
buildPassword="${LITERT_LM_BUILD_PASSWORD:-blueclaw}"
remoteWorkRoot="${LITERT_LM_REMOTE_WORK_ROOT:-/var/cache/internkim/litert-lm-build}"

usage() {
  cat <<USAGE
Usage:
  tools/build-litert-lm-main [--version vX.Y.Z] [--host <ip>] [--user <name>] [--password <pass>]

Builds the litert_lm_main C++ binary on a Linux aarch64 build host (default: the
provisioned board) and caches the result in .dependency/litert-lm-main/<key>/.
Cache hits skip the build entirely.

Environment overrides:
  LITERT_LM_VERSION        Source tag to build (default: v0.10.2)
  LITERT_LM_BUILD_HOST     SSH host (default: cached board IP)
  LITERT_LM_BUILD_USER     SSH user (default: admin)
  LITERT_LM_BUILD_PASSWORD SSH password (omit for key auth)
  LITERT_LM_REMOTE_WORK_ROOT Remote build directory (default: /var/cache/internkim/litert-lm-build)
USAGE
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --version) litertVersion="$2"; shift 2 ;;
    --host) buildHost="$2"; shift 2 ;;
    --user) buildUser="$2"; shift 2 ;;
    --password) buildPassword="$2"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) echo "unknown argument: $1" >&2; usage >&2; exit 1 ;;
  esac
done

cacheKey="${litertVersion}-aarch64"
cacheDirectory="$repositoryRoot/.dependency/litert-lm-main/$cacheKey"
cachedBinaryPath="$cacheDirectory/litert_lm_main"
sourceCacheDirectory="$repositoryRoot/.dependency/litert-lm-main/sources"
sourceTarballPath="$sourceCacheDirectory/litert-lm-$litertVersion.tar.gz"

if [ -x "$cachedBinaryPath" ] && [ -s "$cachedBinaryPath" ]; then
  echo "$cachedBinaryPath"
  exit 0
fi

if [ -z "$buildHost" ]; then
  buildHost="$(tr -d '\r\n' < "$HOME/.internkim/board_ip" 2>/dev/null || true)"
fi
if [ -z "$buildHost" ]; then
  echo "No build host. Pass --host <ip> or set LITERT_LM_BUILD_HOST." >&2
  exit 1
fi

echo "litert-lm build target: $litertVersion on $buildUser@$buildHost"
echo "cache miss: $cachedBinaryPath"

mkdir -p "$sourceCacheDirectory"
if [ ! -s "$sourceTarballPath" ]; then
  echo "downloading source tarball into $sourceTarballPath"
  curl -fsSL "https://github.com/google-ai-edge/litert-lm/archive/refs/tags/$litertVersion.tar.gz" -o "$sourceTarballPath.tmp"
  mv "$sourceTarballPath.tmp" "$sourceTarballPath"
else
  echo "reusing cached source tarball at $sourceTarballPath"
fi

sshpassBin="$repositoryRoot/bin/sshpass"
sshOptions=(-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ServerAliveInterval=30 -o ServerAliveCountMax=240)
sshCommand=(ssh "${sshOptions[@]}" "$buildUser@$buildHost")
scpCommand=(scp "${sshOptions[@]}")
if [ -n "$buildPassword" ] && [ -x "$sshpassBin" ]; then
  sshCommand=(env "SSHPASS=$buildPassword" "$sshpassBin" -e ssh "${sshOptions[@]}" "$buildUser@$buildHost")
  scpCommand=(env "SSHPASS=$buildPassword" "$sshpassBin" -e scp "${sshOptions[@]}")
fi

remoteScript=$(cat <<REMOTE
set -euo pipefail
sudoPrefix=""
if [ -n "${buildPassword:-}" ]; then
  sudoPrefix="echo '$buildPassword' | sudo -S -p ''"
elif sudo -n true 2>/dev/null; then
  sudoPrefix="sudo"
else
  echo "sudo requires a password but none was provided. Pass --password or configure NOPASSWD on the build host." >&2
  exit 1
fi
runSudo() { eval "\$sudoPrefix \$*"; }

runSudo mkdir -p "$remoteWorkRoot"
runSudo chown "$buildUser":"$buildUser" "$remoteWorkRoot"
cd "$remoteWorkRoot"

tarballPath="$remoteWorkRoot/litert-lm-$litertVersion.tar.gz"
if [ ! -s "\$tarballPath" ]; then
  echo "source tarball missing at \$tarballPath" >&2
  exit 1
fi
sourceDirectoryName="\$(tar -tzf "\$tarballPath" | head -1 | tr -d '/')"
if [ -z "\$sourceDirectoryName" ]; then
  echo "could not determine source directory inside \$tarballPath" >&2
  exit 1
fi
if [ ! -d "\$sourceDirectoryName" ]; then
  tar -xzf "\$tarballPath"
fi
cd "\$sourceDirectoryName"

echo "installing build dependencies (apt)"
runSudo apt-get update -y
runSudo apt-get install -y --no-install-recommends \\
  build-essential cmake ninja-build pkg-config \\
  libssl-dev libcurl4-openssl-dev zlib1g-dev \\
  python3 python3-venv default-jdk curl ca-certificates

cmakeMajor="\$(cmake --version | awk 'NR==1 {split(\$3, parts, "."); print parts[1] "." parts[2]}')"
if awk -v have="\$cmakeMajor" 'BEGIN { exit (have+0 >= 3.25) ? 0 : 1 }'; then
  cmakeBinary="cmake"
else
  echo "system cmake \$cmakeMajor too old; installing modern cmake via pip"
  runSudo apt-get install -y --no-install-recommends python3-pip
  pip3 install --user --upgrade --break-system-packages cmake
  cmakeBinary="\$HOME/.local/bin/cmake"
  if [ ! -x "\$cmakeBinary" ]; then
    echo "pip install did not produce \$cmakeBinary" >&2
    ls "\$HOME/.local/bin/" >&2 || true
    exit 1
  fi
fi

if ! command -v rustc >/dev/null 2>&1; then
  curl -fsSL https://sh.rustup.rs | sh -s -- -y --default-toolchain stable --profile minimal
fi
if [ -f "\$HOME/.cargo/env" ]; then
  source "\$HOME/.cargo/env"
fi

if ! command -v g++-13 >/dev/null 2>&1; then
  echo "g++-13 not present; falling back to system g++"
fi
export CXX="\${CXX:-g++}"
export CC="\${CC:-gcc}"

"\$cmakeBinary" -B cmake/build -G "Unix Makefiles" \\
  -DCMAKE_BUILD_TYPE=Release \\
  -DCMAKE_CXX_STANDARD=20

cpuCount="\$(nproc 2>/dev/null || echo 2)"
parallelJobs="\$cpuCount"
if [ "\$parallelJobs" -gt 4 ]; then
  parallelJobs=4
fi

"\$cmakeBinary" --build cmake/build -t litert_lm_main -j"\$parallelJobs"

if [ ! -s "cmake/build/runtime/engine/litert_lm_main" ]; then
  echo "build did not produce litert_lm_main" >&2
  ls cmake/build >&2 || true
  exit 1
fi
REMOTE
)

echo "ensuring remote work root exists"
"${sshCommand[@]}" "set -e
sudoPrefix=\"\"
if [ -n \"${buildPassword}\" ]; then
  sudoPrefix=\"echo '$buildPassword' | sudo -S -p ''\"
elif sudo -n true 2>/dev/null; then
  sudoPrefix=\"sudo\"
else
  echo 'sudo password required' >&2; exit 1
fi
eval \"\$sudoPrefix mkdir -p $remoteWorkRoot\"
eval \"\$sudoPrefix chown $buildUser:$buildUser $remoteWorkRoot\""

echo "uploading source tarball to remote"
"${scpCommand[@]}" "$sourceTarballPath" "$buildUser@$buildHost:$remoteWorkRoot/litert-lm-$litertVersion.tar.gz"

echo "running remote build (this can take 30+ minutes on Jetson Orin Nano)"
"${sshCommand[@]}" "$remoteScript"

mkdir -p "$cacheDirectory"
echo "resolving remote binary path"
remoteBinaryPath="$("${sshCommand[@]}" "ls $remoteWorkRoot/litert-lm-*/cmake/build/runtime/engine/litert_lm_main" 2>/dev/null | head -1)"
if [ -z "$remoteBinaryPath" ]; then
  echo "remote build did not produce litert_lm_main under $remoteWorkRoot" >&2
  exit 1
fi
echo "fetching binary into cache: $remoteBinaryPath"
"${scpCommand[@]}" "$buildUser@$buildHost:$remoteBinaryPath" "$cachedBinaryPath"
chmod 0755 "$cachedBinaryPath"

echo "$cachedBinaryPath"
