+/// The type the generic file path stores for bytes with no recognised signature.
+const UNRECOGNISED_MIME: &str = "application/octet-stream";
+
+/// The type the generic file path stores for a zip archive it can name no further.
+const ZIP_MIME: &str = "application/zip";
+
+/// Declared types whose files are zip archives, besides any `+zip` type
+/// (RFC 6839 structured syntax suffix, e.g. `application/epub+zip`).
+///
+/// `infer` names an OOXML file from where its parts sit in the archive (the
+/// first entry, or the third and fourth, under `word/`, `xl/` or `ppt/`), so a
+/// document from a writer that orders its parts differently sniffs as plain
+/// zip. An ODF package whose `mimetype` entry is not first, or a JAR, can fall
+/// back the same way.
+const ZIP_PACKAGED_MIME_TYPES: &[&str] = &[
+    "application/x-zip-compressed",
+    "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
+    "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
+    "application/vnd.openxmlformats-officedocument.presentationml.presentation",
+    "application/vnd.oasis.opendocument.text",
+    "application/vnd.oasis.opendocument.spreadsheet",
+    "application/vnd.oasis.opendocument.presentation",
+    "application/vnd.oasis.opendocument.graphics",
+    "application/java-archive",
+];
+
+/// Whether the generic file path refuses content of this type.
+///
+/// Recognized media must never fall through exact-byte attachment storage.
+/// Images and video use their canonical media validators; audio is rejected
+/// until Buzz has an explicit sanitizer and location-metadata validator for its
+/// container. Active content and executables are never stored.
+fn is_refused_on_file_path(mime: &str) -> bool {
+    mime.starts_with("image/")
+        || mime.starts_with("video/")
+        || mime.starts_with("audio/")
+        || BLOCKED_FILE_MIME_TYPES.contains(&mime)
+}
+
+fn is_zip_packaged(mime: &str) -> bool {
+    mime.ends_with("+zip") || ZIP_PACKAGED_MIME_TYPES.contains(&mime)
+}
+
+/// Whether a type a client declares for a blob agrees with the type the store
+/// sniffed from its bytes.
+///
+/// Sniffing names the most specific type it can prove, which for a container
+/// is sometimes only the container: a Word document whose parts are ordered
+/// unusually is provably a zip archive and no more. A declaration agrees when
+/// it names the stored type, names nothing (`application/octet-stream`), or
+/// names a format the stored type is the container of: a zip-packaged format
+/// over a stored zip, or a format with no signature over unrecognised bytes.
+/// A type the generic file path would refuse never agrees with anything but
+/// itself, so a blocked type still cannot reach a valid imeta.
+pub fn declared_mime_matches_stored(declared: &str, stored: &str) -> bool {
+    if declared == stored || declared == UNRECOGNISED_MIME {
+        return true;
+    }
+    if is_refused_on_file_path(declared) {
+        return false;
+    }
+    match stored {
+        ZIP_MIME => is_zip_packaged(declared),
+        UNRECOGNISED_MIME => !infer::is_mime_supported(declared),
+        _ => false,
+    }
+}
