#!/usr/bin/env bash
set -euo pipefail

scriptDirectory="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repositoryRoot="$(cd "$scriptDirectory/.." && pwd)"

modelName="${GEMMA_GGUF_NAME:-gemma-4-E4B-it-Q4_0.gguf}"
sourceURL="${GEMMA_GGUF_URL:-https://huggingface.co/unsloth/gemma-4-E4B-it-GGUF/resolve/main/$modelName}"

usage() {
  cat <<USAGE
Usage:
  tools/fetch-gemma-gguf [--name <filename>] [--url <url>]

Downloads the Gemma 4 E4B IT GGUF (Q4_0 by default) into
.dependency/llama-cpp-models/<filename>. Cache hits skip the download.
USAGE
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --name) modelName="$2"; shift 2 ;;
    --url) sourceURL="$2"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) echo "unknown argument: $1" >&2; usage >&2; exit 1 ;;
  esac
done

cacheDirectory="$repositoryRoot/.dependency/llama-cpp-models"
cachedModelPath="$cacheDirectory/$modelName"

if [ -s "$cachedModelPath" ]; then
  echo "$cachedModelPath"
  exit 0
fi

mkdir -p "$cacheDirectory"
echo "downloading $modelName"
curl -fL --progress-bar -o "$cachedModelPath.tmp" "$sourceURL"
mv "$cachedModelPath.tmp" "$cachedModelPath"
echo "$cachedModelPath"
