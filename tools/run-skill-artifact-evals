def main() -> int:
    arguments = parse_arguments()
    if arguments.command == "list":
        return list_evaluations()
    if arguments.command == "run":
        return run_evaluations(arguments)
    if arguments.command == "audit":
        return audit_run(arguments)
    if arguments.command == "judge":
        return judge_run(arguments)
    if arguments.command == "record":
        return record_scores(arguments)
    return 1


def parse_arguments() -> argparse.Namespace:
    argumentParser = argparse.ArgumentParser(description="Run fixed skill artifact quality evals.")
    subcommands = argumentParser.add_subparsers(dest="command", required=True)

    subcommands.add_parser("list", help="List available evaluations.")

    runParser = subcommands.add_parser("run", help="Run fixed evaluations and save timestamped artifacts.")
    runParser.add_argument("--evaluation", action="append", default=[], help="Evaluation ID to run. Repeatable.")
    runParser.add_argument("--dry-run", action="store_true", help="Write run files without executing InternKim.")
    runParser.add_argument("--reuse", action="store_true", help="Reuse the shared Local Fleet while still sending prompts through Mattermost.")
    runParser.add_argument("--seed", type=int, default=DEFAULT_GENERATION_SEED, help="Fixed generation seed passed through internkim test.")
    runParser.add_argument("--temperature", type=float, default=DEFAULT_GENERATION_TEMPERATURE, help="Fixed generation temperature passed through internkim test.")
    runParser.add_argument("--timeout", type=int, default=DEFAULT_TEST_TIMEOUT_SECONDS, help="Seconds passed to internkim test --timeout.")
    runParser.add_argument("--command-timeout", type=int, default=DEFAULT_COMMAND_TIMEOUT_SECONDS, help="Outer Python subprocess timeout in seconds.")

    auditParser = subcommands.add_parser("audit", help="Audit artifacts in an existing run directory.")
    auditParser.add_argument("run_directory", help="Run directory containing generated artifacts.")

    judgeParser = subcommands.add_parser("judge", help="Score a generated run with a separate evaluator.")
    judgeParser.add_argument("run_directory", help="Run directory containing generated artifacts.")
    judgeParser.add_argument("--mode", choices=["heuristic", "openrouter"], default="heuristic", help="Evaluator mode. Heuristic is local and deterministic; openrouter calls a separate judge model.")
    judgeParser.add_argument("--model", default="", help="OpenRouter model name for --mode openrouter. Required for openrouter mode unless SKILL_ARTIFACT_EVAL_JUDGE_MODEL is set.")
    judgeParser.add_argument("--api-key-env", default="OPENROUTER_API_KEY", help="Environment variable containing the OpenRouter API key.")

    recordParser = subcommands.add_parser("record", help="Record a completed scorecard in the tracked score ledger.")
    recordParser.add_argument("run_directory", help="Run directory containing scorecard.json.")

    return argumentParser.parse_args()


def list_evaluations() -> int:
    configuration = load_evaluations()
    for evaluation in configuration["evaluations"]:
        print(f"{evaluation['id']}\t{evaluation['skillName']}\t{evaluation['artifactKind']}")
    return 0


def run_evaluations(arguments: argparse.Namespace) -> int:
    configuration = load_evaluations()
    selectedEvaluations = select_evaluations(configuration, arguments.evaluation)
    runID = current_timestamp()
    runDirectory = ARTIFACTS_ROOT / runID
    runDirectory.mkdir(parents=True, exist_ok=False)

    manifest = create_manifest(runID, selectedEvaluations, arguments.dry_run, arguments.reuse, arguments.seed, arguments.temperature, arguments.timeout, arguments.command_timeout)
    write_json(runDirectory / "manifest.json", manifest)

    for evaluation in selectedEvaluations:
        run_single_evaluation(runDirectory, evaluation, arguments.dry_run, arguments.reuse, arguments.seed, arguments.temperature, arguments.timeout, arguments.command_timeout)

    update_scorecard_for_evaluable_outputs(runDirectory, configuration, selectedEvaluations, None)
    manifest = update_manifest_evaluability(runDirectory, manifest, selectedEvaluations)
    manifest["efficiencyByEvaluationID"] = collect_efficiency_by_evaluation(runDirectory, selectedEvaluations)
    manifest["completedAt"] = current_datetime()
    write_json(runDirectory / "manifest.json", manifest)
    print(relative_path(runDirectory))
    return 0


def record_scores(arguments: argparse.Namespace) -> int:
    runDirectory = resolve_run_directory(arguments.run_directory)
    if not (runDirectory / "scorecard.json").exists():
        raise SystemExit("no evaluable artifacts to record")
    scorecard = read_json(runDirectory / "scorecard.json")
    if len(scorecard.get("scenarios", [])) == 0:
        raise SystemExit("no evaluable artifacts to record")
    manifest = read_json(runDirectory / "manifest.json")
    scoreEntry = create_score_entry(runDirectory, manifest, scorecard)
    scoresLedger = read_json(SCORES_PATH)
    scoresLedger["runs"] = upsert_score_entry(scoresLedger["runs"], scoreEntry)
    write_json(SCORES_PATH, scoresLedger)
    print(f"recorded {scoreEntry['runID']}")
    return 0


def audit_run(arguments: argparse.Namespace) -> int:
    runDirectory = resolve_run_directory(arguments.run_directory)
    audit_run_directory(runDirectory)
    print(f"audited {relative_path(runDirectory)}")
    return 0


def audit_run_directory(runDirectory: Path) -> None:
    configuration = load_evaluations()
    evaluationsByID = {evaluation["id"]: evaluation for evaluation in configuration["evaluations"]}
    manifest = read_json(runDirectory / "manifest.json")
    selectedEvaluations = []
    for evaluationID in manifest["evaluationIDs"]:
        evaluation = evaluationsByID[evaluationID]
        selectedEvaluations.append(evaluation)
        resultDirectory = existing_result_directory(runDirectory, evaluationID)
        diagnosticDirectory = existing_diagnostic_directory(runDirectory, evaluationID)
        commandResultPath = diagnosticDirectory / "command-result.json"
        commandResult = read_json(commandResultPath) if commandResultPath.exists() else {"exitCode": None}
        audit = audit_evaluation_output(resultDirectory, diagnosticDirectory, evaluation, commandResult.get("exitCode"))
        write_json(resultDirectory / "audit.json", audit)
        write_result_summary(resultDirectory, evaluation, audit)
    update_scorecard_for_evaluable_outputs(runDirectory, configuration, selectedEvaluations, None)
    manifest = update_manifest_evaluability(runDirectory, manifest, selectedEvaluations)
    manifest["efficiencyByEvaluationID"] = collect_efficiency_by_evaluation(runDirectory, selectedEvaluations)
    write_json(runDirectory / "manifest.json", manifest)


def collect_efficiency_by_evaluation(runDirectory: Path, selectedEvaluations: list[dict]) -> dict:
    efficiencyByEvaluationID = {}
    for evaluation in selectedEvaluations:
        audit = read_evaluation_audit(runDirectory, evaluation)
        efficiencyByEvaluationID[evaluation["id"]] = audit.get("efficiency") if audit else unavailable_efficiency_metrics("no audit was produced because generation was skipped, interrupted, or failed before result collection")
    return efficiencyByEvaluationID


def judge_run(arguments: argparse.Namespace) -> int:
    runDirectory = resolve_run_directory(arguments.run_directory)
    audit_run_directory(runDirectory)
    configuration = load_evaluations()
    manifest = read_json(runDirectory / "manifest.json")
    if not (runDirectory / "scorecard.json").exists():
        print(f"skipped judge for {relative_path(runDirectory)}: no evaluable artifacts")
        return 0
    scorecard = read_json(runDirectory / "scorecard.json")
    if len(scorecard.get("scenarios", [])) == 0:
        print(f"skipped judge for {relative_path(runDirectory)}: no evaluable artifacts")
        return 0
    judgeMetadata = create_judge_metadata(arguments)
    judgments = []
    for scenario in scorecard["scenarios"]:
        evaluation = evaluation_by_id(configuration, scenario["evaluationID"])
        judgment = judge_evaluation(runDirectory, evaluation, scenario, judgeMetadata, arguments)
        apply_judgment_to_scenario(scenario, judgment)
        write_judgment(runDirectory, evaluation["id"], judgment)
        judgments.append(judgment)
    scorecard["judge"] = judgeMetadata
    write_json(runDirectory / "scorecard.json", scorecard)
    manifest["evaluationPath"] = "separate-" + judgeMetadata["mode"] + "-judge"
    manifest["judge"] = judgeMetadata
    manifest["judgedAt"] = current_datetime()
    write_json(runDirectory / "manifest.json", manifest)
    write_json(runDirectory / "judgments" / "summary.json", {"judge": judgeMetadata, "judgments": judgments})
    print(f"judged {relative_path(runDirectory)} with {judgeMetadata['mode']}")
    return 0


def create_judge_metadata(arguments: argparse.Namespace) -> dict:
    model = first_non_empty_string(arguments.model, os.environ.get("SKILL_ARTIFACT_EVAL_JUDGE_MODEL", ""))
    metadata = {
        "mode": arguments.mode,
        "judgedAt": current_datetime(),
        "isSeparateFromGeneration": True,
    }
    if arguments.mode == "openrouter":
        if not model:
            raise SystemExit("--model or SKILL_ARTIFACT_EVAL_JUDGE_MODEL is required for --mode openrouter")
        metadata["provider"] = "openrouter"
        metadata["model"] = model
    return metadata


def evaluation_by_id(configuration: dict, evaluationID: str) -> dict:
    for evaluation in configuration["evaluations"]:
        if evaluation["id"] == evaluationID:
            return evaluation
    raise SystemExit(f"unknown evaluation ID in scorecard: {evaluationID}")


def judge_evaluation(runDirectory: Path, evaluation: dict, scenario: dict, judgeMetadata: dict, arguments: argparse.Namespace) -> dict:
    if judgeMetadata["mode"] == "openrouter":
        return openrouter_judgment(runDirectory, evaluation, scenario, judgeMetadata, arguments)
    return heuristic_judgment(runDirectory, evaluation, scenario, judgeMetadata)


def write_judgment(runDirectory: Path, evaluationID: str, judgment: dict) -> None:
    directory = runDirectory / "judgments" / evaluationID
    directory.mkdir(parents=True, exist_ok=True)
    write_json(directory / "judgment.json", judgment)


def apply_judgment_to_scenario(scenario: dict, judgment: dict) -> None:
    scoresByID = {score["criterionID"]: score for score in judgment["scores"]}
    for criterion in scenario["scores"]:
        judgedCriterion = scoresByID.get(criterion["criterionID"])
        if judgedCriterion:
            criterion["score"] = judgedCriterion["score"]
            criterion["evidence"] = judgedCriterion["evidence"]
    scenario["notes"] = judgment.get("notes", "")


def heuristic_judgment(runDirectory: Path, evaluation: dict, scenario: dict, judgeMetadata: dict) -> dict:
    resultDirectory = existing_result_directory(runDirectory, evaluation["id"])
    audit = read_json(resultDirectory / "audit.json")
    formatChecks = audit.get("formatChecks", {})
    renderChecks = audit.get("renderChecks", {})
    requiredMissing = audit.get("requiredText", {}).get("missing", [])
    requiredPresent = audit.get("requiredText", {}).get("present", [])
    forbiddenPresent = audit.get("forbiddenText", {}).get("present", [])
    artifactExists = bool(audit.get("artifactExists"))
    if not artifactExists:
        raise SystemExit(f"{evaluation['id']} is not evaluable because the requested artifact was not produced")
    requiredTotal = len(requiredMissing) + len(requiredPresent)
    requiredCoverage = ratio(len(requiredPresent), requiredTotal)
    scores = []
    for criterion in scenario["scores"]:
        scores.append(score_criterion(evaluation, criterion, requiredCoverage, requiredMissing, forbiddenPresent, formatChecks, renderChecks))
    return {
        "evaluationID": evaluation["id"],
        "judge": judgeMetadata,
        "scores": scores,
        "notes": heuristic_notes(artifactExists, requiredMissing, forbiddenPresent, formatChecks, renderChecks),
        "auditSummary": audit_summary(audit),
    }


def score_criterion(evaluation: dict, criterion: dict, requiredCoverage: float, requiredMissing: list[str], forbiddenPresent: list[str], formatChecks: dict, renderChecks: dict) -> dict:
    criterionID = criterion["criterionID"]
    maxScore = criterion["maxScore"]
    if criterionID == "sourceFidelity":
        score = maxScore * requiredCoverage
        score -= min(len(forbiddenPresent) * 12, maxScore)
        score -= min(len(requiredMissing) * 2, maxScore)
        return judged_criterion(criterionID, maxScore, score, fidelity_evidence(requiredMissing, forbiddenPresent, requiredCoverage))
    if criterionID == "instructionFit":
        score = maxScore * instruction_fit_ratio(evaluation, formatChecks, requiredCoverage)
        return judged_criterion(criterionID, maxScore, score, instruction_evidence(evaluation, formatChecks))
    if criterionID == "formatReliability":
        score = maxScore * format_reliability_ratio(evaluation, formatChecks, renderChecks)
        return judged_criterion(criterionID, maxScore, score, format_evidence(formatChecks, renderChecks))
    if criterionID == "sourceGroundedUsefulness":
        score = maxScore * source_grounded_usefulness_ratio(evaluation, formatChecks, requiredCoverage, forbiddenPresent)
        return judged_criterion(criterionID, maxScore, score, usefulness_evidence(requiredCoverage, formatChecks))
    if criterionID == "visualUsability":
        score = maxScore * visual_usability_ratio(evaluation, formatChecks, renderChecks)
        return judged_criterion(criterionID, maxScore, score, visual_evidence(formatChecks, renderChecks))
    raise SystemExit(f"unknown scoring criterion ID: {criterionID}")


def judged_criterion(criterionID: str, maxScore: int | float, score: int | float, evidence: str) -> dict:
    boundedScore = max(0, min(float(maxScore), score))
    return {
        "criterionID": criterionID,
        "maxScore": maxScore,
        "score": round(boundedScore, 2),
        "evidence": evidence,
    }


def instruction_fit_ratio(evaluation: dict, formatChecks: dict, requiredCoverage: float) -> float:
    artifactKind = evaluation["artifactKind"]
    if artifactKind == "docx":
        return average([requiredCoverage, positive_ratio(formatChecks.get("headingCount", 0)), positive_ratio(formatChecks.get("tableCount", 0)), 1.0 if formatChecks.get("hasDocumentXML") else 0.0])
    if artifactKind == "xlsx":
        sheetNames = set(formatChecks.get("sheetNames", []))
        requestedSheets = {"요약", "비용", "일정"}
        return average([requiredCoverage, ratio(len(sheetNames & requestedSheets), len(requestedSheets)), positive_ratio(formatChecks.get("formulaCount", 0)), xlsx_formula_quality_ratio(formatChecks)])
    if artifactKind == "website":
        return average([requiredCoverage, 1.0 if formatChecks.get("hasRenderedText") else 0.0, ratio(formatChecks.get("screenshotCount", 0), 2)])
    if artifactKind == "pdf":
        return average([requiredCoverage, 1.0 if formatChecks.get("hasTextLayer") else 0.0, pdf_page_limit_ratio(formatChecks, 2)])
    if artifactKind == "presentation":
        if is_pptx_format_checks(formatChecks):
            return average([requiredCoverage, positive_ratio(formatChecks.get("slideCount", 0))])
        return average([requiredCoverage, 1.0 if formatChecks.get("hasTextLayer") else 0.0])
    return requiredCoverage


def format_reliability_ratio(evaluation: dict, formatChecks: dict, renderChecks: dict) -> float:
    artifactKind = evaluation["artifactKind"]
    if artifactKind == "website":
        return 1.0 if renderChecks.get("passed") else 0.0
    if artifactKind == "docx":
        return average([1.0 if formatChecks.get("isZip") else 0.0, 1.0 if formatChecks.get("hasDocumentXML") else 0.0, docx_table_quality_ratio(formatChecks), render_ratio(renderChecks)])
    if artifactKind == "xlsx":
        return average([1.0 if formatChecks.get("isZip") else 0.0, 1.0 if formatChecks.get("hasWorkbookXML") else 0.0, positive_ratio(formatChecks.get("sheetCount", 0)), render_ratio(renderChecks)])
    if artifactKind == "pdf":
        return average([1.0 if formatChecks.get("isPDF") else 0.0, positive_ratio(formatChecks.get("pageCount", 0)), 1.0 if formatChecks.get("hasTextLayer") else 0.0, render_ratio(renderChecks)])
    if artifactKind == "presentation":
        if is_pptx_format_checks(formatChecks):
            return average([1.0 if formatChecks.get("isZip") else 0.0, 1.0 if formatChecks.get("hasPresentationXML") else 0.0, positive_ratio(formatChecks.get("slideCount", 0)), render_ratio(renderChecks)])
        return average([1.0 if formatChecks.get("isPDF") else 0.0, positive_ratio(formatChecks.get("pageCount", 0)), 1.0 if formatChecks.get("hasTextLayer") else 0.0, render_ratio(renderChecks)])
    return render_ratio(renderChecks)


def source_grounded_usefulness_ratio(evaluation: dict, formatChecks: dict, requiredCoverage: float, forbiddenPresent: list[str]) -> float:
    penalty = 0.0 if not forbiddenPresent else min(0.6, len(forbiddenPresent) * 0.2)
    artifactKind = evaluation["artifactKind"]
    if artifactKind == "xlsx":
        structure = average([positive_ratio(formatChecks.get("formulaCount", 0)), positive_ratio(formatChecks.get("sheetCount", 0)), xlsx_formula_quality_ratio(formatChecks)])
        return max(0.0, average([requiredCoverage, structure]) - penalty)
    if artifactKind == "docx":
        return max(0.0, average([requiredCoverage, positive_ratio(formatChecks.get("tableCount", 0)), docx_table_quality_ratio(formatChecks)]) - penalty)
    if artifactKind == "pdf":
        return max(0.0, average([requiredCoverage, 1.0 if formatChecks.get("hasTextLayer") else 0.0, pdf_page_limit_ratio(formatChecks, 2)]) - penalty)
    if artifactKind == "website":
        return max(0.0, average([requiredCoverage, 1.0 if formatChecks.get("hasRenderedText") else 0.0]) - penalty)
    if artifactKind == "presentation":
        if is_pptx_format_checks(formatChecks):
            return max(0.0, average([requiredCoverage, positive_ratio(formatChecks.get("slideCount", 0))]) - penalty)
        return max(0.0, average([requiredCoverage, 1.0 if formatChecks.get("hasTextLayer") else 0.0]) - penalty)
    return max(0.0, requiredCoverage - penalty)


def visual_usability_ratio(evaluation: dict, formatChecks: dict, renderChecks: dict) -> float:
    artifactKind = evaluation["artifactKind"]
    if artifactKind == "xlsx":
        return average([render_ratio(renderChecks), 1.0 if formatChecks.get("hasFrozenPanes") else 0.0, 1.0 if formatChecks.get("hasAutoFilter") else 0.0, xlsx_formula_quality_ratio(formatChecks)])
    if artifactKind == "docx":
        return average([render_ratio(renderChecks), render_visual_balance_ratio(renderChecks), positive_ratio(formatChecks.get("tableCount", 0)), docx_table_quality_ratio(formatChecks), typography_quality_ratio(formatChecks)])
    if artifactKind == "pdf":
        return average([render_ratio(renderChecks), render_visual_balance_ratio(renderChecks), pdf_page_limit_ratio(formatChecks, 2), 1.0 if formatChecks.get("hasTextLayer") else 0.0, typography_quality_ratio(formatChecks)])
    if artifactKind == "website":
        return average([render_ratio(renderChecks), render_visual_balance_ratio(renderChecks), typography_quality_ratio(formatChecks), 1.0 if formatChecks.get("hasRenderedText") else 0.0, ratio(formatChecks.get("screenshotCount", 0), 2)])
    if artifactKind == "presentation":
        if is_pptx_format_checks(formatChecks):
            return average([render_ratio(renderChecks), render_visual_balance_ratio(renderChecks), positive_ratio(formatChecks.get("slideCount", 0))])
        return average([render_ratio(renderChecks), render_visual_balance_ratio(renderChecks), 1.0 if formatChecks.get("hasTextLayer") else 0.0, typography_quality_ratio(formatChecks)])
    return render_ratio(renderChecks)


def is_pptx_format_checks(formatChecks: dict) -> bool:
    return "hasPresentationXML" in formatChecks


def render_ratio(renderChecks: dict) -> float:
    if not renderChecks.get("attempted"):
        return 0.5
    return 1.0 if renderChecks.get("passed") else 0.0


def render_visual_balance_ratio(renderChecks: dict) -> float:
    screenshots = renderChecks.get("screenshots", [])
    if not isinstance(screenshots, list) or not screenshots:
        return 0.5
    scores = []
    for screenshot in screenshots:
        if not isinstance(screenshot, dict):
            continue
        visualMetrics = screenshot.get("visualMetrics", {})
        score = visualMetrics.get("visualBalanceScore") if isinstance(visualMetrics, dict) else None
        if isinstance(score, (int, float)):
            scores.append(float(score))
    if not scores:
        return 0.5
    return average(scores)


def xlsx_formula_quality_ratio(formatChecks: dict) -> float:
    offRowFormulaCount = formatChecks.get("offRowFormulaCount", 0)
    if not isinstance(offRowFormulaCount, (int, float)):
        return 0.0
    return 1.0 if offRowFormulaCount == 0 else 0.0


def docx_table_quality_ratio(formatChecks: dict) -> float:
    penalties = 0.0
    penalties += min(0.35, float(formatChecks.get("wideTableCount", 0) or 0) * 0.15)
    penalties += min(0.35, float(formatChecks.get("emptyTableCellCount", 0) or 0) * 0.03)
    penalties += min(0.35, float(formatChecks.get("denseTableCellCount", 0) or 0) * 0.08)
    return max(0.0, 1.0 - penalties)


def typography_quality_ratio(formatChecks: dict) -> float:
    typography = formatChecks.get("typography", {})
    if not isinstance(typography, dict):
        return 0.5
    score = typography.get("typographyScore")
    if isinstance(score, (int, float)):
        return ratio(score, 1)
    return 0.5


def pdf_page_limit_ratio(formatChecks: dict, maxPages: int) -> float:
    pageCount = formatChecks.get("pageCount", 0)
    if not isinstance(pageCount, (int, float)) or pageCount <= 0:
        return 0.0
    if pageCount <= maxPages:
        return 1.0
    return max(0.0, 1.0 - ((pageCount - maxPages) * 0.25))


def positive_ratio(value) -> float:
    return 1.0 if isinstance(value, (int, float)) and value > 0 else 0.0


def ratio(numerator: int | float, denominator: int | float) -> float:
    try:
        denominatorValue = float(denominator)
        numeratorValue = float(numerator)
    except (TypeError, ValueError):
        return 0.0
    if denominatorValue <= 0:
        return 1.0
    return max(0.0, min(1.0, numeratorValue / denominatorValue))


def average(values: list[float]) -> float:
    if not values:
        return 0.0
    return sum(values) / len(values)


def summarize_numeric_values(values: list[float]) -> dict:
    if not values:
        return {"count": 0}
    return {
        "count": len(values),
        "min": round(min(values), 3),
        "median": round(statistics.median(values), 3),
        "max": round(max(values), 3),
    }


def fidelity_evidence(requiredMissing: list[str], forbiddenPresent: list[str], requiredCoverage: float) -> str:
    parts = [f"Required evidence coverage {requiredCoverage:.0%}."]
    if requiredMissing:
        parts.append("Missing required source facts: " + ", ".join(requiredMissing[:8]) + ".")
    if forbiddenPresent:
        parts.append("Forbidden unsupported facts present: " + ", ".join(forbiddenPresent[:8]) + ".")
    return " ".join(parts)


def instruction_evidence(evaluation: dict, formatChecks: dict) -> str:
    artifactKind = evaluation["artifactKind"]
    if artifactKind == "xlsx":
        return "Workbook sheets: " + ", ".join(formatChecks.get("sheetNames", [])) + f"; formulaCount={formatChecks.get('formulaCount', 0)}."
    if artifactKind == "docx":
        return f"DOCX tableCount={formatChecks.get('tableCount', 0)}."
    return "Instruction fit scored from required evidence and artifact audit."


def format_evidence(formatChecks: dict, renderChecks: dict) -> str:
    return "Format checks: " + json.dumps(formatChecks, ensure_ascii=False, sort_keys=True) + "; render: " + json.dumps(renderChecks, ensure_ascii=False, sort_keys=True)


def usefulness_evidence(requiredCoverage: float, formatChecks: dict) -> str:
    return f"Usefulness scored from source coverage {requiredCoverage:.0%} and structure checks {json.dumps(formatChecks, ensure_ascii=False, sort_keys=True)}."


def visual_evidence(formatChecks: dict, renderChecks: dict) -> str:
    return "Visual usability scored from render output and layout affordances: " + json.dumps({"format": formatChecks, "render": renderChecks}, ensure_ascii=False, sort_keys=True)


def heuristic_notes(artifactExists: bool, requiredMissing: list[str], forbiddenPresent: list[str], formatChecks: dict, renderChecks: dict) -> str:
    notes = []
    if not artifactExists:
        notes.append("Artifact was missing.")
    if requiredMissing:
        notes.append("Missing required source facts: " + ", ".join(requiredMissing[:8]) + ".")
    if forbiddenPresent:
        notes.append("Unsupported forbidden facts were present: " + ", ".join(forbiddenPresent[:8]) + ".")
    if renderChecks.get("attempted") and not renderChecks.get("passed"):
        notes.append("Render check failed.")
    offRowFormulaCount = formatChecks.get("offRowFormulaCount", 0)
    if isinstance(offRowFormulaCount, (int, float)) and offRowFormulaCount > 0:
        notes.append(f"{int(offRowFormulaCount)} row-level formulas reference a different row.")
    if formatChecks.get("hasTextLayer") is False:
        notes.append("PDF text layer was missing or unreadable.")
    pageCount = formatChecks.get("pageCount", 0)
    if isinstance(pageCount, (int, float)) and pageCount > 2:
        notes.append(f"PDF has {int(pageCount)} pages, above the expected compact proposal length.")
    wideTableCount = formatChecks.get("wideTableCount", 0)
    if isinstance(wideTableCount, (int, float)) and wideTableCount > 0:
        notes.append(f"{int(wideTableCount)} DOCX tables may be too wide.")
    denseTableCellCount = formatChecks.get("denseTableCellCount", 0)
    if isinstance(denseTableCellCount, (int, float)) and denseTableCellCount > 0:
        notes.append(f"{int(denseTableCellCount)} DOCX table cells are dense.")
    if formatChecks.get("hasRenderedText") is False:
        notes.append("Website rendered text was missing from the captured browser DOM.")
    if formatChecks.get("siteScreenshotsVerified") is False:
        notes.append("Website screenshot verification was missing or failed.")
    typographyScore = typography_quality_ratio(formatChecks)
    if isinstance(formatChecks.get("typography"), dict) and typographyScore < 0.75:
        notes.append(f"Typography/layout score was low ({typographyScore:.2f}).")
    balanceScore = render_visual_balance_ratio(renderChecks)
    if isinstance(renderChecks.get("screenshots"), list) and renderChecks.get("screenshots") and balanceScore < 0.75:
        notes.append(f"Rendered visual balance score was low ({balanceScore:.2f}).")
    if not notes:
        notes.append("Heuristic judge found no required-text, forbidden-text, or format blocker.")
    return " ".join(notes)


def openrouter_judgment(runDirectory: Path, evaluation: dict, scenario: dict, judgeMetadata: dict, arguments: argparse.Namespace) -> dict:
    apiKey = os.environ.get(arguments.api_key_env, "")
    if not apiKey:
        raise SystemExit(f"{arguments.api_key_env} is required for --mode openrouter")
    resultDirectory = existing_result_directory(runDirectory, evaluation["id"])
    audit = read_json(resultDirectory / "audit.json")
    prompt = openrouter_judge_prompt(runDirectory, evaluation, scenario, audit)
    content = call_openrouter_judge(apiKey, judgeMetadata["model"], prompt)
    judgment = parse_openrouter_judgment(content)
    judgment["evaluationID"] = evaluation["id"]
    judgment["judge"] = judgeMetadata
    judgment["auditSummary"] = audit_summary(audit)
    return judgment


def openrouter_judge_prompt(runDirectory: Path, evaluation: dict, scenario: dict, audit: dict) -> str:
    sourceData = read_source_data(evaluation)
    resultDirectory = existing_result_directory(runDirectory, evaluation["id"])
    diagnosticDirectory = existing_diagnostic_directory(runDirectory, evaluation["id"])
    artifactText = extract_evaluation_text(artifact_path(resultDirectory, evaluation), diagnosticDirectory, evaluation["artifactKind"])
    return "\n\n".join([
        "You are an independent evaluator. KimIntern generated the artifact; do not treat KimIntern as the judge.",
        "Score only from the fixed instruction, source data, extracted artifact text, and audit metadata. Penalize unsupported invention heavily.",
        "Return only JSON with keys scores and notes. scores must be an array of {criterionID,maxScore,score,evidence}.",
        "Criteria:\n" + json.dumps(scenario["scores"], ensure_ascii=False, indent=2),
        "Fixed instruction:\n" + evaluation["fixedInstruction"],
        "Source data:\n" + sourceData,
        "Extracted artifact text:\n" + artifactText[:20000],
        "Audit metadata:\n" + json.dumps(audit_summary(audit), ensure_ascii=False, indent=2),
    ])


def call_openrouter_judge(apiKey: str, model: str, prompt: str) -> str:
    requestDocument = {
        "model": model,
        "messages": [
            {"role": "system", "content": "You are a strict artifact quality evaluator. Output valid JSON only."},
            {"role": "user", "content": prompt},
        ],
        "temperature": 0,
    }
    request = urllib.request.Request(
        "https://openrouter.ai/api/v1/chat/completions",
        data=json.dumps(requestDocument).encode("utf-8"),
        headers={
            "Authorization": "Bearer " + apiKey,
            "Content-Type": "application/json",
            "HTTP-Referer": "https://internkim.local/skill-artifact-evals",
            "X-Title": "InternKim Skill Artifact Evals",
        },
        method="POST",
    )
    try:
        with urllib.request.urlopen(request, timeout=180) as response:
            responseDocument = json.loads(response.read().decode("utf-8"))
    except urllib.error.HTTPError as errorValue:
        body = errorValue.read().decode("utf-8", errors="replace")
        raise SystemExit(f"OpenRouter judge failed: HTTP {errorValue.code}: {body}") from errorValue
    choices = responseDocument.get("choices", [])
    if not choices:
        raise SystemExit("OpenRouter judge returned no choices")
    return choices[0].get("message", {}).get("content", "")


def parse_openrouter_judgment(content: str) -> dict:
    stripped = content.strip()
    if stripped.startswith("```"):
        stripped = strip_fenced_json(stripped)
    try:
        judgment = json.loads(stripped)
    except json.JSONDecodeError as errorValue:
        raise SystemExit("OpenRouter judge returned invalid JSON: " + content[:1000]) from errorValue
    if not isinstance(judgment.get("scores"), list):
        raise SystemExit("OpenRouter judge JSON must include scores array")
    judgment["notes"] = str(judgment.get("notes", ""))
    return judgment


def strip_fenced_json(value: str) -> str:
    lines = value.splitlines()
    if len(lines) >= 3 and lines[0].startswith("```") and lines[-1].startswith("```"):
        return "\n".join(lines[1:-1]).strip()
    return value


def load_evaluations() -> dict:
    return read_json(EVALUATIONS_PATH)


def select_evaluations(configuration: dict, selectedIDs: list[str]) -> list[dict]:
    evaluationsByID = {evaluation["id"]: evaluation for evaluation in configuration["evaluations"]}
    if not selectedIDs:
        return list(evaluationsByID.values())

    missingIDs = [selectedID for selectedID in selectedIDs if selectedID not in evaluationsByID]
    if missingIDs:
        raise SystemExit(f"unknown evaluation ID: {', '.join(missingIDs)}")

    return [evaluationsByID[selectedID] for selectedID in selectedIDs]


