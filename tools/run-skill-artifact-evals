        "hasRenderedText": bool(siteHTMLText.strip()),
        "siteScreenshotsVerified": bool(testResult.get("siteScreenshotsVerified")),
        "screenshotCount": len(siteScreenshots) if isinstance(siteScreenshots, list) else 0,
        "typography": siteStyleMetrics if isinstance(siteStyleMetrics, dict) else {},
    }


def audit_xlsx_format(artifactPath) -> dict:
    if not artifactPath or not artifactPath.exists():
        return {"isZip": False, "hasWorkbookXML": False, "sheetCount": 0, "formulaCount": 0}
    try:
        with zipfile.ZipFile(artifactPath) as archive:
            names = set(archive.namelist())
            workbook = ElementTree.fromstring(archive.read("xl/workbook.xml"))
            worksheetRoots = [
                ElementTree.fromstring(archive.read(path))
                for path in sorted(names)
                if path.startswith("xl/worksheets/") and path.endswith(".xml")
            ]
    except (KeyError, OSError, zipfile.BadZipFile, ElementTree.ParseError):
        return {"isZip": False, "hasWorkbookXML": False, "sheetCount": 0, "formulaCount": 0}
    namespace = {"main": "http://schemas.openxmlformats.org/spreadsheetml/2006/main"}
    return {
        "isZip": True,
        "hasWorkbookXML": "xl/workbook.xml" in names,
        "sheetCount": len(workbook.findall(".//main:sheet", namespace)),
        "sheetNames": [
            sheet.get("name", "")
            for sheet in workbook.findall(".//main:sheet", namespace)
            if sheet.get("name")
        ],
        "formulaCount": sum(len(root.findall(".//main:f", namespace)) for root in worksheetRoots),
        "offRowFormulaCount": count_off_row_formulas(worksheetRoots, namespace),
        "hasFrozenPanes": any(root.find(".//main:pane[@state='frozen']", namespace) is not None for root in worksheetRoots),
        "hasAutoFilter": any(root.find(".//main:autoFilter", namespace) is not None for root in worksheetRoots),
        "nonEmptyCellCount": sum(len(root.findall(".//main:c", namespace)) for root in worksheetRoots),
    }


def count_off_row_formulas(worksheetRoots: list[ElementTree.Element], namespace: dict[str, str]) -> int:
    count = 0
    for root in worksheetRoots:
        for cell in root.findall(".//main:c", namespace):
            formula = cell.find("main:f", namespace)
            if formula is not None and formula.text and formula_uses_different_row_reference(cell.get("r", ""), formula.text):
                count += 1
    return count


def formula_uses_different_row_reference(cellReference: str, formulaText: str) -> bool:
    cellRow = cell_reference_row(cellReference)
    if cellRow is None:
        return False
    formula = formulaText.upper()
    if "!" in formula:
        return False
    if any(functionName in formula for functionName in ["SUM(", "SUMIF(", "AVERAGE(", "COUNT(", "COUNTA(", "COUNTIF(", "MIN(", "MAX(", "SUBTOTAL("]):
        return False
    referencedRows = [int(match.group(2)) for match in re.finditer(r"(?<![A-Z])([A-Z]{1,3})([0-9]+)", formula)]
    if not referencedRows:
        return False
    return any(rowNumber != cellRow for rowNumber in referencedRows)


def cell_reference_row(cellReference: str) -> int | None:
    match = re.search(r"([0-9]+)$", cellReference or "")
    if not match:
        return None
    return int(match.group(1))


def write_result_summary(resultDirectory: Path, evaluation: dict, audit: dict | None) -> None:
    files = collect_files(resultDirectory)
    screenshots = collect_screenshots(resultDirectory)
    summary = {
        "evaluationID": evaluation["id"],
        "artifactKind": evaluation["artifactKind"],
        "files": files,
        "screenshots": screenshots,
        "outputStatus": summarize_output_status(evaluation, audit, files, screenshots),
        "audit": audit_summary(audit) if audit else None,
    }
    write_json(resultDirectory / "summary.json", summary)


def summarize_output_status(evaluation: dict, audit: dict | None, files: list[dict], screenshots: list[dict]) -> dict:
    if audit is None:
        return {
            "artifact": "not_audited",
            "artifactReason": "Dry run or interrupted run did not audit generated output.",
            "screenshots": "not_audited",
            "screenshotReason": "Dry run or interrupted run did not run render checks.",
        }
    artifactStatus, artifactReason = summarize_artifact_status(evaluation, audit, files)
    screenshotStatus, screenshotReason = summarize_screenshot_status(evaluation, audit, screenshots)
    return {
        "artifact": artifactStatus,
        "artifactReason": artifactReason,
        "screenshots": screenshotStatus,
        "screenshotReason": screenshotReason,
    }


def summarize_artifact_status(evaluation: dict, audit: dict, files: list[dict]) -> tuple[str, str]:
    if files:
        return "saved", f"{len(files)} artifact file(s) saved under results/<evaluation>/files."
    if audit.get("exitCode") is None:
        return "not_run", "Generation command was skipped, dry-run, or interrupted before a command result was recorded."
    if evaluation["artifactKind"] == "website" and not evaluation.get("outputFileName"):
        publicURL = audit.get("formatChecks", {}).get("publicURL", "")
        if publicURL:
            return "not_file_artifact", "Website eval stores the public URL and screenshots instead of a file attachment."
        if audit.get("exitCode") != 0:
            return "missing", "Website generation command failed before a public URL or downloadable artifact was available."
        return "not_file_artifact", "Website eval did not request a local file artifact."
    if audit.get("artifactExists"):
        return "missing_from_summary", "Audit found an artifact, but it was not listed under the files directory."
    if audit.get("exitCode") != 0:
        return "missing", "Generation command failed before the requested artifact was copied."
    return "missing", "No artifact was found at the expected output path."


def summarize_screenshot_status(evaluation: dict, audit: dict, screenshots: list[dict]) -> tuple[str, str]:
    if screenshots:
        return "saved", f"{len(screenshots)} screenshot(s) saved under results/<evaluation>/screenshots."
    if audit.get("exitCode") is None:
        return "not_run", "Generation command was skipped, dry-run, or interrupted before render checks could run."
    renderChecks = audit.get("renderChecks", {})
    if not renderChecks.get("attempted"):
        return "not_attempted", renderChecks.get("reason", "Render check was not attempted.")
    if renderChecks.get("passed"):
        return "missing_from_summary", "Render check passed, but no screenshot files were listed."
    renderer = renderChecks.get("renderer", "unknown renderer")
    exitCode = renderChecks.get("exitCode")
    if exitCode is not None:
        return "missing", f"{renderer} render failed with exit code {exitCode}."
    return "missing", f"{renderer} render did not produce screenshots."


def collect_outputs(runDirectory: Path, scenarios: list[dict]) -> list[dict]:
    outputs = []
    for scenario in scenarios:
        directory = existing_result_directory(runDirectory, scenario["evaluationID"])
        summaryPath = directory / "summary.json"
        if summaryPath.exists():
            outputs.append(read_json(summaryPath))
            continue
        outputs.append({
            "evaluationID": scenario["evaluationID"],
            "artifactKind": scenario["artifactKind"],
            "files": collect_files(directory),
            "screenshots": collect_screenshots(directory),
        })
    return outputs


def collect_files(resultDirectory: Path) -> list[dict]:
    directory = files_directory(resultDirectory)
    if not directory.exists():
        directory = resultDirectory
    return [file_entry(path) for path in sorted(directory.iterdir()) if path.is_file() and is_artifact_file(path)]


def is_artifact_file(path: Path) -> bool:
    return path.suffix.lower() in ARTIFACT_FILE_EXTENSIONS


def collect_screenshots(resultDirectory: Path) -> list[dict]:
    directory = screenshots_directory(resultDirectory)
    if not directory.exists():
        directory = resultDirectory / "render"
    if not directory.exists():
        return []
    return [file_entry(path) for path in sorted(directory.glob("*.png")) if path.is_file()]


def file_entry(path: Path) -> dict:
    entry = {
        "path": relative_path(path),
        "fileBytes": path.stat().st_size,
    }
    dimensions = render_image_dimensions(path) if path.suffix.lower() == ".png" else {}
    if dimensions:
        entry["dimensions"] = dimensions
    return entry


def collect_audit_summaries(runDirectory: Path, scenarios: list[dict]) -> list[dict]:
    audits = []
    for scenario in scenarios:
        auditPath = existing_result_directory(runDirectory, scenario["evaluationID"]) / "audit.json"
        if auditPath.exists():
            audits.append(audit_summary(read_json(auditPath)))
    return audits


def collect_efficiency_summaries(runDirectory: Path, scenarios: list[dict]) -> list[dict]:
    efficiencySummaries = []
    for scenario in scenarios:
        auditPath = existing_result_directory(runDirectory, scenario["evaluationID"]) / "audit.json"
        efficiency = read_json(auditPath).get("efficiency") if auditPath.exists() else None
        efficiencySummaries.append({
            "evaluationID": scenario["evaluationID"],
            **(efficiency if efficiency else unavailable_efficiency_metrics("no audit was produced for this evaluation")),
        })
    return efficiencySummaries


def audit_summary(audit: dict) -> dict:
    renderChecks = audit.get("renderChecks", {})
    return {
        "evaluationID": audit.get("evaluationID"),
        "artifactKind": audit.get("artifactKind"),
        "exitCode": audit.get("exitCode"),
        "artifactPath": audit.get("artifactPath"),
        "artifactExists": audit.get("artifactExists"),
        "artifactBytes": audit.get("artifactBytes"),
        "requiredMissing": audit.get("requiredText", {}).get("missing", []),
        "forbiddenPresent": audit.get("forbiddenText", {}).get("present", []),
        "formatChecks": audit.get("formatChecks", {}),
        "render": {
            "attempted": renderChecks.get("attempted", False),
            "reason": renderChecks.get("reason", ""),
            "renderer": renderChecks.get("renderer"),
            "exitCode": renderChecks.get("exitCode"),
            "passed": renderChecks.get("passed", False),
            "usedExistingScreenshots": renderChecks.get("usedExistingScreenshots", False),
            "screenshots": renderChecks.get("screenshots", renderChecks.get("images", [])),
        },
    }


def resolve_run_directory(runDirectoryValue: str) -> Path:
    runDirectory = Path(runDirectoryValue)
    if not runDirectory.is_absolute():
        runDirectory = REPOSITORY_ROOT / runDirectory
    if not runDirectory.exists():
        raise SystemExit(f"run directory does not exist: {runDirectoryValue}")
    return runDirectory


def current_timestamp() -> str:
    return datetime.datetime.now(datetime.UTC).strftime("%Y%m%dT%H%M%SZ")


def current_datetime() -> str:
    return datetime.datetime.now(datetime.UTC).isoformat(timespec="seconds").replace("+00:00", "Z")


def git_revision() -> str:
    completedProcess = subprocess.run(["git", "rev-parse", "--short", "HEAD"], cwd=REPOSITORY_ROOT, text=True, capture_output=True)
    if completedProcess.returncode != 0:
        return "unknown"
    return completedProcess.stdout.strip()


def read_json(path: Path) -> dict:
    return json.loads(path.read_text(encoding="utf-8"))


def read_test_result(diagnosticDirectory: Path) -> dict:
    path = diagnosticDirectory / "test-result.json"
    if not path.exists():
        return {}
    try:
        document = read_json(path)
    except (json.JSONDecodeError, OSError):
        return {}
    return document if isinstance(document, dict) else {}


def write_json(path: Path, value: dict) -> None:
    path.write_text(json.dumps(value, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")


def sha256_text(value: str) -> str:
    return hashlib.sha256(value.encode("utf-8")).hexdigest()


def relative_path(path: Path) -> str:
    return path.relative_to(REPOSITORY_ROOT).as_posix()


def format_float(value: float) -> str:
    return f"{value:g}"


def first_non_empty_string(*values) -> str:
    for value in values:
        trimmedValue = str(value or "").strip()
        if trimmedValue:
            return trimmedValue
    return ""


if __name__ == "__main__":
    sys.exit(main())
