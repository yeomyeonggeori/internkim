def write_scorecard(runDirectory: Path, runID: str, configuration: dict, selectedEvaluations: list[dict], judgeMetadata: dict | None) -> None:
    scorecard = {
        "runID": runID,
        "scoringVersion": configuration["version"],
        "judge": judgeMetadata,
        "scoringInstructions": configuration["scorecardInstructions"],
        "scenarios": [create_scorecard_scenario(evaluation, configuration["scoringCriteria"]) for evaluation in selectedEvaluations]
    }
    write_json(runDirectory / "scorecard.json", scorecard)


def update_scorecard_for_evaluable_outputs(runDirectory: Path, configuration: dict, selectedEvaluations: list[dict], judgeMetadata: dict | None) -> None:
    evaluableEvaluations = [evaluation for evaluation in selectedEvaluations if is_evaluation_evaluable(runDirectory, evaluation)]
    scorecardPath = runDirectory / "scorecard.json"
    if not evaluableEvaluations:
        if scorecardPath.exists():
            scorecardPath.unlink()
        return
    write_scorecard(runDirectory, runDirectory.name, configuration, evaluableEvaluations, judgeMetadata)


def update_manifest_evaluability(runDirectory: Path, manifest: dict, selectedEvaluations: list[dict]) -> dict:
    evaluableIDs = []
    nonEvaluable = []
    for evaluation in selectedEvaluations:
        audit = read_evaluation_audit(runDirectory, evaluation)
        if audit and is_audit_evaluable(evaluation, audit):
            evaluableIDs.append(evaluation["id"])
            continue
        nonEvaluable.append({
            "evaluationID": evaluation["id"],
            "reason": non_evaluable_reason(evaluation, audit),
        })
    manifest["evaluableEvaluationIDs"] = evaluableIDs
    manifest["nonEvaluableEvaluations"] = nonEvaluable
    if not evaluableIDs:
        manifest["evaluationPath"] = None
        manifest.pop("judge", None)
        manifest.pop("judgedAt", None)
    return manifest


def is_evaluation_evaluable(runDirectory: Path, evaluation: dict) -> bool:
    audit = read_evaluation_audit(runDirectory, evaluation)
    return bool(audit and is_audit_evaluable(evaluation, audit))


def read_evaluation_audit(runDirectory: Path, evaluation: dict) -> dict | None:
    auditPath = existing_result_directory(runDirectory, evaluation["id"]) / "audit.json"
    if not auditPath.exists():
        return None
    return read_json(auditPath)


def is_audit_evaluable(evaluation: dict, audit: dict) -> bool:
    if evaluation["artifactKind"] == "website":
        formatChecks = audit.get("formatChecks", {})
        renderChecks = audit.get("renderChecks", {})
        return bool(formatChecks.get("hasPublicURL") or renderChecks.get("publicURL"))
    return bool(audit.get("artifactExists"))


def non_evaluable_reason(evaluation: dict, audit: dict | None) -> str:
    if audit is None:
        return "No audit was produced because generation was skipped, interrupted, or failed before result collection."
    if evaluation["artifactKind"] == "website":
        return "No published website URL was produced, so there is no website artifact to evaluate."
    if audit.get("exitCode") is None:
        return "Generation was skipped, dry-run, or interrupted before producing an artifact."
    if audit.get("exitCode") != 0:
        return "Generation command failed before producing the requested artifact."
    return "The requested artifact was not found at the expected output path."


def create_scorecard_scenario(evaluation: dict, scoringCriteria: list[dict]) -> dict:
    return {
        "evaluationID": evaluation["id"],
        "skillName": evaluation["skillName"],
        "artifactKind": evaluation["artifactKind"],
        "scores": [create_scorecard_criterion(criterion) for criterion in scoringCriteria],
        "notes": ""
    }


def create_scorecard_criterion(criterion: dict) -> dict:
    return {
        "criterionID": criterion["id"],
        "label": criterion["label"],
        "maxScore": criterion["maxScore"],
        "score": None,
        "evidence": ""
    }


def run_single_evaluation(runDirectory: Path, evaluation: dict, isDryRun: bool, shouldReuseFleet: bool, seed: int, temperature: float, testTimeoutSeconds: int, commandTimeoutSeconds: int) -> None:
    resultDirectory = result_directory(runDirectory, evaluation["id"])
    diagnosticDirectory = diagnostic_directory(runDirectory, evaluation["id"])
    resultDirectory.mkdir(parents=True)
    diagnosticDirectory.mkdir(parents=True)
    if evaluation["outputFileName"]:
        files_directory(resultDirectory).mkdir()
    prompt = build_prompt(evaluation)
    (diagnosticDirectory / "prompt.txt").write_text(prompt + "\n", encoding="utf-8")
    write_json(diagnosticDirectory / "evaluation.json", enrich_evaluation(evaluation, prompt))
    command = build_evaluation_command(evaluation, resultDirectory, diagnosticDirectory, prompt, shouldReuseFleet, seed, temperature, testTimeoutSeconds)
    write_json(diagnosticDirectory / "command.json", {"command": command})
    runMetadata = {"startedAt": current_datetime(), "finishedAt": None}
    write_json(diagnosticDirectory / "run.json", runMetadata)

    if isDryRun:
        write_json(diagnosticDirectory / "command-result.json", {"exitCode": None, "skipped": True})
        runMetadata["finishedAt"] = current_datetime()
        write_json(diagnosticDirectory / "run.json", runMetadata)
        write_result_summary(resultDirectory, evaluation, None)
        return

    try:
        completedProcess = subprocess.run(command, cwd=REPOSITORY_ROOT, text=True, capture_output=True, timeout=commandTimeoutSeconds)
        stdoutText = completedProcess.stdout
        stderrText = completedProcess.stderr
        exitCode = completedProcess.returncode
        commandResult = {"exitCode": exitCode, "skipped": False, "timedOut": False}
    except subprocess.TimeoutExpired as errorValue:
        stdoutText = subprocess_output_text(errorValue.stdout)
        stderrText = subprocess_output_text(errorValue.stderr)
        exitCode = -1
        commandResult = {"exitCode": exitCode, "skipped": False, "timedOut": True, "timeoutSeconds": commandTimeoutSeconds}
    (diagnosticDirectory / "stdout.txt").write_text(stdoutText, encoding="utf-8")
    (diagnosticDirectory / "stderr.txt").write_text(stderrText, encoding="utf-8")
    write_json(diagnosticDirectory / "command-result.json", commandResult)
    audit = audit_evaluation_output(resultDirectory, diagnosticDirectory, evaluation, exitCode)
    write_json(resultDirectory / "audit.json", audit)
    write_result_summary(resultDirectory, evaluation, audit)
    runMetadata["finishedAt"] = current_datetime()
    write_json(diagnosticDirectory / "run.json", runMetadata)


def subprocess_output_text(value) -> str:
    if value is None:
        return ""
    if isinstance(value, bytes):
        return value.decode("utf-8", errors="replace")
    return str(value)


def result_directory(runDirectory: Path, evaluationID: str) -> Path:
    return runDirectory / "results" / evaluationID


def diagnostic_directory(runDirectory: Path, evaluationID: str) -> Path:
    return runDirectory / "diagnostics" / evaluationID


def files_directory(resultDirectory: Path) -> Path:
    return resultDirectory / "files"


def screenshots_directory(resultDirectory: Path) -> Path:
    return resultDirectory / "screenshots"


def legacy_evaluation_directory(runDirectory: Path, evaluationID: str) -> Path:
    return runDirectory / evaluationID


def existing_result_directory(runDirectory: Path, evaluationID: str) -> Path:
    directory = result_directory(runDirectory, evaluationID)
    if directory.exists():
        return directory
    return legacy_evaluation_directory(runDirectory, evaluationID)


def existing_diagnostic_directory(runDirectory: Path, evaluationID: str) -> Path:
    directory = diagnostic_directory(runDirectory, evaluationID)
    if directory.exists():
        return directory
    return legacy_evaluation_directory(runDirectory, evaluationID)


def build_prompt(evaluation: dict) -> str:
    sourceData = read_source_data(evaluation)
    return "\n\n".join([
        evaluation["fixedInstruction"].strip(),
        COMMON_SOURCE_RULES,
        quality_rules(evaluation),
        "소스 데이터:",
        sourceData.strip()
    ])


def quality_rules(evaluation: dict) -> str:
    if evaluation["artifactKind"] == "website":
        return WEBSITE_QUALITY_RULES
    if evaluation["artifactKind"] == "xlsx":
        return SPREADSHEET_QUALITY_RULES
    if evaluation["artifactKind"] == "presentation":
        return PRESENTATION_QUALITY_RULES
    return DOCUMENT_QUALITY_RULES


def enrich_evaluation(evaluation: dict, prompt: str) -> dict:
    enrichedEvaluation = dict(evaluation)
    sourcePath = EVALUATIONS_PATH.parent / evaluation["sourceFile"]
    enrichedEvaluation["sourceSHA256"] = sha256_text(sourcePath.read_text(encoding="utf-8"))
    enrichedEvaluation["promptSHA256"] = sha256_text(prompt)
    return enrichedEvaluation


def read_source_data(evaluation: dict) -> str:
    sourcePath = EVALUATIONS_PATH.parent / evaluation["sourceFile"]
    return sourcePath.read_text(encoding="utf-8")


def build_evaluation_command(evaluation: dict, resultDirectory: Path, diagnosticDirectory: Path, prompt: str, shouldReuseFleet: bool, seed: int, temperature: float, testTimeoutSeconds: int) -> list[str]:
    command = [
        str(REPOSITORY_ROOT / "internkim"),
        "test",
        prompt,
        "--no-open",
        "--seed",
        str(seed),
        "--temperature",
        format_float(temperature),
        "--timeout",
        str(testTimeoutSeconds),
        "--result-json",
        str(diagnosticDirectory / "test-result.json"),
    ]
    if shouldReuseFleet:
        command.append("--reuse")
    if evaluation["artifactKind"] == "website":
        command.append("--expect-public-url")
    for expectedTool in evaluation.get("expectedTools", []):
        command.extend(["--expect-tool", expectedTool])
    if evaluation["outputFileName"]:
        command.extend(["-o", str(files_directory(resultDirectory) / evaluation["outputFileName"])])
    return command


def create_score_entry(runDirectory: Path, manifest: dict, scorecard: dict) -> dict:
    scenarios = [create_score_scenario(scenario) for scenario in scorecard["scenarios"]]
    return {
        "runID": scorecard["runID"],
        "startedAt": manifest["startedAt"],
        "completedAt": manifest["completedAt"],
        "recordedAt": current_datetime(),
        "gitRevision": manifest["gitRevision"],
        "runDirectory": relative_path(runDirectory),
        "generationOptions": manifest.get("generationOptions"),
        "judge": scorecard.get("judge"),
        "scores": scenarios,
        "outputs": collect_outputs(runDirectory, scenarios),
        "audits": collect_audit_summaries(runDirectory, scenarios),
        "efficiency": collect_efficiency_summaries(runDirectory, scenarios)
    }


def create_score_scenario(scenario: dict) -> dict:
    criteria = [validate_criterion_score(criterion) for criterion in scenario["scores"]]
    return {
        "evaluationID": scenario["evaluationID"],
        "skillName": scenario["skillName"],
        "artifactKind": scenario["artifactKind"],
        "totalScore": sum(criterion["score"] for criterion in criteria),
        "maxScore": sum(criterion["maxScore"] for criterion in criteria),
        "criteria": criteria,
        "notes": scenario.get("notes", "")
    }


def validate_criterion_score(criterion: dict) -> dict:
    score = criterion.get("score")
    maxScore = criterion["maxScore"]
    if not isinstance(score, (int, float)):
        raise SystemExit(f"{criterion['criterionID']} score is missing")
    if score < 0 or score > maxScore:
        raise SystemExit(f"{criterion['criterionID']} score must be between 0 and {maxScore}")
    return criterion


def upsert_score_entry(scoreEntries: list[dict], scoreEntry: dict) -> list[dict]:
    remainingEntries = [entry for entry in scoreEntries if entry["runID"] != scoreEntry["runID"]]
    return remainingEntries + [scoreEntry]


def audit_evaluation_output(resultDirectory: Path, diagnosticDirectory: Path, evaluation: dict, exitCode) -> dict:
    artifactPath = artifact_path(resultDirectory, evaluation)
    extractedText = extract_evaluation_text(artifactPath, diagnosticDirectory, evaluation["artifactKind"])
    formatChecks = audit_format(artifactPath, diagnosticDirectory, evaluation["artifactKind"])
    renderChecks = audit_render(resultDirectory, diagnosticDirectory, artifactPath, evaluation["artifactKind"], exitCode)
    artifactExists = evaluation_artifact_exists(artifactPath, evaluation["artifactKind"], formatChecks)
    return {
        "evaluationID": evaluation["id"],
        "artifactKind": evaluation["artifactKind"],
        "exitCode": exitCode,
        "artifactPath": relative_path(artifactPath) if artifactPath else None,
        "artifactExists": artifactExists,
        "artifactBytes": artifactPath.stat().st_size if artifactPath and artifactPath.exists() else 0,
        "extractedTextLength": len(extractedText),
        "requiredText": check_text_presence(extractedText, evaluation.get("requiredText", [])),
        "forbiddenText": check_text_presence(extractedText, evaluation.get("forbiddenText", [])),
        "formatChecks": formatChecks,
        "renderChecks": renderChecks,
        "efficiency": compute_efficiency_metrics(read_test_result(diagnosticDirectory)),
    }


TURN_TASK_STEP_ID_PATTERN = re.compile(r":turn-\d+$")
TOOL_REQUESTED_EVENT_NAME_PATTERN = re.compile(r"^tool\..+\.requested$")
TOOL_RESULT_EVENT_NAME_PATTERN = re.compile(r"^tool\..+\.result$")


def compute_efficiency_metrics(testResult: dict) -> dict:
    taskDetailError = str(testResult.get("taskDetailError", "")).strip()
    taskDetail = testResult.get("taskDetail")
    if not isinstance(taskDetail, dict):
        return unavailable_efficiency_metrics(taskDetailError or "no taskDetail was captured for this generation run")
    taskRun = taskDetail.get("taskRun")
    taskSteps = taskDetail.get("taskSteps")
    taskEvents = taskDetail.get("taskEvents")
    if not isinstance(taskRun, dict) or not isinstance(taskSteps, list) or not isinstance(taskEvents, list):
        return unavailable_efficiency_metrics("taskDetail response was missing taskRun, taskSteps, or taskEvents")
    return {
        "available": True,
        "reason": None,
        "taskRunID": string_or_none(testResult.get("taskRunID")),
        "taskStatus": string_or_none(taskRun.get("status")),
        "turnCount": count_turn_task_steps(taskSteps),
        "totalToolCalls": count_events_matching_pattern(taskEvents, TOOL_REQUESTED_EVENT_NAME_PATTERN),
        "failedToolCalls": count_failed_tool_result_events(taskEvents),
        "recoveryAttempts": count_events_with_name(taskEvents, "agent.recovery_attempt"),
        "failureDebtEvents": count_events_with_name(taskEvents, "agent.failure_debt_created"),
        "requiredEvidenceReaskEvents": count_events_with_name(taskEvents, "agent.required_evidence_reask"),
        "llmCallCount": count_events_with_name(taskEvents, "llm.call"),
        "wallClockSeconds": compute_task_run_wall_clock_seconds(taskRun),
    }


def unavailable_efficiency_metrics(reason: str) -> dict:
    return {
        "available": False,
        "reason": reason,
        "taskRunID": None,
        "taskStatus": None,
        "turnCount": None,
        "totalToolCalls": None,
        "failedToolCalls": None,
        "recoveryAttempts": None,
        "failureDebtEvents": None,
        "requiredEvidenceReaskEvents": None,
        "llmCallCount": None,
        "wallClockSeconds": None,
    }


def count_turn_task_steps(taskSteps: list) -> int:
    return len([
        taskStep for taskStep in taskSteps
        if isinstance(taskStep, dict) and TURN_TASK_STEP_ID_PATTERN.search(str(taskStep.get("taskStepID", "")))
    ])


def count_events_matching_pattern(taskEvents: list, pattern: re.Pattern) -> int:
    return len([
        taskEvent for taskEvent in taskEvents
        if isinstance(taskEvent, dict) and pattern.match(str(taskEvent.get("name", "")))
    ])


def count_events_with_name(taskEvents: list, name: str) -> int:
    return len([taskEvent for taskEvent in taskEvents if isinstance(taskEvent, dict) and taskEvent.get("name") == name])


def count_failed_tool_result_events(taskEvents: list) -> int:
    count = 0
    for taskEvent in taskEvents:
        if not isinstance(taskEvent, dict) or not TOOL_RESULT_EVENT_NAME_PATTERN.match(str(taskEvent.get("name", ""))):
            continue
        if task_event_body_reports_failure(taskEvent.get("body", "")):
            count += 1
    return count


def task_event_body_reports_failure(body) -> bool:
    if not isinstance(body, str) or not body.strip():
        return False
    try:
        document = json.loads(body)
    except json.JSONDecodeError:
        return False
    return isinstance(document, dict) and bool(document.get("failure"))


def compute_task_run_wall_clock_seconds(taskRun: dict) -> float | None:
    createdAt = parse_iso_datetime(taskRun.get("createdAt"))
    updatedAt = parse_iso_datetime(taskRun.get("updatedAt"))
    if createdAt is None or updatedAt is None:
        return None
    return round((updatedAt - createdAt).total_seconds(), 3)


def parse_iso_datetime(value) -> datetime.datetime | None:
    if not isinstance(value, str) or not value.strip():
        return None
    normalized = value.strip()
    if normalized.endswith("Z"):
        normalized = normalized[:-1] + "+00:00"
    try:
        return datetime.datetime.fromisoformat(normalized)
    except ValueError:
        return None


def string_or_none(value) -> str | None:
    trimmedValue = str(value or "").strip()
    return trimmedValue if trimmedValue else None


def evaluation_artifact_exists(artifactPath: Path | None, artifactKind: str, formatChecks: dict) -> bool:
    if artifactKind == "website":
        return bool(formatChecks.get("hasPublicURL"))
    return bool(artifactPath and artifactPath.exists())


def artifact_path(resultDirectory: Path, evaluation: dict):
    outputFileName = evaluation.get("outputFileName")
    if not outputFileName:
        return None
    outputPath = files_directory(resultDirectory) / outputFileName
    if outputPath.exists():
        return outputPath
    return resultDirectory / outputFileName


def extract_evaluation_text(artifactPath, diagnosticDirectory: Path, artifactKind: str) -> str:
    if artifactKind == "website":
        return extract_website_text(diagnosticDirectory)
    return extract_artifact_text(artifactPath, artifactKind)


def extract_artifact_text(artifactPath, artifactKind: str) -> str:
    if not artifactPath or not artifactPath.exists():
        return ""
    if artifactKind == "docx":
        return extract_docx_text(artifactPath)
    if artifactKind == "xlsx":
        return extract_xlsx_text(artifactPath)
    if artifactKind == "pdf":
        return extract_pdf_text(artifactPath)
    if artifactKind == "presentation":
        return extract_presentation_text(artifactPath)
    return ""


def extract_presentation_text(artifactPath: Path) -> str:
    if artifactPath.suffix.lower() == ".pdf":
        return extract_pdf_text(artifactPath)
    return extract_pptx_text(artifactPath)


def extract_pptx_text(artifactPath: Path) -> str:
    try:
        with zipfile.ZipFile(artifactPath) as archive:
            slidePaths = sorted(name for name in archive.namelist() if re.match(r"^ppt/slides/slide\d+\.xml$", name))
            texts = []
            for slidePath in slidePaths:
                root = ElementTree.fromstring(archive.read(slidePath))
                namespace = {"a": "http://schemas.openxmlformats.org/drawingml/2006/main"}
                for textElement in root.findall(".//a:t", namespace):
                    if textElement.text:
                        texts.append(textElement.text)
    except (KeyError, OSError, zipfile.BadZipFile, ElementTree.ParseError):
        return ""
    return "\n".join(texts)


def extract_docx_text(artifactPath: Path) -> str:
    try:
        with zipfile.ZipFile(artifactPath) as archive:
            document = ElementTree.fromstring(archive.read("word/document.xml"))
    except (KeyError, OSError, zipfile.BadZipFile, ElementTree.ParseError):
        return ""
    namespace = {"w": "http://schemas.openxmlformats.org/wordprocessingml/2006/main"}
    paragraphs = []
    for paragraph in document.findall(".//w:p", namespace):
        text = "".join(node.text or "" for node in paragraph.findall(".//w:t", namespace)).strip()
        if text:
            paragraphs.append(text)
    return "\n".join(paragraphs)


def extract_xlsx_text(artifactPath: Path) -> str:
    try:
        with zipfile.ZipFile(artifactPath) as archive:
            sharedStrings = read_xlsx_shared_strings(archive)
            workbookText = read_xlsx_workbook_text(archive)
            worksheetText = read_xlsx_worksheet_text(archive, sharedStrings)
    except (KeyError, OSError, zipfile.BadZipFile, ElementTree.ParseError):
        return ""
    return "\n".join(workbookText + worksheetText)


def extract_pdf_text(artifactPath: Path) -> str:
    pdftotextPath = shutil.which("pdftotext")
    if not pdftotextPath:
        return ""
    completedProcess = subprocess.run(
        [pdftotextPath, "-layout", str(artifactPath), "-"],
        cwd=REPOSITORY_ROOT,
        text=True,
        capture_output=True,
    )
    if completedProcess.returncode != 0:
        return ""
    return completedProcess.stdout


def extract_website_text(diagnosticDirectory: Path) -> str:
    testResult = read_test_result(diagnosticDirectory)
    if testResult:
        return "\n".join([
            str(testResult.get("botMessage", "")),
            str(testResult.get("sitePublicURL", "")),
            str(testResult.get("siteHTMLText", "")),
        ])
    return ""


def read_xlsx_shared_strings(archive: zipfile.ZipFile) -> list[str]:
    if "xl/sharedStrings.xml" not in archive.namelist():
        return []
    root = ElementTree.fromstring(archive.read("xl/sharedStrings.xml"))
    namespace = {"main": "http://schemas.openxmlformats.org/spreadsheetml/2006/main"}
    strings = []
    for item in root.findall("main:si", namespace):
        strings.append("".join(text.text or "" for text in item.findall(".//main:t", namespace)))
    return strings


def read_xlsx_workbook_text(archive: zipfile.ZipFile) -> list[str]:
    root = ElementTree.fromstring(archive.read("xl/workbook.xml"))
    namespace = {"main": "http://schemas.openxmlformats.org/spreadsheetml/2006/main"}
    return [
        sheet.get("name", "")
        for sheet in root.findall(".//main:sheet", namespace)
        if sheet.get("name")
    ]


def read_xlsx_worksheet_text(archive: zipfile.ZipFile, sharedStrings: list[str]) -> list[str]:
    values = []
    for worksheetPath in sorted(path for path in archive.namelist() if path.startswith("xl/worksheets/") and path.endswith(".xml")):
        root = ElementTree.fromstring(archive.read(worksheetPath))
        values.extend(read_xlsx_cells(root, sharedStrings))
    return values


def read_xlsx_cells(root: ElementTree.Element, sharedStrings: list[str]) -> list[str]:
    namespace = {"main": "http://schemas.openxmlformats.org/spreadsheetml/2006/main"}
    values = []
    for cell in root.findall(".//main:c", namespace):
        values.extend(read_xlsx_cell_values(cell, sharedStrings, namespace))
    return values


def read_xlsx_cell_values(cell: ElementTree.Element, sharedStrings: list[str], namespace: dict[str, str]) -> list[str]:
    values = []
    formula = cell.find("main:f", namespace)
    if formula is not None and formula.text:
        values.append("=" + formula.text)
    cellType = cell.get("t")
    if cellType == "inlineStr":
        inlineText = "".join(text.text or "" for text in cell.findall(".//main:is/main:t", namespace))
        if inlineText:
            values.append(inlineText)
        return values
    valueElement = cell.find("main:v", namespace)
    if valueElement is None or valueElement.text is None:
        return values
    if cellType == "s":
        values.append(resolve_shared_string(valueElement.text, sharedStrings))
    else:
        values.append(valueElement.text)
    return [value for value in values if value]


def resolve_shared_string(indexText: str, sharedStrings: list[str]) -> str:
    try:
        index = int(indexText)
    except ValueError:
        return indexText
    if 0 <= index < len(sharedStrings):
        return sharedStrings[index]
    return indexText


def check_text_presence(extractedText: str, values: list[str]) -> dict:
    return {
        "present": [value for value in values if value in extractedText],
        "missing": [value for value in values if value not in extractedText]
    }


def audit_format(artifactPath: Path | None, diagnosticDirectory: Path, artifactKind: str) -> dict:
    if artifactKind == "docx":
        return audit_docx_format(artifactPath)
    if artifactKind == "xlsx":
        return audit_xlsx_format(artifactPath)
    if artifactKind == "pdf":
        return audit_pdf_format(artifactPath)
    if artifactKind == "website":
        return audit_website_format(diagnosticDirectory)
    if artifactKind == "presentation":
        return audit_presentation_format(artifactPath)
    return {}


def audit_presentation_format(artifactPath: Path | None) -> dict:
    if artifactPath and artifactPath.suffix.lower() == ".pdf":
        return audit_pdf_format(artifactPath)
    return audit_pptx_format(artifactPath)


def audit_pptx_format(artifactPath: Path | None) -> dict:
    if not artifactPath or not artifactPath.exists():
        return {"isZip": False, "hasPresentationXML": False, "slideCount": 0}
    try:
        with zipfile.ZipFile(artifactPath) as archive:
            names = set(archive.namelist())
            slidePaths = [name for name in names if re.match(r"^ppt/slides/slide\d+\.xml$", name)]
    except (OSError, zipfile.BadZipFile):
        return {"isZip": False, "hasPresentationXML": False, "slideCount": 0}
    return {
        "isZip": True,
        "hasPresentationXML": "ppt/presentation.xml" in names,
        "slideCount": len(slidePaths),
    }


def audit_render(resultDirectory: Path, diagnosticDirectory: Path, artifactPath: Path | None, artifactKind: str, exitCode) -> dict:
    if artifactKind == "website":
        return audit_website_render(resultDirectory, diagnosticDirectory, exitCode)
    if artifactKind not in {"docx", "pdf", "xlsx", "presentation"}:
        return {"attempted": False, "reason": "artifact kind is not renderable by local file thumbnail audit"}
    if not artifactPath or not artifactPath.exists():
        return {"attempted": False, "reason": "artifact file is missing"}

    if artifactKind == "pdf" or (artifactKind == "presentation" and artifactPath.suffix.lower() == ".pdf"):
        pdfRender = render_pdf_with_pdftoppm(resultDirectory, artifactPath)
        if pdfRender.get("passed"):
            return pdfRender

    qlmanagePath = shutil.which("qlmanage")
    if not qlmanagePath:
        return fallback_render(resultDirectory, artifactPath, artifactKind, "qlmanage was not found")

    renderDirectory = screenshots_directory(resultDirectory)
    renderDirectory.mkdir(exist_ok=True)
    temporaryRenderDirectory = renderDirectory / ".render-tmp"
    clear_directory(temporaryRenderDirectory)
    temporaryRenderDirectory.mkdir(exist_ok=True)
    completedProcess = subprocess.run(
        [qlmanagePath, "-t", "-s", "1600", "-o", str(temporaryRenderDirectory), str(artifactPath)],
        cwd=REPOSITORY_ROOT,
        text=True,
        capture_output=True,
    )
    temporaryImagePaths = normalize_render_screenshots(temporaryRenderDirectory)
    hasNewImages = completedProcess.returncode == 0 and any(path.stat().st_size > 0 for path in temporaryImagePaths)
    if hasNewImages:
        clear_render_directory(renderDirectory)
        imagePaths = move_render_screenshots(temporaryImagePaths, renderDirectory)
    else:
        imagePaths = sorted(path for path in renderDirectory.glob("*.png") if path.is_file())
    images = [inspect_render_image(path) for path in imagePaths]
    clear_directory(temporaryRenderDirectory)
    usedExistingScreenshots = not hasNewImages and bool(images)
    if not hasNewImages and not images:
        return fallback_render(resultDirectory, artifactPath, artifactKind, qlmanage_failure_reason(completedProcess))
    return {
        "attempted": True,
        "renderer": "qlmanage",
        "exitCode": completedProcess.returncode,
        "passed": hasNewImages or any(image["fileBytes"] > 0 for image in images),
        "usedExistingScreenshots": usedExistingScreenshots,
        "screenshots": images,
    }


def render_pdf_with_pdftoppm(resultDirectory: Path, artifactPath: Path) -> dict:
    pdftoppmPath = shutil.which("pdftoppm")
    if not pdftoppmPath:
        return {"attempted": True, "renderer": "pdftoppm", "passed": False, "reason": "pdftoppm was not found", "screenshots": []}
    renderDirectory = screenshots_directory(resultDirectory)
    renderDirectory.mkdir(exist_ok=True)
    temporaryRenderDirectory = renderDirectory / ".pdf-render-tmp"
    clear_directory(temporaryRenderDirectory)
    temporaryRenderDirectory.mkdir(exist_ok=True)
    outputPrefix = temporaryRenderDirectory / "page"
    completedProcess = subprocess.run(
        [pdftoppmPath, "-png", "-r", "144", "-f", "1", "-singlefile", str(artifactPath), str(outputPrefix)],
        cwd=REPOSITORY_ROOT,
        text=True,
        capture_output=True,
    )
    imagePaths = sorted(path for path in temporaryRenderDirectory.glob("*.png") if path.is_file())
    hasNewImages = completedProcess.returncode == 0 and any(path.stat().st_size > 0 for path in imagePaths)
    if not hasNewImages:
        clear_directory(temporaryRenderDirectory)
        return {
            "attempted": True,
            "renderer": "pdftoppm",
            "exitCode": completedProcess.returncode,
            "passed": False,
            "reason": first_non_empty_string(completedProcess.stderr.strip(), completedProcess.stdout.strip(), "pdftoppm did not produce screenshots"),
            "screenshots": [],
        }
    clear_render_directory(renderDirectory)
    movedPaths = move_render_screenshots(imagePaths, renderDirectory)
    images = [inspect_render_image(path) for path in movedPaths]
    clear_directory(temporaryRenderDirectory)
    return {
        "attempted": True,
        "renderer": "pdftoppm",
        "exitCode": completedProcess.returncode,
        "passed": True,
        "screenshots": images,
    }


def fallback_render(resultDirectory: Path, artifactPath: Path, artifactKind: str, reason: str) -> dict:
    renderDirectory = screenshots_directory(resultDirectory)
    renderDirectory.mkdir(exist_ok=True)
    clear_render_directory(renderDirectory)
    imagePath = renderDirectory / "render-001.png"
    isRendered = render_preview_image(artifactPath, artifactKind, imagePath)
    images = [inspect_render_image(imagePath)] if isRendered else []
    return {
        "attempted": True,
        "renderer": "python-pillow-preview",
        "passed": isRendered,
        "reason": reason,
        "screenshots": images,
    }


def qlmanage_failure_reason(completedProcess: subprocess.CompletedProcess) -> str:
    return first_non_empty_string(
        completedProcess.stderr.strip(),
        completedProcess.stdout.strip(),
        f"qlmanage exited with {completedProcess.returncode}",
    )


def render_preview_image(artifactPath: Path, artifactKind: str, imagePath: Path) -> bool:
    try:
        from PIL import Image, ImageDraw
    except ImportError:
        return False
    lines = preview_lines_for_artifact(artifactPath, artifactKind)
    if not lines:
        return False
    width = 1240
    height = 1600
    margin = 72
    image = Image.new("RGB", (width, height), "white")
    draw = ImageDraw.Draw(image)
    titleFont = preview_font(34)
    bodyFont = preview_font(24)
    smallFont = preview_font(18)
    draw.rectangle((0, 0, width, 18), fill=(28, 57, 89))
    y = margin
    title = artifactPath.name
    draw.text((margin, y), title, fill=(24, 33, 45), font=titleFont)
    y += 58
    draw.line((margin, y, width - margin, y), fill=(210, 218, 226), width=2)
    y += 34
    for line in wrapped_preview_lines(draw, lines, bodyFont, width - margin * 2):
        if y > height - margin - 32:
            draw.text((margin, height - margin), "…", fill=(96, 106, 116), font=smallFont)
            break
        draw.text((margin, y), line, fill=(35, 43, 52), font=bodyFont)
        y += 35
    image.save(imagePath)
    return imagePath.exists() and imagePath.stat().st_size > 0


def preview_lines_for_artifact(artifactPath: Path, artifactKind: str) -> list[str]:
    if artifactKind == "xlsx":
        return xlsx_preview_lines(artifactPath)
    text = extract_artifact_text(artifactPath, artifactKind)
    return [line.strip() for line in text.splitlines() if line.strip()][:70]


def wrapped_preview_lines(draw, lines: list[str], font, maxWidth: int) -> list[str]:
    wrappedLines = []
    for line in lines:
        words = line.split()
        if not words:
            wrappedLines.append("")
            continue
        currentLine = ""
        for word in words:
            candidate = word if not currentLine else currentLine + " " + word
            if draw.textlength(candidate, font=font) <= maxWidth:
                currentLine = candidate
                continue
            if currentLine:
                wrappedLines.append(currentLine)
            currentLine = word
        if currentLine:
            wrappedLines.append(currentLine)
    return wrappedLines


def preview_font(size: int):
    from PIL import ImageFont
    for path in preview_font_paths():
        if Path(path).exists():
            try:
                return ImageFont.truetype(path, size)
            except OSError:
                continue
    return ImageFont.load_default()


def preview_font_paths() -> list[str]:
    return [
        "/System/Library/Fonts/AppleSDGothicNeo.ttc",
        "/System/Library/Fonts/Supplemental/Arial Unicode.ttf",
        "/System/Library/Fonts/Supplemental/Arial.ttf",
        "/Library/Fonts/Arial Unicode.ttf",
    ]


def xlsx_preview_lines(artifactPath: Path) -> list[str]:
    try:
        with zipfile.ZipFile(artifactPath) as archive:
            sharedStrings = read_xlsx_shared_strings(archive)
            sheetNames = read_xlsx_workbook_text(archive)
            worksheetPaths = sorted(path for path in archive.namelist() if path.startswith("xl/worksheets/") and path.endswith(".xml"))
            lines = []
            for index, worksheetPath in enumerate(worksheetPaths[:3]):
                sheetName = sheetNames[index] if index < len(sheetNames) else Path(worksheetPath).stem
                lines.append(f"[{sheetName}]")
                root = ElementTree.fromstring(archive.read(worksheetPath))
                rows = xlsx_preview_rows(root, sharedStrings)
                lines.extend(rows[:12])
                lines.append("")
            return lines
    except (KeyError, OSError, zipfile.BadZipFile, ElementTree.ParseError):
        return []


def xlsx_preview_rows(root: ElementTree.Element, sharedStrings: list[str]) -> list[str]:
    namespace = {"main": "http://schemas.openxmlformats.org/spreadsheetml/2006/main"}
    rows = []
    for row in root.findall(".//main:row", namespace):
        values = []
        for cell in row.findall("main:c", namespace)[:8]:
            cellValues = read_xlsx_cell_values(cell, sharedStrings, namespace)
            values.append(" ".join(cellValues) if cellValues else "")
        if any(value.strip() for value in values):
            rows.append(" | ".join(values))
    return rows


def audit_website_render(resultDirectory: Path, diagnosticDirectory: Path, exitCode) -> dict:
    commandPath = diagnosticDirectory / "command.json"
    command = read_json(commandPath).get("command", []) if commandPath.exists() else []
    testResult = read_test_result(diagnosticDirectory)
    screenshots = restore_site_screenshots(resultDirectory, testResult)
    hasExpectedPublicURL = "--expect-public-url" in command
    isPassed = exitCode == 0 and hasExpectedPublicURL
    if testResult:
        isPassed = isPassed and bool(testResult.get("siteScreenshotsVerified"))
    return {
        "attempted": hasExpectedPublicURL,
        "renderer": "remote chromium via Mattermost public URL verification",
        "passed": isPassed,
        "expectedTools": expected_tools_from_command(command),
        "publicURL": str(testResult.get("sitePublicURL", "")).strip() if testResult else "",
        "screenshots": screenshots,
    }


def restore_site_screenshots(resultDirectory: Path, testResult: dict) -> list[dict]:
    if not testResult:
        return []
    screenshots = testResult.get("siteScreenshots", [])
    if not isinstance(screenshots, list):
        return []
    if not screenshots:
        renderDirectory = screenshots_directory(resultDirectory)
        if not renderDirectory.exists():
            return []
        return [inspect_render_image(path) for path in sorted(renderDirectory.glob("*.png")) if path.is_file()]
    renderDirectory = screenshots_directory(resultDirectory)
    renderDirectory.mkdir(exist_ok=True)
    clear_render_directory(renderDirectory)
    restoredScreenshots = []
    for index, screenshot in enumerate(screenshots, start=1):
        if not isinstance(screenshot, dict):
            continue
        contentBase64 = str(screenshot.get("contentBase64", ""))
        if not contentBase64:
            continue
        filename = "site-desktop.png" if index == 1 else "site-mobile.png"
        path = renderDirectory / filename
        try:
            path.write_bytes(base64.b64decode(contentBase64))
        except (ValueError, OSError):
            continue
        restoredScreenshots.append(inspect_render_image(path))
    return restoredScreenshots


def expected_tools_from_command(command: list[str]) -> list[str]:
    expectedTools = []
    for index, argument in enumerate(command):
        if argument == "--expect-tool" and index + 1 < len(command):
            expectedTools.append(command[index + 1])
    return expectedTools


def clear_render_directory(renderDirectory: Path) -> None:
    for path in renderDirectory.iterdir():
        if path.is_file():
            path.unlink()


def clear_directory(directory: Path) -> None:
    if directory.exists():
        shutil.rmtree(directory)


def move_render_screenshots(imagePaths: list[Path], renderDirectory: Path) -> list[Path]:
    movedPaths = []
    for index, imagePath in enumerate(imagePaths, start=1):
        destinationPath = renderDirectory / f"render-{index:03d}.png"
        imagePath.replace(destinationPath)
        movedPaths.append(destinationPath)
    return movedPaths


def normalize_render_screenshots(renderDirectory: Path) -> list[Path]:
    imagePaths = sorted(path for path in renderDirectory.glob("*.png") if path.is_file())
    normalizedPaths = []
    for index, imagePath in enumerate(imagePaths, start=1):
        normalizedPath = renderDirectory / f"render-{index:03d}.png"
        if imagePath != normalizedPath:
            imagePath.replace(normalizedPath)
        normalizedPaths.append(normalizedPath)
    return normalizedPaths


def inspect_render_image(path: Path) -> dict:
    image = {
        "path": relative_path(path),
        "fileBytes": path.stat().st_size,
    }
    dimensions = render_image_dimensions(path)
    if dimensions:
        image["dimensions"] = dimensions
    visualMetrics = render_image_visual_metrics(path)
    if visualMetrics:
        image["visualMetrics"] = visualMetrics
    return image


def render_image_visual_metrics(path: Path) -> dict:
    try:
        from PIL import Image
    except ImportError:
        return {}
    try:
        image = Image.open(path).convert("RGBA")
    except OSError:
        return {}
    width, height = image.size
    if width <= 0 or height <= 0:
        return {}
    step = max(1, int(max(width, height) / 600))
    pixels = image.load()
    contentPixels = []
    sampledCount = 0
    for y in range(0, height, step):
        for x in range(0, width, step):
            red, green, blue, alpha = pixels[x, y]
            if alpha < 20:
                continue
            sampledCount += 1
            if min(red, green, blue) < 245 or max(red, green, blue) - min(red, green, blue) > 12:
                contentPixels.append((x, y))
    if sampledCount == 0 or not contentPixels:
        return {
            "contentDensity": 0,
            "visualBalanceScore": 0,
            "reason": "no visible non-background content detected",
        }
    xValues = [point[0] for point in contentPixels]
    yValues = [point[1] for point in contentPixels]
    contentDensity = len(contentPixels) / sampledCount
    bounds = {
        "left": min(xValues),
        "right": max(xValues),
        "top": min(yValues),
        "bottom": max(yValues),
    }
    centerOffsetX = abs(((bounds["left"] + bounds["right"]) / 2) - (width / 2)) / width
    centerOffsetY = abs(((bounds["top"] + bounds["bottom"]) / 2) - (height / 2)) / height
    marginRatios = {
        "left": bounds["left"] / width,
        "right": (width - bounds["right"]) / width,
        "top": bounds["top"] / height,
        "bottom": (height - bounds["bottom"]) / height,
    }
    visualBalanceScore = score_visual_balance(contentDensity, centerOffsetX, centerOffsetY, marginRatios)
    return {
        "contentDensity": round(contentDensity, 4),
        "centerOffsetX": round(centerOffsetX, 4),
        "centerOffsetY": round(centerOffsetY, 4),
        "marginRatios": {key: round(value, 4) for key, value in marginRatios.items()},
        "visualBalanceScore": round(visualBalanceScore, 3),
    }


def score_visual_balance(contentDensity: float, centerOffsetX: float, centerOffsetY: float, marginRatios: dict[str, float]) -> float:
    densityPenalty = 0.0
    if contentDensity < 0.015:
        densityPenalty = 0.35
    elif contentDensity > 0.75:
        densityPenalty = 0.25
    edgePenalty = min(0.35, sum(0.08 for value in marginRatios.values() if value < 0.015))
    offsetPenalty = min(0.35, centerOffsetX * 1.4 + centerOffsetY * 0.7)
    return max(0.0, 1.0 - densityPenalty - edgePenalty - offsetPenalty)


def render_image_dimensions(path: Path) -> dict:
    sipsPath = shutil.which("sips")
    if not sipsPath:
        return {}
    completedProcess = subprocess.run(
        [sipsPath, "-g", "pixelWidth", "-g", "pixelHeight", str(path)],
        text=True,
        capture_output=True,
    )
    if completedProcess.returncode != 0:
        return {"inspectExitCode": completedProcess.returncode}
    dimensions = {}
    for line in completedProcess.stdout.splitlines():
        key, _, value = line.strip().partition(":")
        if key in {"pixelWidth", "pixelHeight"}:
            dimensions[key] = int(value.strip())
    return dimensions


def audit_docx_format(artifactPath) -> dict:
    if not artifactPath or not artifactPath.exists():
        return {"isZip": False, "hasDocumentXML": False, "paragraphCount": 0, "tableCount": 0}
    try:
        with zipfile.ZipFile(artifactPath) as archive:
            names = set(archive.namelist())
            document = ElementTree.fromstring(archive.read("word/document.xml"))
            typography = audit_docx_typography(document, names, archive)
    except (KeyError, OSError, zipfile.BadZipFile, ElementTree.ParseError):
        return {"isZip": False, "hasDocumentXML": False, "paragraphCount": 0, "tableCount": 0}
    namespace = {"w": "http://schemas.openxmlformats.org/wordprocessingml/2006/main"}
    paragraphs = document.findall(".//w:p", namespace)
    tables = document.findall(".//w:tbl", namespace)
    tableSummaries = [summarize_docx_table(table, namespace) for table in tables]
    return {
        "isZip": True,
        "hasDocumentXML": "word/document.xml" in names,
        "hasStylesXML": "word/styles.xml" in names,
        "paragraphCount": len([paragraph for paragraph in paragraphs if docx_paragraph_text(paragraph, namespace).strip()]),
        "headingCount": count_docx_headings(paragraphs, namespace),
        "pageBreakCount": len(document.findall(".//w:br[@w:type='page']", namespace)),
        "tableCount": len(tables),
        "wideTableCount": len([table for table in tableSummaries if table["columns"] > 5]),
        "emptyTableCellCount": sum(table["emptyCellCount"] for table in tableSummaries),
        "denseTableCellCount": sum(table["denseCellCount"] for table in tableSummaries),
        "typography": typography,
    }


def summarize_docx_table(table: ElementTree.Element, namespace: dict[str, str]) -> dict:
    rows = table.findall(".//w:tr", namespace)
    columnCounts = []
    emptyCellCount = 0
    denseCellCount = 0
    for row in rows:
        cells = row.findall("w:tc", namespace)
        columnCounts.append(len(cells))
        for cell in cells:
            text = "".join(node.text or "" for node in cell.findall(".//w:t", namespace)).strip()
            if not text:
                emptyCellCount += 1
            if len(text) > 90:
                denseCellCount += 1
    return {
        "rows": len(rows),
        "columns": max(columnCounts) if columnCounts else 0,
        "emptyCellCount": emptyCellCount,
        "denseCellCount": denseCellCount,
    }


def docx_paragraph_text(paragraph: ElementTree.Element, namespace: dict[str, str]) -> str:
    return "".join(node.text or "" for node in paragraph.findall(".//w:t", namespace))


def count_docx_headings(paragraphs: list[ElementTree.Element], namespace: dict[str, str]) -> int:
    count = 0
    styleAttribute = "{http://schemas.openxmlformats.org/wordprocessingml/2006/main}val"
    for paragraph in paragraphs:
        style = paragraph.find(".//w:pStyle", namespace)
        styleValue = style.get(styleAttribute, "") if style is not None else ""
        if styleValue.startswith("Heading") or styleValue == "Title":
            count += 1
    return count


def audit_docx_typography(document: ElementTree.Element, names: set[str], archive: zipfile.ZipFile) -> dict:
    namespace = {"w": "http://schemas.openxmlformats.org/wordprocessingml/2006/main"}
    styles = read_docx_styles(archive, names)
    fontSizes = collect_docx_font_sizes(document, namespace) + collect_docx_font_sizes(styles, namespace)
    margins = read_docx_page_margins(document, namespace)
    lineSpacingValues = collect_docx_line_spacing(document, namespace) + collect_docx_line_spacing(styles, namespace)
    hasEastAsiaFont = docx_has_east_asia_font(document, namespace) or docx_has_east_asia_font(styles, namespace)
    typographyScore = score_docx_typography(fontSizes, margins, lineSpacingValues, hasEastAsiaFont)
    return {
        "fontSizePoints": summarize_numeric_values(fontSizes),
        "pageMarginsInches": margins,
        "lineSpacingValues": summarize_numeric_values(lineSpacingValues),
        "hasEastAsiaFont": hasEastAsiaFont,
        "typographyScore": round(typographyScore, 3),
    }


def read_docx_styles(archive: zipfile.ZipFile, names: set[str]) -> ElementTree.Element | None:
    if "word/styles.xml" not in names:
        return None
    try:
        return ElementTree.fromstring(archive.read("word/styles.xml"))
    except (KeyError, ElementTree.ParseError):
        return None


def collect_docx_font_sizes(root: ElementTree.Element | None, namespace: dict[str, str]) -> list[float]:
    if root is None:
        return []
    values = []
    valueAttribute = "{http://schemas.openxmlformats.org/wordprocessingml/2006/main}val"
    for sizeElement in root.findall(".//w:sz", namespace):
        rawValue = sizeElement.get(valueAttribute)
        if rawValue and rawValue.isdigit():
            values.append(int(rawValue) / 2)
    return values


def collect_docx_line_spacing(root: ElementTree.Element | None, namespace: dict[str, str]) -> list[float]:
    if root is None:
        return []
    values = []
    lineAttribute = "{http://schemas.openxmlformats.org/wordprocessingml/2006/main}line"
    for spacingElement in root.findall(".//w:spacing", namespace):
        rawValue = spacingElement.get(lineAttribute)
        if rawValue and rawValue.isdigit():
            values.append(int(rawValue) / 240)
    return values


def read_docx_page_margins(document: ElementTree.Element, namespace: dict[str, str]) -> dict:
    marginElement = document.find(".//w:sectPr/w:pgMar", namespace)
    if marginElement is None:
        return {}
    attributes = {
        "top": "{http://schemas.openxmlformats.org/wordprocessingml/2006/main}top",
        "right": "{http://schemas.openxmlformats.org/wordprocessingml/2006/main}right",
        "bottom": "{http://schemas.openxmlformats.org/wordprocessingml/2006/main}bottom",
        "left": "{http://schemas.openxmlformats.org/wordprocessingml/2006/main}left",
    }
    margins = {}
    for name, attribute in attributes.items():
        value = marginElement.get(attribute)
        if value and re.match(r"^-?[0-9]+$", value):
            margins[name] = round(int(value) / 1440, 3)
    return margins


def docx_has_east_asia_font(root: ElementTree.Element | None, namespace: dict[str, str]) -> bool:
    if root is None:
        return False
    eastAsiaAttribute = "{http://schemas.openxmlformats.org/wordprocessingml/2006/main}eastAsia"
    return any(bool(element.get(eastAsiaAttribute)) for element in root.findall(".//w:rFonts", namespace))


def score_docx_typography(fontSizes: list[float], margins: dict, lineSpacingValues: list[float], hasEastAsiaFont: bool) -> float:
    checks = []
    if fontSizes:
        medianFontSize = statistics.median(fontSizes)
        checks.append(1.0 if 9 <= medianFontSize <= 12.5 else 0.45)
        checks.append(1.0 if max(fontSizes) <= 24 else 0.65)
    else:
        checks.append(0.45)
    if margins:
        checks.append(average([1.0 if 0.45 <= margin <= 1.2 else 0.45 for margin in margins.values()]))
    else:
        checks.append(0.5)
    if lineSpacingValues:
        checks.append(average([1.0 if 1.0 <= value <= 1.35 else 0.55 for value in lineSpacingValues]))
    else:
        checks.append(0.7)
    checks.append(1.0 if hasEastAsiaFont else 0.55)
    return average(checks)


def audit_pdf_format(artifactPath) -> dict:
    if not artifactPath or not artifactPath.exists():
        return {"isPDF": False, "pageCount": 0, "hasTextLayer": False}
    text = extract_pdf_text(artifactPath)
    fonts = pdf_fonts(artifactPath)
    return {
        "isPDF": artifactPath.read_bytes()[:4] == b"%PDF",
        "pageCount": pdf_page_count(artifactPath),
        "hasTextLayer": bool(text.strip()),
        "extractedTextLength": len(text),
        "fontCount": len(fonts),
        "fonts": fonts[:20],
        "typography": audit_pdf_typography(artifactPath),
    }


def pdf_page_count(artifactPath: Path) -> int:
    pdfinfoPath = shutil.which("pdfinfo")
    if not pdfinfoPath:
        return 0
    completedProcess = subprocess.run(
        [pdfinfoPath, str(artifactPath)],
        cwd=REPOSITORY_ROOT,
        text=True,
        capture_output=True,
    )
    if completedProcess.returncode != 0:
        return 0
    for line in completedProcess.stdout.splitlines():
        key, _, value = line.partition(":")
        if key.strip() == "Pages":
            try:
                return int(value.strip())
            except ValueError:
                return 0
    return 0


def pdf_fonts(artifactPath: Path) -> list[str]:
    pdffontsPath = shutil.which("pdffonts")
    if not pdffontsPath:
        return []
    completedProcess = subprocess.run(
        [pdffontsPath, str(artifactPath)],
        cwd=REPOSITORY_ROOT,
        text=True,
        capture_output=True,
    )
    if completedProcess.returncode != 0:
        return []
    fonts = []
    for line in completedProcess.stdout.splitlines()[2:]:
        name = line[:38].strip()
        if name:
            fonts.append(name)
    return fonts


def audit_pdf_typography(artifactPath: Path) -> dict:
    pages = pdf_bbox_pages(artifactPath)
    wordHeights = [word["height"] for page in pages for word in page["words"]]
    margins = [page_margin_ratios(page) for page in pages if page["words"]]
    typographyScore = score_pdf_typography(wordHeights, margins)
    return {
        "wordHeightPoints": summarize_numeric_values(wordHeights),
        "pageMarginRatios": summarize_margin_ratios(margins),
        "typographyScore": round(typographyScore, 3),
    }


def pdf_bbox_pages(artifactPath: Path) -> list[dict]:
    pdftotextPath = shutil.which("pdftotext")
    if not pdftotextPath:
        return []
    completedProcess = subprocess.run(
        [pdftotextPath, "-bbox", str(artifactPath), "-"],
        cwd=REPOSITORY_ROOT,
        text=True,
        capture_output=True,
    )
    if completedProcess.returncode != 0:
        return []
    try:
        root = ElementTree.fromstring(completedProcess.stdout)
    except ElementTree.ParseError:
        return []
    namespace = {"html": "http://www.w3.org/1999/xhtml"}
    pages = []
    for page in root.findall(".//html:page", namespace):
        width = float(page.get("width", "0") or 0)
        height = float(page.get("height", "0") or 0)
        words = []
        for word in page.findall(".//html:word", namespace):
            box = pdf_word_box(word)
            if box:
                words.append(box)
        pages.append({"width": width, "height": height, "words": words})
    return pages


def pdf_word_box(word: ElementTree.Element) -> dict | None:
    try:
        xMin = float(word.get("xMin", ""))
        yMin = float(word.get("yMin", ""))
        xMax = float(word.get("xMax", ""))
        yMax = float(word.get("yMax", ""))
    except ValueError:
        return None
    return {
        "xMin": xMin,
        "xMax": xMax,
        "yMin": yMin,
        "yMax": yMax,
        "height": max(0.0, yMax - yMin),
    }


def page_margin_ratios(page: dict) -> dict:
    width = page.get("width", 0) or 1
    height = page.get("height", 0) or 1
    words = page.get("words", [])
    left = min(word["xMin"] for word in words) / width
    right = (width - max(word["xMax"] for word in words)) / width
    top = min(word["yMin"] for word in words) / height
    bottom = (height - max(word["yMax"] for word in words)) / height
    return {"left": left, "right": right, "top": top, "bottom": bottom}


def summarize_margin_ratios(margins: list[dict]) -> dict:
    if not margins:
        return {}
    return {
        edge: round(statistics.median([margin[edge] for margin in margins]), 4)
        for edge in ["left", "right", "top", "bottom"]
    }


def score_pdf_typography(wordHeights: list[float], margins: list[dict]) -> float:
    checks = []
    if wordHeights:
        medianHeight = statistics.median(wordHeights)
        checks.append(1.0 if 6.5 <= medianHeight <= 14 else 0.45)
        checks.append(1.0 if max(wordHeights) <= 28 else 0.7)
    else:
        checks.append(0.0)
    if margins:
        edgeScores = []
        for margin in margins:
            edgeScores.extend(1.0 if 0.04 <= value <= 0.22 else 0.5 for value in margin.values())
        checks.append(average(edgeScores))
    else:
        checks.append(0.5)
    return average(checks)


def audit_website_format(diagnosticDirectory: Path) -> dict:
    testResult = read_test_result(diagnosticDirectory)
    if not testResult:
        return {"hasPublicURL": False, "renderedTextLength": 0, "siteScreenshotsVerified": False, "typography": {}}
    siteHTMLText = str(testResult.get("siteHTMLText", ""))
