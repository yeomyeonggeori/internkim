#!/usr/bin/env python3
"""Render the relay's and the plane's settings, as `tools/environment.json`
declares them, into the documents that list them by hand: the launchagent
template's environment block and a settings table in host/README.md. Each generated region sits between a
`BEGIN GENERATED` / `END GENERATED` marker; everything outside a marker pair
is the file's own hand-maintained content and is left untouched.

Run with --check to fail when a file's generated region does not match what
regeneration would produce, instead of writing it. tools/verify runs --check;
run this script with no arguments after editing tools/environment.json
to bring the documents back in line.
"""

import json
import pathlib
import re
import sys

REPOSITORY_ROOT = pathlib.Path(__file__).resolve().parent.parent
DECLARATIONS_PATH = REPOSITORY_ROOT / "tools" / "environment.json"

LAUNCHAGENT_PATH = REPOSITORY_ROOT / "host" / "relay" / "launchagent.plist.template"
README_PATH = REPOSITORY_ROOT / "host" / "README.md"


def comment(comment_start, comment_end, body):
    return f"{comment_start} {body} {comment_end}".rstrip() if comment_end else f"{comment_start} {body}"


def markers(comment_start, comment_end):
    start = comment(
        comment_start,
        comment_end,
        "BEGIN GENERATED from tools/environment.json — edit that file, then run tools/render-environment-documents",
    )
    end = comment(comment_start, comment_end, "END GENERATED")
    return start, end


# The company agent key as a value is for a shell driven by hand, never a
# deployment, so the launchagent template carries only its path.
LAUNCHAGENT_EXCLUDED = {"AGENT_API_KEY"}


def load_declarations():
    return json.loads(DECLARATIONS_PATH.read_text(encoding="utf-8"))


def process_tokens(process_field):
    return {token.strip() for token in process_field.split(",")}


def names_for(declarations, *wanted_processes):
    wanted = set(wanted_processes)
    return sorted(
        name
        for name, meta in declarations.items()
        if process_tokens(meta["process"]) & wanted
    )


def replace_marked_region(text, comment_start, comment_end, new_body, end_indent=""):
    start_marker, end_marker = markers(comment_start, comment_end)
    pattern = re.compile(re.escape(start_marker) + r".*?" + re.escape(end_marker), re.DOTALL)
    if not pattern.search(text):
        raise SystemExit(f"no {start_marker!r} … {end_marker!r} region found")
    replacement = f"{start_marker}\n{new_body}{end_indent}{end_marker}"
    return pattern.sub(replacement, text, count=1)


def render_launchagent(declarations):
    names = [name for name in names_for(declarations, "relay") if name not in LAUNCHAGENT_EXCLUDED]
    lines = []
    for name in names:
        lines.append(f"        <key>{name}</key>")
        lines.append(f"        <string>{name}_VALUE</string>")
    body = "\n".join(lines) + "\n"
    text = LAUNCHAGENT_PATH.read_text(encoding="utf-8")
    return replace_marked_region(text, "<!--", "-->", body, end_indent="        ")


def render_readme_table(declarations):
    names = names_for(declarations, "relay", "host")
    lines = ["| Name | Used by | What it is |", "| --- | --- | --- |"]
    for name in names:
        meta = declarations[name]
        tokens = process_tokens(meta["process"])
        used_by = " + ".join(label for label in ("relay", "host") if label in tokens)
        description = meta["description"].replace("|", "\\|")
        lines.append(f"| `{name}` | {used_by} | {description} |")
    body = "\n".join(lines) + "\n\n"
    text = README_PATH.read_text(encoding="utf-8")
    return replace_marked_region(text, "<!--", "-->", body)


TARGETS = [
    ("host/relay/launchagent.plist.template", LAUNCHAGENT_PATH, render_launchagent),
    ("host/README.md", README_PATH, render_readme_table),
]


def main():
    check_only = "--check" in sys.argv[1:]
    declarations = load_declarations()
    drifted = []
    for label, path, render in TARGETS:
        rendered = render(declarations)
        current = path.read_text(encoding="utf-8")
        if rendered == current:
            print(f"ok   {label}")
            continue
        if check_only:
            drifted.append(label)
            print(f"FAIL {label}: out of date with {DECLARATIONS_PATH.relative_to(REPOSITORY_ROOT)}", file=sys.stderr)
        else:
            path.write_text(rendered, encoding="utf-8")
            print(f"wrote {label}")
    if drifted:
        print(
            "\nRun tools/render-environment-documents (no arguments) to regenerate.",
            file=sys.stderr,
        )
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
