#!/usr/bin/env bash
set -euo pipefail

script_directory="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repository_root="$(cd "$script_directory/.." && pwd)"
artifact_directory="${INTERNKIM_BLUECLAW_RUNTIME_ARTIFACT_DIR:-$repository_root/.dependency/blueclaw-runtime}"
scratch_directory="${INTERNKIM_BLUECLAW_RUNTIME_SCRATCH_DIR:-${TMPDIR:-/tmp}/internkim-blueclaw-runtime}"
cache_directory="${INTERNKIM_BLUECLAW_RUNTIME_CACHE_DIR:-$scratch_directory/cache}"
work_directory="${INTERNKIM_BLUECLAW_RUNTIME_WORK_DIR:-$scratch_directory/work}"
stage_directory="$work_directory/stage"
rootfs_directory="$work_directory/rootfs"
rootfs_image_path="$stage_directory/rootfs.ext4"
cloud_hypervisor_version="${CLOUD_HYPERVISOR_VERSION:-53.0}"
virtiofsd_version="${VIRTIOFSD_VERSION:-1.10.0-1ubuntu0.1}"
linux_kernel_version="${BLUECLAW_LINUX_KERNEL_VERSION:-6.1.129}"
guest_kernel_configuration_path="$repository_root/assets/blueclaw-runtime/guest-kernel-aarch64.config"
rootfs_size="${BLUECLAW_RUNTIME_ROOTFS_SIZE:-4G}"
blueclaw_bun_version="${BLUECLAW_BUN_VERSION:-1.3.10}"
blueclaw_uv_version="${BLUECLAW_UV_VERSION:-0.11.11}"
kernel_source="${BLUECLAW_KERNEL_IMAGE_SOURCE:-}"
rootfs_source="${BLUECLAW_ROOTFS_IMAGE_SOURCE:-}"
builder="local"
ssh_host=""
ssh_user="${USER:-admin}"
ssh_password=""
remote_directory="/tmp/internkim-blueclaw-runtime-builder"
stop_container_after_build=0
maximum_transfer_bytes="${INTERNKIM_RUNTIME_BUILDER_MAX_TRANSFER_BYTES:-5000000000}"
transfer_probe_seconds="${INTERNKIM_RUNTIME_BUILDER_PROBE_SECONDS:-120}"
rsync_excludes=(
  --exclude '.git'
  --exclude '.dependency/agent-browser'
  --exclude '.dependency/blueclaw-payload'
  --exclude '.dependency/blueclaw-runtime*'
  --exclude '.dependency/device-browser'
  --exclude '.dependency/litert-lm-main'
  --exclude '.dependency/litert-models'
  --exclude '.dependency/llama-cpp'
  --exclude '.dependency/llama-cpp-models'
  --exclude '.dependency/role-memory-arm64'
  --exclude 'build'
  --exclude 'dist'
  --exclude 'node_modules'
  --exclude 'web/.svelte-kit'
  --exclude 'web/.wrangler'
  --exclude 'web/.artifacts'
  --exclude 'web/node_modules'
  --exclude 'web/playwright-report'
  --exclude 'web/test-results'
)

append_ignored_top_level_excludes() {
  local entry entry_name
  for entry in "$repository_root"/.[!.]* "$repository_root"/*; do
    [ -e "$entry" ] || continue
    entry_name="$(basename "$entry")"
    [ "$entry_name" = ".git" ] && continue
    if git -C "$repository_root" check-ignore -q "$entry_name" 2>/dev/null; then
      rsync_excludes+=(--exclude "/$entry_name")
    fi
  done
}

guard_transfer_size() {
  local probe_output probe_status transfer_bytes
  probe_output="$(timeout "$transfer_probe_seconds" rsync -an --stats \
    "${rsync_excludes[@]}" "$repository_root/" "$repository_root/" 2>/dev/null)"
  probe_status=$?
  if [ "$probe_status" -ne 0 ]; then
    echo "runtime builder transfer could not be sized within ${transfer_probe_seconds}s;" >&2
    echo "something under the repository root is far larger than a source tree." >&2
    exit 1
  fi
  transfer_bytes="$(printf '%s' "$probe_output" | awk '/^Total file size:/ { gsub(/[^0-9]/, "", $4); print $4; exit }')"
  [ -n "$transfer_bytes" ] || return 0
  if [ "$transfer_bytes" -gt "$maximum_transfer_bytes" ]; then
    echo "runtime builder would ship $transfer_bytes bytes to the builder, above the ${maximum_transfer_bytes} byte limit." >&2
    echo "largest included top-level entries:" >&2
    report_largest_included_entries >&2
    exit 1
  fi
}

report_largest_included_entries() {
  local entry entry_name
  for entry in "$repository_root"/.[!.]* "$repository_root"/*; do
    [ -d "$entry" ] || continue
    entry_name="$(basename "$entry")"
    [ "$entry_name" = ".git" ] && continue
    git -C "$repository_root" check-ignore -q "$entry_name" 2>/dev/null && continue
    timeout 20 du -sh "$entry" 2>/dev/null || echo "?	$entry"
  done | sort -rh | head -8
}

usage() {
  cat <<'USAGE'
Usage:
  tools/prepare-blueclaw-runtime [--builder local]
  tools/prepare-blueclaw-runtime --builder container
  tools/prepare-blueclaw-runtime --builder ssh --host <linux-arm64> [--user <user>] [--password <password>]

Prepare .dependency/blueclaw-runtime from a Linux arm64 builder.
USAGE
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --builder)
      builder="${2:-}"
      shift 2
      ;;
    --host)
      ssh_host="${2:-}"
      shift 2
      ;;
    --user)
      ssh_user="${2:-}"
      shift 2
      ;;
    --password)
      ssh_password="${2:-}"
      shift 2
      ;;
    --remote-dir)
      remote_directory="${2:-}"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "unknown argument: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

ensure_internkim_binary() {
  local go_cache
  go_cache="${GOCACHE:-/tmp/internkim-go-cache}"

  if [[ -n "${GOMODCACHE:-}" ]]; then
    GOCACHE="$go_cache" GOMODCACHE="$GOMODCACHE" go build -o "$repository_root/internkim" "$repository_root/cmd/internkim"
    return
  fi

  GOCACHE="$go_cache" go build -o "$repository_root/internkim" "$repository_root/cmd/internkim"
}

cleanup_container_builder() {
  if [ "$stop_container_after_build" = "1" ]; then
    echo "stopping container builder VM"
    "$repository_root/internkim" lab vm-down >/dev/null 2>&1 || echo "warning: failed to stop container builder VM" >&2
  fi
}

run_container_builder() {
  ensure_internkim_binary
  local container_status_before
  container_status_before="$("$repository_root/internkim" lab status 2>/dev/null || true)"
  stop_container_after_build=0
  if [ "$container_status_before" != "running" ] && [ "${INTERNKIM_KEEP_CONTAINER_VM:-0}" != "1" ]; then
    stop_container_after_build=1
  fi
  trap cleanup_container_builder EXIT
  "$repository_root/internkim" lab runtime-builder-prepare
  ssh_host="$("$repository_root/internkim" lab vm-ip)"
  ssh_user="admin"
  ssh_password="admin"
  run_ssh_builder
  trap - EXIT
  cleanup_container_builder
}

ssh_base_command() {
  local ssh_options=(-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null)
  if [[ "$ssh_host" == *.example.test ]]; then
    ssh_options+=(-o "ProxyCommand=$repository_root/tools/cloudflared-access-ssh %h")
  fi

  if [ -n "$ssh_password" ]; then
    "$repository_root/bin/sshpass" -p "$ssh_password" ssh "${ssh_options[@]}" "$@"
    return
  fi
  ssh "${ssh_options[@]}" "$@"
}

rsync_ssh_command() {
  local ssh_command
  ssh_command="ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null"
  if [[ "$ssh_host" == *.example.test ]]; then
    ssh_command="$ssh_command -o 'ProxyCommand=$repository_root/tools/cloudflared-access-ssh %h'"
  fi
  if [ -n "$ssh_password" ]; then
    echo "'$repository_root/bin/sshpass' -p '$ssh_password' $ssh_command"
    return
  fi
  echo "$ssh_command"
}

rsync_to_builder() {
  local remote_target="$ssh_user@$ssh_host"
  local rsync_ssh
  append_ignored_top_level_excludes
  guard_transfer_size
  rsync_ssh="$(rsync_ssh_command)"
  rsync -az --delete \
    -e "$rsync_ssh" \
    "${rsync_excludes[@]}" \
    "$repository_root/" "$remote_target:$remote_directory/repo/"
}

rsync_from_builder() {
  local remote_target="$ssh_user@$ssh_host"
  local rsync_ssh
  rsync_ssh="$(rsync_ssh_command)"
  mkdir -p "$artifact_directory"
  rsync -a --whole-file \
    -e "$rsync_ssh" \
    "$remote_target:$remote_directory/repo/.dependency/blueclaw-runtime/" "$artifact_directory/"
}

rsync_kernel_source_to_builder() {
  local local_kernel_source="$1"
  local remote_target="$ssh_user@$ssh_host"
  local rsync_ssh
  rsync_ssh="$(rsync_ssh_command)"
  ssh_base_command "$remote_target" "mkdir -p '$remote_directory/kernel-source'"
  rsync -az \
    -e "$rsync_ssh" \
    "$local_kernel_source" "$remote_target:$remote_directory/kernel-source/vmlinux.bin"
}

guest_kernel_configuration_sha() {
  sha256sum "$guest_kernel_configuration_path" | cut -d' ' -f1
}

published_kernel_matches_configuration() {
  local published_manifest_path="$artifact_directory/manifest.json"
  [ -s "$artifact_directory/vmlinux.bin" ] || return 1
  [ -s "$published_manifest_path" ] || return 1
  python3 - "$published_manifest_path" "$(guest_kernel_configuration_sha)" <<'PY'
import json
import sys

manifest_path, configuration_sha = sys.argv[1:3]
with open(manifest_path, encoding="utf-8") as file:
    manifest = json.load(file)
sys.exit(0 if manifest.get("guestKernelConfigurationSHA256") == configuration_sha else 1)
PY
}

resolve_local_kernel_source() {
  if [ -n "$kernel_source" ]; then
    echo "$kernel_source"
    return
  fi
  if [ -s "$artifact_directory/vmlinux.bin" ] && published_kernel_matches_configuration; then
    echo "$artifact_directory/vmlinux.bin"
  fi
}

shell_quote() {
  printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

run_ssh_builder() {
  if [ -z "$ssh_host" ]; then
    echo "--builder ssh requires --host <linux-arm64>" >&2
    exit 1
  fi
  require_command rsync
  ssh_base_command "$ssh_user@$ssh_host" "mkdir -p '$remote_directory'"
  rsync_to_builder
  local remote_kernel_source="$kernel_source"
  local local_kernel_source
  local_kernel_source="$(resolve_local_kernel_source)"
  if [ -n "$local_kernel_source" ]; then
    if [ ! -s "$local_kernel_source" ]; then
      echo "kernel source does not exist: $local_kernel_source" >&2
      exit 1
    fi
    rsync_kernel_source_to_builder "$local_kernel_source"
    remote_kernel_source="$remote_directory/kernel-source/vmlinux.bin"
  fi
  ssh_base_command "$ssh_user@$ssh_host" "cd '$remote_directory/repo' && BLUECLAW_BUILD_KERNEL=$(shell_quote "${BLUECLAW_BUILD_KERNEL:-0}") BLUECLAW_KERNEL_IMAGE_SOURCE=$(shell_quote "$remote_kernel_source") BLUECLAW_RUNTIME_ROOTFS_SIZE=$(shell_quote "$rootfs_size") tools/prepare-blueclaw-runtime --builder local"
  rsync_from_builder
}

require_command() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "$1 is required to prepare the Blueclaw runtime" >&2
    exit 1
  fi
}

run_root() {
  if [ "$(id -u)" = "0" ]; then
    "$@"
    return
  fi
  sudo "$@"
}

case "$builder" in
  container)
    run_container_builder
    exit 0
    ;;
  tart)
    echo "the tart builder was removed; use --builder container" >&2
    exit 1
    ;;
  ssh)
    run_ssh_builder
    exit 0
    ;;
  local)
    ;;
  *)
    echo "unsupported builder: $builder" >&2
    usage >&2
    exit 1
    ;;
esac

builds_a_guest_image=1
if [ -n "$kernel_source" ] && [ -n "$rootfs_source" ]; then
  builds_a_guest_image=0
fi

if [ "$builds_a_guest_image" = "1" ] && [ "$(uname -s)" != "Linux" ]; then
  echo "Blueclaw runtime artifact build requires a prepared Linux arm64 builder." >&2
  echo "Run: make prepare-blueclaw-runtime-builder && tools/prepare-blueclaw-runtime --builder container" >&2
  echo "Or: tools/prepare-blueclaw-runtime --builder ssh --host <linux-arm64>" >&2
  echo "Given both BLUECLAW_KERNEL_IMAGE_SOURCE and BLUECLAW_ROOTFS_IMAGE_SOURCE this only repackages, and runs anywhere." >&2
  exit 1
fi

if [ "$builds_a_guest_image" = "1" ] && [ "$(uname -m)" != "aarch64" ] && [ "$(uname -m)" != "arm64" ]; then
  echo "Blueclaw runtime artifacts must be prepared on Linux arm64" >&2
  exit 1
fi

require_command curl
require_command sha256sum
require_command find
require_command python3

if [ "$builds_a_guest_image" = "1" ]; then
  require_command tar
  require_command unzip
  require_command dpkg-deb
  require_command mkfs.ext4
  require_command rsync
  require_command go
  require_command make
  require_command git
fi

if [ "$builds_a_guest_image" = "1" ]; then
  run_root mkdir -p "$scratch_directory" "$cache_directory" "$work_directory"
  run_root chown "$(id -u):$(id -g)" "$scratch_directory" "$cache_directory" "$work_directory"
  run_root rm -rf "$stage_directory"
else
  mkdir -p "$scratch_directory" "$cache_directory" "$work_directory"
  rm -rf "$stage_directory"
fi
mkdir -p "$artifact_directory" "$stage_directory"

prepare_cloud_hypervisor() {
  local binary_path="$cache_directory/cloud-hypervisor-v$cloud_hypervisor_version-aarch64"
  local download_url="https://github.com/cloud-hypervisor/cloud-hypervisor/releases/download/v$cloud_hypervisor_version/cloud-hypervisor-static-aarch64"

  if [ -x "$artifact_directory/cloud-hypervisor" ]; then
    install -m 0755 "$artifact_directory/cloud-hypervisor" "$stage_directory/cloud-hypervisor"
    return
  fi

  if [ ! -s "$binary_path" ]; then
    curl --fail --location --retry 3 --output "$binary_path.tmp" "$download_url"
    mv "$binary_path.tmp" "$binary_path"
  fi

  install -m 0755 "$binary_path" "$stage_directory/cloud-hypervisor"
}

guest_kernel_build_identifier() {
  echo "$linux_kernel_version-$(guest_kernel_configuration_sha | cut -c1-16)"
}

# Cloud Hypervisor reaches a shared directory through a vhost-user daemon rather than
# serving it itself. Ubuntu 22.04 carries no virtiofsd, so the binary travels with the
# runtime the way the VMMs do; the 24.04 build runs there unchanged.
prepare_virtiofsd() {
  local archive_path="$cache_directory/virtiofsd-$virtiofsd_version-arm64.deb"
  local extract_directory="$work_directory/virtiofsd-$virtiofsd_version"
  local download_url="http://ports.ubuntu.com/ubuntu-ports/pool/universe/r/rust-virtiofsd/virtiofsd_${virtiofsd_version}_arm64.deb"

  if [ -x "$artifact_directory/virtiofsd" ]; then
    install -m 0755 "$artifact_directory/virtiofsd" "$stage_directory/virtiofsd"
    return
  fi

  if [ ! -s "$archive_path" ]; then
    curl --fail --location --retry 3 --output "$archive_path.tmp" "$download_url"
    mv "$archive_path.tmp" "$archive_path"
  fi

  rm -rf "$extract_directory"
  mkdir -p "$extract_directory"
  ( cd "$extract_directory" && dpkg-deb --fsys-tarfile "$archive_path" | tar -x ./usr/libexec/virtiofsd )

  local virtiofsd_binary="$extract_directory/usr/libexec/virtiofsd"
  if [ ! -s "$virtiofsd_binary" ]; then
    echo "virtiofsd package did not contain usr/libexec/virtiofsd" >&2
    exit 1
  fi
  install -m 0755 "$virtiofsd_binary" "$stage_directory/virtiofsd"
}

prepare_kernel() {
  if [ -n "$kernel_source" ]; then
    install -m 0644 "$kernel_source" "$stage_directory/vmlinux.bin"
    return
  fi

  if [ ! -s "$guest_kernel_configuration_path" ]; then
    echo "missing guest kernel configuration at $guest_kernel_configuration_path" >&2
    exit 1
  fi

  if published_kernel_matches_configuration; then
    install -m 0644 "$artifact_directory/vmlinux.bin" "$stage_directory/vmlinux.bin"
    return
  fi

  local kernel_cache_path="$cache_directory/vmlinux-$(guest_kernel_build_identifier)-aarch64.bin"
  if [ -s "$kernel_cache_path" ]; then
    install -m 0644 "$kernel_cache_path" "$stage_directory/vmlinux.bin"
    return
  fi

  if [ "${BLUECLAW_BUILD_KERNEL:-0}" != "1" ]; then
    echo "missing Blueclaw guest kernel image for $(guest_kernel_build_identifier)" >&2
    echo "set BLUECLAW_KERNEL_IMAGE_SOURCE to an arm64 kernel image built from $guest_kernel_configuration_path, or set BLUECLAW_BUILD_KERNEL=1" >&2
    exit 1
  fi

  require_command curl
  require_command tar

  local kernel_archive_path="$cache_directory/linux-$linux_kernel_version.tar.xz"
  local kernel_source_directory="$work_directory/linux-$linux_kernel_version"
  local kernel_download_url="https://cdn.kernel.org/pub/linux/kernel/v6.x/linux-$linux_kernel_version.tar.xz"

  if [ ! -s "$kernel_archive_path" ]; then
    curl --fail --location --retry 3 --output "$kernel_archive_path.tmp" "$kernel_download_url"
    mv "$kernel_archive_path.tmp" "$kernel_archive_path"
  fi

  rm -rf "$kernel_source_directory"
  tar -xJf "$kernel_archive_path" -C "$work_directory"

  cp "$guest_kernel_configuration_path" "$kernel_source_directory/.config"
  (
    cd "$kernel_source_directory"
    make olddefconfig
    make -j"$(nproc)" Image
  )

  assert_guest_kernel_supports_cloud_hypervisor "$kernel_source_directory/.config"

  local built_kernel_path="$kernel_source_directory/arch/arm64/boot/Image"
  if [ ! -s "$built_kernel_path" ]; then
    echo "Linux kernel build did not produce arch/arm64/boot/Image" >&2
    exit 1
  fi

  install -m 0644 "$built_kernel_path" "$kernel_cache_path"
  install -m 0644 "$kernel_cache_path" "$stage_directory/vmlinux.bin"
}

assert_guest_kernel_supports_cloud_hypervisor() {
  local resolved_configuration_path="$1"
  local missing_symbols=()
  local symbol
  for symbol in \
    CONFIG_SERIAL_8250_CONSOLE \
    CONFIG_PCI \
    CONFIG_PCI_HOST_GENERIC \
    CONFIG_VIRTIO_PCI \
    CONFIG_SERIAL_AMBA_PL011_CONSOLE \
    CONFIG_FUSE_FS \
    CONFIG_VIRTIO_FS; do
    if ! grep -q "^$symbol=y$" "$resolved_configuration_path"; then
      missing_symbols+=("$symbol")
    fi
  done
  if [ "${#missing_symbols[@]}" -gt 0 ]; then
    echo "guest kernel configuration resolved without ${missing_symbols[*]}" >&2
    echo "Cloud Hypervisor reaches virtio over PCI, and the guest kernel must carry it" >&2
    exit 1
  fi
}

build_blueclaw_base_binaries() {
  local binary_directory="$work_directory/bin"
  mkdir -p "$binary_directory"
  (
    cd "$repository_root/.dependency/blueclaw"
    GOOS=linux GOARCH=arm64 CGO_ENABLED=0 go build -o "$binary_directory/blueclaw-supervisor" ./cmd/blueclaw-supervisor
    GOOS=linux GOARCH=arm64 CGO_ENABLED=0 go build -o "$binary_directory/blueclaw-guest-healthd" ./cmd/blueclaw-guest-healthd
    GOOS=linux GOARCH=arm64 CGO_ENABLED=0 go build -o "$binary_directory/blueclaw-vsock-http-proxy" ./cmd/blueclaw-vsock-http-proxy
    GOOS=linux GOARCH=arm64 CGO_ENABLED=0 go build -o "$binary_directory/blueclaw-posix-helper" ./cmd/blueclaw-posix-helper
  )
}

rootfs_base_packages="ca-certificates,curl,bash,bc,coreutils,findutils,postgresql,postgresql-client,python3,python3-venv,python3-pip,iproute2,procps,mount,e2fsprogs,unzip,chromium,fontconfig,fonts-noto-cjk"
rootfs_base_release="bookworm"
rootfs_pgvector_package="postgresql-15-pgvector"
rootfs_base_cache_path=""

ensure_rootfs_bun() {
  local base_directory="$1"
  local bun_archive_name="bun-linux-aarch64"
  local bun_archive_path="$cache_directory/bun-v${blueclaw_bun_version}-${bun_archive_name}.zip"
  local bun_extract_directory="$work_directory/bun-v${blueclaw_bun_version}"

  if [ ! -s "$bun_archive_path" ]; then
    mkdir -p "$cache_directory"
    curl -fsSL "https://github.com/oven-sh/bun/releases/download/bun-v${blueclaw_bun_version}/${bun_archive_name}.zip" -o "$bun_archive_path.tmp"
    mv "$bun_archive_path.tmp" "$bun_archive_path"
  fi

  rm -rf "$bun_extract_directory"
  mkdir -p "$bun_extract_directory"
  unzip -q "$bun_archive_path" -d "$bun_extract_directory"
  run_root install -m 0755 "$bun_extract_directory/$bun_archive_name/bun" "$base_directory/usr/local/bin/bun"
  run_root ln -sf bun "$base_directory/usr/local/bin/bunx"
  rm -rf "$bun_extract_directory"
}

run_chroot_with_runtime_mounts() {
  local base_directory="$1"
  shift
  local mounted_dev=0
  local mounted_proc=0
  local command_status=0

  run_root mkdir -p "$base_directory/dev" "$base_directory/proc"
  if ! mountpoint -q "$base_directory/dev"; then
    run_root mount --bind /dev "$base_directory/dev"
    mounted_dev=1
  fi
  if ! mountpoint -q "$base_directory/proc"; then
    run_root mount -t proc proc "$base_directory/proc"
    mounted_proc=1
  fi

  set +e
  run_root chroot "$base_directory" "$@"
  command_status=$?
  set -e

  if [ "$mounted_proc" -eq 1 ]; then
    run_root umount "$base_directory/proc"
  fi
  if [ "$mounted_dev" -eq 1 ]; then
    run_root umount "$base_directory/dev"
  fi

  return "$command_status"
}

ensure_rootfs_site_scaffold_cache() {
  local base_directory="$1"
  local scaffold_package_json_path="$2"

  run_root mkdir -p "$base_directory/opt/blueclaw/bun-cache" "$base_directory/opt/blueclaw/site-scaffold"
  run_root sh -c "sed 's/__SITE_PACKAGE_NAME__/site-scaffold-cache/' '$scaffold_package_json_path' > '$base_directory/opt/blueclaw/site-scaffold/package.json'"
  run_chroot_with_runtime_mounts "$base_directory" /usr/bin/env BUN_INSTALL_CACHE_DIR=/opt/blueclaw/bun-cache /usr/local/bin/bun install --cwd /opt/blueclaw/site-scaffold >/dev/null
  run_root rm -rf "$base_directory/opt/blueclaw/site-scaffold/node_modules"
}

ensure_rootfs_uv() {
  local base_directory="$1"

  run_root mkdir -p "$base_directory/usr/local/bin"
  run_chroot_with_runtime_mounts "$base_directory" /bin/sh -c "curl -LsSf 'https://astral.sh/uv/${blueclaw_uv_version}/install.sh' | UV_UNMANAGED_INSTALL=/usr/local/bin sh" >/dev/null
  run_chroot_with_runtime_mounts "$base_directory" /usr/local/bin/uv --version >/dev/null
}

ensure_rootfs_pgvector() {
  local base_directory="$1"

  run_chroot_with_runtime_mounts "$base_directory" /bin/sh -c '
set -eu
if [ -x /usr/share/postgresql-common/pgdg/apt.postgresql.org.sh ]; then
  /usr/share/postgresql-common/pgdg/apt.postgresql.org.sh -y
else
  install -d /usr/share/keyrings
  curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc -o /usr/share/keyrings/postgresql-archive-keyring.asc
  echo "deb [signed-by=/usr/share/keyrings/postgresql-archive-keyring.asc] https://apt.postgresql.org/pub/repos/apt '"$rootfs_base_release"'-pgdg main" >/etc/apt/sources.list.d/pgdg.list
  apt-get update
fi
DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends '"$rootfs_pgvector_package"'
apt-get clean
rm -rf /var/lib/apt/lists/*
' >/dev/null
}

ensure_rootfs_builtin_skills_python() {
  local base_directory="$1"
  local requirements_path="$2"

  run_root install -m 0644 "$requirements_path" "$base_directory/opt/blueclaw/builtin-skills-requirements.txt"
  run_chroot_with_runtime_mounts "$base_directory" /usr/local/bin/uv venv --clear --python /usr/bin/python3 /opt/blueclaw/builtin-skills-venv >/dev/null
  run_chroot_with_runtime_mounts "$base_directory" /usr/local/bin/uv pip install --python /opt/blueclaw/builtin-skills-venv/bin/python -r /opt/blueclaw/builtin-skills-requirements.txt >/dev/null
  run_chroot_with_runtime_mounts "$base_directory" /opt/blueclaw/builtin-skills-venv/bin/python -c "import docx, fpdf, openpyxl, pptx, pypdf" >/dev/null
}

ensure_rootfs_base() {
  require_command mmdebstrap
  local builtin_skills_requirements_path="$repository_root/assets/blueclaw-runtime/builtin-skills-requirements.txt"
  if [ ! -s "$builtin_skills_requirements_path" ]; then
    echo "missing builtin skills requirements.txt at $builtin_skills_requirements_path" >&2
    exit 1
  fi
  local site_scaffold_package_json_path="$repository_root/.dependency/internkim-plugin/skills/website/assets/scaffold/app/package.json"
  if [ ! -s "$site_scaffold_package_json_path" ]; then
    echo "missing site scaffold package.json at $site_scaffold_package_json_path" >&2
    exit 1
  fi
  local builtin_skills_requirements_hash
  builtin_skills_requirements_hash="$(sha256sum "$builtin_skills_requirements_path" | cut -d' ' -f1)"
  local site_scaffold_package_json_hash
  site_scaffold_package_json_hash="$(sha256sum "$site_scaffold_package_json_path" | cut -d' ' -f1)"
  local prepare_script_hash
  prepare_script_hash="$(sha256sum "$repository_root/tools/prepare-blueclaw-runtime" | cut -d' ' -f1)"
  local cache_key
  cache_key="$(printf '%s\n%s\n%s\n%s\n%s\n%s\n%s\n%s\n' "$rootfs_base_packages" "$rootfs_base_release" "$rootfs_pgvector_package" "$builtin_skills_requirements_hash" "$blueclaw_bun_version" "$blueclaw_uv_version" "$site_scaffold_package_json_hash" "$prepare_script_hash" | sha256sum | cut -c1-16)"
  rootfs_base_cache_path="$cache_directory/rootfs-base-${cache_key}.tar"

  if [ -s "$rootfs_base_cache_path" ]; then
    return
  fi

  local base_directory="$work_directory/rootfs-base"
  run_root rm -rf "$base_directory"
  run_root mmdebstrap \
    --variant=minbase \
    --architectures=arm64 \
    --include="$rootfs_base_packages" \
    "$rootfs_base_release" \
    "$base_directory" \
    http://deb.debian.org/debian

  run_root mkdir -p "$base_directory/opt/blueclaw"
  ensure_rootfs_pgvector "$base_directory"
  ensure_rootfs_uv "$base_directory"
  ensure_rootfs_builtin_skills_python "$base_directory" "$builtin_skills_requirements_path"
  ensure_rootfs_bun "$base_directory"
  ensure_rootfs_site_scaffold_cache "$base_directory" "$site_scaffold_package_json_path"
  run_root chroot "$base_directory" uv --version >/dev/null
  run_root chroot "$base_directory" bun --version >/dev/null
  run_root chroot "$base_directory" bunx --version >/dev/null
  run_root chroot "$base_directory" /bin/sh -c "command -v bc >/dev/null"
  run_root test -x "$base_directory/opt/blueclaw/builtin-skills-venv/bin/python"
  run_root chroot "$base_directory" chromium --version >/dev/null
  run_root test -f "$base_directory/usr/share/postgresql/15/extension/vector.control"

  run_root tar -C "$base_directory" --xattrs --acls --numeric-owner -cf "$rootfs_base_cache_path.tmp" .
  run_root chown "$(id -u):$(id -g)" "$rootfs_base_cache_path.tmp"
  mv "$rootfs_base_cache_path.tmp" "$rootfs_base_cache_path"
  run_root rm -rf "$base_directory"
  find "$cache_directory" -maxdepth 1 -name 'rootfs-base-*.tar' -not -name "rootfs-base-${cache_key}.tar" -print0 | xargs -0 -r rm -f
}

ensure_rootfs_blueclaw_account() {
  local passwd_path="$rootfs_directory/etc/passwd"
  local group_path="$rootfs_directory/etc/group"
  local shadow_path="$rootfs_directory/etc/shadow"
  local gshadow_path="$rootfs_directory/etc/gshadow"

  if ! run_root grep -q '^blueclaw:' "$group_path"; then
    printf '%s\n' 'blueclaw:x:971:' | run_root tee -a "$group_path" >/dev/null
  fi
  if ! run_root grep -q '^blueclaw:' "$passwd_path"; then
    printf '%s\n' 'blueclaw:x:998:971:Blueclaw:/workspace:/bin/bash' | run_root tee -a "$passwd_path" >/dev/null
  fi
  if [ -f "$shadow_path" ] && ! run_root grep -q '^blueclaw:' "$shadow_path"; then
    printf '%s\n' 'blueclaw:*:19723:0:99999:7:::' | run_root tee -a "$shadow_path" >/dev/null
  fi
  if [ -f "$gshadow_path" ] && ! run_root grep -q '^blueclaw:' "$gshadow_path"; then
    printf '%s\n' 'blueclaw:*::' | run_root tee -a "$gshadow_path" >/dev/null
  fi
}

prepare_rootfs_directory() {
  ensure_rootfs_base
  run_root rm -rf "$rootfs_directory"
  run_root mkdir -p "$rootfs_directory"
  run_root tar -C "$rootfs_directory" --xattrs --acls --numeric-owner -xf "$rootfs_base_cache_path"
  ensure_rootfs_blueclaw_account

  run_root mkdir -p \
    "$rootfs_directory/usr/local/bin" \
    "$rootfs_directory/opt/blueclaw" \
    "$rootfs_directory/proc" \
    "$rootfs_directory/sys" \
    "$rootfs_directory/dev" \
    "$rootfs_directory/dev/pts" \
    "$rootfs_directory/run" \
    "$rootfs_directory/tmp" \
    "$rootfs_directory/workspace"
  run_root chmod 1777 "$rootfs_directory/tmp"
  run_root install -m 0755 "$work_directory/bin/blueclaw-guest-healthd" "$rootfs_directory/usr/local/bin/blueclaw-guest-healthd"
  run_root install -m 0755 "$work_directory/bin/blueclaw-vsock-http-proxy" "$rootfs_directory/usr/local/bin/blueclaw-vsock-http-proxy"
  run_root install -m 0755 "$work_directory/bin/blueclaw-posix-helper" "$rootfs_directory/usr/local/bin/blueclaw-posix-helper"
  run_root chown 0:0 "$rootfs_directory/usr/local/bin/blueclaw-posix-helper"
  run_root chmod 4755 "$rootfs_directory/usr/local/bin/blueclaw-posix-helper"
  run_root install -m 0755 "$repository_root/assets/blueclaw-runtime/guest-init" "$rootfs_directory/sbin/init"
}

prepare_rootfs() {
  if [ -n "$rootfs_source" ]; then
    install -m 0644 "$rootfs_source" "$rootfs_image_path"
    return
  fi
  build_blueclaw_base_binaries
  prepare_rootfs_directory
  prepare_rootfs_image
}

# A supplied guest image was built somewhere else, so the manifest states that build's
# sources rather than this checkout's. Inventing them here would let a stale image pass
# the freshness gate that exists to catch exactly that.
supplied_rootfs_provenance() {
  local field="$1"
  local source_manifest_path
  source_manifest_path="$(dirname "$rootfs_source")/manifest.json"
  if [ ! -s "$source_manifest_path" ]; then
    echo "BLUECLAW_ROOTFS_IMAGE_SOURCE needs a manifest.json beside it to state where the image came from" >&2
    exit 1
  fi
  python3 - "$source_manifest_path" "$field" <<'PROVENANCE'
import json
import sys

manifest_path, field = sys.argv[1:3]
with open(manifest_path, encoding="utf-8") as file:
    manifest = json.load(file)
value = manifest.get(field, "")
if not value:
    print(f"the manifest beside the supplied guest image states no {field}", file=sys.stderr)
    raise SystemExit(1)
print(value)
PROVENANCE
}

prepare_rootfs_image() {
  run_root rm -f "$rootfs_image_path"
  truncate -s "$rootfs_size" "$rootfs_image_path"
  run_root mkfs.ext4 -F -L blueclaw-rootfs -d "$rootfs_directory" "$rootfs_image_path" >/dev/null
}

write_manifest() {
  local guest_init_sha
  local prepare_script_sha
  local base_source_sha
  if [ -n "$rootfs_source" ]; then
    guest_init_sha="$(supplied_rootfs_provenance guestInitSHA256)"
    prepare_script_sha="$(supplied_rootfs_provenance prepareScriptSHA256)"
    base_source_sha="$(supplied_rootfs_provenance baseSourceSHA256)"
    write_manifest_document
    return
  fi
  guest_init_sha="$(sha256sum "$repository_root/assets/blueclaw-runtime/guest-init" | cut -d' ' -f1)"
  prepare_script_sha="$(sha256sum "$repository_root/tools/prepare-blueclaw-runtime" | cut -d' ' -f1)"
  base_source_sha="$(python3 - "$repository_root/.dependency/blueclaw" <<'PY'
import hashlib
import pathlib
import sys

root = pathlib.Path(sys.argv[1])
paths = [
    "go.mod",
    "go.sum",
    "cmd/blueclaw-guest-healthd",
    "cmd/blueclaw-vsock-http-proxy",
    "cmd/blueclaw-posix-helper",
    "internal/policy",
    "internal/security/posix_identity.go",
]

def file_sha256(path):
    hash_value = hashlib.sha256()
    with path.open("rb") as file:
        for chunk in iter(lambda: file.read(1024 * 1024), b""):
            hash_value.update(chunk)
    return hash_value.hexdigest()

def directory_sha256(path):
    hash_value = hashlib.sha256()
    for file_path in sorted(item for item in path.rglob("*") if item.is_file()):
        relative_path = file_path.relative_to(path).as_posix()
        hash_value.update(relative_path.encode())
        hash_value.update(b"\n")
        with file_path.open("rb") as file:
            for chunk in iter(lambda: file.read(1024 * 1024), b""):
                hash_value.update(chunk)
        hash_value.update(b"\n")
    return hash_value.hexdigest()

hash_value = hashlib.sha256()
for relative_path in paths:
    path = root / relative_path
    hash_value.update(relative_path.encode())
    hash_value.update(b"\n")
    hash_value.update((directory_sha256(path) if path.is_dir() else file_sha256(path)).encode())
    hash_value.update(b"\n")
print(hash_value.hexdigest())
PY
)"
  write_manifest_document
}

write_manifest_document() {
  python3 - "$stage_directory" "$artifact_directory/manifest.json" "$cloud_hypervisor_version" "$guest_init_sha" "$prepare_script_sha" "$base_source_sha" "$(guest_kernel_configuration_sha)" <<'PY'
import hashlib
import json
import os
import sys

stage_directory, manifest_path, version, guest_init_sha256, prepare_script_sha256, base_source_sha256, guest_kernel_configuration_sha256 = sys.argv[1:8]
files = []
for name, mode in [
    ("cloud-hypervisor", "0755"),
    ("virtiofsd", "0755"),
    ("vmlinux.bin", "0644"),
    ("rootfs.ext4", "0644"),
]:
    path = os.path.join(stage_directory, name)
    hash_value = hashlib.sha256()
    with open(path, "rb") as file:
        while True:
            chunk = file.read(1024 * 1024)
            if not chunk:
                break
            hash_value.update(chunk)
    files.append({"name": name, "path": name, "sha256": hash_value.hexdigest(), "mode": mode})
manifest = {
    "runtimeName": "internkim-blueclaw-runtime",
    "platform": "linux-arm64",
    "version": version,
    "guestInitSHA256": guest_init_sha256,
    "prepareScriptSHA256": prepare_script_sha256,
    "baseSourceSHA256": base_source_sha256,
    "guestKernelConfigurationSHA256": guest_kernel_configuration_sha256,
    "files": files,
}
document = json.dumps(manifest, indent=2, ensure_ascii=False) + "\n"
with open(os.path.join(stage_directory, "manifest.json"), "w", encoding="utf-8") as file:
    file.write(document)
with open(manifest_path, "w", encoding="utf-8") as file:
    file.write(document)
PY
}

publish_artifacts() {
  for file_name in cloud-hypervisor virtiofsd vmlinux.bin rootfs.ext4 manifest.json; do
    mv "$stage_directory/$file_name" "$artifact_directory/$file_name"
  done
}

