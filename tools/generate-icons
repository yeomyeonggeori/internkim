#!/usr/bin/env python3
"""Cut the docs favicon and the bot avatar from assets/internkim.square.png.

assets/internkim.icon.png is the finished app icon, drawn in Icon Composer,
and waits for a desktop wrapper. assets/internkim.square.png is the same face
drawn full bleed, and takes the slots a platform recuts or shrinks: the docs
favicon and the bot avatar.

The web app's icons in web/static are supplied artwork, not cut from these
masters, so this script does not write them.

A tab favicon is drawn at 16 to 32 pixels, and the whole square is unreadable
there: the face lands on a dozen pixels and the frame around it takes the
rest. The docs favicon is cut to FAVICON_FRAME instead, which fills the tile
with the sprout, head and glasses.

Needs Pillow on the running Python.
"""

import pathlib
import sys

try:
    from PIL import Image
except ImportError as error:
    sys.exit(f"tools/generate-icons needs Pillow: {error}")

REPOSITORY_ROOT = pathlib.Path(__file__).resolve().parent.parent
SQUARE_MASTER = REPOSITORY_ROOT / "assets" / "internkim.square.png"
FAVICON_SIZES = [(48, 48), (32, 32), (16, 16)]
MASTER_SIDE = 1024
FAVICON_FRAME = (122, 178, 780)


def save(image: Image.Image, relative_path: str, size: int, mode: str) -> None:
    output = image.resize((size, size), Image.LANCZOS).convert(mode)
    output.save(REPOSITORY_ROOT / relative_path, optimize=True)
    print(relative_path, output.size, output.mode)


def framed_face(square: Image.Image) -> Image.Image:
    if square.size != (MASTER_SIDE, MASTER_SIDE):
        sys.exit(f"{SQUARE_MASTER} is {square.size[0]}x{square.size[1]}; FAVICON_FRAME reads {MASTER_SIDE}")
    left, top, side = FAVICON_FRAME
    return square.crop((left, top, left + side, top + side))


def write_favicon(square: Image.Image) -> None:
    face = framed_face(square)
    largest, *rest = FAVICON_SIZES
    frames = [face.resize(size, Image.LANCZOS).convert("RGBA") for size in (largest, *rest)]
    frames[0].save(REPOSITORY_ROOT / "docs/web/public/favicon.ico", append_images=frames[1:], sizes=FAVICON_SIZES)
    print("docs/web/public/favicon.ico", FAVICON_SIZES)


def main() -> None:
    square = Image.open(SQUARE_MASTER).convert("RGB")

    save(square, "assets/internkim.png", 512, "RGB")
    write_favicon(square)


if __name__ == "__main__":
    main()
