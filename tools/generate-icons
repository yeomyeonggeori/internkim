#!/usr/bin/env python3
"""Cut every tab favicon from assets/internkim.favicon.png and the bot avatar
from assets/internkim.square.png, for the messenger and for the web pages that
show the agent speaking.

assets/internkim.favicon.png is the round mark, drawn for the sizes a browser
draws a tab at: the sprout, the head and the glasses, with the eyes and mouth
dropped so the glasses still read at 16 pixels. Both sites take their tab
favicon from it, so intern.kim and docs.intern.kim show one mark.

assets/internkim.icon.png is the finished app icon, drawn in Icon Composer
with its own rounded shape and margin, and becomes the Mac app's
web/src-tauri/icons/icon.icns: macOS draws an icns as it is given.
`cargo tauri icon` cuts that file from the square master too, so this script
runs after it. assets/internkim.square.png is the face drawn full bleed, and
takes the slots a platform masks for itself: the bot avatar, and the
installed-app tiles in web/static, which are supplied artwork this script does
not write.

The Mac app's menu bar icon is the round mark as a template image: macOS
paints its opaque pixels in the menu bar's own colour, so the blue becomes
ink and the white becomes a hole. The face's white body fills the bottom
of the circle, so the ink that remains is centred on its own bounds.

web/static/favicon.svg is the round mark as a vector, and a browser that reads
SVG icons uses it instead of these rasters. It is drawn by hand, so a new
round master has to be exported to it as well.

Needs Pillow on the running Python.
"""

import pathlib
import sys

try:
    from PIL import Image
except ImportError as error:
    sys.exit(f"tools/generate-icons needs Pillow: {error}")

REPOSITORY_ROOT = pathlib.Path(__file__).resolve().parent.parent
ROUND_MASTER = REPOSITORY_ROOT / "assets" / "internkim.favicon.png"
SQUARE_MASTER = REPOSITORY_ROOT / "assets" / "internkim.square.png"
MAC_APP_ICON_MASTER = REPOSITORY_ROOT / "assets" / "internkim.icon.png"
MAC_APP_ICON = "web/src-tauri/icons/icon.icns"
MAC_APP_ICON_SIDES = [16, 32, 64, 128, 256, 512, 1024]
MENU_BAR_ICON = "web/src-tauri/plugins/desktop-control/icons/menu-bar.png"
MENU_BAR_ICON_SIDE = 36
ROUND_MARK_BLUE_RED_CHANNEL = 14
DOCS_FAVICON_SIZES = [(48, 48), (32, 32), (16, 16)]
WEB_FAVICON_SIDES = {"web/static/favicon.png": 32, "web/static/favicon-192.png": 192, "web/static/favicon-512.png": 512}


def save(image: Image.Image, relative_path: str, side: int, mode: str) -> None:
    output = image.resize((side, side), Image.LANCZOS).convert(mode)
    output.save(REPOSITORY_ROOT / relative_path, optimize=True)
    print(relative_path, output.size, output.mode)


def write_docs_favicon(round_mark: Image.Image) -> None:
    frames = [round_mark.resize(size, Image.LANCZOS) for size in DOCS_FAVICON_SIZES]
    frames[0].save(REPOSITORY_ROOT / "docs/web/public/favicon.ico", append_images=frames[1:], sizes=DOCS_FAVICON_SIZES)
    print("docs/web/public/favicon.ico", DOCS_FAVICON_SIZES)


def write_web_favicons(round_mark: Image.Image) -> None:
    for relative_path, side in WEB_FAVICON_SIDES.items():
        save(round_mark, relative_path, side, "RGBA")


def write_mac_app_icon() -> None:
    finished_icon = Image.open(MAC_APP_ICON_MASTER).convert("RGBA")
    sizes = [(side, side) for side in MAC_APP_ICON_SIDES]
    finished_icon.save(REPOSITORY_ROOT / MAC_APP_ICON, format="ICNS", sizes=sizes)
    print(MAC_APP_ICON, MAC_APP_ICON_SIDES)


def blueness(red: int) -> int:
    span = 255 - ROUND_MARK_BLUE_RED_CHANNEL
    return round(max(0, min(255, (255 - red) * 255 / span)))


def centre_ink_on_square(template: Image.Image) -> Image.Image:
    ink = template.crop(template.getchannel("A").getbbox())
    side = max(ink.size)
    square = Image.new("RGBA", (side, side), (0, 0, 0, 0))
    square.paste(ink, ((side - ink.width) // 2, (side - ink.height) // 2))
    return square


def write_menu_bar_icon(round_mark: Image.Image) -> None:
    red, _, _, alpha = round_mark.split()
    ink = Image.composite(red.point(blueness), Image.new("L", round_mark.size, 0), alpha)
    black = Image.new("L", round_mark.size, 0)
    template = Image.merge("RGBA", (black, black, black, ink))
    save(centre_ink_on_square(template), MENU_BAR_ICON, MENU_BAR_ICON_SIDE, "RGBA")


def main() -> None:
    round_mark = Image.open(ROUND_MASTER).convert("RGBA")
    write_docs_favicon(round_mark)
    write_web_favicons(round_mark)
    write_menu_bar_icon(round_mark)

    square = Image.open(SQUARE_MASTER).convert("RGB")
    save(square, "assets/internkim.png", 512, "RGB")
    save(square, "web/static/agent-avatar.png", 256, "RGB")
    write_mac_app_icon()


if __name__ == "__main__":
    main()
