#!/usr/bin/env python3
"""Run blueclaw's scenario tests against the skills and tools this repository ships.

Blueclaw's scenarios read their skill roots and their capability catalog from
the environment, and skip when nothing sets either. The skills are prepared
first by the step the install runs, because a skill that was never prepared asks
the agent to run its own setup, which a scenario cannot approve.
"""

import os
import pathlib
import re
import subprocess
import sys

REPOSITORY_ROOT = pathlib.Path(__file__).resolve().parent.parent
SUBMODULE_PATH = REPOSITORY_ROOT / ".dependency" / "blueclaw"

sys.path.insert(0, str(REPOSITORY_ROOT / "tools"))
from skill_paths import skill_root_paths  # noqa: E402


SCENARIO_PACKAGE_PATHS = [
    pathlib.Path("internal") / "defaultharness" / "e2e",
    pathlib.Path("internal") / "e2e",
]


def scenario_package_path() -> pathlib.Path:
    for relative_path in SCENARIO_PACKAGE_PATHS:
        if (SUBMODULE_PATH / relative_path).is_dir():
            return relative_path
    raise SystemExit("blueclaw has no scenario package in " + ", ".join(str(path) for path in SCENARIO_PACKAGE_PATHS))


def declared_variable(constant_name: str, source_name: str) -> str:
    declaration = re.search(
        constant_name + r' = "([A-Z_]+)"',
        (SUBMODULE_PATH / scenario_package_path() / source_name).read_text(),
    )
    if declaration is None:
        raise SystemExit(f"blueclaw declares no {constant_name}, so its scenarios would skip")
    return declaration.group(1)


def prepare_skills(skill_roots: list[str]) -> int:
    for skill_root in skill_roots:
        result = subprocess.run(
            ["go", "run", "./cmd/internkim-host", "prepare-skills", "--skills-directory", skill_root],
            cwd=REPOSITORY_ROOT,
        )
        if result.returncode != 0:
            return result.returncode
    return 0


def main() -> int:
    if not (SUBMODULE_PATH / "go.mod").is_file():
        print("blueclaw is not checked out: git submodule update --init --recursive", file=sys.stderr)
        return 1
    skill_roots = [str(path) for path in skill_root_paths(REPOSITORY_ROOT) if path.is_dir()]
    if not skill_roots:
        print("no skill root exists to offer blueclaw's scenarios", file=sys.stderr)
        return 1
    catalog_path = REPOSITORY_ROOT / "pkg" / "capabilityprotocol" / "generated" / "capability-tools.json"
    if not catalog_path.is_file():
        print(f"no capability catalog at {catalog_path}: make generate-protocol", file=sys.stderr)
        return 1
    preparation_status = prepare_skills(skill_roots)
    if preparation_status != 0:
        return preparation_status
    environment = dict(os.environ)
    environment[declared_variable("ScenarioSkillRootsVariable", "scenarios.go")] = os.pathsep.join(skill_roots)
    environment[declared_variable("ScenarioCapabilityCatalogVariable", "virtual_session.go")] = str(catalog_path)
    arguments = sys.argv[1:] or ["-tags", "appliance", "./" + scenario_package_path().as_posix() + "/"]
    return subprocess.run(["go", "test", *arguments], cwd=SUBMODULE_PATH, env=environment).returncode


if __name__ == "__main__":
    sys.exit(main())
