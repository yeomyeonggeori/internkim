#!/usr/bin/env python3
"""Move the credentials that used to answer from a file under .local/secrets
into `.env`, which is now their only home.

Each value is copied only when `.env` does not already carry it. A `.env` value
that differs from the file is a conflict: both are left alone and the run fails,
because guessing which of two disagreeing secrets is current is how the wrong
one gets deployed. Values are never printed; a conflict is reported by digest.

Run with --retire to move the consumed files into
~/.internkim/retired-secrets/<today>/ once they have been copied. `.env` is per
worktree while .local/secrets is usually a symlink shared between them, so
--repository-root names which worktree's `.env` receives the values.
"""

import argparse
import datetime
import hashlib
import pathlib
import shutil
import sys

SECRET_FILE_NAMES = [
    ("INTERNKIM_RELEASE_DOWNLOAD_TOKEN", "release-download-token"),
    ("INTERNKIM_CONSOLE_PASSWORD", "console-password"),
    ("INTERNKIM_BUZZ_KEY_SEED", "buzz-key-seed"),
]


def digest(value):
    return hashlib.sha256(value.encode("utf-8")).hexdigest()[:12]


def read_environment_lines(environment_path):
    if not environment_path.exists():
        return []
    return environment_path.read_text(encoding="utf-8").rstrip("\n").split("\n")


def environment_value(lines, key):
    prefix = key + "="
    for line in reversed(lines):
        stripped = line.strip()
        if stripped.startswith("export "):
            stripped = stripped[len("export "):].lstrip()
        if stripped.startswith(prefix):
            return unquote(stripped[len(prefix):].strip())
    return ""


def unquote(value):
    if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
        return value[1:-1]
    return value


def with_value(lines, key, value):
    prefix = key + "="
    for index, line in enumerate(lines):
        stripped = line.strip()
        if stripped.startswith("export "):
            stripped = stripped[len("export "):].lstrip()
        if stripped.startswith(prefix):
            updated = list(lines)
            updated[index] = prefix + value
            return updated
    return list(lines) + [prefix + value]


def back_up_environment(environment_path):
    if not environment_path.exists():
        return None
    stamp = datetime.datetime.now().strftime("%Y%m%dT%H%M%S")
    backup_path = environment_path.with_name(f".env.backup-{stamp}")
    shutil.copy2(environment_path, backup_path)
    backup_path.chmod(0o600)
    return backup_path


def write_environment(environment_path, lines):
    environment_path.write_text("\n".join(lines) + "\n", encoding="utf-8")
    environment_path.chmod(0o600)


def retirement_directory():
    today = datetime.date.today().isoformat()
    directory = pathlib.Path.home() / ".internkim" / "retired-secrets" / today
    directory.mkdir(parents=True, exist_ok=True)
    directory.chmod(0o700)
    return directory


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--retire", action="store_true")
    parser.add_argument("--repository-root", default=str(pathlib.Path(__file__).resolve().parent.parent))
    arguments = parser.parse_args()

    repository_root = pathlib.Path(arguments.repository_root).resolve()
    environment_path = repository_root / ".env"
    local_secrets = repository_root / ".local" / "secrets"
    migrations = [(key, local_secrets / name) for key, name in SECRET_FILE_NAMES]

    print(f"repository {repository_root}")
    print(f"env        {environment_path}{'' if environment_path.exists() else '  (will be created)'}")
    print()

    lines = read_environment_lines(environment_path)
    copied = []
    conflicts = []
    already_held = []

    for key, path in migrations:
        if not path.exists():
            print(f"skip    {key}: no file at {path.relative_to(repository_root)}")
            continue
        file_value = path.read_text(encoding="utf-8").strip()
        if not file_value:
            print(f"skip    {key}: {path.name} is empty")
            continue
        current_value = environment_value(lines, key)
        if not current_value:
            lines = with_value(lines, key, file_value)
            copied.append((key, path))
            print(f"move    {key}  <- {path.name}  (sha256:{digest(file_value)})")
        elif current_value == file_value:
            already_held.append((key, path))
            print(f"same    {key}: .env already holds it")
        else:
            conflicts.append(key)
            print(
                f"CONFLICT {key}: .env has sha256:{digest(current_value)}, "
                f"{path.name} has sha256:{digest(file_value)}; neither touched"
            )

    if copied:
        backup_path = back_up_environment(environment_path)
        if backup_path:
            print(f"\nbacked up .env to {backup_path.name}")
        write_environment(environment_path, lines)
        print(f"wrote .env with {len(copied)} value(s)")
    else:
        print("\n.env unchanged")

    retirable = copied + already_held
    if arguments.retire and retirable:
        directory = retirement_directory()
        for key, path in retirable:
            destination = directory / path.name
            shutil.move(str(path), str(destination))
            destination.chmod(0o600)
            print(f"retired {path.name} -> {destination}")
    elif retirable:
        print("\nthese files are no longer read; rerun with --retire to move them aside:")
        for _, path in retirable:
            print(f"  {path.relative_to(repository_root)}")

    if conflicts:
        print(
            "\nResolve each conflict by hand: decide which value is current, put it in "
            ".env, then rerun.",
            file=sys.stderr,
        )
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
