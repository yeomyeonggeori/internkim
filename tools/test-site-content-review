FILLER_CONTENT = {
    "siteName": "연남로보틱스",
    "tagline": "레거시 창고 자동화",
    "blocks": [
        {"variant": "features", "title": "Our Services", "items": [
            {"title": "서비스 1", "body": "설명 1"},
            {"title": "서비스 2", "body": "설명 2"},
