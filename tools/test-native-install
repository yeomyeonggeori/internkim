    def observe_a_message_that_arrives_before_the_roster(self, step, plane):
        """What the stranger run lost: a member who writes before the agent knows them."""
        self.machine.checked_shell(
            AGENT_WITHOUT_ITS_ROSTER_COMMAND
            % {"admind": ADMIND_UNIT_NAME, "agent": AGENT_UNIT_NAME, "python": HOST_PYTHON_PATH}
        )
        self.message_text = message_asking_for_an_answer("before the roster")
        session = plane.member_session(self.company_id, self.message_text)
        message_id = (session.get("sent") or {}).get("messageID") or ""
        self.sent_messages.append((message_id, self.message_text))
        time.sleep(LONGER_THAN_THE_RELAY_USED_TO_WAIT_SECONDS)
        waited_seconds = LONGER_THAN_THE_RELAY_USED_TO_WAIT_SECONDS + 30
        held = self.machine.shell(
            RELAY_QUEUE_COMMAND % {"relay": RELAY_UNIT_NAME, "seconds": waited_seconds}
        ).stdout.strip()
        unanswered = self.machine.shell(
            AGENT_ANSWER_COMMAND % {
                "agent_path": COMPANY_CONDITION_PATH,
                "messenger_path": MESSENGER_DATABASE_PATH,
                "text": self.message_text,
                "message": message_id or "no-message",
            }
        ).stdout.strip()
        reported = dict(line.split("=", 1) for line in (held + "\n" + unanswered).splitlines() if "=" in line)
        step.observe(
            "a message the agent cannot place yet stays queued past the point the relay used to drop it",
            f"the relay's own inbound queue on disk and its journal {LONGER_THAN_THE_RELAY_USED_TO_WAIT_SECONDS}s after "
            "the message was sent, with admind stopped and the agent started on an empty roster, and the agent's "
            "task ledger for the message's text",
            "the member's message landing in the messenger says only that the relay stored it; the relay gave a "
            "message it could not hand over 32 seconds and then deleted it, and the agent started no task for it",
        ).record(
            bool(message_id)
            and reported.get("queued", "0") not in ("", "0")
            and reported.get("dropped") == "0"
            and not reported.get("task"),
            f"message {message_id or 'not sent'}\n{held}\n{unanswered}"
            + (f"\n{session['refused']}" if session.get("refused") else ""),
        )
        self.machine.checked_shell(f"systemctl start {ADMIND_UNIT_NAME}")
        self.observe_the_agent_answered(step)

    def observe_readiness_after_the_upgrade(self, step):
        answers = self.machine.shell(READINESS_COMMAND).stdout.strip()
        step.observe(
            "the services answer their readiness endpoints the moment the upgrade returns",
            "an HTTP GET inside the guest to "
            + ", ".join(f"127.0.0.1:{port}{path}" for port, path in READINESS_PROBES)
            + ", sent as soon as install.sh exits",
            "the package restarts every unit, and a unit is active the moment its process starts, whether or "
            "not that process will ever take work; an upgrade that returns before the company answers hands "
            "a person a host that drops what they say next",
        ).record(every_probe_answered(answers), answers or "nothing answered")

    def observe_the_upgraded_host_answers(self, step, plane):
        self.observe_readiness_after_the_upgrade(step)
        observe_the_conversion_environment(self.machine, step)
        self.message_text = message_asking_for_an_answer("after the upgrade")
        self.observe_the_host_holds_the_gateway_socket(step)
        self.observe_the_member_round_trip(step, plane)
        self.observe_the_agent_answered(step)
        retired = self.machine.shell(RETIRED_MEMORY_STORE_COMMAND)
        step.observe(
            "the upgraded agent's database keeps no vector extension and none of the retired memory tables",
            "pg_extension and pg_tables in the blueclaw database after the upgraded agent answered",
            "the install drops the extension as the cluster's superuser and the agent's migration drops the tables; "
            "a database still carrying either makes every later backup need pgvector to restore",
        ).record(retired.returncode == 0 and not retired.stdout.strip(), retired.stdout.strip() or "none")

    def run_step_ten(self, step, releases, plane):
        """An administrator asks the agent for the newer release, the way host_update asks admind."""
        older = package_fields(releases[0] / asset_name(".deb"))["Version"]
        newer = package_fields(releases[1] / asset_name(".deb"))["Version"]
        self.serve_the_newer_release_as_stable(releases[1], older, newer)
        administrator = plane.administrator_email

        version = self.ask_admind(agent_update.VERSION_PATH, administrator, {})[1]
        step.observe(
            "the gateway reports the installed release, its stable channel and the newer stable release",
            f"admind's {agent_update.VERSION_PATH} over its socket as {administrator}, the route host_version_get takes",
            "the version the agent states is the gateway's reading of dpkg, the channel install.sh recorded and "
            "the release list; a stub that answers a constant would pass nothing here",
        ).record(
            version.get("installedVersion") == f"v{older}"
            and version.get("channel") == "stable"
            and (version.get("latestStable") or {}).get("version") == f"v{newer}"
            and version.get("isUpdateAvailable") is True,
            json.dumps(version)[:600],
        )

        plan = self.ask_admind(agent_update.PLAN_PATH, administrator, {})[1]
        step.observe(
            "the confirmation is given the versions, the restart's cost and when it can run",
            f"admind's {agent_update.PLAN_PATH}, the route the approval gate resolves host_update's target through",
            "the gate words whatever this answers into the question an administrator approves, so a fact "
            "missing here is a fact the administrator is never told",
        ).record(
            plan.get("id") == f"v{newer}" and [choice.get("key") for choice in plan.get("choices") or []] == ["offHours", "now"]
            and "expectedDowntimeSeconds" in (plan.get("preview") or ""),
            json.dumps(plan)[:900],
        )

        requester = self.requester_of_the_last_answered_message()
        self.machine.checked_shell(agent_update.monitor_command((*READINESS_PROBES, MESSENGER_BRIDGE)))
        started_at = time.monotonic()
        status, started = self.ask_admind(agent_update.START_PATH, administrator, {"isApproved": True, "input": {}, "requester": requester})
        note = self.machine.shell(f"cat {agent_update.NOTE_PATH} 2>/dev/null").stdout
        second_status, second = self.ask_admind(agent_update.START_PATH, administrator, {"isApproved": True, "input": {}, "requester": requester})
        step.observe(
            "the approved call starts one update in a unit of its own, after writing who asked and where",
            f"admind's {agent_update.START_PATH} answer, the note at {agent_update.NOTE_PATH} read right after, "
            "and a second identical call made at once",
            "the update restarts admind itself, so only a note on disk and a unit outside admind's cgroup "
            "carry the request across; a second update racing the first would have two package managers "
            "on one dpkg lock",
        ).record(
            status == "200" and started.get("toVersion") == f"v{newer}"
            and requester["conversationID"] in note and f"v{newer}" in note
            and second_status == "409" and second.get("errorCode") == "update_in_progress",
            f"{status} {json.dumps(started)}\nnote {note.strip()[:400]}\nsecond {second_status} {json.dumps(second)}",
        )

        attempt_while_away = self.send_while_the_services_are_away(plane)
        finished = self.wait_in_the_guest(
            f"systemctl is-active {agent_update.UPDATE_UNIT_NAME}; dpkg-query -W -f 'version=${{Version}}\\n' {PACKAGE_NAME}",
            lambda reading: f"version={newer}" in reading
            and reading.split("\n")[0].strip() not in ("active", "activating", "deactivating"),
            timeout_seconds=2400,
        )
        update_seconds = time.monotonic() - started_at
        reported = self.wait_in_the_guest(
            f"test -e {agent_update.NOTE_PATH} && echo pending || echo cleared",
            lambda reading: "cleared" in reading,
            timeout_seconds=900,
        )
        monitor = self.machine.shell(
            f"systemctl stop {agent_update.MONITOR_UNIT_NAME} 2>/dev/null; cat {agent_update.MONITOR_LOG_PATH}"
        ).stdout
        downtime, is_back, readings = agent_update.downtime_from(monitor)
        self.measured_downtime = (downtime, update_seconds)

        step.observe(
            "the host comes back on the newer release",
            f"dpkg's version and the unit's state after `{agent_update.UPDATE_UNIT_NAME}` finished, and the build "
            "admind's health route reports",
            "the unit exiting is the updater's account of itself; dpkg and the running gateway are the machine's",
        ).record(
            f"version={newer}" in finished.stdout and build_identity_reported(self.machine).get("admindBuildID") == newer,
            finished.stdout.strip() + f"\nrunning {json.dumps(build_identity_reported(self.machine))}",
        )
        step.observe(
            "a message sent while the services are away is refused and its sender is told, or it is answered",
            "the result frame the member's websocket received for a message sent while the monitor read the "
            "services away, and the agent's task ledger for it",
            "the confirmation tells the administrator that a message sent during the restart has to be sent "
            "again; a message sent once everything is back says nothing about that window",
        ).record(
            attempt_while_away["was_away"]
            and (attempt_while_away["status"] not in (None, 200) or self.was_answered(attempt_while_away)),
            json.dumps({key: value for key, value in attempt_while_away.items() if key != "text"}),
        )
        outcome = self.wait_in_the_guest(
            agent_update.OUTCOME_COMMAND % {
                "agent_path": COMPANY_CONDITION_PATH,
                "messenger_path": MESSENGER_DATABASE_PATH,
                "fragment": agent_update.OUTCOME_PROMPT_FRAGMENT,
                "member_message": self.last_sent_message_id() or "no-message",
            },
            lambda reading: "task=completed" in reading and "answers=0" not in reading,
            timeout_seconds=600,
        )
        step.observe(
            "the agent reports the update's result in the conversation it was asked in, and the note is cleared",
            "the agent's task for the result admind handed it, the messenger's store for an agent message in "
            f"that conversation written after that task began, and {agent_update.NOTE_PATH}",
            "a result written to a log, or to a conversation nobody asked in, is not one the administrator reads",
        ).record(
            "task=completed" in outcome.stdout and "answers=0" not in outcome.stdout and "cleared" in reported.stdout,
            outcome.stdout.strip()[-700:] + "\n" + reported.stdout.strip(),
        )

        self.message_text = message_asking_for_an_answer("sent again after the agent update")
        self.observe_the_member_round_trip(step, plane)
        self.observe_the_agent_answered(step)

        promised_seconds = agent_update.promised_downtime_seconds()
        step.observe(
            f"the services were away no longer than the {promised_seconds} seconds the confirmation promises",
            f"a reading every second of the relay unit and {', '.join(f'{port}{path}' for port, path in (*READINESS_PROBES, MESSENGER_BRIDGE))}, "
            "taken in the guest from before the update started until the result was reported",
            "the number in the question an administrator approves is only true if the restart it describes keeps to it",
        ).record(
            is_back and readings > 0 and 0 < downtime <= promised_seconds,
            f"longest outage {downtime:.1f}s over {readings} readings; the update took {update_seconds:.0f}s end to end",
        )
        self.machine.shell(
            f"rm -rf {Path(agent_update.ADMIND_DROP_IN_PATH).parent} {Path(agent_update.UPDATE_UNIT_DROP_IN_PATH).parent}; "
            f"systemctl daemon-reload; systemctl restart {ADMIND_UNIT_NAME}"
        )
        return step

    def serve_the_newer_release_as_stable(self, newer_release, older, newer):
        self.release.publish(newer_release)
        agent_update.write_stable_listing(
            self.release.directory, [f"v{newer}", f"v{older}"], time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
        )
        gateway = self.machine.host_gateway()
        drop_ins = agent_update.release_source_drop_ins(
            f"http://{gateway}:{self.release.port}/{agent_update.RELEASE_API_PATH}", self.release.download_url(gateway)
        )
        written = "".join(
            f"install -d {Path(path).parent}\nprintf '%s' {shlex.quote(contents)} > {path}\n" for path, contents in drop_ins.items()
        )
        self.machine.checked_shell(f"set -eu\n{written}systemctl daemon-reload\nsystemctl restart {ADMIND_UNIT_NAME}\n")
        self.wait_in_the_guest(READINESS_COMMAND, every_probe_answered)

    def ask_admind(self, path, email, body):
        return agent_update.answer_of(self.machine.shell(agent_update.ask_admind_command(path, email, body)).stdout)

    def requester_of_the_last_answered_message(self):
        reading = self.machine.shell(
            agent_update.ORIGIN_COMMAND % {"agent_path": COMPANY_CONDITION_PATH, "text": self.message_text}
        ).stdout.strip().splitlines()
        person_id, conversation_id, reply_target_id = (reading[-1].split("|") + ["", "", ""])[:3] if reading else ("", "", "")
        if not conversation_id:
            raise RigFailure(f"the agent's ledger names no conversation for {self.message_text!r}: {reading}")
        return {
            "personID": person_id,
            "platform": agent_update.MESSENGER_PLATFORM,
            "conversationID": conversation_id,
            "replyTargetID": reply_target_id,
        }

    def send_while_the_services_are_away(self, plane):
        text = message_asking_for_an_answer("sent during the agent update")
        deadline = time.monotonic() + 600
        while time.monotonic() < deadline:
            if self.monitor_reads_away():
                session = plane.member_session(self.company_id, text)
                sent = session.get("sent") or {}
                return {
                    "was_away": True,
                    "is_still_away": self.monitor_reads_away(),
                    "status": sent.get("status"),
                    "messageID": sent.get("messageID") or "",
                    "body": json.dumps(sent.get("body"))[:300],
                    "text": text,
                }
            time.sleep(1)
        return {"was_away": False, "status": None, "messageID": "", "text": text}

    def monitor_reads_away(self):
        return self.machine.shell(f"tail -n 1 {agent_update.MONITOR_LOG_PATH}").stdout.strip().endswith(" down")

    def was_answered(self, attempt):
        if not attempt.get("messageID"):
            return False
        reading = self.wait_in_the_guest(
            AGENT_ANSWER_COMMAND % {
                "agent_path": COMPANY_CONDITION_PATH,
                "messenger_path": MESSENGER_DATABASE_PATH,
                "text": attempt["text"],
                "message": attempt["messageID"],
            },
            the_agent_answered,
            timeout_seconds=600,
        )
        return the_agent_answered(reading.stdout)

    def wait_in_the_guest(self, script, is_ready, timeout_seconds=300):
        deadline = time.monotonic() + timeout_seconds
        while True:
            reading = self.machine.shell(script)
            if is_ready(reading.stdout) or time.monotonic() > deadline:
                return reading
            time.sleep(5)

    def relay_reported_of_the_gateway(self):
        reported = self.machine.shell(
            f"journalctl -u {RELAY_UNIT_NAME} --no-pager -n 40 2>/dev/null | grep -i gateway | tail -5; true"
        )
        return reported.stdout.strip() or f"{RELAY_UNIT_NAME} said nothing about the gateway"

    @contextlib.contextmanager
    def driving(self, machine, files_command):
        held = (self.machine, self.files_command)
        self.machine, self.files_command = machine, files_command
        try:
            yield
        finally:
            self.machine, self.files_command = held

    def take_a_backup(self, step):
        remembered = self.machine.shell(in_the_agents_database(REMEMBERED_ROW % {"conversation": BACKUP_CONVERSATION, "phrase": self.remembered_phrase}))
        written = self.machine.shell(PERSONS_FILE_COMMAND % {"phrase": shlex.quote(self.persons_phrase)})
        self.persons_file = written.stdout.strip().splitlines()[-1] if written.returncode == 0 else ""
        self.source_ownership = self.machine.shell(OWNERSHIP_COMMAND % {"path": self.persons_file or "/nonexistent"}).stdout
        step.observe(
            "the company has a row carrying a phrase, a message and a file a person owns",
            "the agent's database after inserting a conversation carrying the phrase, and a file written into the home "
            "of the first bc_person_ account the roster made, owned by it",
            "the restore can only be judged against data the backup was taken over",
        ).record(
            remembered.returncode == 0 and bool(self.persons_file),
            f"{remembered.stdout.strip()[-200:]}\n{written.stdout.strip()[-200:]}\n{self.source_ownership.strip()}",
        )

        scheduled = self.machine.shell(
            f"systemctl is-enabled {BACKUP_TIMER_NAME}; systemctl show -p NextElapseUSecRealtime --value {BACKUP_TIMER_NAME}"
        )
        step.observe(
            "the daily backup is scheduled on a host the line installed or upgraded",
            f"`systemctl is-enabled` of {BACKUP_TIMER_NAME} and when it next fires",
            "a timer file under the unit directory schedules nothing until it is enabled and started, and an "
            "upgraded host is the one a fresh-install check would never see",
        ).record(
            scheduled.stdout.startswith("enabled\n") and len(scheduled.stdout.split("\n", 1)[1].strip()) > 0,
            scheduled.stdout.strip(),
        )
        backed_up = self.machine.shell(f"{PACKAGE_NAME} backup 2>&1", timeout_seconds=1800)
        listed = self.machine.shell(
            f"archive=\"$(ls -1 {BACKUPS_DIRECTORY}/internkim-backup-*.tar | tail -n 1)\"; "
            f"echo \"$archive\"; stat -c '%a %U:%G' {BACKUPS_DIRECTORY} \"$archive\"; tar -tf \"$archive\"; "
            f"tar -xOf \"$archive\" manifest.json; "
            "systemctl is-active blueclaw.service buzz-relay.service | tr '\\n' ' '"
        )
        lines = listed.stdout.splitlines()
        archive = lines[0] if lines else ""
        step.observe(
            "`internkim backup` writes one archive only root can read while the services keep running",
            f"the exit status of `{PACKAGE_NAME} backup`, the modes of {BACKUPS_DIRECTORY} and the archive, "
            "the members `tar -tf` lists, and whether the agent and the messenger stayed active",
            "the archive holds the company's keys and its people's data, so its mode is the whole of its "
            "protection on this machine; and a backup that stopped the services would be an outage every night",
        ).record(
            backed_up.returncode == 0
            and "700 root:root" in listed.stdout and "600 root:root" in listed.stdout
            and all(member in listed.stdout for member in (
                "manifest.json", "databases/blueclaw.dump", "databases/buzz.dump", "files.tar", "roster.json"))
            and f'"companyID": "{self.company_id}"' in listed.stdout
            and listed.stdout.strip().endswith("active active"),
            f"{backed_up.stdout.strip()[-900:]}\n{listed.stdout.strip()[-1500:]}",
        )
        if archive and backed_up.returncode == 0:
            self.machine.checked_shell(f"cp {archive} {SHARE_PATH}/")
            self.archive_path = self.machine.share_directory / Path(archive).name

    def take_the_older_backup(self, step):
        if self.machine.shell(f"systemctl cat {BACKUP_TIMER_NAME} >/dev/null 2>&1").returncode != 0:
            return step.block("the older release takes no backup, so there is none from before the upgrade to restore")
        carried = self.machine.shell(RETIRED_MEMORY_STORE_COMMAND).stdout.strip()
        if not carried:
            return step.block(
                "the older release's database carries no vector extension and no memory table, "
                "so its backup proves nothing a newer one does not"
            )
        remembered = self.machine.shell(
            in_the_agents_database(REMEMBERED_ROW % {"conversation": OLDER_BACKUP_CONVERSATION, "phrase": self.older_phrase})
        )
        backed_up = self.machine.shell(f"{PACKAGE_NAME} backup 2>&1", timeout_seconds=1800)
        archive = self.machine.shell(f"ls -1 {BACKUPS_DIRECTORY}/internkim-backup-*.tar | tail -n 1").stdout.strip()
        step.observe(
            "the older release backs up a database that carries the retired memory store",
            f"what the blueclaw database holds of the vector extension and the memory tables, and the exit status of "
            f"`{PACKAGE_NAME} backup` on the older release",
            "a backup of a database that never had them would restore anywhere, and this is the one a host "
            "upgrading today already holds",
        ).record(
            remembered.returncode == 0 and backed_up.returncode == 0 and bool(archive),
            f"carried: {carried}\n{backed_up.stdout.strip()[-600:]}",
        )
        if backed_up.returncode == 0 and archive:
            self.machine.checked_shell(f"cp {archive} {SHARE_PATH}/")
            self.older_archive_path = self.machine.share_directory / Path(archive).name

    def restore_the_older_backup(self, step, family, share):
        shutil.copyfile(self.older_archive_path, share / self.older_archive_path.name)
        restored = self.restored_machine.shell(
            f"{PACKAGE_NAME} restore {SHARE_PATH}/{self.older_archive_path.name} 2>&1", timeout_seconds=1800
        )
        control_files = self.restored_machine.shell(PGVECTOR_CONTROL_FILES_COMMAND).stdout.strip()
        step.observe(
            f"`internkim restore` brings back the older release's backup on a fresh {family.name} machine with no pgvector",
            f"the exit status of `{PACKAGE_NAME} restore` and every vector.control on the machine",
            "the backup names the vector extension and tables typed on it, and a restore that needed them would "
            "fail on every machine this release installs",
        ).record(restored.returncode == 0 and not control_files, f"vector.control: {control_files or 'none'}\n{restored.stdout.strip()[-1500:]}")
        with self.driving(self.restored_machine, family.files_command):
            phrase = self.machine.shell(
                in_the_agents_database(REMEMBERED_ROW_AFTER_RESTORE % {"conversation": OLDER_BACKUP_CONVERSATION})
            )
            retired = self.machine.shell(RETIRED_MEMORY_STORE_COMMAND)
        fields = phrase.stdout.strip().split("|")
        step.observe(
            "the older backup's row is back, and the agent migrated it on this release to no vector extension "
            "and no memory table",
            "the phrase the restored row carries, and pg_extension and pg_tables in the restored blueclaw database",
            "the restore leaves out only what is typed on vector; everything else has to come back, and the "
            "agent's own migration is what drops the rest",
        ).record(
            len(fields) == 2 and fields[1] == self.older_phrase and retired.returncode == 0 and not retired.stdout.strip(),
            f"{phrase.stdout.strip()[-300:]}\nleft: {retired.stdout.strip() or 'none'}",
        )

    def restore_elsewhere(self, step, plane, older_step=None):
        family = FAMILIES[self.options.restore_family]
        if self.archive_path is None:
            return step.block("no archive was written, so there is nothing to restore")
        if family.package_in(self.options.package_directory) is None:
            return step.block(f"no {family.asset_name} under {self.options.package_directory} to install on {family.name}")
        share = self.working_directory / "restored-share"
        (share / "scripts").mkdir(parents=True, exist_ok=True)
        self.restored_machine = Machine(
            self.options.name + "-restored", share, kernel_image_path=self.options.kernel,
            image=family.image, bootstrap_script=family.bootstrap,
        )
        self.restored_machine.preflight()
        self.restored_machine.create()
        self.restored_machine.wait_until_running()
        self.restored_machine.checked_shell(family.tools_command, timeout_seconds=900)
        installed = self.restored_machine.shell(
            self.release.install_line(self.restored_machine.host_gateway()), timeout_seconds=2400
        )
        replacing = ""
        if self.older_archive_path and older_step:
            self.restore_the_older_backup(older_step, family, share)
            replacing = " --replace"
        shutil.copyfile(self.archive_path, share / self.archive_path.name)
        restored = self.restored_machine.shell(
            f"{PACKAGE_NAME} restore{replacing} {SHARE_PATH}/{self.archive_path.name} 2>&1", timeout_seconds=1800
        )
        step.observe(
            f"`internkim restore` brings the company back on a fresh {family.name} machine",
            f"the exit status of `{PACKAGE_NAME} restore` on a guest that had only run `install.sh host`",
            "a restore that needs anything but the package and the archive is not a restore a person can do "
            "the morning after",
        ).record(
            installed.returncode == 0 and restored.returncode == 0,
            f"install.sh exited {installed.returncode}\n{restored.stdout.strip()[-1800:]}",
        )
        with self.driving(self.restored_machine, family.files_command):
            self.observe_what_came_back(step)
            self.observe_running_services(step)
            self.observe_the_host_holds_the_gateway_socket(step)
            self.message_text = message_asking_for_an_answer("after restore")
            self.observe_the_member_round_trip(step, plane)
        return step

    def observe_what_came_back(self, step):
        nearest = self.machine.shell(in_the_agents_database(REMEMBERED_ROW_AFTER_RESTORE % {"conversation": BACKUP_CONVERSATION}))
        fields = nearest.stdout.strip().split("|")
        step.observe(
            "the remembered phrase comes back, on this machine's own PostgreSQL",
            "the PostgreSQL major the restored database runs on and the phrase the restored row carries",
            "the dump crossing a major is what a logical backup is for",
        ).record(len(fields) == 2 and fields[1] == self.remembered_phrase, nearest.stdout.strip()[-300:])

        sent_message_id, sent_message_text = self.sent_messages[0] if self.sent_messages else ("", "")
        message = self.machine.shell(
            MESSENGER_STORE_COMMAND % {"path": MESSENGER_DATABASE_PATH, "message": sent_message_id or "no-message"}
        )
        step.observe(
            "the message sent before the backup is in the restored messenger's store",
            f"the row the earlier message id names, read through {MESSENGER_DATABASE_PATH}",
            "the messenger's database is the conversation; a restored box without it is a company with amnesia",
        ).record(bool(sent_message_id) and sent_message_text in message.stdout, message.stdout.strip()[-300:])

        owned = self.machine.shell(OWNERSHIP_COMMAND % {"path": self.persons_file or "/nonexistent"}).stdout
        source_owner = self.source_ownership.split(" ")[0] if self.source_ownership else ""
        step.observe(
            "the person's file and the agent's workspace are back, owned by the same account names and modes, "
            "whatever numbers those accounts have here",
            "`stat` of the file and of /workspace on both machines, and the numeric ids of the service accounts on each",
            "tar restores numeric owners by default, and on a machine whose accounts were made in a different "
            "order that hands one person's files to someone else",
        ).record(
            bool(source_owner) and owned.startswith(source_owner + " 640 ") and self.persons_phrase in owned
            and "workspace=blueclaw:blueclaw " in self.source_ownership and "workspace=blueclaw:blueclaw " in owned,
            f"before: {self.source_ownership.strip()}\nafter:  {owned.strip()}",
        )

    # ----------------------------------------------------------------- report

    def report(self):
        lines = []
        for step in sorted(self.steps, key=lambda step: step.number):
            marker = {"PASS": "✓", "FAIL": "✗", "BLOCKED": "—"}[step.verdict]
            lines.append(f"{marker} step {step.number} · {step.name}")
            if step.blocked_because:
                lines.append(f"    blocked: {step.blocked_because}")
            for observation in step.observations:
                lines.append(f"    {'✓' if observation.passed else '✗'} {observation.name}")
                lines.append(f"        observes: {observation.observes}")
                if not observation.passed and observation.not_a_proxy:
                    lines.append(f"        why that and not a stand-in: {observation.not_a_proxy}")
                if observation.detail:
                    for detail_line in observation.detail.splitlines():
                        lines.append(f"        | {detail_line}")
        return "\n".join(lines)

    def verdict(self):
        return all(step.verdict == "PASS" for step in self.steps)


def observe_the_conversion_environment(machine, step):
    python = capabilityd_argument(machine, "--file-read-python")
    imported = machine.shell(f"{python} -c '{DOCUMENT_MODULES_THE_CONVERSION_IMPORTS}' 2>&1 && echo imported")
    step.observe(
        "the conversion environment imports every module file_read conversion opens",
        f"`{python}`, the interpreter the capabilityd unit names, run in the guest with the conversion import list",
        "the file existing says the install step ran; the import is what needs the wheels, the interpreter and "
        "this machine's glibc to agree",
    ).record(imported.stdout.strip().endswith("imported"), imported.stdout.strip()[-400:])
    resolved = machine.shell(f"readlink -f {python}").stdout.strip()
    step.observe(
        f"the conversion environment runs on uv's CPython {HOST_PYTHON_VERSION}, not the distribution's",
        f"where {python} resolves to",
        "a venv whose link pointed at /usr/bin/python3 would import on this guest and not on the next one",
    ).record(f"/cpython-{HOST_PYTHON_VERSION}-" in resolved and not resolved.startswith("/usr/"), resolved)


def observe_a_real_conversion(machine, step):
    phrase = f"internkim rig {uuid.uuid4().hex[:12]}"
    for file_name, content in (("rig.docx", a_docx_saying(phrase)), ("rig.pdf", a_pdf_saying(phrase))):
        answer = read_through_capabilityd(machine, file_name, content)
        step.observe(
            f"the running capabilityd reads {file_name} through its conversion environment",
            f"document_read invoked on capabilityd's socket with {file_name} carried the way blueclaw sends it",
            "the imports passing says the modules load; the text coming back is the helper, the wheels and the "
            "service's own account converting a file",
        ).record(
            phrase in answer.stdout and '"isError":true' not in answer.stdout,
            (answer.stdout + answer.stderr).strip()[-600:],
        )


@contextlib.contextmanager
def kept_or_temporary_directory(is_kept):
    if not is_kept:
        with tempfile.TemporaryDirectory(prefix="internkim-install-rig-") as temporary:
            yield temporary
        return
    yield tempfile.mkdtemp(prefix="internkim-install-rig-")


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument(
        "--package-directory",
        default=str(DEFAULT_PACKAGE_DIRECTORY),
        help="the release under test, as `internkim release packages` writes it (default: %(default)s)",
    )
    parser.add_argument(
        "--older-package-directory",
        help="a release built from an earlier commit; it is installed first and step 3 upgrades from it",
    )
    parser.add_argument(
        "--stand-in",
        action="store_true",
        help="build a stand-in package so the rig's own assertions can be exercised before the real one exists",
    )
    parser.add_argument(
        "--distribution",
        choices=sorted(DISTRIBUTIONS),
        default=DEFAULT_DISTRIBUTION,
        help="the release the guest runs (default: %(default)s)",
    )
    parser.add_argument(
        "--without-company",
        action="store_true",
        help="do not give the guest a company, so no local plane is needed; step 5 is reported BLOCKED rather than passed",
    )
    parser.add_argument(
        "--restore-family",
        choices=sorted(FAMILIES),
        default="fedora",
        help="the family of the fresh guest step 6 restores the backup onto (default: %(default)s)",
    )
    parser.add_argument(
        "--agent-update",
        action="store_true",
        help="move to the newer release the way an administrator's host_update does, through admind's socket, "
        "instead of running the line again (step 10 in place of steps 3 and 7)",
    )
    parser.add_argument("--name", default=f"internkim-installrig-{uuid.uuid4().hex[:8]}")
    parser.add_argument("--keep", action="store_true", help="leave the guest running for autopsy")
    parser.add_argument(
        "--kernel",
        default=str(RUNTIME_KERNEL if ARCHITECTURE == "amd64" else KERNEL_IMAGE_PATH),
        help="the guest kernel; INTERNKIM_CONTAINER_KERNEL_PAGE_SIZE=16k tools/prepare-container-kernel builds the CM5's page size (default: %(default)s)",
    )
    options = parser.parse_args()
    if options.agent_update and rig_model_key() == RIG_MODEL_KEY:
        print(
            "✗ native install rig\n"
            "    --agent-update needs a model: the agent reports the update's result in words, and step 10\n"
            "    fails without one. Run it under `monkeys run @test tools/test-native-install ...`.",
            file=sys.stderr,
        )
        return 2

    rig = Rig(options)
    # --keep leaves a guest for autopsy, and a guest whose shared directory has been
    # deleted cannot be driven: every command the rig runs is a script it writes there.
    with kept_or_temporary_directory(options.keep) as temporary:
        rig.working_directory = Path(temporary)
        releases = rig.releases_under_test()
        if not releases:
            print(
                f"✗ native install rig\n"
                f"    No {asset_name('.deb')} under {options.package_directory}.\n"
                f"    Build it with `internkim release packages --format deb --architecture {ARCHITECTURE}`.\n"
                f"    To exercise the rig itself against a stand-in, pass --stand-in.",
                file=sys.stderr,
            )
            return 1

        print(f"the machine: {ARCHITECTURE} {options.distribution}, named {options.name}")
        print(f"under test:  {', '.join(str(directory) for directory in releases)}")
        print(f"pre-seeded:  {', '.join(PRESEEDED_PACKAGES)}, then the package's own Depends:")
        print()

        try:
            rig.package_under_test = releases[0] / asset_name(".deb")
            rig.is_an_upgrade = len(releases) > 1
            rig.prepare_release(releases[0])
            rig.start_machine()
            rig.dependencies = rig.install_declared_dependencies(rig.package_under_test)
            baseline = rig.snapshot()

            step_one = rig.step(1, "one command installs the company host")
            rig.run_step_one(step_one)

            step_two = rig.step(2, "the machine is in the state the package manager would have left it")
            rig.run_step_two(step_two, baseline)

            rig.plant_state()

            step_five = rig.step(5, "a person signs in and exchanges a message")
            revision_before = {}
            if options.stand_in or options.without_company:
                step_five.block(
                    "not run against a stand-in: the package under test carries none of the "
                    "services a company would be given to"
                    if options.stand_in
                    else "not run: --without-company was passed, so no plane issued this guest a company"
                )
            else:
                rig.plane = CompanyPlane(rig.working_directory / "plane", rig.machine.host_gateway())
                rig.plane.start()
                rig.plane.reach_the_record_from(rig.machine)
                rig.give_the_guest_a_company(step_five, rig.plane)
                rig.observe_running_services(step_five)
                observe_a_real_conversion(rig.machine, step_five)
                rig.observe_the_host_holds_the_gateway_socket(step_five)
                rig.observe_the_member_round_trip(step_five, rig.plane, is_watching_for_typing=True)
                rig.observe_the_agent_answered(step_five)
                step_eight = rig.step(8, "a message that arrives before the agent holds the roster is answered once it does")
                rig.observe_a_message_that_arrives_before_the_roster(step_eight, rig.plane)
                revision_before = rig.build_identity_the_guest_reports()

            step_nine = None
            if not options.stand_in and not options.without_company and len(releases) > 1:
                step_nine = rig.step(9, "a backup the older release took comes back on a fresh machine without pgvector")
                rig.take_the_older_backup(step_nine)

            is_an_agent_update = options.agent_update and rig.plane and len(releases) > 1
            if is_an_agent_update:
                step_ten = rig.step(10, "an administrator asks the agent, and the host moves to the newer release and says so")
                rig.run_step_ten(step_ten, releases, rig.plane)
            else:
                step_three = rig.step(3, "running the line again moves it to a newer release")
                rig.run_step_three(step_three, releases)

            if not options.stand_in and not options.without_company:
                if len(releases) > 1 and not is_an_agent_update:
                    step_seven = rig.step(7, "after the upgrade the same person still reaches the agent and hears back")
                    rig.observe_the_upgraded_host_answers(step_seven, rig.plane)
                    rig.observe_the_processes_moved(
                        step_seven, revision_before, rig.build_identity_the_guest_reports()
                    )
                step_six = rig.step(6, f"a backup brings the company back on a fresh {options.restore_family} machine")
                rig.take_a_backup(step_six)

            step_four = rig.step(4, "apt remove and apt purge leave what the plan says they leave")
            rig.run_step_four(step_four)

            if rig.plane:
                rig.restore_elsewhere(step_six, rig.plane, step_nine)
        except RigFailure as failure:
            print(f"✗ native install rig\n    {failure}", file=sys.stderr)
            if not options.keep:
                for machine in (rig.machine, rig.restored_machine):
                    if machine:
                        machine.destroy()
            return 2
        finally:
            if rig.plane:
                if rig.company_id:
                    rig.plane.forget_the_company_computer(rig.company_id)
                rig.plane.stop()
            if rig.release:
                rig.release.stop()

        print(rig.report())
        print()
        if options.keep:
            print(f"the guest is still up: container exec {options.name} bash")
            if rig.restored_machine:
                print(f"the restored guest is still up: container exec {rig.restored_machine.name} bash")
            print(f"its shared directory is {rig.working_directory}")
        else:
            for machine in (rig.machine, rig.restored_machine):
                if machine:
                    machine.destroy()

        passed = rig.verdict()
        print(f"{'✓' if passed else '✗'} native install rig")
        return 0 if passed else 1


if __name__ == "__main__":
    sys.exit(main())
