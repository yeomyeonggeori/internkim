        )
        step.observe(
            "the guest's relay is holding the gateway socket, on a token it obtained itself",
            f"whether GATEWAY_SERVER_KEY is in the environment of the running {RELAY_UNIT_NAME}, "
            "and how many times it has reported the gateway connected",
            "a relay handed a server key reaches /company/<id>/server with no token at all, which "
            "is not the handshake an installed box performs; and the line it prints on open is "
            "reached only after the gateway verified the token the app minted for it",
        ).record(
            reported.get("serverkey") == "0" and int(reported.get("connected") or 0) > 0,
            "\n".join(f"{name}={value}" for name, value in sorted(reported.items()))
            + "\n"
