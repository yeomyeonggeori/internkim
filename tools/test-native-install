    def observe_the_member_round_trip(self, step, plane, is_watching_for_typing=False):
        """A person signs in, says something, and the company answers.

        Everything here goes over the member's own websocket to the gateway,
        authenticated with the access token GoTrue issued them, and is answered
        over the socket the guest's relay is holding. No admin token, no server
        key: the two levers that would reach the company without the handshake
        the installed box performs.
        """
        member_id = plane.member_identity(self.company_id)
        messenger_identity = (
            plane.wait_until_the_member_holds_a_messenger_credential(member_id) if member_id else ""
        )
        bridge_port, bridge_path = MESSENGER_BRIDGE
        bridge = self.wait_in_the_guest(
            BRIDGE_COMMAND % {"port": bridge_port, "path": bridge_path},
            lambda reported: reported.strip().endswith("=200"),
        )
        roster = self.wait_in_the_guest(
            RELAY_ROSTER_COMMAND
            % {"path": MESSENGER_DATABASE_PATH, "pubkey": messenger_identity or "nobody"},
            lambda reported: "roster=yes" in reported,
            timeout_seconds=600,
        )
        session = plane.member_session(
            self.company_id,
            self.message_text,
            TYPING_WAIT_SECONDS if is_watching_for_typing else 0,
        )
        presence = session.get("presence") or {}
        sent = session.get("sent") or {}

        step.observe(
            "a member signing in through the browser path sees the host as connected",
            "the presence frame the gateway sends unasked on a member's own websocket, opened "
            f"with {plane.administrator_email}'s GoTrue access token as the internkim.bearer. subprotocol",
            "a browser cannot put a header on a websocket handshake, so this is the wire a person "
            "is actually on; and presence is the gateway's own account of whether the company's "
            "machine is holding the other half",
        ).record(
            presence.get("isServerConnected") is True,
            f"token alg {session.get('tokenAlgorithm') or 'none'}\n"
            + json.dumps({"presence": presence, "conversation": session.get("conversation")})[:400]
            + (f"\n{session['refused']}" if session.get("refused") else ""),
        )

        message_id = sent.get("messageID") or ""
        self.sent_messages.append((message_id, self.message_text))
        stored = self.machine.shell(
            MESSENGER_STORE_COMMAND
            % {"path": MESSENGER_DATABASE_PATH, "message": message_id or "no-message"}
        )
        step.observe(
            "the message reaches the messenger inside the guest",
            f"the row the message id names in the guest's own event store, read with psql through "
            f"{MESSENGER_DATABASE_PATH}",
            "the answer the member received is the company's account of its own run; this is the "
            "store the company's machine keeps, read on the machine, by a path that did not write it",
        ).record(
            bool(message_id) and self.message_text in stored.stdout,
            (stored.stdout.strip() or "the store holds no such message")[-400:],
        )

        step.observe(
            "the answer comes back through the same socket to the member",
            "the result frame the member's websocket received for the call that posted the message",
            "a message the company stored and never answered for is a person watching a spinner; "
            "the frame is what tells them it landed",
        ).record(
            sent.get("status") == 200 and bool(message_id),
            f"the messenger knows this member as {messenger_identity or 'nobody'}; "
            f"{roster.stdout.strip()}; {bridge.stdout.strip()}\n"
            + json.dumps({"status": sent.get("status"), "messageID": message_id, "body": sent.get("body")})[:500],
        )
        if is_watching_for_typing:
            self.observe_the_agent_typing(step, session, messenger_identity)

    def observe_the_agent_typing(self, step, session, messenger_identity):
        conversation_id = (session.get("conversation") or {}).get("id") or ""
        typing = session.get("typing") or []
        someone_else_typing = [
            event for event in typing if event.get("authorExternalID") not in ("", messenger_identity)
        ]
        step.observe(
            "the member sees the agent typing in the conversation they wrote in",
            f"the typing.started frames the member's own websocket received within {TYPING_WAIT_SECONDS}s "
            "of sending, for that conversation and from anyone but the member",
            "an answer takes a model's time to write, and a person who sees nothing in that time thinks "
            "nobody heard; the frame is what the messenger draws the typing line from",
        ).record(
            bool(someone_else_typing),
            f"conversation {conversation_id or 'none'}, member {messenger_identity or 'nobody'}\n"
            + json.dumps(typing)[:400]
            + "\n"
            + self.machine.shell(
                f"journalctl -u {AGENT_UNIT_NAME} --no-pager -n 400 2>/dev/null | grep -m 5 progress; true"
            ).stdout.strip()[-800:],
        )

