# Whether the relay dialled /company/<id>/host or /company/<id>/server is not
# something either endpoint says out loud, and only the first is a handshake an
# installed box performs. The environment of the running process is where the
# difference lives: with GATEWAY_SERVER_KEY set the relay takes the server door,
# which needs no token at all.
HOST_SOCKET_COMMAND = r"""
pid="$(systemctl show %(unit)s -p MainPID --value 2>/dev/null)"
printf 'serverkey=%%s\n' "$(tr '\0' '\n' < /proc/${pid:-0}/environ 2>/dev/null | grep -c '^GATEWAY_SERVER_KEY=' || true)"
printf 'connected=%%s\n' "$(journalctl -u %(unit)s --no-pager -n 500 2>/dev/null | grep -c 'gateway connected for company %(company)s' || true)"
"""

# The messenger keeps its own store on the company's machine, and a message that
# crossed the gateway is a row in it. Read with the credentials the box wrote for
# the relay, by a path that did not write the row.
MESSENGER_STORE_COMMAND = r"""
url="$(sed -n 's/^DATABASE_URL=//p' %(path)s 2>/dev/null | head -1)"
[ -n "$url" ] || { echo "no DATABASE_URL in %(path)s"; exit 0; }
found="$(psql "$url" -tAc "select encode(pubkey,'hex') || ' ' || content from events where kind = 9 and encode(id,'hex') = '%(message)s'" 2>&1)"
printf '%%s\n' "$found"
case "$found" in
  *ERROR*|"") psql "$url" -tAc "select current_database() || ' as ' || current_user" 2>&1
              psql "$url" -tAc "select table_schema || '.' || table_name from information_schema.tables where table_name in ('events','relay_members','channels')" 2>&1 ;;
esac
"""

# Whether the messenger will take anything this person signs. admind derives
