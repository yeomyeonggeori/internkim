#!/usr/bin/env bash
set -euo pipefail

repositoryRoot="$(cd "$(dirname "$0")/.." && pwd)"
withLocalPlane="$repositoryRoot/tools/with-local-plane"
lockPath="$(sed -n 's/^lockPath="\(.*\)"$/\1/p' "$withLocalPlane")"
lastUsedPath="$(sed -n 's/^lastUsedPath="\(.*\)"$/\1/p' "$withLocalPlane")"
runDirectory="$(mktemp -d)"
fakeState="$runDirectory/state"
fakeBinaries="$runDirectory/bin"
lastUseBeforeTheTest="$runDirectory/last-use-before-the-test"

if [ -z "$lockPath" ] || [ -z "$lastUsedPath" ]; then
  echo "tools/with-local-plane no longer declares a lock path and a last-used path this test can read" >&2
  exit 1
fi

idleStopsWaiting() {
  pgrep -f -- "--stop-when-idle" | sort || true
}

stopTheIdleStopsThisTestStarted() {
  comm -13 "$runDirectory/idle-stops-before-the-test" <(idleStopsWaiting) | xargs kill 2>/dev/null || true
}

restoreTheLastUse() {
  stopTheIdleStopsThisTestStarted
  if [ -e "$lastUseBeforeTheTest" ]; then
    cp "$lastUseBeforeTheTest" "$lastUsedPath"
  else
    rm -f "$lastUsedPath"
  fi
  rm -rf "$runDirectory"
}

if [ -e "$lastUsedPath" ]; then
  cp "$lastUsedPath" "$lastUseBeforeTheTest"
fi
idleStopsWaiting > "$runDirectory/idle-stops-before-the-test"
trap restoreTheLastUse EXIT

mkdir -p "$fakeState" "$fakeBinaries"

cat > "$fakeBinaries/supabase" <<FAKE
#!/usr/bin/env bash
echo "supabase \$*" >> "$fakeState/calls"
case "\$1" in
  status) [ -e "$fakeState/stack" ] ;;
  start) [ -e "$fakeState/docker" ] && touch "$fakeState/stack" ;;
  stop) rm -f "$fakeState/stack" ;;
esac
FAKE

cat > "$fakeBinaries/colima" <<FAKE
#!/usr/bin/env bash
echo "colima \$*" >> "$fakeState/calls"
case "\$1" in
  status) [ -e "$fakeState/docker" ] ;;
  start) touch "$fakeState/docker" ;;
  stop) rm -f "$fakeState/docker" "$fakeState/stack" "$fakeState/other" ;;
esac
FAKE

cat > "$fakeBinaries/docker" <<FAKE
#!/usr/bin/env bash
[ -e "$fakeState/docker" ] || exit 1
case "\$1 \$*" in
  info*) exit 0 ;;
  *status=exited*) exit 0 ;;
  ps*)
    [ -e "$fakeState/stack" ] && echo supabase_db_fake
    [ -e "$fakeState/other" ] && echo other_container
    exit 0 ;;
esac
FAKE

chmod +x "$fakeBinaries"/*
export PATH="$fakeBinaries:$PATH"

unset LOCAL_PLANE_LOCK_HOLDER

failures=0

fail() {
  printf 'FAIL %s\n' "$1" >&2
  failures=$((failures + 1))
}

heldByALivingProcess() {
  local processID
  processID="$(sed -n 1p "$lockPath" 2>/dev/null || true)"
  if [ -z "$processID" ]; then
    return 1
  fi
  kill -0 "$processID" 2>/dev/null
}

isAbandoned() {
  [ -e "$lockPath" ] && ! heldByALivingProcess
}

waitUntilTheFirstCommandHoldsTheLock() {
  local deadline=$(($(date +%s) + 1200))
  while [ ! -e "$runDirectory/first-holding" ]; do
    if [ "$(date +%s)" -ge "$deadline" ]; then
      return 1
    fi
    sleep 0.2
  done
}

"$withLocalPlane" sh -c "touch '$runDirectory/first-holding' && sleep 3" &
firstHolder=$!
if ! waitUntilTheFirstCommandHoldsTheLock; then
  fail "the first command never took the lock"
fi

secondStartedAt="$(date +%s)"
"$withLocalPlane" sh -c 'true' 2> "$runDirectory/second-diagnostics"
secondFinishedAt="$(date +%s)"
wait "$firstHolder" || fail "the first command failed while it held the lock"

secondWaitedSeconds=$((secondFinishedAt - secondStartedAt))
if [ "$secondWaitedSeconds" -lt 1 ]; then
  fail "the second command did not wait for the first, it finished in ${secondWaitedSeconds}s"
fi

if ! grep -q "waiting for the local plane held by .* in $repositoryRoot" "$runDirectory/second-diagnostics"; then
  fail "the second command did not name the holder it waited for"
  cat "$runDirectory/second-diagnostics" >&2
fi

if ! "$withLocalPlane" "$withLocalPlane" sh -c 'true'; then
  fail "a command run inside a command already holding the lock deadlocked"
fi

if isAbandoned; then
  fail "the lock outlived the commands that took it"
fi

"$withLocalPlane" sh -c 'kill -TERM $$' 2> "$runDirectory/killed-diagnostics" && killedStatus=0 || killedStatus=$?
if [ "$killedStatus" -eq 0 ]; then
  fail "a command killed by a signal reported success"
fi
if isAbandoned; then
  fail "the lock outlived a command killed by a signal"
fi

resetFakes() {
  rm -f "$fakeState"/*
  for piece in "$@"; do
    touch "$fakeState/$piece"
  done
}

called() {
  grep -qx "$1" "$fakeState/calls" 2>/dev/null
}

resetFakes
"$withLocalPlane" sh -c "[ -e '$fakeState/stack' ]" 2> /dev/null || fail "a command under the lock ran before the stopped plane was started"
if ! called "colima start"; then
  fail "a command under the lock found docker down and did not start colima"
fi
useToken="$(sed -n 1p "$lastUsedPath" 2>/dev/null || true)"
if [ -z "$useToken" ]; then
  fail "releasing the lock with the plane up recorded no last use"
elif ! pgrep -f -- "--stop-when-idle $useToken" >/dev/null; then
  fail "releasing the lock with the plane up left nothing to stop it once idle"
fi

resetFakes docker stack
printf 'idle\n' > "$lastUsedPath"
"$withLocalPlane" --stop-when-idle idle 0
if [ -e "$fakeState/stack" ] || [ -e "$fakeState/docker" ]; then
  fail "a plane unused since the last release was not stopped"
fi

resetFakes docker stack
printf 'newer\n' > "$lastUsedPath"
"$withLocalPlane" --stop-when-idle idle 0
if called "supabase stop"; then
  fail "a plane used again after the release was stopped anyway"
fi

resetFakes docker stack other
printf 'idle\n' > "$lastUsedPath"
"$withLocalPlane" --stop-when-idle idle 0 > /dev/null
if [ -e "$fakeState/stack" ]; then
  fail "an idle plane beside other containers was not stopped"
fi
if called "colima stop"; then
  fail "colima was stopped under containers that are not the plane"
fi

movedCheckout="$runDirectory/checkout"
mkdir -p "$movedCheckout/tools" "$movedCheckout/supabase"
cp "$withLocalPlane" "$movedCheckout/tools/with-local-plane"
cp "$repositoryRoot/supabase/config.toml" "$movedCheckout/supabase/config.toml"
resetFakes docker stack
printf 'idle\n' > "$lastUsedPath"
"$movedCheckout/tools/with-local-plane" --stop-when-idle idle 2 > /dev/null 2>&1 &
idleStopFromTheRemovedCheckout=$!
until pgrep -P "$idleStopFromTheRemovedCheckout" sleep >/dev/null; do
  sleep 0.1
done
rm -rf "$movedCheckout"
wait "$idleStopFromTheRemovedCheckout" || true
if [ -e "$fakeState/stack" ]; then
  fail "an idle stop left the plane up once the checkout that scheduled it was removed"
fi

if [ "$failures" -ne 0 ]; then
  printf '%s check(s) failed\n' "$failures" >&2
  exit 1
fi

echo "the local plane lock queues concurrent commands and stops an idle plane"
