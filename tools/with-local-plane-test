#!/usr/bin/env bash
set -euo pipefail

repositoryRoot="$(cd "$(dirname "$0")/.." && pwd)"
runDirectory="$(mktemp -d)"
export LOCAL_PLANE_STATE_DIRECTORY="$runDirectory/plane-state"
lockPath="$LOCAL_PLANE_STATE_DIRECTORY/internkim-local-plane.lock"
queuePath="$LOCAL_PLANE_STATE_DIRECTORY/internkim-local-plane.queue"
lastUsedPath="$LOCAL_PLANE_STATE_DIRECTORY/internkim-local-plane.last-used"
mkdir -p "$LOCAL_PLANE_STATE_DIRECTORY"
export LOCAL_PLANE_STOP_TIMEOUT_SECONDS=1
export LOCAL_PLANE_START_TIMEOUT_SECONDS=1
fakeState="$runDirectory/state"
fakeBinaries="$runDirectory/bin"
checkoutRoot="$runDirectory/checkout"
withLocalPlane="$checkoutRoot/tools/with-local-plane"

idleStopsWaiting() {
  pgrep -f -- "--stop-when-idle" | sort || true
}

stopTheIdleStopsThisTestStarted() {
  comm -13 "$runDirectory/idle-stops-before-the-test" <(idleStopsWaiting) | xargs kill 2>/dev/null || true
}

cleanUp() {
  stopTheIdleStopsThisTestStarted
  pkill -f "$fakeBinaries/fake-stack-" 2>/dev/null || true
  rm -rf "$runDirectory"
}

idleStopsWaiting > "$runDirectory/idle-stops-before-the-test"
trap cleanUp EXIT

copyCheckout() {
  mkdir -p "$1/tools" "$1/supabase" "$1/web/scripts"
  cp "$repositoryRoot/tools/with-local-plane" "$1/tools/with-local-plane"
  cp "$repositoryRoot/web/scripts/local-plane-signing-key.sh" "$1/web/scripts/local-plane-signing-key.sh"
  cp "$repositoryRoot/supabase/config.toml" "$1/supabase/config.toml"
}

mkdir -p "$fakeState" "$fakeBinaries"
copyCheckout "$checkoutRoot"

cat > "$fakeBinaries/supabase" <<FAKE
#!/usr/bin/env bash
{ printf 'supabase'; printf ' %q' "\$@"; printf '\n'; } >> "$fakeState/calls"
[ -n "\${SUPABASE_EXPERIMENTAL_STACK:-}" ] && echo "SUPABASE_EXPERIMENTAL_STACK=\$SUPABASE_EXPERIMENTAL_STACK" >> "$fakeState/calls"
[ -n "\${SUPABASE_AUTH_SIGNING_KEYS_PATH:-}" ] && echo "SUPABASE_AUTH_SIGNING_KEYS_PATH=\$SUPABASE_AUTH_SIGNING_KEYS_PATH" >> "$fakeState/calls"
owner=unavailable
[ -e "$fakeState/stack" ] && owner=reachable
storage=running
[ -e "$fakeState/asleep" ] && storage=sleeping
services='[{"service":"storage","state":"'\$storage'"}]'
[ -e "$fakeState/start-hangs" ] && services='[{"service":"db","state":"running"},{"service":"auth","state":"starting"},{"service":"realtime","state":"stopped"}]'
case "\$1 \${2:-}" in
  "--version "*) cat "$fakeState/version" 2>/dev/null || echo 2.119.0 ;;
  "status "*) printf '{"identity":{"id":"fake-stack"},"owner":"%s","services":%s}\n' "\$owner" "\$services" ;;
  "start "*) [ -e "$fakeState/start-hangs" ] && exec sleep 600; touch "$fakeState/stack"; [[ " \$* " == *" --eager "* ]] || touch "$fakeState/asleep" ;;
  "gen signing-key") echo '{"kty":"EC","kid":"fake"}' ;;
  "stack list") cat "$fakeState/stacks.json" 2>/dev/null || echo '{"stacks":[]}' ;;
  "stack stop") [ -e "$fakeState/stop-hangs" ] && exec sleep 600; rm -f "$fakeState/stack" "$fakeState/asleep" ;;
  "stack destroy") rm -f "$fakeState/stack" ;;
esac
FAKE

cat > "$fakeBinaries/fake-stack-host" <<'FAKE'
#!/usr/bin/env bash
"$(dirname "$0")/fake-stack-native" __supabase_stack_native__ -- "supabase-stack-id=$4" &
sleep 600 &
wait
FAKE

cat > "$fakeBinaries/fake-stack-native" <<'FAKE'
#!/usr/bin/env bash
sleep 600 &
wait
FAKE

chmod +x "$fakeBinaries"/*
export PATH="$fakeBinaries:$PATH"

unset LOCAL_PLANE_LOCK_HOLDER

failures=0

fail() {
  printf 'FAIL %s\n' "$1" >&2
  failures=$((failures + 1))
}

resetFakes() {
  rm -f "$fakeState"/*
  for piece in "$@"; do
    touch "$fakeState/$piece"
  done
}

called() {
  grep -qx -- "$1" "$fakeState/calls" 2>/dev/null
}

heldByALivingProcess() {
  local processID
  processID="$(sed -n 1p "$lockPath" 2>/dev/null || true)"
  if [ -z "$processID" ]; then
    return 1
  fi
  kill -0 "$processID" 2>/dev/null
}

isAbandoned() {
  [ -e "$lockPath" ] && ! heldByALivingProcess
}

waitUntilTheFirstCommandHoldsTheLock() {
  local deadline=$(($(date +%s) + 1200))
  while [ ! -e "$runDirectory/first-holding" ]; do
    if [ "$(date +%s)" -ge "$deadline" ]; then
      return 1
    fi
    sleep 0.2
  done
}

resetFakes stack
"$withLocalPlane" sh -c "touch '$runDirectory/first-holding' && sleep 3" &
firstHolder=$!
if ! waitUntilTheFirstCommandHoldsTheLock; then
  fail "the first command never took the lock"
fi

secondStartedAt="$(date +%s)"
"$withLocalPlane" sh -c 'true' 2> "$runDirectory/second-diagnostics"
secondFinishedAt="$(date +%s)"
wait "$firstHolder" || fail "the first command failed while it held the lock"

secondWaitedSeconds=$((secondFinishedAt - secondStartedAt))
if [ "$secondWaitedSeconds" -lt 1 ]; then
  fail "the second command did not wait for the first, it finished in ${secondWaitedSeconds}s"
fi

if ! grep -q "waiting for the local plane held by .* in $checkoutRoot" "$runDirectory/second-diagnostics"; then
  fail "the second command did not name the holder it waited for"
  cat "$runDirectory/second-diagnostics" >&2
fi

finishesWithin() {
  local processID="$1"
  local deadline=$(($(date +%s) + $2))
  while kill -0 "$processID" 2>/dev/null; do
    if [ "$(date +%s)" -ge "$deadline" ]; then
      kill "$processID" 2>/dev/null || true
      wait "$processID" 2>/dev/null || true
      return 1
    fi
    sleep 0.1
  done
}

resetFakes stack
sleep 600 &
openEndedHolder=$!
openEndedWorktree="$runDirectory/demo-worktree"
openEndedCommand="bash -c exec tools/test-native-install --hold --name internkim-demo"
printf '%s\n%s\n%s\n%s\n' "$openEndedHolder" "$openEndedWorktree" "$(($(date +%s) - 36000))" "$openEndedCommand" > "$lockPath"
"$withLocalPlane" sh -c "touch '$runDirectory/ran-behind-an-open-ended-hold'" 2> "$runDirectory/open-ended-diagnostics" &
openEndedWaiter=$!
if ! finishesWithin "$openEndedWaiter" 10; then
  fail "a command waited on a holder that had held the plane for ten hours instead of failing"
elif wait "$openEndedWaiter"; then
  fail "a command behind a holder that had held the plane for ten hours reported success"
fi
if [ -e "$runDirectory/ran-behind-an-open-ended-hold" ]; then
  fail "a command ran on a plane another process still held"
fi
for detail in "held for 10h00m by $openEndedHolder in $openEndedWorktree" "running $openEndedCommand" "pkill -TERM -P $openEndedHolder"; do
  if ! grep -qF -- "$detail" "$runDirectory/open-ended-diagnostics"; then
    fail "a command that refused to wait on an open-ended hold did not say: $detail"
    cat "$runDirectory/open-ended-diagnostics" >&2
  fi
done
if [ "$(sed -n 1p "$lockPath")" != "$openEndedHolder" ]; then
  fail "a command that refused to wait on an open-ended hold took the lock from its holder"
fi
kill "$openEndedHolder"
wait "$openEndedHolder" 2>/dev/null || true
rm -f "$lockPath"
rm -rf "$queuePath"

startedInOrder() {
  local label="$1"
  "$withLocalPlane" sh -c "echo $label >> '$runDirectory/claim-order'" 2> /dev/null &
  waiter=$!
  until grep -qx "$waiter" "$queuePath"/* 2> /dev/null; do
    sleep 0.05
  done
}

for releaseDelay in 0.1 0.5 0.9; do
  resetFakes stack
  rm -f "$runDirectory/claim-order" "$runDirectory/release" "$runDirectory/first-holding"
  rm -rf "$queuePath"
  mkdir -p "$queuePath"
  sh -c 'exit 0' & deadWaiter=$!
  wait "$deadWaiter"
  printf '%s\n' "$deadWaiter" > "$queuePath/000000001"
  "$withLocalPlane" sh -c "touch '$runDirectory/first-holding'; until [ -e '$runDirectory/release' ]; do sleep 0.05; done" &
  holder=$!
  waitUntilTheFirstCommandHoldsTheLock || fail "the holder never took the lock"
  startedInOrder earlier
  earlierWaiter=$waiter
  startedInOrder later
  laterWaiter=$waiter
  sleep "$releaseDelay"
  touch "$runDirectory/release"
  wait "$holder" "$earlierWaiter" "$laterWaiter"
  if [ "$(tr '\n' ' ' < "$runDirectory/claim-order")" != "earlier later " ]; then
    fail "waiters did not claim in arrival order, or a dead waiter blocked the queue, released after ${releaseDelay}s: $(tr '\n' ' ' < "$runDirectory/claim-order")"
  fi
done
rm -rf "$queuePath"
resetFakes stack

if ! "$withLocalPlane" "$withLocalPlane" sh -c 'true'; then
  fail "a command run inside a command already holding the lock deadlocked"
fi

if isAbandoned; then
  fail "the lock outlived the commands that took it"
fi

"$withLocalPlane" sh -c 'kill -TERM $$' 2> "$runDirectory/killed-diagnostics" && killedStatus=0 || killedStatus=$?
if [ "$killedStatus" -eq 0 ]; then
  fail "a command killed by a signal reported success"
fi
if isAbandoned; then
  fail "the lock outlived a command killed by a signal"
fi

resetFakes
printf '2.118.0\n' > "$fakeState/version"
"$withLocalPlane" sh -c "touch '$runDirectory/ran-on-an-old-cli'" 2> "$runDirectory/old-cli-diagnostics" && oldCLIStatus=0 || oldCLIStatus=$?
if [ "$oldCLIStatus" -eq 0 ] || [ -e "$runDirectory/ran-on-an-old-cli" ]; then
  fail "the lock ran a command on a Supabase CLI older than the one it requires"
fi
if ! grep -q "2.119.0 or later" "$runDirectory/old-cli-diagnostics"; then
  fail "the lock refused an old Supabase CLI without naming the version it requires"
fi

signingKeysPath="$checkoutRoot/supabase/.temp/local-signing-keys.json"
resetFakes
"$withLocalPlane" sh -c "[ -e '$fakeState/stack' ]" 2> /dev/null || fail "a command under the lock ran before the stopped plane was started"
if ! called "supabase start --runtime native --eager --output-format text"; then
  fail "the lock found the plane down and did not start it on the native runtime"
fi
if [ "$(python3 -c 'import json, sys; print(json.load(open(sys.argv[1]))[0]["kid"])' "$signingKeysPath" 2>/dev/null)" != "fake" ]; then
  fail "the lock started a plane without writing its signing key as a key set"
fi
if ! called "SUPABASE_AUTH_SIGNING_KEYS_PATH=$signingKeysPath"; then
  fail "the lock started the plane without pointing it at the signing key it wrote"
fi
useToken="$(sed -n 1p "$lastUsedPath" 2>/dev/null || true)"
if [ -z "$useToken" ]; then
  fail "releasing the lock with the plane up recorded no last use"
elif ! pgrep -f -- "--stop-when-idle $useToken fake-stack" >/dev/null; then
  fail "releasing the lock with the plane up left nothing to stop that stack once idle"
fi

otherCheckout="$runDirectory/other-checkout"
unrelatedProject="$runDirectory/unrelated-project"
copyCheckout "$otherCheckout"
mkdir -p "$unrelatedProject/supabase"
printf 'project_id = "unrelated"\n' > "$unrelatedProject/supabase/config.toml"
resetFakes
cat > "$fakeState/stacks.json" <<STACKS
{"stacks": [
  {"id": "own", "project_root": "$checkoutRoot", "branch_context": "", "runtime": "native"},
  {"id": "other-checkout", "project_root": "$otherCheckout", "branch_context": "refs/heads/other", "runtime": "native"},
  {"id": "removed-checkout", "project_root": "$runDirectory/removed", "branch_context": "refs/heads/gone", "runtime": "docker"},
  {"id": "unrelated", "project_root": "$unrelatedProject", "branch_context": "refs/heads/main", "runtime": "docker"}
]}
STACKS
"$withLocalPlane" true 2> /dev/null
if ! called "supabase stack stop --stack-id other-checkout --output-format text"; then
  fail "the lock left another checkout's stack holding the plane's ports"
fi
if called "supabase stack destroy --stack-id other-checkout --yes --output-format text"; then
  fail "the lock destroyed the data of a stack that belongs to a checkout that still exists"
fi
if ! called "supabase stack destroy --stack-id removed-checkout --yes --output-format text"; then
  fail "the lock left a removed checkout's stack holding the plane's ports"
fi
if called "supabase stack destroy --stack-id own --yes --output-format text"; then
  fail "the lock destroyed the stack of the checkout it runs from"
fi
if called "supabase stack destroy --stack-id unrelated --yes --output-format text"; then
  fail "the lock destroyed a stack of a project that is not this repository"
fi

startWedgedStack() {
  ("$fakeBinaries/fake-stack-host" __supabase_stack_host__ "$runDirectory/stacks" "$runDirectory/cache" "$1" > /dev/null 2>&1 &)
  local deadline=$(($(date +%s) + 10))
  until pgrep -f "^sleep 600" -P "$(pgrep -f "supabase-stack-id=$1" | head -1)" > /dev/null 2>&1; do
    if [ "$(date +%s)" -ge "$deadline" ]; then
      return 1
    fi
    sleep 0.05
  done
}

processesOfTheWedgedStack() {
  local host native
  host="$(pgrep -f "__supabase_stack_host__ .* $1\$" || true)"
  native="$(pgrep -f "supabase-stack-id=$1" || true)"
  printf '%s\n' $host $native
  for parent in $host $native; do
    pgrep -P "$parent" || true
  done
}

resetFakes stop-hangs
cat > "$fakeState/stacks.json" <<STACKS
{"stacks": [
  {"id": "wedged-stack", "project_root": "$otherCheckout", "branch_context": "refs/heads/other", "runtime": "native"}
]}
STACKS
startWedgedStack wedged-stack || fail "the fake wedged stack never started"
wedgedProcesses="$(processesOfTheWedgedStack wedged-stack | sort -u | tr '\n' ' ')"
"$withLocalPlane" sh -c "touch '$runDirectory/ran-past-a-wedged-stack'" 2> "$runDirectory/wedged-diagnostics" && wedgedStatus=0 || wedgedStatus=$?
if [ "$wedgedStatus" -ne 0 ] || [ ! -e "$runDirectory/ran-past-a-wedged-stack" ]; then
  fail "a stack whose stop hangs failed an unrelated command"
  cat "$runDirectory/wedged-diagnostics" >&2
fi
for processIdentifier in $wedgedProcesses; do
  if kill -0 "$processIdentifier" 2>/dev/null; then
    fail "process $processIdentifier of a stack whose stop hung was left running"
  fi
done
reclaimLine="$(grep "^RECLAIMED the local plane stack wedged-stack of $otherCheckout: .* killed (" "$runDirectory/wedged-diagnostics" || true)"
for processIdentifier in $wedgedProcesses; do
  if [[ "$reclaimLine" != *"$processIdentifier "* ]]; then
    fail "reclaiming a stack whose stop hung did not name process $processIdentifier among what it killed"
    cat "$runDirectory/wedged-diagnostics" >&2
  fi
done

resetFakes start-hangs
"$withLocalPlane" sh -c "touch '$runDirectory/ran-on-an-unready-plane'" 2> "$runDirectory/unready-diagnostics" && unreadyStatus=0 || unreadyStatus=$?
if [ "$unreadyStatus" -eq 0 ] || [ -e "$runDirectory/ran-on-an-unready-plane" ]; then
  fail "the lock ran a command on a plane that never became ready"
fi
if ! grep -q "not ready: auth (starting), realtime (stopped)" "$runDirectory/unready-diagnostics"; then
  fail "the lock gave up on a plane that never became ready without naming the services that were not"
  cat "$runDirectory/unready-diagnostics" >&2
fi
if isAbandoned || [ -e "$lockPath" ]; then
  fail "the lock outlived a plane that never became ready"
fi

resetFakes stack
cat > "$fakeState/stacks.json" <<STACKS
{"stacks": [
  {"id": "own-on-docker", "project_root": "$checkoutRoot", "branch_context": "", "runtime": "docker"}
]}
STACKS
"$withLocalPlane" true 2> /dev/null
if ! called "supabase stack destroy --stack-id own-on-docker --yes --output-format text"; then
  fail "the lock reused a stack of its own checkout recorded on a runtime other than native"
fi
if ! called "supabase start --runtime native --eager --output-format text"; then
  fail "the lock destroyed a stack on another runtime and did not start a native one"
fi

resetFakes stack asleep
"$withLocalPlane" true 2> /dev/null
if ! called "supabase stack stop --stack-id fake-stack --output-format text"; then
  fail "the lock ran a command on a plane whose services sleep until a request wakes them"
fi
if ! called "supabase start --runtime native --eager --output-format text"; then
  fail "the lock stopped a sleeping plane and did not start it with every service awake"
fi

resetFakes stack
"$withLocalPlane" true 2> /dev/null
if called "supabase stack stop --stack-id fake-stack --output-format text"; then
  fail "the lock restarted a plane whose services were all awake"
fi

resetFakes stack
printf 'idle\n' > "$lastUsedPath"
"$withLocalPlane" --stop-when-idle idle fake-stack 0 > /dev/null 2>&1
if [ -e "$fakeState/stack" ]; then
  fail "a plane unused since the last release was not stopped"
fi
if ! called "SUPABASE_EXPERIMENTAL_STACK=1"; then
  fail "the idle stop asked for a stack without enabling the CLI's stack commands"
fi

resetFakes stack
printf 'newer\n' > "$lastUsedPath"
"$withLocalPlane" --stop-when-idle idle fake-stack 0
if called "supabase stack stop --stack-id fake-stack --output-format text"; then
  fail "a plane used again after the release was stopped anyway"
fi

movedCheckout="$runDirectory/moved-checkout"
copyCheckout "$movedCheckout"
resetFakes stack
printf 'idle\n' > "$lastUsedPath"
"$movedCheckout/tools/with-local-plane" --stop-when-idle idle fake-stack 2 > /dev/null 2>&1 &
idleStopFromTheRemovedCheckout=$!
until pgrep -P "$idleStopFromTheRemovedCheckout" sleep >/dev/null; do
  sleep 0.1
done
rm -rf "$movedCheckout"
wait "$idleStopFromTheRemovedCheckout" || true
if [ -e "$fakeState/stack" ]; then
  fail "an idle stop left the plane up once the checkout that scheduled it was removed"
fi

if [ "$failures" -ne 0 ]; then
  printf '%s check(s) failed\n' "$failures" >&2
  exit 1
fi

echo "the local plane lock queues concurrent commands, starts the native stack with every service awake and stops it when idle"
