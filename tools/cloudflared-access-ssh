#!/usr/bin/env python3
"""ProxyCommand for reaching the company host over Cloudflare Access with a service token.

A service token needs no browser. Its two halves live in the @host vault
profile, beside the hostname they admit. ssh starts this with whatever
environment it holds, so without the token in the environment it re-executes
itself under `monkeys run @host`:

    ssh -o ProxyCommand='tools/cloudflared-access-ssh %h' internkim@<hostname>

`internkim @host ssh` passes the same ProxyCommand. With no token it stops and
says which key is missing. It never starts `cloudflared access ssh` without one,
because that opens a browser sign-in.
"""
import os
import pathlib
import shutil
import sys

repositoryRoot = pathlib.Path(__file__).resolve().parent.parent
tokenProfile = "host"
clientIDVariable = "INTERNKIM_CF_ACCESS_CLIENT_ID"
clientSecretVariable = "INTERNKIM_CF_ACCESS_CLIENT_SECRET"
vaultMarker = "INTERNKIM_ENVIRONMENT_FROM_VAULT"


def refuse(reason):
    print(f"cloudflared-access-ssh: {reason}", file=sys.stderr)
    raise SystemExit(1)


def heldToken():
    clientID = os.environ.get("INTERNKIM_CF_ACCESS_CLIENT_ID", "").strip()
    clientSecret = os.environ.get("INTERNKIM_CF_ACCESS_CLIENT_SECRET", "").strip()
    if clientID and clientSecret:
        return clientID, clientSecret
    return None


def monkeysPath():
    found = shutil.which("monkeys") or str(pathlib.Path.home() / ".local/bin/monkeys")
    return found if pathlib.Path(found).exists() else None


def runUnderTheTokenProfile():
    monkeys = monkeysPath()
    if monkeys is None:
        refuse(f"no {clientIDVariable} in the environment and no monkeys to fetch it from @{tokenProfile}")
    os.environ[vaultMarker] = tokenProfile
    os.chdir(repositoryRoot)
    os.execvpe(monkeys, [
        "monkeys", "run", f"@{tokenProfile}", sys.executable, str(pathlib.Path(__file__).resolve()), *sys.argv[1:],
    ], os.environ)


if len(sys.argv) < 2:
    raise SystemExit("usage: cloudflared-access-ssh <hostname>")
hostname = sys.argv[1]

token = heldToken()
if token is None and os.environ.get(vaultMarker) != tokenProfile:
    runUnderTheTokenProfile()
if token is None:
    refuse(
        f"@{tokenProfile} holds no {clientIDVariable} and {clientSecretVariable}; "
        "create a service token in Cloudflare Zero Trust and remember both halves there"
    )

clientID, clientSecret = token
os.execvp("cloudflared", [
    "cloudflared", "access", "ssh", "--hostname", hostname,
    "--service-token-id", clientID, "--service-token-secret", clientSecret,
])
