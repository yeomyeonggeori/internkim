#!/usr/bin/env python3
"""ProxyCommand for reaching the Jetson over Cloudflare Access with its service token.

A service token lasts a year and needs no browser. It lives in the @production
vault profile.

ssh starts this with whatever environment it holds, so this re-executes itself
under `monkeys run @production` to be handed the token:

    Host 0.ssh.*.intern.kim 1.ssh.*.intern.kim
      ProxyCommand /path/to/tools/cloudflared-access-ssh %h

With no token it stops and says which key is missing. It never starts
`cloudflared access ssh` without one, because that opens a browser sign-in.
"""
import os
import pathlib
import shutil
import sys

repositoryRoot = pathlib.Path(__file__).resolve().parent.parent
tokenProfile = "production"
vaultMarker = "INTERNKIM_ENVIRONMENT_FROM_VAULT"


def refuse(reason):
    print(f"cloudflared-access-ssh: {reason}", file=sys.stderr)
    raise SystemExit(1)


def heldToken():
    clientID = os.environ.get("INTERNKIM_CF_ACCESS_CLIENT_ID", "").strip()
    clientSecret = os.environ.get("INTERNKIM_CF_ACCESS_CLIENT_SECRET", "").strip()
    if clientID and clientSecret:
        return clientID, clientSecret
    return None


def monkeysPath():
    found = shutil.which("monkeys") or str(pathlib.Path.home() / ".local/bin/monkeys")
    return found if pathlib.Path(found).exists() else None


def runUnderTheTokenProfile():
    monkeys = monkeysPath()
    if monkeys is None:
        refuse(f"no INTERNKIM_CF_ACCESS_CLIENT_ID in the environment and no monkeys to fetch it from @{tokenProfile}")
    os.environ[vaultMarker] = tokenProfile
    os.chdir(repositoryRoot)
    os.execvpe(monkeys, [
        "monkeys", "run", f"@{tokenProfile}", sys.executable, str(pathlib.Path(__file__).resolve()), *sys.argv[1:],
    ], os.environ)


if len(sys.argv) < 2:
    raise SystemExit("usage: cloudflared-access-ssh <hostname>")
hostname = sys.argv[1]

token = heldToken()
if token is None and os.environ.get(vaultMarker) != tokenProfile:
    runUnderTheTokenProfile()
if token is None:
    refuse(
        f"@{tokenProfile} holds no INTERNKIM_CF_ACCESS_CLIENT_ID and INTERNKIM_CF_ACCESS_CLIENT_SECRET"
    )

clientID, clientSecret = token
os.execvp("cloudflared", [
    "cloudflared", "access", "ssh", "--hostname", hostname,
    "--service-token-id", clientID, "--service-token-secret", clientSecret,
])
