#!/usr/bin/env python3
import argparse
import json
from pathlib import Path


def generated_files(repository):
    source = repository / "web/src/lib/data-room/template.json"
    template = json.loads(source.read_text())
    encoded = json.dumps(template, ensure_ascii=False, separators=(",", ":"))
    migration = "\n".join([
        "create function internal.data_room_template()",
        "returns jsonb language sql immutable set search_path = ''",
        "as $template$ select $json$" + encoded + "$json$::jsonb; $template$;",
        "revoke all on function internal.data_room_template() from public, anon, authenticated;",
        "",
    ])
    return {
        repository / "supabase/migrations/20261003000006_data_room_template.sql": migration,
        repository / ".dependency/internkim-plugin/skills/dataroom/assets/template.json": source.read_text(),
        repository / ".dependency/internkim-plugin/skills/dataroom/references/domains.md": template_reference(template),
        repository / "docs/data-room/layout.mdx": template_reference(template, "en", True),
        repository / "docs/data-room/layout.ko.mdx": template_reference(template, "ko", True),
    }


def template_reference(template, language="en", is_document=False):
    is_korean = language == "ko"
    title = "분류와 기본 역할" if is_korean else "Categories and default roles"
    lines = ["---", f"title: {title}", "---", ""] if is_document else []
    lines += ["문서는 업무 목적에 따라 중분류 또는 X에 보관합니다. 대분류 권한은 이후 추가되는 하위 분류도 포함합니다." if is_korean
              else "File by business function in an intermediate category or X. A parent grant includes current and future children.", "",
              "| Code | Category | Parent | Scope |", "|---|---|---|---|"]
    for category in template["categories"]:
        name = category["nameKO"] if is_korean else category["name"]
        lines.append(f'| `{category["code"]}-{category["slug"]}` | {name} | {category["parent"] or "—"} | {category["description"]} |')
    lines += ["", "## 기본 역할" if is_korean else "## Default roles", "",
              "읽기 범위는 역할별 코드 배열입니다. 여러 역할을 받으면 범위를 합칩니다. 커스텀 역할을 추가하거나 기본 역할을 편집할 수 있습니다." if is_korean
              else "Each reader role names an array of category codes. Multiple grants combine. Add custom roles or edit these defaults.", "",
              "| Role | Name | readableCategories |", "|---|---|---|"]
    for role in template["roles"]:
        name = role["nameKO"] if is_korean else role["name"]
        codes = ", ".join(role["readableCategories"])
        lines.append(f'| `{role["code"]}` | {name} | [{codes}] |')
    return "\n".join(lines) + "\n"


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--check", action="store_true")
    arguments = parser.parse_args()
    repository = Path(__file__).resolve().parent.parent
    stale = []
    for destination, content in generated_files(repository).items():
        if destination.exists() and destination.read_text() == content:
            continue
        if arguments.check:
            stale.append(str(destination.relative_to(repository)))
            continue
        destination.parent.mkdir(parents=True, exist_ok=True)
        destination.write_text(content)
    if stale:
        raise SystemExit("Regenerate the data room template: " + ", ".join(stale))


if __name__ == "__main__":
    main()
