#!/usr/bin/env python3
import argparse
import json
from pathlib import Path


# An applied migration is never edited, so a template change is written to a
# new migration and this path moves to it.
TEMPLATE_MIGRATION = "supabase/migrations/20261004000006_the_data_room_template_names_circles.sql"


def generated_files(repository):
    source = repository / "web/src/lib/data-room/template.json"
    template = json.loads(source.read_text())
    encoded = json.dumps(template, ensure_ascii=False, separators=(",", ":"))
    migration = "\n".join([
        "create or replace function internal.data_room_template()",
        "returns jsonb language sql immutable set search_path = ''",
        "as $template$ select $json$" + encoded + "$json$::jsonb; $template$;",
        "revoke all on function internal.data_room_template() from public, anon, authenticated;",
        "",
    ])
    return {
        repository / TEMPLATE_MIGRATION: migration,
        repository / ".dependency/internkim-plugin/skills/dataroom/assets/template.json": source.read_text(),
        repository / ".dependency/internkim-plugin/skills/dataroom/references/domains.md": template_reference(template),
        repository / "docs/data-room/layout.mdx": template_reference(template, "en", True),
        repository / "docs/data-room/layout.ko.mdx": template_reference(template, "ko", True),
    }


def template_reference(template, language="en", is_document=False):
    is_korean = language == "ko"
    title = "분류와 기본 서클" if is_korean else "Categories and default circles"
    lines = ["---", f"title: {title}", "---", ""] if is_document else []
    lines += ["문서는 업무 목적에 따라 하위 분류가 없는 분류 또는 X에 보관합니다. 중분류가 없는 대분류도 선택할 수 있습니다. 대분류 권한은 이후 추가되는 하위 분류도 포함합니다." if is_korean
              else "File by business function in a category without children or X. A parent without children is a filing destination. A parent grant includes current and future children.", "",
              "| Code | Category | Parent | Scope |", "|---|---|---|---|"]
    for category in template["categories"]:
        name = category["nameKO"] if is_korean else category["name"]
        lines.append(f'| `{category["code"]}` | {name} | {category["parent"] or "—"} | {category["description"]} |')
    lines += ["", "## 기본 서클" if is_korean else "## Default circles", "",
              "읽기 범위는 서클별 코드 배열입니다. 여러 서클에 속하면 범위를 합칩니다. 서클을 새로 만들거나 기본 서클을 편집할 수 있습니다." if is_korean
              else "Each circle names an array of category codes. Belonging to several circles combines them. Add circles or edit these defaults.", "",
              "| Circle | Name | readableCategories |", "|---|---|---|"]
    for circle in template["circles"]:
        name = circle["nameKO"] if is_korean else circle["name"]
        codes = ", ".join(circle["readableCategories"])
        lines.append(f'| `{circle["id"]}` | {name} | [{codes}] |')
    return "\n".join(lines) + "\n"


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--check", action="store_true")
    arguments = parser.parse_args()
    repository = Path(__file__).resolve().parent.parent
    stale = []
    for destination, content in generated_files(repository).items():
        if destination.exists() and destination.read_text() == content:
            continue
        if arguments.check:
            stale.append(str(destination.relative_to(repository)))
            continue
        destination.parent.mkdir(parents=True, exist_ok=True)
        destination.write_text(content)
    if stale:
        raise SystemExit("Regenerate the data room template: " + ", ".join(stale))


if __name__ == "__main__":
    main()
