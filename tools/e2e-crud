#!/usr/bin/env bash
# Reproducible real end-to-end CRUD verification against a live 김인턴 on a fleet VM.
# Each case posts a real Mattermost message, a live model executes it, and we assert
# the real task outcome (capability/tool actually succeeded) plus record the step
# count (fewer steps scores higher). Evidence is saved under e2e-evidence/.
#
# Usage: tools/e2e-crud [case-name-filter]
#   Bring up a fleet first, e.g.: internkim test --keep "warmup" (leaves the VM up).
#   INTERNKIM_E2E_CONFIG overrides the fleet run config path.
set -uo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
FILTER="${1:-}"
CFG="${INTERNKIM_E2E_CONFIG:-$(ls -dt "$ROOT"/.local/local-fleet/runs/*/config.json 2>/dev/null | head -1)}"
[ -n "${CFG:-}" ] && [ -f "$CFG" ] || { echo "no fleet run config found; bring up a fleet (internkim test --keep ...) first" >&2; exit 1; }

vmssh() { "$ROOT/internkim" lab vm-ssh --config "$CFG" "$@" 2>/dev/null; }
shell_quote() { printf "%q" "$1"; }
remote() { vmssh "bash -s -- $*" < "$ROOT/tools/e2e-crud-remote.sh" | tail -1; }
remote_command() {
	local command="" argument
	for argument in "$@"; do
		command="$command $(shell_quote "$argument")"
	done
	remote "${command# }"
}

VMIP="$("$ROOT/internkim" lab vm-ip --config "$CFG" 2>/dev/null | tail -1)"
MM_URL="http://$VMIP:8065"
ADMIN_PASS="$(vmssh 'sudo cat /root/.internkim/secrets/mm-admin-pass' | tail -1)"
EVID="$ROOT/e2e-evidence"; mkdir -p "$EVID"

MODEL="${INTERNKIM_E2E_MODEL:-xiaomi/mimo-v2.5}"
echo "fleet: $CFG"
echo "mattermost: $MM_URL"
echo "model: $MODEL"
RUN_NONCE="${INTERNKIM_E2E_NONCE:-$(date +%H%M%S)}"
echo "run id: $RUN_NONCE (fresh person + channel)"
SETUP="$(vmssh "E2E_NONCE='$RUN_NONCE' E2E_SKIP_RESET='${INTERNKIM_E2E_SKIP_RESET:-}' bash -s setup" < "$ROOT/tools/e2e-crud-remote.sh" | tail -1)"
CH="$(echo "$SETUP" | jq -r '.channelID')"
TOK="$(echo "$SETUP" | jq -r '.e2eToken')"
CHNAME="$(echo "$SETUP" | jq -r '.channelName')"
REQUESTER_USER="$(echo "$SETUP" | jq -r '.e2eUsername')"
REQUESTER_PASS="$(echo "$SETUP" | jq -r '.e2ePassword')"
[ -n "$CH" ] && [ "$CH" != null ] && [ -n "$TOK" ] && [ "$TOK" != null ] || { echo "setup failed: $SETUP" >&2; exit 1; }
if [ "${INTERNKIM_E2E_SKIP_MODEL:-}" = 1 ]; then
	echo "skipping model pin (already set)"
else
	echo "pinning model (restarts blueclaw)..."
	remote_command set-model "$MODEL" >/dev/null
fi
INGRESS_READY_SECONDS="${INTERNKIM_E2E_INGRESS_READY_SECONDS:-12}"
if [ "$INGRESS_READY_SECONDS" -gt 0 ] 2>/dev/null; then
	echo "waiting ${INGRESS_READY_SECONDS}s for Mattermost ingress..."
	sleep "$INGRESS_READY_SECONDS"
fi

# name|prompt|expected_op|timeout — natural language; ordered so add precedes update/delete.
# A fresh e2e person+channel per run keeps state clean, so entities resolve by natural
# description (e.g. "주간보고서 업무 삭제") without injecting internal IDs into prompts.
CASES=(
	"task-add|내 주간보고서 작성 업무 추가해줘|task.add|220"
	"task-query|내 업무 목록 보여줘|task.list|220"
	"task-update|내 주간보고서 업무 진행 중으로 바꿔줘|task.update|220"
	"task-delete|내 주간보고서 업무 삭제해줘|task.delete|220"
	"calendar-add|7월 13일 오후 2시에 샨보장이랑 미팅 일정 잡아줘|calendar.add|220"
	"calendar-query|이번 달 내 일정 보여줘|calendar.list|220"
	"calendar-update|샨보장 미팅을 7월 14일로 옮겨줘|calendar.update|220"
	"calendar-delete|샨보장 미팅 일정 삭제해줘|calendar.delete|220"
	"docx-create|회의록 Word 문서(.docx)로 만들어줘 내용은 안건 3개 간단히|file.deliver|320"
	"docx-edit|방금 만든 회의록 Word 문서에 결정사항 항목 추가해줘|file.deliver|320"
	"docx-delete|회의록 Word 문서 삭제해줘|file.delete|220"
	"pdf-create|행사 안내 PDF 문서 만들어줘 내용은 일정 3개 간단히|file.deliver|320"
	"pdf-edit|방금 만든 행사 안내 PDF에 장소 항목 추가해줘|file.deliver|320"
	"pdf-delete|행사 안내 PDF 문서 삭제해줘|file.delete|220"
	"xlsx-create|예산 엑셀 스프레드시트 만들어줘 항목 3개 간단히|file.deliver|320"
	"xlsx-edit|방금 만든 예산 엑셀에 합계 행 추가해줘|file.deliver|320"
	"xlsx-delete|예산 엑셀 삭제해줘|file.delete|220"
	"schedule-add|매주 월요일 오전 9시에 주간보고 리마인드 예약해줘|schedule.create|260"
	"schedule-update|주간보고 리마인드를 화요일로 바꿔줘|schedule.update|260"
	"schedule-delete|주간보고 리마인드 예약 삭제해줘|schedule.cancel|220"
	"site-create|테스트 ID IK-SITE-CRUD-$RUN_NONCE. 먼저 빈 입력으로 site.status를 확인하고 status가 not_found이면 site.create에서 slug local-fleet-studio-$RUN_NONCE 로 새 사이트를 만들어줘. 기존 사이트는 삭제하거나 덮어쓰지 마. 'Local Fleet Studio $RUN_NONCE'라는 단일 페이지 회사 소개 웹사이트를 배포해줘. 첫 화면 제목은 'Local Fleet Studio $RUN_NONCE', 보조 문구는 '로컬 플릿 웹사이트 CRUD 테스트', 섹션은 서비스 소개, 장점 3개, 문의 CTA만 넣어줘. 추가 질문하지 말고 합리적인 기본값으로 진행해줘.|site.create|600"
	"site-edit|테스트 ID IK-SITE-CRUD-$RUN_NONCE. 방금 배포한 'Local Fleet Studio $RUN_NONCE' 웹사이트의 첫 화면 제목을 'Local Fleet Studio $RUN_NONCE 수정됨'으로 바꾸고 보조 문구 '재배포 확인 문구 $RUN_NONCE'를 추가한 뒤 같은 사이트를 다시 배포해줘. 새 사이트는 만들지 마.|site.publish|600"
	"site-delete|테스트 ID IK-SITE-CRUD-$RUN_NONCE. 방금 배포한 'Local Fleet Studio $RUN_NONCE' 테스트 웹사이트를 삭제해줘. 삭제 확인을 물으면 승인할게.|site.delete|260"
	"dm-send|길동이한테 회의 잘 부탁한다고 메시지 보내줘|message.send|220"
)

screenshot() { # case-name png-path
	# Headed by default so the run is watchable; set INTERNKIM_E2E_HEADLESS=1 to hide it.
	local headed=--headed; [ "${INTERNKIM_E2E_HEADLESS:-}" = 1 ] && headed=
	# Log in as the requester so requester-only ephemeral approval buttons are visible.
	(cd "$ROOT/web" && \
		INTERNKIM_MATTERMOST_URL="$MM_URL" INTERNKIM_ADMIN_EMAIL="$REQUESTER_USER" INTERNKIM_ADMIN_PASSWORD="$REQUESTER_PASS" \
		INTERNKIM_MATTERMOST_TEAM_NAME="internkim" INTERNKIM_CRUD_CHANNEL="$CHNAME" INTERNKIM_CRUD_SCREENSHOT="$2" \
		bunx playwright test tests/e2e/crud-evidence.spec.ts $headed >/dev/null 2>&1) || true
}

site_screenshot() { # case-name public-url png-path
	[ -n "$2" ] || return 1
	local headed=--headed; [ "${INTERNKIM_E2E_HEADLESS:-}" = 1 ] && headed=
	(cd "$ROOT/web" && \
		INTERNKIM_PUBLIC_URL="$2" INTERNKIM_SITE_SCREENSHOT="$3" \
		bunx playwright test tests/e2e/site-evidence.spec.ts $headed >/dev/null 2>&1)
}

decode_base64_to_path() { # base64 path
	local encoded_file
	encoded_file="$(mktemp)"
	printf "%s" "$1" > "$encoded_file"
	if base64 --decode < "$encoded_file" > "$2" 2>/dev/null; then
		rm -f "$encoded_file"
		return 0
	fi
	if base64 -D < "$encoded_file" > "$2" 2>/dev/null; then
		rm -f "$encoded_file"
		return 0
	fi
	rm -f "$encoded_file" "$2"
	return 1
}

evidence_filename() { # case-name filename
	local filename
	filename="$(basename "$2")"
	[ -n "$filename" ] && [ "$filename" != "." ] || filename="$1-file"
	printf "%s-%s" "$1" "$filename"
}

save_downloaded_files() { # case-name result-json
	local name="$1" result="$2" file_json filename content_base64 output
	local saved_files=()
	while IFS= read -r file_json; do
		filename="$(printf "%s" "$file_json" | jq -r '.filename // .fileID // "file"')"
		content_base64="$(printf "%s" "$file_json" | jq -r '.contentBase64 // ""')"
		[ -n "$content_base64" ] || continue
		output="$EVID/$(evidence_filename "$name" "$filename")"
		decode_base64_to_path "$content_base64" "$output" || continue
		saved_files+=("$(basename "$output")")
	done < <(printf "%s" "$result" | jq -c '.downloadedFiles[]?')
	local IFS=,
	printf "%s" "${saved_files[*]-}"
}

requires_site_screenshot() { # case-name
	[ "$1" = site-create ] || [ "$1" = site-edit ]
}

requires_downloaded_file() { # case-name
	[ "$1" = docx-create ] || [ "$1" = pdf-create ] || [ "$1" = xlsx-create ]
}

evidence_list() { # mattermost-png site-png downloaded-file-list
	local mattermost_png="$1" site_png="$2" downloaded_files="$3" files=() file
	local downloaded_file_array=()
	[ -f "$mattermost_png" ] && files+=("$(basename "$mattermost_png")")
	[ -n "$site_png" ] && [ -f "$site_png" ] && files+=("$(basename "$site_png")")
	if [ -n "$downloaded_files" ]; then
		IFS=',' read -ra downloaded_file_array <<< "$downloaded_files"
		for file in "${downloaded_file_array[@]}"; do
			[ -n "$file" ] && files+=("$file")
		done
	fi
	if [ "${#files[@]}" -eq 0 ]; then
		printf "(no evidence)"
		return
	fi
	local IFS=,
	printf "%s" "${files[*]}"
}

score_for() { # passed steps -> score
	[ "$1" = true ] || { echo 0; return; }
	local s="$2"; [ "$s" -lt 2 ] 2>/dev/null && { echo 100; return; }
	local v=$((100 - (s - 2) * 8)); [ "$v" -lt 0 ] && v=0; echo "$v"
}

PASS=0; TOTAL=0; TOTAL_SCORE=0
printf "\n%-16s %-7s %6s %6s  %s\n" CASE OUTCOME STEPS SCORE EVIDENCE
printf -- "------------------------------------------------------------\n"
matches_filter() { # case-name -- FILTER may be a comma-separated list of substrings; empty runs all
	[ -z "$FILTER" ] && return 0
	local part
	IFS=',' read -ra parts <<< "$FILTER"
	for part in "${parts[@]}"; do
		[ -n "$part" ] && [[ "$1" == *"$part"* ]] && return 0
	done
	return 1
}

for entry in "${CASES[@]}"; do
	IFS='|' read -r name prompt op timeout <<< "$entry"
	matches_filter "$name" || continue
	TOTAL=$((TOTAL + 1))
	res="$(remote_command run-case "$CH" "$TOK" "$prompt" "$op" "$timeout")"
	status="$(echo "$res" | jq -r '.status // "error"')"
	reason="$(echo "$res" | jq -r '.reason // ""')"
	if [ "$status" != completed ] && echo "$reason" | grep -qiE "429|rate.?limit|timeout|HTTP 5[0-9][0-9]|context deadline"; then
		sleep 45
		res="$(remote_command run-case "$CH" "$TOK" "$prompt" "$op" "$timeout")"
		status="$(echo "$res" | jq -r '.status // "error"')"
	fi
	steps="$(echo "$res" | jq -r '.steps // 0')"
	opok="$(echo "$res" | jq -r '.opOk // false')"
	png="$EVID/$name.png"; rm -f "$png"; screenshot "$name" "$png"
	public_url="$(echo "$res" | jq -r '.publicURL // ""')"
	site_png=""
	if requires_site_screenshot "$name"; then
		site_png="$EVID/$name-site.png"; rm -f "$site_png"
		site_screenshot "$name" "$public_url" "$site_png" || rm -f "$site_png"
	fi
	downloaded_files="$(save_downloaded_files "$name" "$res")"
	passed=false
	if [ "$status" = completed ] && [ "$opok" = true ]; then
		passed=true
		requires_site_screenshot "$name" && [ ! -f "$site_png" ] && passed=false
		requires_downloaded_file "$name" && [ -z "$downloaded_files" ] && passed=false
	fi
	score="$(score_for "$passed" "$steps")"
	[ "$passed" = true ] && PASS=$((PASS + 1))
	TOTAL_SCORE=$((TOTAL_SCORE + score))
	printf "%-16s %-7s %6s %6s  %s\n" "$name" "$([ "$passed" = true ] && echo PASS || echo FAIL)" "$steps" "$score" "$(evidence_list "$png" "$site_png" "$downloaded_files")"
	sleep "${INTERNKIM_E2E_PACE_SECONDS:-40}"
done
printf -- "------------------------------------------------------------\n"
printf "passed %d/%d   total score %d\n\n" "$PASS" "$TOTAL" "$TOTAL_SCORE"
[ "$PASS" = "$TOTAL" ]
