PASS = "✓"
FAIL = "✗"

INSTALL_LINE_URL = "https://intern.kim/install.sh"
PUBLISHED_BASE_URL = "https://updates.intern.kim"
APT_SOURCE_PATH = "/etc/apt/sources.list.d/internkim.sources"
SIGNATURE_NAMES = ("InRelease", "Release.gpg")

# Cloudflare answers 403 to a request that names no client, and python's default
# does not; apt and curl do, which is why they are served and this was not.
RIG_USER_AGENT = "internkim-published-apt-rig/1"

# The monkeys profile this repository keeps its credentials under.
VAULT_PROFILE = "cli"


class Judgement:
    def __init__(self):
        self.results = []

    def record(self, name, passed, observed, why):
        self.results.append({"name": name, "passed": passed, "observed": observed, "why": why})
        print(f"{PASS if passed else FAIL} {name}")
        for line in observed.strip().splitlines():
            print(f"    {line}")
        print()
        return passed

    def missing(self, name, why):
        self.results.append({"name": name, "passed": False, "observed": "not made", "why": why})
        print(f"{FAIL} {name}\n    not made\n")

    def verdict(self):
        return all(result["passed"] for result in self.results)


def asking_for(url):
    return urllib.request.Request(url, headers={"User-Agent": RIG_USER_AGENT})


def run_through_the_vault():
    """Hold the bucket's credential the way the CLI holds it.

    `monkeys` hands a value to the command it starts and redacts one read back
    through a pipe, so the only way to have one is to be that command. Every
    reason not to declines and leaves the run as it was: a rig that cannot
    reach the vault should name what it wanted rather than fail later somewhere
    that does not say so.
    """
    if os.environ.get("INTERNKIM_ENVIRONMENT_FROM_VAULT"):
        return
    monkeys = shutil.which("monkeys")
    if monkeys is None:
        print(f"{FAIL} monkeys is not installed, so the environment is whatever was already set", file=sys.stderr)
        return
    doctor = subprocess.run(
        [monkeys, "doctor", "--short"], cwd=str(REPOSITORY_ROOT), capture_output=True, text=True,
    )
    gap = [line for line in doctor.stdout.splitlines() if line.startswith(f"missing @{VAULT_PROFILE}:")]
    if gap:
        print(f"{FAIL} the vault has a gap, so the environment is whatever was already set: {gap[0]}", file=sys.stderr)
        return
    os.environ["INTERNKIM_ENVIRONMENT_FROM_VAULT"] = "1"
    # -u because this rig's output is usually redirected to a file, and python
    # buffers stdout when it is. A watcher then reads an empty log for the whole
    # run and cannot tell a slow step from a dead one.
    os.execvpe(monkeys, [
        "monkeys", "run", f"@{VAULT_PROFILE}",
        sys.executable, "-u", str(Path(__file__).resolve()), *sys.argv[1:],
    ], os.environ)


def repository_setting(name):
    value = os.environ.get(name, "").strip()
    if not value:
        raise RigFailure(
            f"{name} did not arrive from the vault, and the bucket is named by it; "
            f"`monkeys doctor` says what the @{VAULT_PROFILE} profile lacks"
        )
    return value


def r2_object(arguments, timeout_seconds=3600):
    wrangler = REPOSITORY_ROOT / "web" / "node_modules" / ".bin" / "wrangler"
    completed = subprocess.run(
        [str(wrangler), "r2", "object", *arguments, "--remote"],
        cwd=str(REPOSITORY_ROOT / "web"),
        env=dict(os.environ),
        capture_output=True,
        text=True,
        timeout=timeout_seconds,
    )
    if completed.returncode != 0:
        raise RigFailure(f"wrangler r2 object {arguments[0]} failed: {completed.stderr.strip()[:800]}")
    return completed


class PublishedObject:
    """One published object, taken out of the bucket and put back.

    The bytes are held rather than re-rendered, because what goes back has to
    be what was there and the only certain copy of that is the object itself
    before anything touched it.
    """

    def __init__(self, object_key, local_path, content_type):
        self.object_key = object_key
        self.local_path = Path(local_path)
        self.content_type = content_type
        self.bucket = repository_setting("INTERNKIM_RELEASE_R2_BUCKET")

    def take(self):
        r2_object(["get", f"{self.bucket}/{self.object_key}", "--file", str(self.local_path)])
        return self.local_path.read_bytes()

    def put(self, path):
        r2_object(["put", f"{self.bucket}/{self.object_key}", "--file", str(path),
                   "--force", "--content-type", self.content_type])

    def delete(self):
        r2_object(["delete", f"{self.bucket}/{self.object_key}", "--force"])

    def restore(self):
        self.put(self.local_path)


class PublishedRepository:
    """The published objects, read the way anything else reads them."""

    def __init__(self, suite, working_directory):
        self.suite = suite
        self.working_directory = Path(working_directory)
        self.url = f"{PUBLISHED_BASE_URL}/{REPOSITORY_PREFIX}"

    def fetch(self, relative_path):
        url = f"{self.url}/{relative_path}"
        try:
            with urllib.request.urlopen(asking_for(url), timeout=300) as answer:
                return answer.read()
        except urllib.error.HTTPError as refused:
            raise RigFailure(f"{url} answered {refused.code}") from refused

    def release(self):
        return self.fetch(f"dists/{self.suite}/Release").decode()

    def index(self):
        return self.fetch(f"dists/{self.suite}/main/binary-{ARCHITECTURE}/Packages").decode()

    def entries(self):
        """Every stanza the published index carries, as its fields.

        A suite holds as many versions as were published into it, and which one
        a machine has is a question only that machine can answer. So nothing
        here takes the first stanza for the package: every lookup names a
        version.
        """
        return [
            parse_control_paragraph(stanza)
            for stanza in self.index().split("\n\n")
            if stanza.strip()
        ]

    def versions(self):
        return [entry.get("Version", "") for entry in self.entries()]

    def entry(self, version):
        for entry in self.entries():
            if entry.get("Version") == version:
                return entry
        raise RigFailure(
            f"the published {ARCHITECTURE} index names no {version}; it names "
            + (", ".join(self.versions()) or "nothing")
        )

    def pool_path(self, version):
        return self.entry(version)["Filename"]

    def signed_digest(self, version):
        return self.entry(version)["SHA256"]

    def download(self, relative_path, destination):
        destination = Path(destination)
        digest = hashlib.sha256()
        with urllib.request.urlopen(asking_for(f"{self.url}/{relative_path}"), timeout=3600) as answer:
            with destination.open("wb") as held:
                while True:
                    chunk = answer.read(1 << 20)
                    if not chunk:
                        break
                    digest.update(chunk)
                    held.write(chunk)
        return destination, digest.hexdigest()

    def served_digest(self, pool_path):
        digest = hashlib.sha256()
        with urllib.request.urlopen(asking_for(f"{self.url}/{pool_path}"), timeout=3600) as answer:
            while True:
                chunk = answer.read(1 << 20)
                if not chunk:
                    break
                digest.update(chunk)
        return digest.hexdigest()

    def signature_objects(self):
        return [
            PublishedObject(
                f"{REPOSITORY_PREFIX}/dists/{self.suite}/{name}",
                self.working_directory / name,
                "application/pgp-signature" if name == "Release.gpg" else "text/plain; charset=utf-8",
            )
            for name in SIGNATURE_NAMES
        ]

    def package_object(self, pool_path):
        return PublishedObject(
            f"{REPOSITORY_PREFIX}/{pool_path}",
            self.working_directory / Path(pool_path).name,
            "application/vnd.debian.binary-package",
        )


class PublishedTrial:
    def __init__(self, options):
        self.options = options
        self.judgement = Judgement()
        self.working_directory = None
        self.repository = None
        self.machine = None
        self.installed_version = None
        self.pool_path = None
        self.plane = None
        self.company_id = None

    # ---------------------------------------------------------------- setup

    def start_machine(self):
        share = self.working_directory / "share"
        (share / "scripts").mkdir(parents=True, exist_ok=True)
        self.machine = Machine(self.options.name, share)
        self.machine.preflight()
        self.machine.create()
        self.machine.wait_until_running()

    def guest_has_never_heard_of_us(self):
        looked = self.machine.shell(
            "set -u\n"
            f"echo \"source: $([ -e {APT_SOURCE_PATH} ] && echo present || echo absent)\"\n"
            f"echo \"keyring: $([ -e {KEYRING_PATH} ] && echo present || echo absent)\"\n"
            f"echo \"dpkg: $(dpkg-query -W -f '${{Status}}' {PACKAGE_NAME} 2>/dev/null || echo 'no such package')\"\n"
            "echo \"apt sources: $(grep -rl intern.kim /etc/apt 2>/dev/null | tr '\\n' ' ')\"\n"
            ". /etc/os-release && echo \"release: $ID $VERSION_ID $VERSION_CODENAME\"\n"
            "echo \"page size: $(getconf PAGE_SIZE)\"\n"
            "echo \"memory: $(awk '/MemTotal/ { print $2 \" kB\" }' /proc/meminfo)\"\n"
        )
        said = looked.stdout.strip()
        named_sources = next(
            (line.split(": ", 1)[1].strip() for line in said.splitlines() if line.startswith("apt sources: ")),
            "",
        )
        self.judgement.record(
            "the guest starts with no source, no keyring and no package",
            "source: absent" in said and "keyring: absent" in said
            and "dpkg: no such package" in said and named_sources == "",
            said,
            "a proof that begins with anything of ours already on the machine is a proof about "
            "this rig; what this guest carries before the line is run is what a fresh machine "
            f"carries, plus {', '.join(PRESEEDED_PACKAGES)}, which the container image lacks and "
            "an installed Debian has",
        )

    # --------------------------------------------------------------- the run

    def the_one_line(self):
        """The line a person is given, fetched from the site that publishes it."""
        asking = f"INTERNKIM_INSTALL_SUITE={self.options.suite} " if self.options.suite else ""
        command = f"curl -fsSL {INSTALL_LINE_URL} | {asking}sh -s -- host"
        print(f"in the guest: {command}\n")
        installed = self.machine.shell(
            "set -u\nexport DEBIAN_FRONTEND=noninteractive\n" + command + "\n", timeout_seconds=5400
        )
        spoken = (installed.stdout + installed.stderr).strip()
        status = self.machine.shell(f"dpkg-query -W -f '${{Status}} ${{Version}}' {PACKAGE_NAME} 2>&1")
        self.judgement.record(
            "one line installs the package on a machine that had never heard of us",
            "install ok installed" in status.stdout,
            spoken[-1500:] + f"\n\ndpkg-query: {status.stdout.strip()}",
            "the script came from the site, the keyring and the packages from the worker, and "
            "dpkg's database is what makes it an install rather than a download",
        )
        written = self.machine.shell(f"cat {APT_SOURCE_PATH} 2>&1")
        self.judgement.record(
            "the source it left behind names the published suite and this keyring alone",
            f"Suites: {self.options.suite}" in written.stdout and f"Signed-By: {KEYRING_PATH}" in written.stdout,
            written.stdout.strip(),
            "what apt does on every future upgrade is this file; a machine pinned to a suite "
            "nobody publishes, or trusting a keyring that signs every repository, installs the "
            "same way today and differently later",
        )

    def version_dpkg_records(self):
        """What the machine says it is holding, which is what every lookup keys on."""
        recorded = self.machine.shell(f"dpkg-query -W -f '${{Version}}' {PACKAGE_NAME} 2>/dev/null")
        version = recorded.stdout.strip()
        if not version:
            raise RigFailure(f"the guest holds no {PACKAGE_NAME}, so there is nothing to read an index entry for")
        return version

    def take_the_version_the_guest_holds(self):
        self.installed_version = self.version_dpkg_records()
        self.pool_path = self.repository.pool_path(self.installed_version)
        print(f"the guest holds {self.installed_version}, published at {self.pool_path}\n")

    def the_bytes_are_the_signed_ones(self):
        signed = self.repository.signed_digest(self.installed_version)
        served = self.repository.served_digest(self.pool_path)
        pool_name = Path(self.pool_path).name
        in_the_guest = self.machine.shell(
            "set -u\n"
            f"cached=$(ls /var/cache/apt/archives/{pool_name} 2>/dev/null || true)\n"
            "if [ -n \"$cached\" ]; then sha256sum \"$cached\"; else echo 'apt kept no copy'; fi\n"
        ).stdout.strip()
        self.judgement.record(
            "what the worker serves out of R2 hashes to what the signed index vouches for",
            served == signed,
            f"signed index:     {signed}\nfetched from R2:  {served}\nin the guest:     {in_the_guest}",
            "apt refuses a mismatch, so the install above already implies this; reading the digest "
            "off the wire is the same claim without apt as its own witness",
        )

    # --------------------------------------------------------------- upgrade

    def edit_the_shipped_configuration(self):
        """An operator's edit, made before the upgrade so the upgrade can lose it."""
        self.machine.checked_shell(f"set -eu\nprintf '%s\\n' '{CONFFILE_EDIT}' >> {CONFFILE_PATH}\n")

    def give_the_guest_a_company(self):
        """A box with no company runs nothing, and nothing cannot be asked what it is.

        Every unit the package installs carries ConditionPathExists over a file
        `internkim install` writes, so until this runs there is no process whose
        revision an upgrade could be seen to move.
        """
        self.plane = CompanyPlane(self.working_directory / "plane", self.machine.host_gateway())
        self.plane.start()
        connection = self.plane.connection_document()
        self.company_id = connection["company"]["id"]
        installed = install_the_company(self.machine, connection)
        pointed = self.machine.shell(
            f"readlink -f {STATE_DIRECTORY}/current 2>/dev/null; "
            f"test -s {COMPANY_CONDITION_PATH} && echo condition-met"
        )
        self.judgement.record(
            "the box takes the company the plane issued it",
            self.company_id in pointed.stdout and "condition-met" in pointed.stdout,
            (pointed.stdout.strip() or "nothing was written")
            + f"\ninternkim install exited {installed.returncode}"
            + ("\n" + (installed.stdout + installed.stderr).strip()[-900:] if installed.returncode else ""),
            "`internkim install` printing its steps is the installer's account of its own run; "
            "this is the state every unit reads before it will start, and without it the upgrade "
            "below would move files nothing is running",
        )

    READINESS_DEADLINE_SECONDS = 300

    def the_services_are_up(self, when):
        """Every readiness endpoint, given a deadline rather than a single look.

        A restarted unit is not serving the instant `apt-get upgrade` returns,
        and curl answers 000 for a port nothing listens on and for a port whose
        process is still coming up. One probe cannot tell those apart, so this
        waits and records how long each endpoint took: a service that answers at
        40 seconds and one that never answers are different findings.
        """
        units = installed_units(self.machine)
        started = time.monotonic()
        pending = list(READINESS_PROBES)
        took = {}
        while pending and time.monotonic() - started < self.READINESS_DEADLINE_SECONDS:
            for port, path in list(pending):
                answered = self.machine.shell(
                    f"curl -s -o /dev/null -w '%{{http_code}}' --max-time 10 "
                    f"http://127.0.0.1:{port}{path}"
                )
                if answered.stdout.strip() == "200":
                    took[f"{port}{path}"] = round(time.monotonic() - started)
                    pending.remove((port, path))
            if pending:
                time.sleep(5)
        waited = round(time.monotonic() - started)
        answered_in = "\n".join(f"{endpoint} answered 200 after {seconds}s" for endpoint, seconds in sorted(took.items()))
        never = "\n".join(f"{port}{path} never answered 200 within {waited}s" for port, path in pending)
        self.judgement.record(
            f"the services answer their readiness endpoints {when}",
            bool(units) and not pending,
            f"{len(units)} units installed\n" + "\n".join(part for part in (answered_in, never) if part),
            "systemd reports active for a process that answers a socket while refusing all work, "
            "and an upgrade judged against a machine that was not serving before it proves nothing. "
            "The seconds are part of the observation: a restart that takes a minute and a unit that "
            "never comes back both answer 000 to one probe",
        )

    def the_running_build_is(self, version, when):
        reported = build_identity_reported(self.machine)
        port, path = REVISION_PROBE
        self.judgement.record(
            f"the running services report {version} {when}",
            reported.get("admindBuildID") == version
            and reported.get("gitRevision") not in ("", "unknown"),
            f"127.0.0.1:{port}{path} reports {json.dumps(reported)}\nexpected admindBuildID {version}",
            "dpkg's version, apt's summary and the file's mtime all move for an upgrade that "
            "unpacked new binaries and left the old processes serving them; the only thing that "
            "does not is the build id the process itself answers with",
        )
        return reported

    def stage_the_published_package(self):
        """The package the suite already carries, taken off the wire.

        It is republished beside the newer one rather than re-rendered, so what
        goes back into the pool is the object that was there and a machine
        holding that version keeps being able to fetch it.
        """
        staging = self.working_directory / "packages"
        staging.mkdir(parents=True, exist_ok=True)
        name = Path(self.pool_path).name
        _, digest = self.repository.download(self.pool_path, staging / name)
        signed = self.repository.signed_digest(self.installed_version)
        if digest != signed:
            raise RigFailure(
                f"what R2 serves for {self.installed_version} is not what the signed index vouches "
                f"for, so republishing it would publish something the suite never named: "
                f"{digest} against {signed}"
            )
        print(f"staged the published {self.installed_version} from the pool ({digest[:16]}…)\n")
        return staging

    def say_what_is_about_to_be_written(self, staging, newer_version):
        """What the bucket holds now, beside what this run is about to put there.

        These indexes exist, which is the difference from the run that created
        them: every object below is replaced rather than added, and a suite
        whose Release no longer names a version a machine holds is a machine
        that cannot fetch its own package.
        """
        print("about to publish into the bucket:\n")
        for relative_path in (
            f"dists/{self.options.suite}/Release",
            f"dists/{self.options.suite}/InRelease",
            f"dists/{self.options.suite}/Release.gpg",
            f"dists/{self.options.suite}/main/binary-{ARCHITECTURE}/Packages",
            KEYRING_NAME,
        ):
            try:
                held = self.repository.fetch(relative_path)
                standing = f"{len(held)} bytes, sha256 {hashlib.sha256(held).hexdigest()[:16]}…"
            except RigFailure as refused:
                standing = str(refused)
            print(f"  {REPOSITORY_PREFIX}/{relative_path}\n      now: {standing}")
        print(f"\n  the suite's index names: {', '.join(self.repository.versions())}")
        print(f"  the package directory holds: {', '.join(sorted(path.name for path in staging.glob('*.deb')))}")
        print(f"  so the index will name: {self.installed_version}, {newer_version}\n")

    def publish_the_newer_package(self, staging):
        """Cut the release the way a person does, key and all."""
        monkeys = shutil.which("monkeys") or str(Path.home() / ".local/bin/monkeys")
        if not Path(monkeys).exists():
            raise RigFailure("monkeys is not installed, and it is where the archive signing key lives")
        published = subprocess.run(
            [
                monkeys, "run", str(internkim_command()), "release", "apt",
                "--suite", self.options.suite,
                "--package-directory", str(staging),
            ],
            capture_output=True, text=True, cwd=str(REPOSITORY_ROOT), timeout=5400,
        )
        if published.returncode != 0:
            raise RigFailure(
                f"publishing to {self.options.suite} failed: "
                f"{published.stderr.strip() or published.stdout.strip()}"
            )
        print(published.stdout.strip() + "\n")

    def both_versions_are_in_the_suite(self, older_version, newer_version):
        named = self.repository.versions()
        older_served = self.repository.served_digest(self.repository.pool_path(older_version))
        self.judgement.record(
            "the suite names both versions, and the one already installed is still fetchable",
            set(named) == {older_version, newer_version}
            and older_served == self.repository.signed_digest(older_version),
            f"the index names: {', '.join(named)}\n"
            f"{older_version} in the pool: {older_served}\n"
            f"the index vouches for:      {self.repository.signed_digest(older_version)}",
            "a publish that replaces the index rather than adding to it leaves every machine "
            "holding the older version unable to fetch what it has, which `apt-get install "
            "--reinstall` and any `apt-get -f install` need",
        )

    def apt_sees_the_newer_candidate(self, newer_version):
        self.forget_what_apt_learned()
        updated = self.update()
        policy = self.machine.shell(f"apt-cache policy {PACKAGE_NAME}")
        self.judgement.record(
            "apt fetches the new indexes and prefers the newer version",
            updated.returncode == 0 and f"Candidate: {newer_version}" in policy.stdout,
            (updated.stdout + updated.stderr).strip()[-500:] + "\n\n" + policy.stdout.strip(),
            "the index carrying a new stanza says the bucket was written; apt taking it as the "
            "candidate says apt fetched the new Release, checked the archive key's signature on "
            "it, and checked the index against the digest that Release carries",
        )

    def upgrade(self, newer_version):
        upgraded = self.machine.shell(
            "export DEBIAN_FRONTEND=noninteractive\n"
            "apt-get upgrade -y </dev/null 2>&1 | tail -30\n",
            timeout_seconds=5400,
        )
        self.judgement.record(
            "the upgrade finished without asking the administrator a question",
            "conffile prompt" not in upgraded.stdout and "(Y/I/N/O/D/Z)" not in upgraded.stdout,
            upgraded.stdout.strip()[-700:],
            "a package that reships a configuration file the administrator edited stops dpkg at a "
            "prompt, and an unattended upgrade then halts half-configured with the old process "
            "still serving; DEBIAN_FRONTEND=noninteractive does not prevent it",
        )
        recorded = self.version_dpkg_records()
        self.judgement.record(
            "dpkg records the newer version",
            recorded == newer_version,
            f"dpkg-query: {recorded}\nexpected:   {newer_version}",
            "apt printing `1 upgraded` is apt's account of its own run; dpkg's version field is "
            "the machine's, and it is still not the running process's",
        )
        edited = self.machine.shell(f"cat {CONFFILE_PATH} 2>/dev/null")
        self.judgement.record(
            "the operator's edit to the shipped configuration file survived",
            CONFFILE_EDIT in edited.stdout,
            edited.stdout.strip()[-300:],
            f"{CONFFILE_PATH} is the package's one conffile; runtime.json is an optional override "
            "the package does not ship, so editing that would say nothing about what dpkg kept",
        )

    def the_newer_version_sorts_newer(self, older_version, newer_version):
        """dpkg's ordering, asked of dpkg, before anything is published.

        `release deb` versions a build `0.0.0+<date>.<short git sha>`. Two
        builds cut on one day differ only in the sha, and dpkg orders that
        lexically, so which one apt calls newer follows the sha rather than
        which commit is later. Half the pairs sort the wrong way, and the
        symptom is an `apt upgrade` that reports nothing to do.
        """
        compared = self.machine.shell(
            f"dpkg --compare-versions '{newer_version}' gt '{older_version}' && echo newer || echo not-newer"
        )
        if "not-newer" in compared.stdout:
            raise RigFailure(
                f"dpkg does not order {newer_version} above {older_version}, so apt would offer "
                "no upgrade. The version is 0.0.0+<date>.<short sha> and the sha does not order; "
                "this pair sorts the wrong way round"
            )
        self.judgement.record(
            "dpkg orders the newer package above the one the guest holds",
            True,
            f"dpkg --compare-versions {newer_version} gt {older_version}: {compared.stdout.strip()}",
            "the version carries a git sha, which orders lexically rather than by when the commit "
            "was made, so two builds from one day sort either way; an upgrade proved without "
            "asking dpkg first would be proving a coin flip",
        )

    def prove_the_upgrade(self):
        older_version = self.installed_version
        newer_version = package_fields(self.options.prove_upgrade)["Version"]
        if newer_version == older_version:
            raise RigFailure(
                f"{self.options.prove_upgrade} carries {newer_version}, which is what the suite "
                "already publishes; an upgrade needs somewhere to move to"
            )
        self.the_newer_version_sorts_newer(older_version, newer_version)
        self.edit_the_shipped_configuration()
        self.give_the_guest_a_company()
        self.the_services_are_up("before the upgrade")
        before = self.the_running_build_is(older_version, "before the upgrade")

        staging = self.stage_the_published_package()
        shutil.copyfile(self.options.prove_upgrade, staging / Path(self.options.prove_upgrade).name)
        self.say_what_is_about_to_be_written(staging, newer_version)
        self.publish_the_newer_package(staging)
        self.both_versions_are_in_the_suite(older_version, newer_version)

        self.apt_sees_the_newer_candidate(newer_version)
        self.upgrade(newer_version)
        after = self.the_running_build_is(newer_version, "after the upgrade")
        self.judgement.record(
            "the running services moved, rather than the files under them",
            bool(before.get("admindBuildID"))
            and before.get("admindBuildID") != after.get("admindBuildID"),
            f"before {json.dumps(before)}\nafter  {json.dumps(after)}",
            "this is the whole of what the upgrade claim rests on: the same endpoint, asked twice, "
            "answering with two different builds. A postinst that starts rather than restarts "
            "leaves these equal while every other signal moves",
        )
        self.the_services_are_up("after the upgrade")
        self.take_the_version_the_guest_holds()

    # ------------------------------------------------------------- refusals

    def forget_what_apt_learned(self):
        self.machine.checked_shell("rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*.deb")

    def update(self):
        return self.machine.shell(
            "export DEBIAN_FRONTEND=noninteractive\n"
            f"apt-get update -o Dir::Etc::sourcelist=/dev/null -o Dir::Etc::sourceparts={Path(APT_SOURCE_PATH).parent}\n"
        )

    def write_published_source(self):
        self.machine.checked_shell(
            "set -eu\n"
            f"cat > {APT_SOURCE_PATH} <<'SOURCE'\n"
            "Types: deb\n"
            f"URIs: {self.repository.url}\n"
            f"Suites: {self.options.suite}\n"
            "Components: main\n"
            f"Architectures: {ARCHITECTURE}\n"
            f"Signed-By: {KEYRING_PATH}\n"
            "SOURCE\n"
        )

    def install_published_keyring(self):
        self.machine.checked_shell(
            "set -eu\n"
            "install -d -m 0755 /usr/share/keyrings\n"
            f"curl -fsSL {self.repository.url}/{KEYRING_NAME} -o {KEYRING_PATH}\n"
            f"chmod 0644 {KEYRING_PATH}\n"
        )

    def refusal_unsigned(self):
        """Take the published signatures away and leave everything else standing."""
        signatures = self.repository.signature_objects()
        for signature in signatures:
            signature.take()
        try:
            print("taking the published suite's signatures out of the bucket\n")
            for signature in signatures:
                signature.delete()
            self.write_published_source()
            self.install_published_keyring()
            self.forget_what_apt_learned()
            refused = self.update()
            spoken = (refused.stdout + refused.stderr).strip()
            self.judgement.record(
                "an unsigned published repository is refused",
                refused.returncode != 0 and "is not signed" in spoken,
                spoken[-800:],
                "apt fetches the unsigned Release from the worker without trouble; refusing it is "
                "a policy apt applies after the fetch succeeds, and it is the whole of what stands "
                "between a bucket somebody else can write and root on every machine",
            )
        finally:
            print("putting the published signatures back\n")
            for signature in signatures:
                signature.restore()
            self.judgement.record(
                "the published suite is signed again",
                all(self.repository.fetch(f"dists/{self.suite_name()}/{name}") for name in SIGNATURE_NAMES),
                "\n".join(
                    f"{name}: {len(self.repository.fetch(f'dists/{self.suite_name()}/{name}'))} bytes served"
                    for name in SIGNATURE_NAMES
                ),
                "a restore that is assumed rather than read back is how a repository is left broken "
                "by the run that proved it works",
            )

    def suite_name(self):
        return self.options.suite

    def refusal_wrong_keyring(self):
        """A valid published signature, and a keyring that does not hold its key."""
        stranger = Path(tempfile.mkdtemp(prefix="/tmp/ikpub-stranger-"))
        stranger.chmod(0o700)
        made = run([
            "gpg", "--homedir", str(stranger), "--batch", "--yes", "--no-tty",
            "--pinentry-mode", "loopback", "--passphrase", "", "--quick-generate-key",
            "Somebody Else TEST KEY <stranger@invalid.internkim.test>", "default", "default", "never",
        ])
        if made.returncode != 0:
            raise RigFailure(f"gpg would not generate a stranger's key: {made.stderr.strip()}")
        exported = subprocess.run(["gpg", "--homedir", str(stranger), "--batch", "--export"], capture_output=True)
        if not exported.stdout:
            raise RigFailure(f"gpg exported no stranger key: {exported.stderr.decode()}")
        (self.working_directory / "share" / "stranger-keyring.pgp").write_bytes(exported.stdout)

        self.write_published_source()
        self.machine.checked_shell(
            f"set -eu\ncp {SHARE_PATH}/stranger-keyring.pgp {KEYRING_PATH}\nchmod 0644 {KEYRING_PATH}\n"
        )
        self.forget_what_apt_learned()
        refused = self.update()
        spoken = (refused.stdout + refused.stderr).strip()
        self.judgement.record(
            "the published repository is refused by a machine holding the wrong keyring",
            refused.returncode != 0 and ("NO_PUBKEY" in spoken or "not signed" in spoken),
            spoken[-800:],
            "nothing published changed and the signature is still the archive key's; what changed "
            "is which key this machine was told to accept, which is the whole of what Signed-By is",
        )
        run(["gpgconf", "--homedir", str(stranger), "--kill", "gpg-agent"])
        shutil.rmtree(stranger, ignore_errors=True)
        self.install_published_keyring()

    def refusal_bad_checksum(self):
        """Make R2 serve a package the signed index does not vouch for.

        The substitution keeps the length, because apt checks the size first and
        would refuse on that alone without ever reaching the digest.
        """
        package = self.repository.package_object(self.pool_path)
        original = package.take()
        tampered = self.working_directory / "tampered.deb"
        midpoint = len(original) // 2
        tampered.write_bytes(original[:midpoint] + bytes([original[midpoint] ^ 0xFF]) + original[midpoint + 1:])
        if tampered.stat().st_size != len(original):
            raise RigFailure("the tamper changed the length, so apt would refuse on size alone")
        try:
            print(f"replacing {package.object_key} with a same-length tampered copy\n")
            package.put(tampered)
            self.write_published_source()
            self.install_published_keyring()
            self.forget_what_apt_learned()
            self.update()
            refused = self.machine.shell(
                f"export DEBIAN_FRONTEND=noninteractive\napt-get install -y --reinstall {PACKAGE_NAME}\n",
                timeout_seconds=5400,
            )
            spoken = (refused.stdout + refused.stderr).strip()
            self.judgement.record(
                "a package R2 serves that the signed index does not vouch for is refused",
                refused.returncode != 0 and "Hash Sum mismatch" in spoken and "unexpected size" not in spoken,
                spoken[-900:],
                "the archive key signed the Release, the Release covers the index, and the index "
                "covers this file's SHA256; R2 was made to serve something else, and apt stopped at "
                "the one link in that chain nobody had watched carry a real payload",
            )
        finally:
            print("putting the published package back\n")
            package.restore()
            restored = self.repository.served_digest(self.pool_path)
            signed = self.repository.signed_digest(self.installed_version)
            self.judgement.record(
                "the published package is the signed one again",
                restored == signed,
                f"signed index:    {signed}\nserved from R2:  {restored}",
                "a restore that is assumed rather than read back is how a repository is left broken "
                "by the run that proved it works",
            )

    # --------------------------------------------------------------- driving

    def run_trial(self):
        self.working_directory = Path(tempfile.mkdtemp(prefix="/tmp/ikpub-"))
        (self.working_directory / "share").mkdir(parents=True, exist_ok=True)
        self.repository = PublishedRepository(self.options.suite, self.working_directory)
        try:
            print(self.repository.release())
            print(f"the published {ARCHITECTURE} suite names: {', '.join(self.repository.versions())}\n")
            self.start_machine()
            self.guest_has_never_heard_of_us()
            self.the_one_line()
            self.take_the_version_the_guest_holds()
            self.the_bytes_are_the_signed_ones()
            if self.options.prove_upgrade:
                self.prove_the_upgrade()
            else:
                self.judgement.missing(
                    "apt upgrade carries the guest from one published version to the next",
                    "an upgrade needs a second version in the suite, and putting one there is a "
                    "release; --prove-upgrade <newer.deb> is what publishes it",
                )
            self.refusal_wrong_keyring()
            if self.options.disturb_published_objects:
                self.refusal_unsigned()
                self.refusal_bad_checksum()
            else:
                for name in ("an unsigned published repository is refused",
                             "a package R2 serves that the signed index does not vouch for is refused"):
                    self.judgement.missing(
                        name,
                        "the repository has to be wrong for this, and the only place it can be wrong "
                        "is the bucket; --disturb-published-objects is what writes to it",
                    )
            self.write_report()
        finally:
            if self.plane:
                if self.company_id:
                    self.plane.forget_the_company_computer(self.company_id)
                self.plane.stop()
            if self.machine and not self.options.keep:
                self.machine.destroy()
            if self.options.keep:
                print(f"kept: container {self.options.name}, working directory {self.working_directory}")
            else:
                shutil.rmtree(self.working_directory, ignore_errors=True)
        return 0 if self.judgement.verdict() else 1

    def write_report(self):
        destination = Path(".artifacts") / "published-apt-repository" / f"{self.options.name}.json"
        destination.parent.mkdir(parents=True, exist_ok=True)
        destination.write_text(json.dumps({
            "suite": self.options.suite,
            "repository": self.repository.url,
            "install_line": INSTALL_LINE_URL,
            "installed_version": self.installed_version,
            "pool_path": self.pool_path,
            "versions_the_suite_names": self.repository.versions(),
            "results": self.judgement.results,
        }, indent=2) + "\n")
        passed = sum(1 for result in self.judgement.results if result["passed"])
        print(f"{passed}/{len(self.judgement.results)} observations held · {destination}")


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--suite", default=TESTING_SUITE, help="the published suite to install from")
    parser.add_argument("--keep", action="store_true", help="leave the guest up for autopsy")
    parser.add_argument("--name", default=f"internkim-published-{uuid.uuid4().hex[:8]}", help="the container's name")
    parser.add_argument(
        "--disturb-published-objects", action="store_true",
        help="take the suite's signatures away and tamper with the .deb, putting both back",
    )
    parser.add_argument(
        "--prove-upgrade", metavar="DEB",
        help="publish this newer package into the suite and carry the guest onto it",
    )
    options = parser.parse_args()
    run_through_the_vault()
    try:
        return PublishedTrial(options).run_trial()
    except RigFailure as failure:
        print(f"{FAIL} {failure}")
        return 1


if __name__ == "__main__":
    sys.exit(main())
