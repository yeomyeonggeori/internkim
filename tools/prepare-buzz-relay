#!/usr/bin/env bash
set -euo pipefail

repository_root="$(cd "$(dirname "$0")/.." && pwd)"

# The messenger is built for the machine that will run it. linux/arm64 is the
# appliance and stays the default, so the artifact directory every other caller
# names does not move; linux/amd64 is the .deb for an ordinary company server and
# sits in a directory of its own beside it. `--target linux` builds both, which is
# what the package release wants. A Mac builds the same clone with the same two
# patches and the same cargo line, on the host rather than in a container: the
# patches are Python text substitutions and the platform they run on has no
# bearing on them, and cargo needs no target flag because the host is the target.
target="linux-arm64"
case "${1:-}" in
  --target) target="$2"; shift 2 ;;
  "") ;;
  *) echo "usage: prepare-buzz-relay [--target linux-arm64|linux-amd64|linux|darwin-arm64]" >&2; exit 1 ;;
esac

if [ "$target" = "linux" ]; then
  "$0" --target linux-arm64
  exec "$0" --target linux-amd64
fi

case "$target" in
  linux-arm64)
    artifact_directory="$repository_root/.dependency/buzz-relay"
    bun_target="bun-linux-arm64"
    container_platform="linux/arm64"
    ;;
  linux-amd64)
    artifact_directory="$repository_root/.dependency/buzz-relay-linux-amd64"
    bun_target="bun-linux-x64"
    container_platform="linux/amd64"
    ;;
  darwin-arm64)
    if [ "$(uname -s)" != "Darwin" ] || [ "$(uname -m)" != "arm64" ]; then
      echo "a darwin-arm64 messenger is built on an arm64 Mac, and this is $(uname -s) $(uname -m)" >&2
      exit 1
    fi
    artifact_directory="$repository_root/.dependency/buzz-relay-darwin-arm64"
    bun_target="bun-darwin-arm64"
    ;;
  *)
    echo "no messenger is built for $target; the targets are linux-arm64, linux-amd64 and darwin-arm64" >&2
    exit 1
    ;;
esac

source_directory="$artifact_directory/src"
pinned_revision="973386351646d01efca2735ad4921c0d219cff85"
source_repository="https://github.com/block/buzz"

# rust-s3 puts the endpoint's path in the Host header, so an S3 endpoint that
# has one answers 400 before it reads the signature. Supabase Storage's is
# https://<project>.supabase.co/storage/v1/s3. Fix: durch/rust-s3#474.
patched_s3_repository="https://github.com/eastriverlee/rust-s3.git"
patched_s3_revision="786653e1b4abd47cb046ef1227aa646d97073c2c"
built_revision="$pinned_revision+rust-s3-$patched_s3_revision+traceless-delete-1"

relay_binary="$artifact_directory/buzz-relay"
admin_binary="$artifact_directory/buzz-admin"
revision_file="$artifact_directory/REVISION"
chatd_binary="$artifact_directory/chatd"
chatd_revision_file="$artifact_directory/CHATD_REVISION"

# chatd is the messenger a company's messages travel over, and setup treats it as
# optional, so a device provisioned without it comes up with no way to be talked
# to. It is built here beside the relay it talks through.
build_chatd() {
  (cd "$repository_root/.dependency/blueclaw/chatd" \
    && bun build src/main.ts --compile --target="$bun_target" --outfile "$chatd_binary")
  chmod +x "$chatd_binary"
  git -C "$repository_root/.dependency/blueclaw" rev-parse HEAD > "$chatd_revision_file"
  echo "chatd built at $(cat "$chatd_revision_file")"
}

chatd_revision="$(git -C "$repository_root/.dependency/blueclaw" rev-parse HEAD)"
if [ ! -x "$chatd_binary" ] || [ "$(cat "$chatd_revision_file" 2>/dev/null)" != "$chatd_revision" ]; then
  build_chatd
else
  echo "chatd already up to date at $chatd_revision"
fi

if [ -x "$relay_binary" ] && [ -x "$admin_binary" ] && [ "$(cat "$revision_file" 2>/dev/null)" = "$built_revision" ]; then
  echo "buzz-relay artifact already up to date at $built_revision"
  exit 0
fi

mkdir -p "$artifact_directory"
if [ ! -d "$source_directory/.git" ]; then
  rm -rf "$source_directory"
  git clone "$source_repository" "$source_directory"
fi
git -C "$source_directory" fetch --depth 1 origin "$pinned_revision"
git -C "$source_directory" checkout --detach "$pinned_revision"

# A deletion leaves a relay-signed kind:40099 "removed a message" row in the
# channel, and the desktop app renders it forever. The app already removes the
# deleted message from every timeline off the kind:9005 delete event itself
# (formatTimelineMessages.ts treats 5/9005 as deletion markers), so the room
# notice is the only trace. Keep it solely for moderation deletes that carry a
# sanitized public_reason; a plain delete vanishes without a tombstone.
python3 - "$source_directory/crates/buzz-relay/src/handlers/side_effects.rs" <<'PATCH'
import pathlib
import sys

source = pathlib.Path(sys.argv[1])
text = source.read_text()
unconditional = """    copy_optional_string_field(event, &mut tombstone, "public_reason");

    emit_system_message(tenant, state, channel_id, tombstone).await?;
"""
conditional = """    copy_optional_string_field(event, &mut tombstone, "public_reason");

    if tombstone.get("public_reason").is_some() {
        emit_system_message(tenant, state, channel_id, tombstone).await?;
    }
"""
if conditional in text:
    sys.exit(0)
if unconditional not in text:
    raise SystemExit("buzz moved the deletion tombstone; re-anchor the traceless-delete patch")
source.write_text(text.replace(unconditional, conditional, 1))
PATCH

python3 - "$source_directory/Cargo.toml" "$patched_s3_repository" "$patched_s3_revision" <<'PATCH'
import pathlib
import sys

manifest, repository, revision = pathlib.Path(sys.argv[1]), sys.argv[2], sys.argv[3]
entry = f'rust-s3 = {{ git = "{repository}", rev = "{revision}" }}'
text = manifest.read_text()
if entry in text:
    sys.exit(0)
if "[patch.crates-io]" not in text:
    raise SystemExit("buzz no longer patches crates.io; place the rust-s3 patch by hand")
manifest.write_text(text.replace("[patch.crates-io]\n", f"[patch.crates-io]\n{entry}\n", 1))
PATCH

if [ "$target" = "darwin-arm64" ]; then
  (cd "$source_directory" \
    && cargo update --package rust-s3 \
    && cargo build --release --locked -p buzz-relay --bin buzz-relay -p buzz-admin --bin buzz-admin)
else
  container run --rm --platform "$container_platform" --memory 8G \
    -v "$source_directory:/build" -w /build rust:1.95-bookworm \
    bash -c '
      set -euo pipefail
      export PATH=/usr/local/cargo/bin:$PATH
      apt-get update -qq
      DEBIAN_FRONTEND=noninteractive apt-get install -y -qq build-essential pkg-config libssl-dev git >/dev/null
      cargo update --package rust-s3
      cargo build --release --locked -p buzz-relay --bin buzz-relay -p buzz-admin --bin buzz-admin
    '
fi

cp "$source_directory/target/release/buzz-relay" "$relay_binary"
cp "$source_directory/target/release/buzz-admin" "$admin_binary"
chmod +x "$relay_binary" "$admin_binary"
printf '%s\n' "$built_revision" > "$revision_file"
echo "buzz-relay artifact prepared at $built_revision for $target"
