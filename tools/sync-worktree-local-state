#!/bin/sh
set -eu

printUsage() {
  echo "usage: tools/sync-worktree-local-state [--copy] <main-worktree-path>" >&2
}

fail() {
  echo "$1" >&2
  exit 1
}

canonicalPath() {
  cd "$1" && pwd
}

linkTargetMatches() {
  path="$1"
  expectedTarget="$2"
  [ -L "$path" ] && [ "$(readlink "$path")" = "$expectedTarget" ]
}

ensureDestinationIsAvailable() {
  destinationPath="$1"
  sourcePath="$2"
  if linkTargetMatches "$destinationPath" "$sourcePath"; then
    echo "kept $destinationPath"
    return 1
  fi
  if [ -e "$destinationPath" ] || [ -L "$destinationPath" ]; then
    fail "destination already exists: $destinationPath"
  fi
  return 0
}

copyLocalState() {
  sourcePath="$1"
  destinationPath="$2"
  mkdir -p "$(dirname "$destinationPath")"
  cp -pR "$sourcePath" "$destinationPath"
  echo "copied $destinationPath"
}

linkLocalState() {
  sourcePath="$1"
  destinationPath="$2"
  mkdir -p "$(dirname "$destinationPath")"
  ln -s "$sourcePath" "$destinationPath"
  echo "linked $destinationPath"
}

syncLocalState() {
  relativePath="$1"
  sourcePath="$mainWorktreePath/$relativePath"
  destinationPath="$repositoryRoot/$relativePath"
  if [ ! -e "$sourcePath" ] && [ ! -L "$sourcePath" ]; then
    echo "skipped $relativePath"
    return
  fi
  if ! ensureDestinationIsAvailable "$destinationPath" "$sourcePath"; then
    return
  fi
  if [ "$syncMode" = "copy" ]; then
    copyLocalState "$sourcePath" "$destinationPath"
    return
  fi
  linkLocalState "$sourcePath" "$destinationPath"
}

checkOutSubmodules() {
  if ! git -C "$repositoryRoot" submodule update --init --recursive >/dev/null 2>&1; then
    echo "skipped submodules (git submodule update failed)"
    return
  fi
  echo "checked out submodules"
}

# Every bun workspace a worktree has to install for itself. They come out of
# bun's cache in seconds and are a few hundred packages rather than gigabytes,
# so sharing them across worktrees would buy nothing and pin every worktree to
# one revision's lockfile. The web build imports blueclaw's protocol package, so
# a worktree missing the submodule's install fails at `bun run build` on an
# unresolved `zod` rather than on anything that names the submodule; the web and
# gateway installs are what `bun test`, `bun run check` and `wrangler dev` need
# before they will start at all.
bunWorkspaces=".dependency/blueclaw web workers/connection-gateway"

installBunWorkspace() {
  relativePath="$1"
  workspacePath="$repositoryRoot/$relativePath"
  if [ ! -f "$workspacePath/package.json" ]; then
    echo "skipped $relativePath dependencies (no package.json)"
    return
  fi
  if ! command -v bun >/dev/null 2>&1; then
    echo "skipped $relativePath dependencies (bun is not installed)"
    return
  fi
  if ! (cd "$workspacePath" && bun install --frozen-lockfile >/dev/null 2>&1); then
    echo "skipped $relativePath dependencies (bun install failed)"
    return
  fi
  echo "installed $relativePath dependencies"
}

installBunWorkspaces() {
  for relativePath in $bunWorkspaces; do
    installBunWorkspace "$relativePath"
  done
}

syncSharedDependencyArtifacts() {
  syncLocalState ".dependency/blueclaw-runtime"
  syncLocalState ".dependency/container-kernel"
  syncLocalState ".dependency/device-browser"
  syncLocalState ".dependency/agent-browser"
  syncLocalState ".dependency/llama-cpp"
  syncLocalState ".dependency/llama-cpp-models"
  syncLocalState ".dependency/litert-models"
  syncLocalState ".dependency/local-fleet-embedding"
  # The relay is built from its own source and carries its own revision, so every
  # worktree wants the same 2 GB of it. Leaving it out cost a fleet run: the buzz
  # steps only fail once provisioning is minutes in.
  syncLocalState ".dependency/buzz-relay"
}

syncMode="link"
if [ "${1:-}" = "--copy" ]; then
  syncMode="copy"
  shift
fi

if [ "$#" -ne 1 ]; then
  printUsage
  exit 2
fi

scriptDirectory="$(cd "$(dirname "$0")" && pwd)"
repositoryRoot="$(canonicalPath "$scriptDirectory/..")"
mainWorktreePath="$(canonicalPath "$1")"

if [ "$repositoryRoot" = "$mainWorktreePath" ]; then
  fail "main worktree path must be different from this worktree"
fi

syncLocalState ".local/ops"
syncLocalState ".agents"
syncLocalState "docs/private"
syncSharedDependencyArtifacts
checkOutSubmodules
installBunWorkspaces
