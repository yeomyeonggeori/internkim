#!/usr/bin/env bash
set -euo pipefail

if [ "$#" -eq 0 ]; then
  echo "usage: $0 <command> [arguments...]" >&2
  echo "Runs the command while holding this machine's one local Supabase stack." >&2
  exit 2
fi

if [ -n "${LOCAL_PLANE_LOCK_HOLDER:-}" ]; then
  exec "$@"
fi

repositoryRoot="$(cd "$(dirname "$0")/.." && pwd)"
stateDirectory="${LOCAL_PLANE_STATE_DIRECTORY:-/tmp}"
lockPath="$stateDirectory/internkim-local-plane.lock"
queuePath="$stateDirectory/internkim-local-plane.queue"
lastUsedPath="$stateDirectory/internkim-local-plane.last-used"
idleStopLogPath="$stateDirectory/internkim-local-plane.idle-stop.log"
defaultIdleSeconds=900
longestBoundedHoldSeconds=2700
heldCommand="$(printf '%s' "$*" | tr '\n' ' ')"
holderPath="${lockPath}.holder.$$"
ticketPath=""
weHoldTheLock=0

releaseLock() {
  rm -f "$holderPath"
  if [ -n "$ticketPath" ]; then
    rm -f "$ticketPath"
  fi
  if [ "$weHoldTheLock" -eq 1 ]; then
    weHoldTheLock=0
    scheduleStopWhenIdle
    rm -f "$lockPath"
  fi
}

trap releaseLock EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP

holderProcessID() {
  sed -n 1p "$1" 2>/dev/null || true
}

holderWorktree() {
  sed -n 2p "$1" 2>/dev/null || true
}

holderClaimedAt() {
  sed -n 3p "$1" 2>/dev/null || true
}

holderCommand() {
  sed -n 4p "$1" 2>/dev/null || true
}

holderIsRunning() {
  local processID
  processID="$(holderProcessID "$1")"
  if [ -z "$processID" ]; then
    return 1
  fi
  kill -0 "$processID" 2>/dev/null
}

claimLock() {
  printf '%s\n%s\n%s\n%s\n' "$$" "$repositoryRoot" "$(date +%s)" "$heldCommand" > "$holderPath"
  ln "$holderPath" "$lockPath" 2>/dev/null
}

releaseStaleHolder() {
  if holderIsRunning "$lockPath"; then
    return 0
  fi
  local claimPath="${lockPath}.claim.$$"
  if ! mv "$lockPath" "$claimPath" 2>/dev/null; then
    return 0
  fi
  if holderIsRunning "$claimPath"; then
    ln "$claimPath" "$lockPath" 2>/dev/null || true
  fi
  rm -f "$claimPath"
}

secondsHeld() {
  local claimedAt
  claimedAt="$(holderClaimedAt "$lockPath")"
  if [[ ! "$claimedAt" =~ ^[0-9]+$ ]]; then
    return 0
  fi
  echo "$(($(date +%s) - claimedAt))"
}

describeDuration() {
  printf '%dh%02dm' "$(($1 / 3600))" "$(($1 % 3600 / 60))"
}

announceWait() {
  local processID worktree heldSeconds
  processID="$(holderProcessID "$lockPath")"
  worktree="$(holderWorktree "$lockPath")"
  heldSeconds="$(secondsHeld)"
  printf 'waiting for the local plane held by %s in %s' \
    "${processID:-another process}" "${worktree:-another worktree}" >&2
  if [ -n "$heldSeconds" ]; then
    printf ' for %s, running %s' "$(describeDuration "$heldSeconds")" "$(holderCommand "$lockPath")" >&2
  fi
  printf '\n' >&2
}

refuseToWaitOnAnOpenEndedHold() {
  local heldSeconds processID
  if ! holderIsRunning "$lockPath"; then
    return 0
  fi
  heldSeconds="$(secondsHeld)"
  if [ -z "$heldSeconds" ] || [ "$heldSeconds" -lt "$longestBoundedHoldSeconds" ]; then
    return 0
  fi
  processID="$(holderProcessID "$lockPath")"
  printf 'the local plane has been held for %s by %s in %s, running %s\n' \
    "$(describeDuration "$heldSeconds")" "$processID" "$(holderWorktree "$lockPath")" "$(holderCommand "$lockPath")" >&2
  printf 'no bounded run holds it past %s, so this is not waiting; once that run is no longer needed, stop it with pkill -TERM -P %s and run this again\n' \
    "$(describeDuration "$longestBoundedHoldSeconds")" "$processID" >&2
  exit 1
}

newestTicketNumber() {
  local newest
  newest="$(ls "$queuePath" 2>/dev/null | tail -1)"
  echo "$((10#${newest:-0}))"
}

takeTicket() {
  local pendingPath="${lockPath}.ticket.$$"
  mkdir -p "$queuePath"
  printf '%s\n' "$$" > "$pendingPath"
  until ticketPath="$queuePath/$(printf '%09d' $(($(newestTicketNumber) + 1)))" \
    && ln "$pendingPath" "$ticketPath" 2>/dev/null; do
    :
  done
  rm -f "$pendingPath"
}

isAtTheHeadOfTheQueue() {
  local ticket
  for ticket in "$queuePath"/*; do
    if [ "$ticket" = "$ticketPath" ]; then
      return 0
    fi
    if holderIsRunning "$ticket"; then
      return 1
    fi
    rm -f "$ticket"
  done
  return 1
}

claimWhenFirstInLine() {
  if ! isAtTheHeadOfTheQueue; then
    return 1
  fi
  if claimLock; then
    return 0
  fi
  releaseStaleHolder
  claimLock
}

acquireLock() {
  local waitedSeconds=0
  takeTicket
  while ! claimWhenFirstInLine; do
    refuseToWaitOnAnOpenEndedHold
    if [ "$((waitedSeconds % 30))" -eq 0 ]; then
      announceWait
    fi
    sleep 1
    waitedSeconds=$((waitedSeconds + 1))
  done
  weHoldTheLock=1
  rm -f "$holderPath" "$ticketPath"
  ticketPath=""
}

minimumCommandLineVersion="2.119.0"
stackRuntime="native"
queryTimeoutSeconds=30
stopTimeoutSeconds="${LOCAL_PLANE_STOP_TIMEOUT_SECONDS:-120}"
startTimeoutSeconds="${LOCAL_PLANE_START_TIMEOUT_SECONDS:-600}"
reclaimGraceSeconds=10

. "$repositoryRoot/web/scripts/local-plane-signing-key.sh"
signingKeysPath="$(local_plane_signing_keys_path "$repositoryRoot")"

localPlaneProjectIdentifier() {
  sed -n '/^\[/q; s/^project_id = "\(.*\)"$/\1/p' "$repositoryRoot/supabase/config.toml"
}

projectIdentifier="$(localPlaneProjectIdentifier)"

runQuietlyUnlessItFails() {
  local outputPath
  outputPath="$(mktemp)"
  "$@" > "$outputPath" 2>&1 && { rm -f "$outputPath"; return 0; }
  local status=$?
  cat "$outputPath" >&2
  rm -f "$outputPath"
  return "$status"
}

runWithin() {
  python3 -c '
import subprocess, sys
seconds, command = float(sys.argv[1]), sys.argv[2:]
try:
    sys.exit(subprocess.run(command, timeout=seconds).returncode)
except subprocess.TimeoutExpired:
    print("%s did not finish within %gs" % (" ".join(command), seconds), file=sys.stderr)
    sys.exit(124)
except KeyboardInterrupt:
    sys.exit(130)
' "$@"
}

supabaseWithin() {
  local seconds="$1"
  shift
  runWithin "$seconds" supabase "$@"
}

versionIsAtLeast() {
  [ "$(printf '%s\n%s\n' "$2" "$1" | sort -V | head -1)" = "$2" ]
}

requireStackCommandLine() {
  local installedVersion
  installedVersion="$(supabaseWithin "$queryTimeoutSeconds" --version 2>/dev/null | head -1 || true)"
  if [ -n "$installedVersion" ] && versionIsAtLeast "$installedVersion" "$minimumCommandLineVersion"; then
    return 0
  fi
  printf 'the local plane runs on the Supabase CLI %s or later, and %s answers %s; put a newer one ahead of it on PATH (npm install --global supabase@latest; Homebrew'"'"'s formula can lag)\n' \
    "$minimumCommandLineVersion" "$(command -v supabase || printf 'nothing on PATH')" "${installedVersion:-no version}" >&2
  exit 1
}

writeSigningKeyWhenMissing() {
  if [ -s "$signingKeysPath" ]; then
    return 0
  fi
  mkdir -p "$(dirname "$signingKeysPath")"
  printf 'writing a local signing key to %s\n' "$signingKeysPath" >&2
  (umask 077 && cd "$repositoryRoot" && supabaseWithin "$queryTimeoutSeconds" gen signing-key --algorithm ES256 --output-format text 2>/dev/null \
    | python3 -c 'import json, sys; json.dump([json.load(sys.stdin)], sys.stdout)' > "$signingKeysPath")
}

localPlaneStatus() {
  (cd "$repositoryRoot" && supabaseWithin "$queryTimeoutSeconds" status --output-format json 2>/dev/null) || true
}

servingStackIdentifier() {
  localPlaneStatus | python3 -c '
import json, sys
status = json.load(sys.stdin)
if status.get("owner", "unavailable") != "unavailable":
    print(status["identity"]["id"])
' 2>/dev/null || true
}

recordedStackIdentifier() {
  localPlaneStatus | python3 -c '
import json, sys
print(json.load(sys.stdin)["identity"]["id"])
' 2>/dev/null || true
}

servicesNotReady() {
  localPlaneStatus | python3 -c '
import json, sys
services = json.load(sys.stdin).get("services", [])
print(", ".join("%s (%s)" % (service["service"], service["state"]) for service in services if service["state"] != "running"))
' 2>/dev/null || printf 'unknown, supabase status did not answer'
}

stackIsServing() {
  [ -n "$(servingStackIdentifier)" ]
}

servingStackHasSleepingServices() {
  localPlaneStatus | python3 -c '
import json, sys
services = json.load(sys.stdin).get("services", [])
sys.exit(0 if any(service["state"] == "sleeping" for service in services) else 1)
' 2>/dev/null
}

currentBranchContext() {
  git -C "$repositoryRoot" symbolic-ref -q HEAD 2>/dev/null || true
}

stacksOfThisRepository() {
  local stackList
  stackList="$(cd "$repositoryRoot" && supabaseWithin "$queryTimeoutSeconds" stack list --output-format json 2>/dev/null)" || return 0
  python3 -c '
import json, os, re, sys
repository_root, branch_context, project_identifier, stack_runtime, selection, stack_list = sys.argv[1:7]

def belongs_to_this_repository(project_root):
    if not os.path.isdir(project_root):
        return True
    try:
        with open(os.path.join(project_root, "supabase", "config.toml"), encoding="utf-8") as config:
            text = config.read()
    except OSError:
        return False
    return re.search("^project_id = \"%s\"$" % re.escape(project_identifier), text, re.MULTILINE) is not None

def is_this_checkout(stack):
    if stack["project_root"] != repository_root:
        return False
    return branch_context == "" or stack["branch_context"] == branch_context

def is_selected(stack):
    if selection == "other-checkouts":
        return not is_this_checkout(stack) and os.path.isdir(stack["project_root"]) and belongs_to_this_repository(stack["project_root"])
    if selection == "removed-checkouts":
        return not os.path.isdir(stack["project_root"])
    return is_this_checkout(stack) and stack["runtime"] != stack_runtime

for stack in json.loads(stack_list)["stacks"]:
    if is_selected(stack):
        print(stack["id"])
' "$repositoryRoot" "$(currentBranchContext)" "$projectIdentifier" "$stackRuntime" "$1" "$stackList"
}

destroyStack() {
  printf 'destroying the local plane stack %s, %s\n' "$1" "$2" >&2
  (cd "$repositoryRoot" && runQuietlyUnlessItFails supabaseWithin "$stopTimeoutSeconds" stack destroy --stack-id "$1" --yes --output-format text)
}

stackProjectRoot() {
  (cd "$repositoryRoot" && supabaseWithin "$queryTimeoutSeconds" stack list --output-format json 2>/dev/null) \
    | python3 -c '
import json, sys
stack_identifier = sys.argv[1]
print(next(stack["project_root"] for stack in json.load(sys.stdin)["stacks"] if stack["id"] == stack_identifier))
' "$1" 2>/dev/null || printf 'an unknown project'
}

stackProcessIdentifiers() {
  ps -axo pid=,command= | awk -v stackIdentifier="$1" '
{
  for (field = 2; field <= NF; field++) {
    if ($field == "supabase-stack-id=" stackIdentifier || ($field == "__supabase_stack_host__" && $(field + 3) == stackIdentifier)) {
      print $1
      next
    }
  }
}'
}

processTreeOf() {
  ps -axo pid=,ppid= | awk -v roots="$*" '
BEGIN {
  rootCount = split(roots, rootList, " ")
  for (position = 1; position <= rootCount; position++) inTree[rootList[position]] = 1
}
{ parentOf[$1] = $2 }
END {
  do {
    grew = 0
    for (child in parentOf) {
      if (!(child in inTree) && (parentOf[child] in inTree)) {
        inTree[child] = 1
        grew = 1
      }
    }
  } while (grew)
  for (member in inTree) print member
}'
}

describeProcesses() {
  ps -o pid=,comm= -p "$(printf '%s' "$*" | tr ' ' ',')" 2>/dev/null \
    | awk '{ name = $2; sub(".*/", "", name); described = described (described == "" ? "" : ", ") $1 " " name } END { print described }'
}

anyProcessIsAlive() {
  local processIdentifier
  for processIdentifier in "$@"; do
    if kill -0 "$processIdentifier" 2>/dev/null; then
      return 0
    fi
  done
  return 1
}

terminateProcesses() {
  kill -TERM "$@" 2>/dev/null || true
  local deadline=$((SECONDS + reclaimGraceSeconds))
  while [ "$SECONDS" -lt "$deadline" ] && anyProcessIsAlive "$@"; do
    sleep 0.2
  done
  kill -KILL "$@" 2>/dev/null || true
}

reclaimStack() {
  local projectRoot stackProcesses processTree killed
  projectRoot="$(stackProjectRoot "$1")"
  stackProcesses="$(stackProcessIdentifiers "$1" | tr '\n' ' ')"
  if [ -z "${stackProcesses// /}" ]; then
    printf 'RECLAIMED the local plane stack %s of %s: %s, and no process of it was running; its data is kept\n' \
      "$1" "$projectRoot" "$2" >&2
    return 0
  fi
  processTree="$(processTreeOf $stackProcesses | tr '\n' ' ')"
  killed="$(describeProcesses $processTree)"
  terminateProcesses $processTree
  printf 'RECLAIMED the local plane stack %s of %s: %s, so its processes were killed (%s); its data is kept\n' \
    "$1" "$projectRoot" "$2" "$killed" >&2
}

stopStack() {
  printf 'stopping the local plane stack %s, %s; its data is kept\n' "$1" "$2" >&2
  if (cd / && SUPABASE_EXPERIMENTAL_STACK=1 runQuietlyUnlessItFails supabaseWithin "$stopTimeoutSeconds" stack stop --stack-id "$1" --output-format text); then
    return 0
  fi
  reclaimStack "$1" "its stop failed or did not finish within ${stopTimeoutSeconds}s"
}

freePortsFromOtherCheckouts() {
  local stackIdentifier
  for stackIdentifier in $(stacksOfThisRepository other-checkouts); do
    stopStack "$stackIdentifier" "held by another checkout or branch that is not running a command"
  done
  for stackIdentifier in $(stacksOfThisRepository removed-checkouts); do
    destroyStack "$stackIdentifier" "its checkout no longer exists"
  done
}

destroyOwnStacksOnAnotherRuntime() {
  local stackIdentifier
  for stackIdentifier in $(stacksOfThisRepository own-on-another-runtime); do
    destroyStack "$stackIdentifier" "recorded on a runtime other than $stackRuntime"
  done
}

stopOwnStackWhenAsleep() {
  local stackIdentifier
  stackIdentifier="$(servingStackIdentifier)"
  if [ -z "$stackIdentifier" ] || ! servingStackHasSleepingServices; then
    return 0
  fi
  stopStack "$stackIdentifier" "started without --eager, so a service sleeps until a request wakes it"
}

startStackWhenDown() {
  destroyOwnStacksOnAnotherRuntime
  stopOwnStackWhenAsleep
  if stackIsServing; then
    return 0
  fi
  freePortsFromOtherCheckouts
  printf 'starting the local plane\n' >&2
  if (cd "$repositoryRoot" && runQuietlyUnlessItFails supabaseWithin "$startTimeoutSeconds" start --runtime "$stackRuntime" --eager --output-format text); then
    return 0
  fi
  failToStart
}

failToStart() {
  local notReady stackIdentifier
  notReady="$(servicesNotReady)"
  printf 'the local plane did not become ready within %ss; not ready: %s\n' "$startTimeoutSeconds" "${notReady:-none reported}" >&2
  stackIdentifier="$(recordedStackIdentifier)"
  if [ -n "$stackIdentifier" ]; then
    reclaimStack "$stackIdentifier" "it did not become ready"
  fi
  exit 1
}

scheduleStopWhenIdle() {
  local stackIdentifier
  stackIdentifier="$(servingStackIdentifier)"
  if [ -z "$stackIdentifier" ]; then
    return 0
  fi
  local useToken="$$.$(date +%s)"
  printf '%s\n' "$useToken" > "$lastUsedPath"
  env -u LOCAL_PLANE_LOCK_HOLDER nohup "$0" --stop-when-idle "$useToken" "$stackIdentifier" \
    >> "$idleStopLogPath" 2>&1 < /dev/null &
}

isTheLastUse() {
  [ "$(sed -n 1p "$lastUsedPath" 2>/dev/null || true)" = "$1" ]
}

stopWhenIdle() {
  local useToken="$1"
  local stackIdentifier="$2"
  local idleSeconds="${3:-$defaultIdleSeconds}"
  sleep "$idleSeconds" & wait "$!"
  if ! isTheLastUse "$useToken"; then
    return 0
  fi
  acquireLock
  if ! isTheLastUse "$useToken"; then
    return 0
  fi
  stopStack "$stackIdentifier" "$(date '+%F %T'), unused since $useToken"
}

if [ "$1" = "--stop-when-idle" ]; then
  shift
  stopWhenIdle "$@"
  exit 0
fi

acquireLock
requireStackCommandLine
writeSigningKeyWhenMissing
export SUPABASE_AUTH_SIGNING_KEYS_PATH="$signingKeysPath"
startStackWhenDown

export LOCAL_PLANE_LOCK_HOLDER="$$"
"$@"
