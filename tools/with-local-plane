#!/usr/bin/env bash
set -euo pipefail

if [ "$#" -eq 0 ]; then
  echo "usage: $0 <command> [arguments...]" >&2
  echo "Runs the command while holding this machine's one local Supabase stack." >&2
  exit 2
fi

if [ -n "${LOCAL_PLANE_LOCK_HOLDER:-}" ]; then
  exec "$@"
fi

repositoryRoot="$(cd "$(dirname "$0")/.." && pwd)"
lockPath="/tmp/internkim-local-plane.lock"
lastUsedPath="/tmp/internkim-local-plane.last-used"
idleStopLogPath="/tmp/internkim-local-plane.idle-stop.log"
defaultIdleSeconds=900
holderPath="${lockPath}.holder.$$"
weHoldTheLock=0

releaseLock() {
  rm -f "$holderPath"
  if [ "$weHoldTheLock" -eq 1 ]; then
    weHoldTheLock=0
    scheduleStopWhenIdle
    rm -f "$lockPath"
  fi
}

trap releaseLock EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP

holderProcessID() {
  sed -n 1p "$1" 2>/dev/null || true
}

holderWorktree() {
  sed -n 2p "$1" 2>/dev/null || true
}

holderIsRunning() {
  local processID
  processID="$(holderProcessID "$1")"
  if [ -z "$processID" ]; then
    return 1
  fi
  kill -0 "$processID" 2>/dev/null
}

claimLock() {
  printf '%s\n%s\n' "$$" "$repositoryRoot" > "$holderPath"
  ln "$holderPath" "$lockPath" 2>/dev/null
}

releaseStaleHolder() {
  if holderIsRunning "$lockPath"; then
    return 0
  fi
  local claimPath="${lockPath}.claim.$$"
  if ! mv "$lockPath" "$claimPath" 2>/dev/null; then
    return 0
  fi
  if holderIsRunning "$claimPath"; then
    ln "$claimPath" "$lockPath" 2>/dev/null || true
  fi
  rm -f "$claimPath"
}

announceWait() {
  local processID worktree
  processID="$(holderProcessID "$lockPath")"
  worktree="$(holderWorktree "$lockPath")"
  printf 'waiting for the local plane held by %s in %s\n' \
    "${processID:-another process}" "${worktree:-another worktree}" >&2
}

acquireLock() {
  local waitedSeconds=0
  while ! claimLock; do
    releaseStaleHolder
    if claimLock; then
      break
    fi
    if [ "$((waitedSeconds % 30))" -eq 0 ]; then
      announceWait
    fi
    sleep 1
    waitedSeconds=$((waitedSeconds + 1))
  done
  weHoldTheLock=1
  rm -f "$holderPath"
}

localPlaneProjectIdentifier() {
  sed -n '/^\[/q; s/^project_id = "\(.*\)"$/\1/p' "$repositoryRoot/supabase/config.toml"
}

projectIdentifier="$(localPlaneProjectIdentifier)"

removeStoppedStackContainers() {
  if ! command -v docker >/dev/null 2>&1; then
    return 0
  fi
  if [ -z "$projectIdentifier" ]; then
    return 0
  fi
  local stoppedContainers
  stoppedContainers="$(
    docker ps --all \
      --filter "label=com.supabase.cli.project=$projectIdentifier" \
      --filter 'status=exited' \
      --filter 'status=dead' \
      --format '{{.Names}}' 2>/dev/null || true
  )"
  if [ -z "$stoppedContainers" ]; then
    return 0
  fi
  while IFS= read -r containerName; do
    if [ -z "$containerName" ]; then
      continue
    fi
    printf 'removing the stopped local plane container %s\n' "$containerName" >&2
    docker rm --force "$containerName" >/dev/null 2>&1 || true
  done <<< "$stoppedContainers"
}

stackIsServing() {
  (cd "$repositoryRoot" && supabase status >/dev/null 2>&1)
}

stackHasContainersRunning() {
  [ -n "$(docker ps --quiet --filter "label=com.supabase.cli.project=$projectIdentifier" 2>/dev/null || true)" ]
}

startDockerWhenDown() {
  if docker info >/dev/null 2>&1; then
    return 0
  fi
  if ! command -v colima >/dev/null 2>&1; then
    return 0
  fi
  printf 'starting colima for the local plane\n' >&2
  colima start >&2
}

startStackWhenDown() {
  if stackIsServing; then
    return 0
  fi
  startDockerWhenDown
  removeStoppedStackContainers
  printf 'starting the local plane\n' >&2
  (cd "$repositoryRoot" && supabase start >/dev/null)
}

scheduleStopWhenIdle() {
  if ! stackHasContainersRunning; then
    return 0
  fi
  local useToken="$$.$(date +%s)"
  printf '%s\n' "$useToken" > "$lastUsedPath"
  env -u LOCAL_PLANE_LOCK_HOLDER nohup "$0" --stop-when-idle "$useToken" \
    >> "$idleStopLogPath" 2>&1 < /dev/null &
}

isTheLastUse() {
  [ "$(sed -n 1p "$lastUsedPath" 2>/dev/null || true)" = "$1" ]
}

stopColimaWhenNothingElseRuns() {
  if ! command -v colima >/dev/null 2>&1; then
    return 0
  fi
  if ! colima status >/dev/null 2>&1; then
    return 0
  fi
  if [ -n "$(docker ps --quiet 2>/dev/null || true)" ]; then
    printf 'leaving colima up: containers outside the local plane still run\n'
    return 0
  fi
  colima stop
}

stopWhenIdle() {
  local useToken="$1"
  local idleSeconds="${2:-$defaultIdleSeconds}"
  sleep "$idleSeconds" & wait "$!"
  if ! isTheLastUse "$useToken"; then
    return 0
  fi
  acquireLock
  if ! isTheLastUse "$useToken"; then
    return 0
  fi
  printf '%s stopping the local plane, unused since %s\n' "$(date '+%F %T')" "$useToken"
  (cd / && supabase stop --project-id "$projectIdentifier")
  stopColimaWhenNothingElseRuns
}

if [ "$1" = "--stop-when-idle" ]; then
  shift
  stopWhenIdle "$@"
  exit 0
fi

acquireLock
startStackWhenDown

export LOCAL_PLANE_LOCK_HOLDER="$$"
"$@"
