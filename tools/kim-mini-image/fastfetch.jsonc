  },
  "modules": [
    "title",
    "separator",
    { "type": "command", "key": "Intern Kim", "text": "dpkg-query -W -f='${Version}' internkim" },
    "os",
    "host",
    "kernel",
    "uptime",
    "cpu",
    "memory",
    { "type": "disk", "key": "Disk", "folders": "/" },
    "localip",
    "break",
    "colors"
  ]
}
