{
  "logo": {
    "type": "file-raw",
    "source": "/etc/xdg/fastfetch/kim-mini-logo",
    "width": 36,
    "height": 18,
    "padding": { "top": 0, "left": 2, "right": 4 }
  },
  "display": {
    "separator": "  ",
