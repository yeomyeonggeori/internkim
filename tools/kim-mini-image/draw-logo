#!/usr/bin/env python3
"""Draw the round mark as terminal text for the Kim mini login banner.

Usage: draw-logo <round mark png> <fastfetch config> <image root>

Both logos are as many columns and lines as the fastfetch config's logo says,
and are written under the image root. The logo source the config names is
drawn in braille, eight dots to a character, in the light brand blue: the blue
of the mark becomes dots and its white is left to the terminal. The same path
with -console appended is drawn in half blocks, two square pixels to a
character, for the Linux console, whose font has no braille.
"""

import json
import pathlib
import sys

from PIL import Image

BRAND_BLUE = (14, 89, 179)
LIGHT_BRAND_BLUE = (96, 156, 240)
WHITE = (255, 255, 255)
OPAQUE_ALPHA = 128
SAMPLES_PER_SIDE = 8
BRAILLE_BLANK = 0x2800
BRAILLE_DOT_BITS = ((0x01, 0x08), (0x02, 0x10), (0x04, 0x20), (0x40, 0x80))
RESET = "\x1b[0m"

Color = tuple[int, int, int]


def read_logo_settings(configuration_path: str) -> dict:
    return json.loads(pathlib.Path(configuration_path).read_text())["logo"]


def sample_mark(mark_path: str, width: int, height: int) -> list[list[Color | None]]:
    mark = Image.open(mark_path).convert("RGBA").resize((width * SAMPLES_PER_SIDE, height * SAMPLES_PER_SIDE), Image.LANCZOS)
    return [[majority_color(mark, x, y) for x in range(width)] for y in range(height)]


def majority_color(mark: Image.Image, x: int, y: int) -> Color | None:
    counts: dict[Color | None, int] = {None: 0, BRAND_BLUE: 0, WHITE: 0}
    for row in range(y * SAMPLES_PER_SIDE, (y + 1) * SAMPLES_PER_SIDE):
        for column in range(x * SAMPLES_PER_SIDE, (x + 1) * SAMPLES_PER_SIDE):
            counts[classify(mark.getpixel((column, row)))] += 1
    return max(counts, key=lambda color: counts[color])


def classify(pixel: tuple[int, int, int, int]) -> Color | None:
    *channels, alpha = pixel
    if alpha < OPAQUE_ALPHA:
        return None
    return min((BRAND_BLUE, WHITE), key=lambda color: sum((wanted - given) ** 2 for wanted, given in zip(color, channels)))


def foreground(color: Color) -> str:
    return "\x1b[38;2;{};{};{}m".format(*color)


def background(color: Color) -> str:
    return "\x1b[48;2;{};{};{}m".format(*color)


def draw_braille(mark_path: str, columns: int, lines: int) -> str:
    dots = sample_mark(mark_path, columns * 2, lines * 4)
    return "".join(draw_braille_line(dots[line * 4:line * 4 + 4], columns) + "\n" for line in range(lines))


def draw_braille_line(dot_rows: list[list[Color | None]], columns: int) -> str:
    cells = []
    for column in range(columns):
        bits = sum(BRAILLE_DOT_BITS[row][side] for row in range(4) for side in range(2) if dot_rows[row][column * 2 + side] == BRAND_BLUE)
        cells.append(" " if bits == 0 else foreground(LIGHT_BRAND_BLUE) + chr(BRAILLE_BLANK + bits) + RESET)
    return "".join(cells)


def draw_half_blocks(mark_path: str, columns: int, lines: int) -> str:
    pixels = sample_mark(mark_path, columns, lines * 2)
    return "".join("".join(draw_half_block_cell(top, bottom) for top, bottom in zip(pixels[line * 2], pixels[line * 2 + 1])) + "\n" for line in range(lines))


def draw_half_block_cell(top: Color | None, bottom: Color | None) -> str:
    if top is None and bottom is None:
        return " "
    if top is None:
        return foreground(bottom) + "▄" + RESET
    if bottom is None:
        return foreground(top) + "▀" + RESET
    if top == bottom:
        return background(top) + " " + RESET
    return foreground(top) + background(bottom) + "▀" + RESET


def write_logos(mark_path: str, configuration_path: str, image_root: str) -> None:
    logo = read_logo_settings(configuration_path)
    destination = pathlib.Path(image_root) / logo["source"].lstrip("/")
    destination.parent.mkdir(parents=True, exist_ok=True)
    destination.write_text(draw_braille(mark_path, logo["width"], logo["height"]))
    destination.with_name(destination.name + "-console").write_text(draw_half_blocks(mark_path, logo["width"], logo["height"]))


if __name__ == "__main__":
    if len(sys.argv) != 4:
        sys.exit(__doc__)
    write_logos(*sys.argv[1:])
