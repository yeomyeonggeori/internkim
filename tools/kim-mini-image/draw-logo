#!/usr/bin/env python3
"""Draw the round mark as terminal text for the Kim mini login banner.

Usage: draw-logo <round mark png> <fastfetch config> <image root>

The logo is written where the fastfetch config's logo source names, under the
image root, as many columns and lines as that config's logo says.
Each character cell holds two pixels, one above the other, drawn with half
blocks in 24-bit color, so the mark keeps square pixels. A pixel is the brand
blue, white, or left to the terminal's own background.
"""

import json
import pathlib
import sys

from PIL import Image

BRAND_BLUE = (14, 89, 179)
WHITE = (255, 255, 255)
PALETTE = (BRAND_BLUE, WHITE)
OPAQUE_ALPHA = 128
RESET = "\x1b[0m"


def read_logo_settings(configuration_path: str) -> dict:
    return json.loads(pathlib.Path(configuration_path).read_text())["logo"]


def nearest_palette_color(pixel: tuple[int, int, int, int]) -> tuple[int, int, int] | None:
    *channels, alpha = pixel
    if alpha < OPAQUE_ALPHA:
        return None
    return min(PALETTE, key=lambda color: sum((wanted - given) ** 2 for wanted, given in zip(color, channels)))


def foreground(color: tuple[int, int, int]) -> str:
    return "\x1b[38;2;{};{};{}m".format(*color)


def background(color: tuple[int, int, int]) -> str:
    return "\x1b[48;2;{};{};{}m".format(*color)


def draw_cell(top: tuple[int, int, int] | None, bottom: tuple[int, int, int] | None) -> str:
    if top is None and bottom is None:
        return " "
    if top is None:
        return foreground(bottom) + "▄" + RESET
    if bottom is None:
        return foreground(top) + "▀" + RESET
    if top == bottom:
        return foreground(top) + "█" + RESET
    return foreground(top) + background(bottom) + "▀" + RESET


def draw_logo(mark_path: str, width: int, height: int) -> str:
    mark = Image.open(mark_path).convert("RGBA").resize((width, height * 2), Image.LANCZOS)
    colors = [[nearest_palette_color(mark.getpixel((x, y))) for x in range(width)] for y in range(height * 2)]
    lines = ["".join(draw_cell(top, bottom) for top, bottom in zip(colors[row], colors[row + 1])) for row in range(0, height * 2, 2)]
    return "\n".join(lines) + "\n"


def write_logo(mark_path: str, configuration_path: str, image_root: str) -> None:
    logo = read_logo_settings(configuration_path)
    destination = pathlib.Path(image_root) / logo["source"].lstrip("/")
    destination.parent.mkdir(parents=True, exist_ok=True)
    destination.write_text(draw_logo(mark_path, logo["width"], logo["height"]))


if __name__ == "__main__":
    if len(sys.argv) != 4:
        sys.exit(__doc__)
    write_logo(*sys.argv[1:])
