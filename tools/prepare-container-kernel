#!/usr/bin/env bash
set -euo pipefail

repository_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
artifact_directory="${INTERNKIM_CONTAINER_KERNEL_DIR:-$repository_root/.dependency/container-kernel}"
kernel_version="${INTERNKIM_CONTAINER_KERNEL_VERSION:-6.1.68}"
kernel_config_reference="${INTERNKIM_CONTAINER_KERNEL_CONFIG_REF:-main}"
page_size="${INTERNKIM_CONTAINER_KERNEL_PAGE_SIZE:-4k}"
case "$page_size" in
  4k) image_name="Image-$kernel_version-kvm" ;;
  16k) image_name="Image-$kernel_version-16k-kvm" ;;
  *) echo "INTERNKIM_CONTAINER_KERNEL_PAGE_SIZE must be 4k or 16k, not $page_size" >&2; exit 1 ;;
esac
kernel_image_path="$artifact_directory/$image_name"

if [ -s "$kernel_image_path" ] && [ "${1:-}" != "--force" ]; then
  echo "$kernel_image_path"
  exit 0
fi

default_cache_directory() {
  if [ -n "${INTERNKIM_CONTAINER_KERNEL_CACHE_DIR:-}" ]; then
    echo "$INTERNKIM_CONTAINER_KERNEL_CACHE_DIR"
    return
  fi
  if [ -n "${XDG_CACHE_HOME:-}" ]; then
    echo "$XDG_CACHE_HOME/internkim/container-kernel"
    return
  fi
  if [ "$(uname -s)" = "Darwin" ]; then
    echo "$HOME/Library/Caches/internkim/container-kernel"
    return
  fi
  echo "${HOME:-/tmp}/.cache/internkim/container-kernel"
}

cache_directory="$(default_cache_directory)"
cache_image_path="$cache_directory/$image_name"

install_kernel_image() {
  local source_path="$1"
  mkdir -p "$artifact_directory" "$cache_directory"
  install -m 0644 "$source_path" "$kernel_image_path"
  if [ "$source_path" != "$cache_image_path" ]; then
    install -m 0644 "$source_path" "$cache_image_path"
  fi
  echo "$kernel_image_path"
  exit 0
}

if [ -s "$cache_image_path" ] && [ "${1:-}" != "--force" ]; then
  install_kernel_image "$cache_image_path"
fi

if command -v git >/dev/null 2>&1 && [ "${1:-}" != "--force" ]; then
  while IFS= read -r line; do
    case "$line" in
      worktree\ *)
        worktree_root="${line#worktree }"
        candidate_path="$worktree_root/.dependency/container-kernel/$image_name"
        if [ -s "$candidate_path" ]; then
          install_kernel_image "$candidate_path"
        fi
        ;;
    esac
  done < <(git -C "$repository_root" worktree list --porcelain 2>/dev/null || true)
fi

require_command() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "missing required command: $1" >&2
    exit 1
  fi
}

require_command container
require_command curl

stage_directory="$(mktemp -d "${TMPDIR:-/tmp}/internkim-container-kernel.XXXXXX")"
cleanup() {
  rm -rf "$stage_directory"
}
trap cleanup EXIT

curl -fsSL -o "$stage_directory/config-arm64" \
  "https://raw.githubusercontent.com/apple/containerization/$kernel_config_reference/kernel/config-arm64"
grep -q '^CONFIG_VIRTUALIZATION=y' "$stage_directory/config-arm64"
grep -q '^CONFIG_KVM=y' "$stage_directory/config-arm64"
if [ "$page_size" = "16k" ]; then
  # Raspberry Pi's arch/arm64/configs/bcm2712_defconfig, the CM5 kernel.
  sed -i.original \
    -e 's/^CONFIG_ARM64_4K_PAGES=y/# CONFIG_ARM64_4K_PAGES is not set/' \
    -e 's/^# CONFIG_ARM64_16K_PAGES is not set/CONFIG_ARM64_16K_PAGES=y/' \
    -e '/^CONFIG_ARM64_VA_BITS/d' -e '/^CONFIG_PGTABLE_LEVELS/d' \
    "$stage_directory/config-arm64"
  echo "CONFIG_ARM64_VA_BITS_47=y" >> "$stage_directory/config-arm64"
fi

cat > "$stage_directory/build-kernel.sh" <<BUILD
#!/bin/sh
set -eu
apk add --no-cache build-base bc bison flex openssl-dev perl python3 elfutils-dev linux-headers findutils xz curl rsync >/dev/null
mkdir -p /build
cd /build
if [ ! -f /work/linux.tar.xz ]; then
  curl -sL -o /work/linux.tar.xz "https://cdn.kernel.org/pub/linux/kernel/v6.x/linux-$kernel_version.tar.xz"
fi
tar xf /work/linux.tar.xz
cd "linux-$kernel_version"
cp /work/config-arm64 .config
make olddefconfig >/dev/null
make -j"\$(nproc)" Image
cp arch/arm64/boot/Image /work/Image
echo KERNEL-BUILD-DONE
BUILD

container run --rm --cpus 10 --memory 8g --volume "$stage_directory:/work" alpine:latest sh /work/build-kernel.sh >&2

mkdir -p "$artifact_directory"
install -m 0644 "$stage_directory/Image" "$kernel_image_path"
mkdir -p "$cache_directory"
install -m 0644 "$stage_directory/Image" "$cache_image_path"
echo "$kernel_image_path"
