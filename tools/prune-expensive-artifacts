#!/bin/bash
set -euo pipefail

keep_count="${1:-5}"
repository_root="$(cd "$(dirname "$0")/.." && pwd)"
artifact_root="$repository_root/.artifacts/expensive"
[ -d "$artifact_root" ] || exit 0
cd "$artifact_root"

# Removing a tree macOS has just finished reading can fail transiently with
# "Directory not empty". Retry before giving up, and never let one run's failure
# abandon the rest: the archive already exists, so stopping here would leave both
# copies on disk and reclaim nothing.
remove_archived_run() {
  local run="$1"
  local attempt
  for attempt in 1 2 3; do
    rm -rf "$run" 2>/dev/null || true
    [ -d "$run" ] || return 0
    sleep 1
  done
  [ -d "$run" ] && return 1
  return 0
}

runs="$(find . -maxdepth 1 -type d -name 'expensive-*' | sed 's|^\./||' | sort -r)"
index=0
for run in $runs; do
  index=$((index + 1))
  if [ "$index" -le "$keep_count" ]; then
    continue
  fi
  archive="$run.tar.gz"
  tar -czf "$archive.partial" "$run"
  tar -tzf "$archive.partial" >/dev/null
  mv "$archive.partial" "$archive"
  if ! remove_archived_run "$run"; then
    echo "archived $run but could not remove the directory; both copies remain" >&2
    continue
  fi
  echo "archived $run"
done
