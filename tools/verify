GROUP_NAMES = {group.name for group in GROUPS}
for declared in GROUPS:
    if declared.lane not in GROUP_NAMES:
        raise SystemExit(f"{declared.name} runs in lane {declared.lane!r}, which is not a group")


def changed_paths_against(base):
    difference = subprocess.run(
        ["git", "diff", "--name-only", f"{base}...HEAD"],
        cwd=REPOSITORY_ROOT,
        capture_output=True,
        text=True,
    )
    uncommitted = subprocess.run(
        ["git", "status", "--porcelain"],
        cwd=REPOSITORY_ROOT,
        capture_output=True,
        text=True,
    )
    paths = set(difference.stdout.split())
    paths.update(line[3:] for line in uncommitted.stdout.splitlines() if line[3:])
    return sorted(paths)


def run_group(group):
    started = time.monotonic()
    for command in group.commands:
        attempted = " ".join(command)
        try:
            finished = subprocess.run(
                command,
                cwd=REPOSITORY_ROOT / group.working_directory,
                capture_output=True,
                text=True,
            )
        except OSError as error:
            return group.name, False, time.monotonic() - started, f"$ {attempted}\n{error}"
        if finished.returncode != 0:
            output = f"$ {attempted}\n{finished.stdout}{finished.stderr}"
            return group.name, False, time.monotonic() - started, output
    return group.name, True, time.monotonic() - started, ""


def run_lane(groups):
    return [run_group(group) for group in groups]


def lanes_of(groups):
    lanes = {}
    for group in groups:
        lanes.setdefault(group.lane, []).append(group)
    return list(lanes.values())


def groups_to_run(arguments):
    if arguments.only:
        wanted = set(arguments.only.split(","))
        named = [group for group in GROUPS if group.name in wanted]
        unknown = wanted - {group.name for group in named}
        if unknown:
            raise SystemExit(f"no such group: {', '.join(sorted(unknown))}")
        return named
    if arguments.all:
        return GROUPS
    changed = changed_paths_against(arguments.base)
    return [group for group in GROUPS if group.is_touched_by(changed)]


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--base", default="origin/main", help="what to compare against")
    parser.add_argument("--all", action="store_true", help="run every group, not only the touched ones")
    parser.add_argument("--only", help="comma-separated group names")
    groups = groups_to_run(parser.parse_args())

    if not groups:
        print("nothing this change can break")
        return 0

    print(f"running {', '.join(group.name for group in groups)}")
    lanes = lanes_of(groups)
    failed = []
    with concurrent.futures.ThreadPoolExecutor(max_workers=len(lanes)) as pool:
        for lane_results in pool.map(run_lane, lanes):
            for name, passed, seconds, output in lane_results:
                print(f"{'ok  ' if passed else 'FAIL'} {name} ({seconds:.0f}s)")
                if not passed:
                    failed.append((name, output))

    for name, output in failed:
        print(f"\n=== {name} ===\n{output}")
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
