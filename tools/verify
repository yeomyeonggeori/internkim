class Group:
    def __init__(self, name, patterns, commands, working_directory=".", lane=None, fills_the_machine=False):
        self.name = name
        self.patterns = patterns
        self.commands = commands
        self.working_directory = working_directory
        self.lane = lane or name
        self.fills_the_machine = fills_the_machine

    def is_touched_by(self, changed_paths):
        return any(self.matches(path) for path in changed_paths)

    def matches(self, path):
        return any(fnmatch.fnmatch(path, pattern) for pattern in self.patterns)

    def narrowed_to(self, changed_paths):
        return self

    def needs_the_local_plane(self, command):
        return command[0] == WITH_LOCAL_PLANE

    def command_to_run(self, command):
        if not self.fills_the_machine:
            return command
        holder = machine_slot_holder()
        if command[0] == WITH_LOCAL_PLANE:
            return [WITH_LOCAL_PLANE, *holder, *command[1:]]
        if self.needs_the_local_plane(command):
            return [WITH_LOCAL_PLANE, *holder, *command]
        return [*holder, *command]


END_TO_END_DIRECTORY = REPOSITORY_ROOT / "web" / "tests" / "e2e"
AREA_ROOTS = ("web/src/routes/", "web/src/lib/", "web/tests/e2e/")
DATABASE_PATTERNS = ("supabase/migrations/*", "supabase/seed.dev.sql")
PLANES_WITHOUT_THE_DATABASE = ("fixture", "mocked", "standalone")


def end_to_end_areas():
    return sorted(path.name for path in END_TO_END_DIRECTORY.iterdir() if path.is_dir() and path.name != "support")


def end_to_end_area_of(path, areas):
    root = next((root for root in AREA_ROOTS if path.startswith(root)), None)
    if root is None:
        return None
    area = path[len(root):].split("/", 1)[0]
    return area if area in areas else None


class EndToEndGroup(Group):
    def __init__(self, name, patterns, lane):
        super().__init__(name, patterns, [["scripts/e2e.sh"]], working_directory="web", lane=lane, fills_the_machine=True)

    def needs_the_local_plane(self, command):
        asked = subprocess.run([command[0], NEEDS_THE_LOCAL_PLANE, *command[1:]], cwd=REPOSITORY_ROOT / self.working_directory, capture_output=True)
        return asked.returncode == 0

    def narrowed_to(self, changed_paths):
        touched = [path for path in changed_paths if self.matches(path)]
        database_paths = [path for path in touched if reaches_only_the_database(path)]
        known_areas = end_to_end_areas()
        areas = {end_to_end_area_of(path, known_areas) for path in touched if path not in database_paths}
        if None in areas:
            return self
        commands = [["scripts/e2e.sh", "--project=central"]] if database_paths else []
        if areas:
            planes = [f"--project={plane}" for plane in PLANES_WITHOUT_THE_DATABASE] if database_paths else []
            commands.append(["scripts/e2e.sh", *planes, *(f"tests/e2e/{area}" for area in sorted(areas))])
        narrowed = EndToEndGroup(self.name, self.patterns, self.lane)
        narrowed.commands = commands
        return narrowed


def reaches_only_the_database(path):
    return any(fnmatch.fnmatch(path, pattern) for pattern in DATABASE_PATTERNS)


