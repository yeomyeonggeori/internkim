def changed_paths_against(base):
    committed = git_paths(["diff", "--name-only", "--no-renames", "-z", f"{base}...HEAD"], f"cannot compare HEAD with {base}")
    uncommitted = git_paths(["diff", "--name-only", "--no-renames", "-z", "HEAD"], "cannot read uncommitted changes")
    untracked = git_paths(["ls-files", "--others", "--exclude-standard", "-z"], "cannot list untracked files")
    return sorted(committed | uncommitted | untracked)


def git_paths(arguments, failure):
    listing = subprocess.run(["git", *arguments], cwd=REPOSITORY_ROOT, capture_output=True, text=True)
    if listing.returncode != 0:
        raise SystemExit(f"{failure}: {listing.stderr.strip()}")
    return {path for path in listing.stdout.split("\0") if path}


def machine_slot_holder():
    return [sys.executable, str(Path(__file__).resolve()), HOLD_A_MACHINE_SLOT, str(MACHINE_SLOT_DIRECTORY), str(MACHINE_SLOTS), "--"]


def claim_free_machine_slot(slot_directory, slot_count):
    for index in range(slot_count):
        handle = (slot_directory / f"internkim-verify-slot-{index}.lock").open("a")
        try:
            fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return handle
        except BlockingIOError:
            handle.close()
    return None


def run_holding_a_machine_slot(slot_directory, slot_count, command):
    slot = claim_free_machine_slot(slot_directory, slot_count)
    if slot is None:
        print(f"waiting for one of {slot_count} machine slots", file=sys.stderr, flush=True)
    while slot is None:
        time.sleep(2)
        slot = claim_free_machine_slot(slot_directory, slot_count)
    with slot:
        return subprocess.run(command).returncode


def run_group(group):
    input_key = group_input_key(group) if reusing_passes else None
    if input_key and (PASSED_GROUP_DIRECTORY / input_key).exists():
        print(f"same {group.name}: it passed on these inputs before", flush=True)
        return group.name, True, None, ""
    result = run_group_commands(group)
    if input_key and result[1]:
        PASSED_GROUP_DIRECTORY.mkdir(parents=True, exist_ok=True)
        (PASSED_GROUP_DIRECTORY / input_key).write_text(f"{group.name}\n{REPOSITORY_ROOT}\n{time.strftime('%Y-%m-%d %H:%M:%S')}\n")
    return result


def group_input_key(group):
    digest = hashlib.sha256()
    digest.update(Path(__file__).read_bytes())
    digest.update(repr((group.name, group.working_directory, group.commands, tool_versions())).encode())
    for path, mode in repository_entries():
        if not group.matches(path):
            continue
        content = entry_content(path, mode)
        if content is None:
            return None
        digest.update(path.encode() + b"\0" + content + b"\0")
    return digest.hexdigest()


def entry_content(path, mode):
    full_path = REPOSITORY_ROOT / path
    if mode == "160000":
        return submodule_content(full_path)
    if full_path.is_symlink():
        return b"link " + os.readlink(full_path).encode()
    if not full_path.is_file():
        return b"absent"
    return hashlib.sha256(full_path.read_bytes()).digest()


def submodule_content(full_path):
    def git(*arguments):
        return subprocess.run(["git", *arguments], cwd=full_path, capture_output=True, text=True)

    top_level = git("rev-parse", "--show-toplevel")
    if top_level.returncode != 0 or Path(top_level.stdout.strip()).resolve() != full_path.resolve():
        return None
    status = git("status", "--porcelain", "--ignore-submodules=none")
    commit = git("rev-parse", "HEAD")
    if status.returncode != 0 or commit.returncode != 0 or status.stdout.strip():
        return None
    return b"commit " + commit.stdout.strip().encode()


@functools.cache
def repository_entries():
    tracked = subprocess.run(["git", "ls-files", "--stage", "-z"], cwd=REPOSITORY_ROOT, capture_output=True, text=True, check=True)
    entries = {}
    for record in tracked.stdout.split("\0"):
        if not record:
            continue
        metadata, path = record.split("\t", 1)
        entries[path] = metadata.split(" ", 1)[0]
    for path in git_paths(["ls-files", "--others", "--exclude-standard", "-z"], "cannot list untracked files"):
        entries[path] = "untracked"
    return sorted(entries.items())


@functools.cache
def tool_versions():
    commands = [["go", "version"], ["bun", "--version"], [sys.executable, "--version"]]
    return tuple(subprocess.run(command, capture_output=True, text=True).stdout.strip() for command in commands)


def run_group_commands(group):
    started = time.monotonic()
    group_log_directory = verification_run_directory / group.name
    group_log_directory.mkdir(parents=True, exist_ok=True)
    print(f"start {group.name}", flush=True)
    for command_index, command in enumerate(group.commands, 1):
        attempted = shlex.join(command)
        log_path = group_log_directory / f"{command_index}.log"
        print(f"run  {group.name} {command_index}/{len(group.commands)} · {log_path}", flush=True)
        try:
            with log_path.open("w") as log:
                log.write(f"$ {attempted}\n")
                log.flush()
                finished = subprocess.run(group.command_to_run(command), cwd=REPOSITORY_ROOT / group.working_directory, stdout=log, stderr=subprocess.STDOUT)
        except OSError as error:
            log_path.write_text(f"$ {attempted}\n{error}\n")
            print(f"FAIL {group.name} command {command_index}", flush=True)
            return group.name, False, time.monotonic() - started, f"$ {attempted}\n{error}"
        if finished.returncode != 0:
            failure = f"$ {attempted}\nexit {finished.returncode}; full output: {log_path}"
            print(f"FAIL {group.name} command {command_index}", flush=True)
            return group.name, False, time.monotonic() - started, failure
        print(f"done {group.name} command {command_index}", flush=True)
    print(f"done {group.name}", flush=True)
    return group.name, True, time.monotonic() - started, ""


def run_lane(groups):
    return [run_group(group) for group in groups]


def lanes_of(groups):
    lanes = {}
    for group in groups:
        lanes.setdefault(group.lane, []).append(group)
    return list(lanes.values())


def groups_to_run(arguments):
    if arguments.only:
        wanted = set(arguments.only.split(","))
        named = [group for group in GROUPS if group.name in wanted]
        unknown = wanted - {group.name for group in named}
        if unknown:
            raise SystemExit(f"no such group: {', '.join(sorted(unknown))}")
        return named
    if arguments.all:
        return GROUPS
    changed = changed_paths_against(arguments.base)
    return [group.narrowed_to(changed) for group in GROUPS if group.is_touched_by(changed)]


def print_plan(groups):
    for group in groups:
        print(f"{group.name} [lane={group.lane}]")
        for command in group.commands:
            print(f"  {' '.join(command)}")


def main():
    global verification_run_directory, reusing_passes
    if sys.argv[1:2] == [HOLD_A_MACHINE_SLOT]:
        slot_directory, slot_count, separator, *command = sys.argv[2:]
        return run_holding_a_machine_slot(Path(slot_directory), int(slot_count), command)
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--base", default="origin/main", help="what to compare against")
    parser.add_argument("--all", action="store_true", help="run every group, not only the touched ones")
    parser.add_argument("--only", help="comma-separated group names")
    parser.add_argument("--plan", action="store_true", help="show selected groups and commands without running them")
    arguments = parser.parse_args()
    groups = groups_to_run(arguments)
    reusing_passes = not (arguments.all or arguments.only)

    if arguments.plan:
        print_plan(groups)
        return 0

    if not groups:
        print("nothing this change can break")
        return 0

    print(f"running {', '.join(group.name for group in groups)}", flush=True)
    verification_run_directory = VERIFICATION_ARTIFACTS / time.strftime("%Y%m%d-%H%M%S") / uuid.uuid4().hex[:8]
    lanes = lanes_of(groups)
    failed = []
    with concurrent.futures.ThreadPoolExecutor(max_workers=len(lanes)) as pool:
        futures = [pool.submit(run_lane, lane) for lane in lanes]
        for future in concurrent.futures.as_completed(futures):
            for name, passed, seconds, output in future.result():
                took = "unchanged since it passed" if seconds is None else f"{seconds:.0f}s"
                print(f"{'ok  ' if passed else 'FAIL'} {name} ({took})", flush=True)
                if not passed:
                    failed.append((name, output))

    for name, output in failed:
        print(f"\n=== {name} ===\n{output}")
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
