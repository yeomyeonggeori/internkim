#!/usr/bin/env python3
"""Run the checks a change needs, before it is pushed.

This is the whole check, and this machine is where it runs; AGENTS.md says why
no GitHub Actions workflow runs it for you.

Groups run at once and their output is held until they finish, so a slow one
never hides a fast one's failure. Groups that name the same lane share
something a second process would corrupt, so they run one after another, in the
order they are declared here; a lane runs every group in it even after one
fails, because the ones after it have their own verdict to give.
"""

import argparse
import concurrent.futures
import fnmatch
import subprocess
import sys
import time
from pathlib import Path

REPOSITORY_ROOT = Path(__file__).resolve().parent.parent


class Group:
    def __init__(self, name, patterns, commands, working_directory=".", lane=None):
        self.name = name
        self.patterns = patterns
        self.commands = commands
        self.working_directory = working_directory
        self.lane = lane or name

    def is_touched_by(self, changed_paths):
        return any(
            fnmatch.fnmatch(path, pattern)
            for path in changed_paths
            for pattern in self.patterns
        )


BUN_INSTALL = ["bun", "install", "--frozen-lockfile"]

GROUPS = [
    Group(
        "blueclaw-pointer",
        [".dependency/blueclaw*"],
        [["tools/verify-blueclaw-pointer"]],
