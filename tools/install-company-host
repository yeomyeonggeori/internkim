#!/usr/bin/env python3

import argparse
import getpass
import json
import os
from pathlib import Path
import re
import secrets
import shutil
import subprocess
import sys
from urllib.parse import urlparse
from uuid import UUID


def text_field(document, name):
    value = document.get(name)
    if not isinstance(value, str) or not value.strip() or any(character in value for character in "\r\n\0"):
        raise ValueError(f"The connection file has no valid {name}. Download it again from company setup.")
    return value


def object_field(document, name):
    value = document.get(name)
    if not isinstance(value, dict):
        raise ValueError(f"The connection file has no {name} section. Download it again from company setup.")
    return value


def validate_address(address, protocols):
    parsed = urlparse(address)
    if parsed.scheme not in protocols or not parsed.hostname or parsed.username or parsed.password or parsed.fragment:
        raise ValueError("The connection file contains an invalid service address.")
    return address.rstrip("/")


def read_configuration(path):
    document = json.loads(path.read_text())
    if not isinstance(document, dict) or type(document.get("schemaVersion")) is not int or document["schemaVersion"] != 1:
        raise ValueError("This installer needs a version 1 connection file from company setup.")
    company = object_field(document, "company")
    central_plane = object_field(document, "centralPlane")
    UUID(text_field(company, "id"))
    text_field(company, "name")
    text_field(company, "slug")
    text_field(central_plane, "publishableKey")
    validate_address(text_field(document, "appURL"), {"https", "http"})
    validate_address(text_field(central_plane, "projectURL"), {"https", "http"})
    validate_address(text_field(document, "gatewayURL"), {"wss", "ws"})
    if not re.fullmatch(r"[a-f0-9]{64}", text_field(document, "agentKey")):
        raise ValueError("The connection file contains an invalid company key.")
    return document


def run_command(arguments, *, capture=False, environment=None):
    return subprocess.run(arguments, check=True, text=True, capture_output=capture, env=environment)


def check_docker():
    if not shutil.which("docker"):
        raise ValueError("Install Docker, then run this command again. See the Quickstart prerequisites.")
    run_command(["docker", "compose", "version"], capture=True)
    operating_system = run_command(["docker", "info", "--format", "{{.OSType}}"], capture=True).stdout.strip()
    if operating_system != "linux":
        raise ValueError("Start Docker with Linux containers, then run this command again.")


def private_write(path, content):
    descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(descriptor, "w") as output:
        os.fchmod(output.fileno(), 0o600)
        output.write(content)


def keep_secret(directory, name):
    path = directory / name
    if path.exists():
        path.chmod(0o600)
        value = path.read_text().strip()
        if not re.fullmatch(r"[a-f0-9]{64}", value):
            raise ValueError(f"Saved {name} is invalid. Restore it from backup; it will not be replaced.")
        return value
    value = secrets.token_hex(32)
    private_write(path, value + "\n")
    return value


def prepare_directory(directory, configuration):
    previous = directory / "connection.json"
    if previous.exists() and read_configuration(previous)["company"]["id"] != configuration["company"]["id"]:
        raise ValueError("This directory belongs to another company. Choose a different --state-directory.")
    directory.mkdir(parents=True, exist_ok=True, mode=0o700)
    directory.chmod(0o700)
    secret_directory = directory / "secrets"
    secret_directory.mkdir(exist_ok=True, mode=0o700)
    secret_directory.chmod(0o700)
    private_write(previous, json.dumps(configuration, indent=2) + "\n")
    private_write(secret_directory / "agent-key", configuration["agentKey"] + "\n")
    return secret_directory


def keep_model_key(directory, key_file):
    destination = directory / "openrouter-key"
    if destination.exists() and not key_file:
        if not destination.read_text().strip():
            raise ValueError("The saved OpenRouter key is empty. Supply --model-key-file to replace it.")
        destination.chmod(0o600)
        return
    value = key_file.read_text().strip() if key_file else getpass.getpass("OpenRouter API key (hidden): ").strip()
    if not value or any(character.isspace() for character in value):
        raise ValueError("Enter the OpenRouter API key from your account's Keys page.")
    private_write(destination, value + "\n")


def build_images(repository, revision, buzz_image):
    base_image = f"internkim-host:{revision}"
    host_image = f"internkim-company-host:{revision}"
    run_command(["docker", "build", "--tag", base_image, "--file", str(repository / "host/Dockerfile"), str(repository)])
    run_command([
        "docker", "build", "--tag", host_image,
        "--build-arg", f"HOST_IMAGE={base_image}", "--build-arg", f"BUZZ_IMAGE={buzz_image}",
        "--file", str(repository / "host/quickstart/Dockerfile"), str(repository)
    ])
    return host_image


def derive_identity(secret_directory, host_image):
    keep_secret(secret_directory, "buzz-key-seed")
    run_command([
        "docker", "run", "--rm", "--user", f"{os.getuid()}:{os.getgid()}",
        "--mount", f"type=bind,source={secret_directory},target=/secrets",
        "--entrypoint", "/usr/local/bin/internkim-host-identity", host_image,
        "--seed", "/secrets/buzz-key-seed", "--output", "/secrets/identity.json"
    ])
    return json.loads((secret_directory / "identity.json").read_text())


def installation_environment(configuration, directory, host_image, buzz_image, identity):
    secret_directory = directory / "secrets"
    password = keep_secret(secret_directory, "postgres-password")
    relay_key = keep_secret(secret_directory, "buzz-relay-key")
    database_address = f"postgres://internkim:{password}@127.0.0.1:5432"
    private_write(secret_directory / "buzz-database.env", f"DATABASE_URL={database_address}/buzz?sslmode=disable\n")
    private_write(secret_directory / "buzz-relay.env", f"BUZZ_RELAY_PRIVATE_KEY={relay_key}\n")
    return {
        "COMPOSE_PROJECT_NAME": f'internkim-{configuration["company"]["id"]}',
        "HOST_STATE_DIRECTORY": str(directory), "HOST_IMAGE": host_image, "BUZZ_IMAGE": buzz_image,
        "SUPABASE_URL": configuration["centralPlane"]["projectURL"],
        "SUPABASE_PUBLISHABLE_KEY": configuration["centralPlane"]["publishableKey"],
        "INTERNKIM_APP_URL": configuration["appURL"], "GATEWAY_URL": configuration["gatewayURL"],
        "DATABASE_URL": f"{database_address}/blueclaw?sslmode=disable",
        "BUZZ_DATABASE_URL": f"{database_address}/buzz?sslmode=disable", "BUZZ_RELAY_PRIVATE_KEY": relay_key,
        "RELAY_OWNER_PUBKEY": identity["relayOwnerPublicKey"], "CHATD_BUZZ_PRIVATE_KEY": identity["agentPrivateKey"],
        "MEDIA_ACCESS_KEY": keep_secret(secret_directory, "media-access-key"),
        "MEDIA_SECRET_KEY": keep_secret(secret_directory, "media-secret-key")
    }


def quote_environment_value(value):
    escaped = value.replace("'", "\\'")
    return f"'{escaped}'"


def compose_environment_text(environment):
    return "".join(f"{name}={quote_environment_value(value)}\n" for name, value in environment.items())


def keep_compose_files(repository, directory):
    for name in ("compose.yaml", "01-buzz.sql"):
        destination = directory / name
        shutil.copyfile(repository / "host/quickstart" / name, destination)
        destination.chmod(0o644)


def installation_arguments():
    parser = argparse.ArgumentParser(description="Install the company computer using its downloaded connection file.")
    parser.add_argument("configuration", type=Path, help="internkim-host.json downloaded from company setup")
    parser.add_argument("--state-directory", type=Path, help="persistent private installation directory")
    parser.add_argument("--model-key-file", type=Path, help="read the OpenRouter key from this private file")
    return parser.parse_args()


def install(arguments):
    configuration = read_configuration(arguments.configuration.expanduser())
    repository = Path(__file__).resolve().parent.parent
    directory = (arguments.state_directory or Path.home() / ".internkim/companies" / configuration["company"]["id"]).expanduser().resolve()
    print("1/4 Checking Docker and the source checkout…", flush=True)
    check_docker()
    revision = run_command(["git", "-C", str(repository), "rev-parse", "--short=12", "HEAD"], capture=True).stdout.strip()
    if not (repository / ".dependency/blueclaw/.dependency/bluecollar/go.mod").is_file():
        raise ValueError("Run git submodule update --init --recursive in the source directory, then try again.")
    secret_directory = prepare_directory(directory, configuration)
    keep_model_key(secret_directory, arguments.model_key_file)
    buzz_image = (repository / "host/quickstart/buzz-image").read_text().strip()
    print("2/4 Building the company server. The first build can take several minutes…", flush=True)
    host_image = build_images(repository, revision, buzz_image)
    print("3/4 Keeping the company's keys and data on this computer…", flush=True)
    identity = derive_identity(secret_directory, host_image)
    environment = installation_environment(configuration, directory, host_image, buzz_image, identity)
    environment_path = directory / "compose.env"
    private_write(environment_path, compose_environment_text(environment))
    keep_compose_files(repository, directory)
    compose = ["docker", "compose", "--env-file", str(environment_path), "--file", str(directory / "compose.yaml")]
    print("4/4 Starting the server and waiting for it to answer…", flush=True)
    run_command([*compose, "up", "--detach", "--wait", "--wait-timeout", "240"], environment={**os.environ, **environment})
    print(f'\nServer ready. Open {configuration["appURL"]}/settings/setup and choose Check connection.')
    print(f'Private settings: {directory}\nDocker restarts the server when Docker starts. Keep this computer awake.')


def main():
    try:
        install(installation_arguments())
    except subprocess.CalledProcessError as error:
        print(f"\nInstallation stopped: {error.cmd[0]} exited with status {error.returncode}.", file=sys.stderr)
        if error.cmd[:2] in (["docker", "info"], ["docker", "compose"]):
            print("Check that Docker is running and that your account can use it. Your saved company data was kept.", file=sys.stderr)
        return 1
    except (OSError, ValueError) as error:
        print(f"\nInstallation stopped: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
