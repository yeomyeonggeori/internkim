#!/usr/bin/env bash
set -euo pipefail

madeOn="$(date +%Y-%m-%d)"
image=""
disk=""

usage() {
  cat <<USAGE
Usage:
  tools/flash-kim-mini <kim-mini-*.img.xz> <diskN> [--made-on YYYY-MM-DD]

Writes a Kim mini image from tools/build-kim-mini-image to an SD card on a Mac,
then records the day the box was made (today unless --made-on is given) in
internkim-made-on on the card's boot partition. The setup network shows that
day in its name. The disk must be an SD card or USB disk; list disks with \`diskutil list external\`.
Writing needs sudo and erases the card.
USAGE
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --made-on) madeOn="$2"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *)
      if [ -z "$image" ]; then image="$1"; elif [ -z "$disk" ]; then disk="${1#/dev/}"; else echo "unknown argument: $1" >&2; usage >&2; exit 1; fi
      shift ;;
  esac
done
[ -n "$image" ] && [ -n "$disk" ] || { usage >&2; exit 1; }
[ -f "$image" ] || { echo "no image at $image" >&2; exit 1; }
date -j -f %Y-%m-%d "$madeOn" +%Y-%m-%d >/dev/null 2>&1 || { echo "--made-on is YYYY-MM-DD, and was given $madeOn" >&2; exit 1; }

diskInformation="$(diskutil info "$disk")" || { echo "there is no disk named $disk" >&2; exit 1; }
if ! printf '%s\n' "$diskInformation" | grep -Eq 'Protocol: +(USB|Secure Digital)$' || printf '%s\n' "$diskInformation" | grep -Eq 'Virtual: +Yes'; then
  echo "$disk is not an SD card or USB disk, so it is not written" >&2
  exit 1
fi
printf '%s\n' "$diskInformation" | grep -E 'Device / Media Name|Disk Size' || true
read -r -p "Erase $disk and write $(basename "$image") to it? Type the disk name to go on: " typed
[ "$typed" = "$disk" ] || { echo "nothing was written" >&2; exit 1; }

diskutil unmountDisk "/dev/$disk"
xz -dc "$image" | sudo dd of="/dev/r$disk" bs=4m
sync
diskutil mountDisk "/dev/$disk" >/dev/null
bootVolume="$(diskutil info "${disk}s1" | sed -n 's/^ *Mount Point: *//p')"
[ -n "$bootVolume" ] || { echo "the card's boot partition did not mount, so internkim-made-on was not written" >&2; exit 1; }
printf '%s\n' "$madeOn" > "$bootVolume/internkim-made-on"
for attempt in 1 2 3 4 5; do
  diskutil eject "/dev/$disk" >/dev/null 2>&1 && break
  [ "$attempt" -lt 5 ] || { echo "the card is written, but macOS would not let go of it; eject $disk from Finder" >&2; exit 1; }
  sleep 2
done
echo "wrote $(basename "$image") to $disk, made on $madeOn"
