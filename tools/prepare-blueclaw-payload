#!/usr/bin/env bash
set -euo pipefail

repository_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
artifact_directory="${INTERNKIM_BLUECLAW_PAYLOAD_ARTIFACT_DIR:-$repository_root/.dependency/blueclaw-payload}"
stage_directory="${TMPDIR:-/tmp}/internkim-blueclaw-payload-stage"
blueclaw_repository="$repository_root/.dependency/blueclaw"
rtk_binary="$repository_root/build/board-bin/rtk"
rtk_download_url="https://github.com/rtk-ai/rtk/releases/latest/download/rtk-aarch64-unknown-linux-gnu.tar.gz"

require_command() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "missing required command: $1" >&2
    exit 1
  fi
}

require_command go
require_command git
require_command python3

prepare_rtk_binary() {
  if [ -x "$rtk_binary" ]; then
    return
  fi

  require_command curl
  require_command tar

  mkdir -p "$(dirname "$rtk_binary")"
  curl -fsSL "$rtk_download_url" -o "$stage_directory/rtk.tar.gz"
  tar -xzf "$stage_directory/rtk.tar.gz" -C "$stage_directory" rtk
  install -m 0755 "$stage_directory/rtk" "$rtk_binary"
}

dirty_suffix() {
  local tracked_diff_file untracked_file hash_value
  tracked_diff_file="$(mktemp)"
  untracked_file="$(mktemp)"
  git -C "$blueclaw_repository" diff HEAD > "$tracked_diff_file"
  git -C "$blueclaw_repository" ls-files --others --exclude-standard > "$untracked_file"
  if [ ! -s "$tracked_diff_file" ] && [ ! -s "$untracked_file" ]; then
    rm -f "$tracked_diff_file" "$untracked_file"
    return
  fi
  if command -v sha256sum >/dev/null 2>&1; then
    hash_value="$(cat "$tracked_diff_file" "$untracked_file" | sha256sum | awk '{print $1}')"
  else
    hash_value="$(cat "$tracked_diff_file" "$untracked_file" | shasum -a 256 | awk '{print $1}')"
  fi
  rm -f "$tracked_diff_file" "$untracked_file"
  printf "dirty-%s" "${hash_value:0:12}"
}

blueclaw_revision="$(git -C "$blueclaw_repository" rev-parse HEAD)"
blueclaw_dirty_suffix="$(dirty_suffix)"
if [ -n "$blueclaw_dirty_suffix" ]; then
  blueclaw_revision="$blueclaw_revision-$blueclaw_dirty_suffix"
fi
release_directory="$stage_directory/workspace/.blueclaw/runtime/releases/$blueclaw_revision"
current_directory="$stage_directory/workspace/.blueclaw/runtime/current"

rm -rf "$stage_directory"
mkdir -p "$release_directory/bin" "$release_directory/migrations" "$current_directory/bin" "$current_directory/migrations"
prepare_rtk_binary

(
  cd "$blueclaw_repository"
  GOOS=linux GOARCH=arm64 CGO_ENABLED=0 go build -o "$release_directory/bin/blueclaw" ./cmd/blueclaw
)

install -m 0755 "$rtk_binary" "$release_directory/bin/rtk"
rsync -a --delete --exclude '._*' --exclude '.DS_Store' "$blueclaw_repository/migrations/" "$release_directory/migrations/"
rsync -a --delete "$release_directory/" "$current_directory/"

python3 - "$stage_directory" "$artifact_directory/manifest.json" "$blueclaw_revision" <<'PY'
import hashlib
import json
import os
import pathlib
import shutil
import sys

stage_directory = pathlib.Path(sys.argv[1])
manifest_path = pathlib.Path(sys.argv[2])
blueclaw_revision = sys.argv[3]
current_directory = stage_directory / "workspace" / ".blueclaw" / "runtime" / "current"
blueclaw_binary_path = current_directory / "bin" / "blueclaw"
rtk_binary_path = current_directory / "bin" / "rtk"
migrations_directory = current_directory / "migrations"

def file_sha256(file_path):
    hash_value = hashlib.sha256()
    with open(file_path, "rb") as file:
        for chunk in iter(lambda: file.read(1024 * 1024), b""):
            hash_value.update(chunk)
    return hash_value.hexdigest()

def directory_sha256(directory_path):
    hash_value = hashlib.sha256()
    file_paths = sorted(path for path in directory_path.rglob("*") if path.is_file() and not is_apple_metadata(path))
    for file_path in file_paths:
        relative_path = file_path.relative_to(directory_path).as_posix()
        hash_value.update(relative_path.encode())
        hash_value.update(b"\n")
        with open(file_path, "rb") as file:
            for chunk in iter(lambda: file.read(1024 * 1024), b""):
                hash_value.update(chunk)
        hash_value.update(b"\n")
    return hash_value.hexdigest()

def is_apple_metadata(file_path):
    return file_path.name == ".DS_Store" or file_path.name.startswith("._")

manifest = {
    "runtimeName": "internkim-blueclaw-payload",
    "platform": "linux-arm64",
    "blueclawRevision": blueclaw_revision,
    "blueclawSHA256": file_sha256(blueclaw_binary_path),
    "rtkSHA256": file_sha256(rtk_binary_path),
    "migrationsSHA256": directory_sha256(migrations_directory),
}

document = json.dumps(manifest, indent=2, ensure_ascii=False) + "\n"
(current_directory / "manifest.json").write_text(document, encoding="utf-8")
(stage_directory / "workspace" / ".blueclaw" / "runtime" / "releases" / blueclaw_revision / "manifest.json").write_text(document, encoding="utf-8")

artifact_directory = manifest_path.parent
if artifact_directory.exists():
    shutil.rmtree(artifact_directory)
artifact_directory.mkdir(parents=True)
shutil.copytree(stage_directory / "workspace", artifact_directory / "workspace", symlinks=True)
manifest_path.write_text(document, encoding="utf-8")
PY

echo "$artifact_directory"
