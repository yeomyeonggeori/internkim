DESIGN_DOCUMENT = """---
colors:
  accent: "#0b3d2e"
typography:
  display: "Paperlogy"
layout:
  margin: "80px"
---

## Style Prompt

Signal ledger: dark green ledger surfaces with oversized variance numerals.

## Visual Identity Gate

Every slide repeats the ledger scoreboard primitive.
"""


def run_review(deck_html: str, design_document: str, required_text: str) -> dict:
    with tempfile.TemporaryDirectory() as raw_directory:
        directory = pathlib.Path(raw_directory)
        (directory / "slides.html").write_text(deck_html, encoding="utf-8")
        if design_document:
            (directory / "DESIGN.md").write_text(design_document, encoding="utf-8")
        if required_text:
            (directory / "required-visible-text.txt").write_text(required_text, encoding="utf-8")
        review_directory = directory / "review"
        review_directory.mkdir()
        subprocess.run(
            [sys.executable, str(RENDER_REVIEW_SCRIPT), str(directory / "slides.html"), "deck", str(review_directory)],
            check=True,
            capture_output=True,
        )
        return json.loads((review_directory / "slide-review.json").read_text(encoding="utf-8"))


def warning_prefixes(report: dict) -> set:
    return {warning.split(":")[0] for warning in report["designWarnings"]}


def main() -> int:
    today_text = datetime.date.today().strftime("%Y. %m. %d")
    templated = run_review(TEMPLATED_DECK.replace("DATE_PLACEHOLDER", today_text), "", "")
    assert templated["slideCount"] == 3, templated["slideCount"]
    assert templated["staticGatePassed"] is False
    assert templated["needsDesignRevision"] is True
    assert templated["qualityGatePassed"] is False
    expected = {
        "weakVisualIdentityWarning",
        "missingSlideRoleWarning",
        "sideStripeWarning",
        "ghostCardWarning",
        "languageMismatchWarning",
        "unsourcedCurrentDateWarning",
        "topicTitleWarning",
        "rawStructurePatternWarning",
        "absoluteFooterWarning",
    }
    missing = expected - warning_prefixes(templated)
    assert not missing, f"missing expected warnings: {missing}"

    compliant = run_review(COMPLIANT_DECK, DESIGN_DOCUMENT, "연남로보틱스\n2026년 2분기\n4.12억 원\n")
    assert compliant["slideCount"] == 3
    assert compliant["designWarnings"] == [], compliant["designWarnings"]
    assert compliant["staticGatePassed"] is True
    assert compliant["visualQualityScore"] == 100
    assert compliant["qualityGatePassed"] is False
    assert compliant["visualEvidenceReliable"] is False

    ledger_with_today = "자료 기준일: " + today_text
    dated = run_review(TEMPLATED_DECK.replace("DATE_PLACEHOLDER", today_text), "", ledger_with_today)
    assert "unsourcedCurrentDateWarning" not in warning_prefixes(dated)

    specification = importlib.util.spec_from_file_location("render_review", RENDER_REVIEW_SCRIPT)
    render_review = importlib.util.module_from_spec(specification)
    specification.loader.exec_module(render_review)
    pattern = render_review.current_date_pattern(datetime.date(2026, 7, 7))
    for text in ["2026.07.07", "2026. 07. 07", "2026-07-07", "2026/7/7", "2026년 7월 7일"]:
        assert pattern.search(text), text
    for text in ["2026-07-17", "2026-07-071", "2025-07-07", "2026년 6월 30일"]:
        assert not pattern.search(text), text

    print("test-presentation-review: all checks passed")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
