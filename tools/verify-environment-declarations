#!/usr/bin/env python3
"""Fail when a read environment variable is not declared, or a declared one has
no reader.

Scans exact syntax only: Go's os.Getenv and os.LookupEnv, TypeScript and
Svelte's process.env dot and bracket forms plus env/environment dot access
(SvelteKit's $env/dynamic/private, Vite's loadEnv, a Cloudflare platform.env,
and a Workers Env parameter all use that same accessor shape), the Python
scripts under tools/ calling os.environ's get and item forms or os.getenv,
and shell's dollar-brace and bare-dollar forms with a colon-dash, colon-
question, colon-equals or colon-plus default. No file is parsed for meaning
beyond that: a name assembled at runtime, or read through a variable holding
another variable's name, is outside what this script can see and outside
what it checks. (This docstring describes those shapes without literally
writing them, on purpose — Python's own os.environ syntax spelled out here
would be a real match this script finds in itself.)

Shell has one syntax for a script's own working variable and for a setting
the environment hands it, so a bare `${NAME}` counts as a read only when the
file never assigns NAME itself; `${NAME:-...}` / `${NAME:?...}` / `${NAME:=...}`
/ `${NAME:+...}` always count, because that operator is the idiom for reading
an external setting with a fallback or a requirement, even in a script that
also assigns NAME elsewhere (a self-referential default such as
`GOCACHE="${GOCACHE:-/tmp/cache}"`).

Run with `--list` to print every read this scan found, one `NAME  file:line`
per line, instead of checking them against the declaration file.
"""

import argparse
import json
import pathlib
import re
import subprocess
import sys

REPOSITORY_ROOT = pathlib.Path(__file__).resolve().parent.parent
DECLARATIONS_PATH = REPOSITORY_ROOT / "docs" / "internal" / "environment.json"

EXCLUDED_DIRECTORY_NAMES = {"node_modules", ".dependency", ".local", ".artifacts", ".git"}

SHELL_NAME_PATTERN = r"[A-Z_][A-Z0-9_]*"
GO_ENV_READ = re.compile(r'os\.(?:Getenv|LookupEnv)\(\s*"([A-Za-z_][A-Za-z0-9_]*)"\s*\)')
# internal/cli/main.go's own `func envOr(key, fallback string) string { return
# os.Getenv(key) ... }` — a literal name at the call site is as exact as
# os.Getenv itself, just one call deeper.
GO_ENV_OR = re.compile(r'\benvOr\(\s*"([A-Za-z_][A-Za-z0-9_]*)"')
TS_PROCESS_ENV_DOT = re.compile(r"process\.env\.([A-Za-z_][A-Za-z0-9_]*)")
TS_PROCESS_ENV_BRACKET = re.compile(r"""process\.env\[\s*['"]([A-Za-z_][A-Za-z0-9_]*)['"]\s*\]""")
TS_ENV_ACCESSOR = re.compile(r"\benv\??\.([A-Z_][A-Z0-9_]*)\b")
TS_ENVIRONMENT_ACCESSOR = re.compile(r"\benvironment\??\.([A-Z_][A-Z0-9_]*)\b")
# web/tests/plane/a-company-plane.ts's own `function environmentValue(name:
# string): string { ... }` wraps process.env the same way envOr wraps
# os.Getenv.
TS_ENVIRONMENT_VALUE_CALL = re.compile(r"""\benvironmentValue\(\s*['"]([A-Za-z_][A-Za-z0-9_]*)['"]""")
# host/relay/relay.ts's own `function required(name: string): string { ...
# process.env[name] ... }`, the same shape again.
TS_REQUIRED_CALL = re.compile(r"""\brequired\(\s*['"]([A-Za-z_][A-Za-z0-9_]*)['"]""")
PYTHON_ENV_CALL = re.compile(
    r"""os\.(?:environ\.get|getenv)\(\s*["']([A-Za-z_][A-Za-z0-9_]*)["']"""
)
PYTHON_ENV_BRACKET = re.compile(r"""os\.environ\[\s*["']([A-Za-z_][A-Za-z0-9_]*)["']\s*\]""")
SHELL_BRACED = re.compile(r"\$\{(" + SHELL_NAME_PATTERN + r")(:?[-=?+][^}]*)?\}")
SHELL_BARE = re.compile(r"\$(" + SHELL_NAME_PATTERN + r")\b")
SHELL_ASSIGNMENT_TARGET = re.compile(r"(?<![\w${:])(" + SHELL_NAME_PATTERN + r")=(?!=)")

# Positional parameters, exit/process status, and other shell mechanics a
# script reads through the same `$NAME` syntax but that no process declares,
# because the shell supplies them rather than the environment a deployment
# configures.
SHELL_BUILTINS = {
    "BASH_COMMAND",
    "BASH_SOURCE",
    "BASHPID",
    "BASH_VERSION",
    "FUNCNAME",
    "IFS",
    "LINENO",
    "OLDPWD",
    "OPTARG",
    "OPTIND",
    "PIPESTATUS",
    "PPID",
    "PWD",
    "RANDOM",
    "REPLY",
    "SECONDS",
}

# `eval "$(supabase status -o env | grep -E '^(API_URL|SECRET_KEY)=')"` assigns
# these names the same way `NAME=value` would, just too indirectly for
# SHELL_ASSIGNMENT_TARGET to see; read the alternation grep already filters
# on, which names the same set for the same reason.
EVAL_ENV_FILTER = re.compile(r"""grep\s+-E\s+['"]\^\(([A-Z_|]+)\)=""")

# `${NAME:-}` with nothing after the dash is the `set -u` null-guard idiom
# ("has this been given a value"), not a request to read NAME from outside —
# so unlike `${NAME:-fallback}` it does not override a local assignment.
BARE_DEFAULT_OPERATOR = re.compile(r"^:?-$")

# `NAME="$NAME"` forwards an incoming value to a subprocess unchanged (as
# `prepare-blueclaw-runtime` does for GOMODCACHE); the left side reads as a
# local assignment, but the value it copies is still read from outside.
SHELL_SELF_COPY = re.compile(r"""\b([A-Z_][A-Z0-9_]*)=(?:"\$\1"|'\$\1'|\$\1)(?=[\s"']|$)""")

# A `#` starting a shell comment is preceded by whitespace or the start of the
# line; `${VAR#pattern}` and `$#` never are, so this does not touch them. A
# `#` inside a quoted string is not stripped either — this only trims what
# reads as a plain trailing or whole-line comment, which is what a usage note
# such as `# set NAME=1 to enable` in e2e-crud always is.
SHELL_COMMENT = re.compile(r"(?:^|(?<=\s))#.*$")


def without_shell_comments(text):
    return "\n".join(SHELL_COMMENT.sub("", line) for line in text.splitlines())


class EnvironmentRead:
    __slots__ = ("name", "relative_path", "line_number")

    def __init__(self, name, relative_path, line_number):
        self.name = name
        self.relative_path = relative_path
        self.line_number = line_number

    def location(self):
        return f"{self.relative_path}:{self.line_number}"


def is_excluded(path):
    return any(part in EXCLUDED_DIRECTORY_NAMES for part in path.parts)


def tracked_files():
    output = subprocess.run(
        ["git", "ls-files"],
        cwd=REPOSITORY_ROOT,
        capture_output=True,
        text=True,
        check=True,
    ).stdout
    for line in output.splitlines():
        path = REPOSITORY_ROOT / line
        if not is_excluded(pathlib.Path(line)):
            yield pathlib.Path(line), path


def matches_at(pattern, text, relative_path, exclude_names=frozenset()):
    for line_number, line in enumerate(text.splitlines(), start=1):
        for match in pattern.finditer(line):
            name = match.group(1)
            if name in exclude_names:
                continue
            yield EnvironmentRead(name, str(relative_path), line_number)


def go_reads(relative_path, text):
    yield from matches_at(GO_ENV_READ, text, relative_path)
    yield from matches_at(GO_ENV_OR, text, relative_path)


def typescript_reads(relative_path, text):
    yield from matches_at(TS_PROCESS_ENV_DOT, text, relative_path)
    yield from matches_at(TS_PROCESS_ENV_BRACKET, text, relative_path)
    yield from matches_at(TS_ENV_ACCESSOR, text, relative_path)
    yield from matches_at(TS_ENVIRONMENT_ACCESSOR, text, relative_path)
    yield from matches_at(TS_ENVIRONMENT_VALUE_CALL, text, relative_path)
    yield from matches_at(TS_REQUIRED_CALL, text, relative_path)


def python_reads(relative_path, text):
    yield from matches_at(PYTHON_ENV_CALL, text, relative_path)
    yield from matches_at(PYTHON_ENV_BRACKET, text, relative_path)


def is_inside_double_quotes(line, position):
    unescaped_quotes_before = 0
    for index in range(position):
        if line[index] == '"' and (index == 0 or line[index - 1] != "\\"):
            unescaped_quotes_before += 1
    return unescaped_quotes_before % 2 == 1


def shell_locally_assigned_names(text):
    text = without_shell_comments(text)
    assigned = set()
    for line in text.splitlines():
        for match in SHELL_ASSIGNMENT_TARGET.finditer(line):
            # `"... NAME=$(shell_quote "$value") ..."` builds a command line
            # for a *different* shell (one end of an ssh call); the `NAME=`
            # inside that quoted string is not this script assigning NAME.
            if not is_inside_double_quotes(line, match.start()):
                assigned.add(match.group(1))
    for match in EVAL_ENV_FILTER.finditer(text):
        assigned.update(match.group(1).split("|"))
    return assigned


def shell_reads(relative_path, text):
    # Shell has one syntax for a script's own working variable and for a
    # setting the environment hands it, so `${NAME}` alone cannot tell them
    # apart by shape. `${NAME:-fallback}` (and `:?`, `:=`, `:+`) can: that
    # operator is the idiom for "take this from outside, with a fallback or a
    # requirement", so it counts as a read regardless of anything else in the
    # file — except a bare `${NAME:-}`, which is the `set -u` null-guard
    # idiom and follows the same rule as an unadorned `${NAME}` or `$NAME`:
    # a read only when the file never assigns NAME itself, because once it
    # does, `$NAME` is that assignment being read back like any other local
    # variable. A comment mentioning a name (`# set NAME=1 to enable`) is
    # neither a read nor an assignment, so it is stripped before either is
    # decided.
    assigned_names = shell_locally_assigned_names(text)
    text = without_shell_comments(text)
    for line_number, line in enumerate(text.splitlines(), start=1):
        self_copied = {match.group(1) for match in SHELL_SELF_COPY.finditer(line)}
        for match in SHELL_BRACED.finditer(line):
            name, operator = match.group(1), match.group(2)
            if name in SHELL_BUILTINS:
                continue
            is_null_guard = operator and BARE_DEFAULT_OPERATOR.match(operator)
            if (operator and not is_null_guard) or name in self_copied:
                yield EnvironmentRead(name, str(relative_path), line_number)
            elif name not in assigned_names:
                yield EnvironmentRead(name, str(relative_path), line_number)
        for match in SHELL_BARE.finditer(line):
            name = match.group(1)
            if name in SHELL_BUILTINS:
                continue
            if name in self_copied or name not in assigned_names:
                yield EnvironmentRead(name, str(relative_path), line_number)


def is_shell_suffixed_path(relative_path):
    return relative_path.suffix == ".sh" or str(relative_path) == "host/entrypoint.sh"


def is_tools_path(relative_path):
    return relative_path.parts[:1] == ("tools",)


def shebang_language(text):
    first_line = text.splitlines()[0] if text else ""
    if not first_line.startswith("#!"):
        return None
    if "python" in first_line:
        return "python"
    if "bash" in first_line or "/sh" in first_line or first_line.endswith("sh"):
        return "shell"
    return None


def collect_reads():
    reads = []
    for relative_path, absolute_path in tracked_files():
        suffix = relative_path.suffix
        if suffix == ".go":
            text = read_text(absolute_path)
            reads.extend(go_reads(relative_path, text))
        elif suffix in (".ts", ".tsx", ".svelte"):
            text = read_text(absolute_path)
            reads.extend(typescript_reads(relative_path, text))
        elif is_shell_suffixed_path(relative_path):
            text = read_text(absolute_path)
            reads.extend(shell_reads(relative_path, text))
        elif is_tools_path(relative_path):
            text = read_text(absolute_path)
            # tools/ scripts carry no extension, so a script's own shebang —
            # not its filename — says whether it reads `${X}` or os.environ.
            language = "python" if suffix == ".py" else shebang_language(text)
            if language == "python":
                reads.extend(python_reads(relative_path, text))
            elif language == "shell":
                reads.extend(shell_reads(relative_path, text))
    return reads


def read_text(absolute_path):
    try:
        return absolute_path.read_text(encoding="utf-8")
    except (UnicodeDecodeError, OSError):
        return ""


def list_reads():
    reads = sorted(collect_reads(), key=lambda read: (read.name, read.location()))
    for read in reads:
        print(f"{read.name}  {read.location()}")
    return 0


def check():
    declarations = json.loads(DECLARATIONS_PATH.read_text(encoding="utf-8"))
    reads = collect_reads()

    read_names = {}
    for read in reads:
        read_names.setdefault(read.name, []).append(read.location())

    undeclared = sorted(set(read_names) - set(declarations))
    unread = sorted(set(declarations) - set(read_names))

    if not undeclared and not unread:
        print(f"ok   {len(read_names)} environment variables read, all declared in "
              f"{DECLARATIONS_PATH.relative_to(REPOSITORY_ROOT)}")
        return 0

    for name in undeclared:
        locations = ", ".join(read_names[name][:3])
        more = "" if len(read_names[name]) <= 3 else f" (+{len(read_names[name]) - 3} more)"
        print(f"FAIL undeclared: {name} read at {locations}{more}", file=sys.stderr)
    for name in unread:
        print(f"FAIL unread declaration: {name} ({declarations[name]['process']}: "
              f"{declarations[name]['description']})", file=sys.stderr)
    print(
        f"\n{len(undeclared)} read with no declaration, {len(unread)} declared with no reader.\n"
        f"Declare a read variable in {DECLARATIONS_PATH.relative_to(REPOSITORY_ROOT)}; "
        "remove a declaration nothing reads.",
        file=sys.stderr,
    )
    return 1


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--list", action="store_true", help="print every read found instead of checking"
    )
    arguments = parser.parse_args()
    if arguments.list:
        return list_reads()
    return check()


if __name__ == "__main__":
    sys.exit(main())
