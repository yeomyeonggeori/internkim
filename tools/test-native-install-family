def load_the_judge_of_the_debian_package():
    """The observation and step classes the apt rig reports with, read from it.

    `tools/test-native-install` is a script, so it is loaded under another name
    rather than copied: a second copy of the report format would be a second
    thing to keep the same.
    """
    path = Path(__file__).resolve().parent / "test-native-install"
    loader = importlib.machinery.SourceFileLoader("test_native_install", str(path))
    specification = importlib.util.spec_from_loader("test_native_install", loader)
    module = importlib.util.module_from_spec(specification)
    loader.exec_module(module)
    return module


