def connection_document(app_url):
    """A connection file that is valid, whose app is the stub and whose other addresses go nowhere."""
    return {
        "schemaVersion": 1,
        "appURL": app_url,
        "company": {"id": str(uuid.uuid4()), "name": "Rig Company", "slug": "rig-company"},
        "centralPlane": {"projectURL": f"http://{NOWHERE}", "publishableKey": "sb_publishable_rig"},
        "gatewayURL": f"ws://{NOWHERE}",
        "agentKey": uuid.uuid4().hex + uuid.uuid4().hex,
    }


class StubApp(http.server.BaseHTTPRequestHandler):
    """The two routes of the company app that `internkim install` and the box unit call.

    On Linux `internkim install` does not read the connection file itself: it claims
    the computer with the app and is handed the company back. The stub hands back
    the company in `connection`, and nothing else the app does is reproduced.
    """

    issued = None

    def do_POST(self):
        length = int(self.headers.get("Content-Length") or 0)
        self.rfile.read(length)
        answers = {
            "/api/box/announce": {"isClaimed": True},
            "/api/box/claim": {},
            "/api/box/session": {
                "configuration": {key: value for key, value in self.issued.items() if key != "agentKey"},
                "session": {
                    "companyID": self.issued["company"]["id"],
                    "accessToken": self.issued["agentKey"],
                    "expiresAt": int(time.time()) + 3600,
                },
                "sealedModelKey": None,
            },
        }
        if self.path not in answers:
            self.send_error(404)
            return
        body = json.dumps(answers[self.path]).encode()
        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, format, *arguments):
        pass


class FamilyRig:
    def __init__(self, options):
        self.options = options
        self.family = FAMILIES[options.family]
        self.steps = []
        self.machine = None
        self.app = None
        self.release = None
        self.company_id = ""
        self.unit_names = []

    def step(self, number, name):
        step = judge.Step(number, name)
        self.steps.append(step)
        return step

    def serve(self, directory):
        self.release = Release(directory / "release")
        self.release.serve()
        self.app = http.server.ThreadingHTTPServer(("0.0.0.0", free_port()), StubApp)
        threading.Thread(target=self.app.serve_forever, daemon=True).start()

    def installed(self):
        status = self.machine.shell(self.family.installed_status_command)
        return self.family.installed_answer in status.stdout

    def start_machine(self, directory):
        share = directory / "share"
        (share / "scripts").mkdir(parents=True)
        self.machine = Machine(
            self.options.name, share, kernel_image_path=self.options.kernel,
            image=self.family.image, bootstrap_script=self.family.bootstrap,
        )
        self.machine.preflight()
        self.machine.create()
        self.machine.wait_until_running()
        self.machine.checked_shell(self.family.tools_command, timeout_seconds=900)
        self.machine.checked_shell("echo '127.0.0.1 intern.kim github.com api.github.com' >> /etc/hosts")

    def shell_value(self, script):
        return self.machine.shell(script).stdout.strip()

    def run_the_line(self):
        return self.machine.shell(self.release.install_line(self.machine.host_gateway()), timeout_seconds=2400)

    def installed_version(self):
        return self.shell_value(self.family.version_command) if self.installed() else ""

    def observe_install(self, step, directory, older_directory):
        older_version = ""
        if older_directory:
            self.release.publish(older_directory)
            attempt = self.run_the_line()
            older_version = self.installed_version()
            step.observe(
                "the release before this one installs, so there is something to upgrade",
                f"`{self.family.version_command}` after `install.sh host` against the older release",
                "the upgrade below is only an upgrade if a version was there first",
            ).record(
                attempt.returncode == 0 and bool(older_version),
                f"install.sh exited {attempt.returncode}, installed {older_version or 'nothing'}\n"
                f"{(attempt.stdout + attempt.stderr).strip()[-600:]}",
            )
        self.release.publish(directory)
        self.observe_tampering(step, older_version)

        attempt = self.run_the_line()
        installed_version = self.installed_version()
        step.observe(
            "the published one-liner installs the release's package through the machine's own package manager"
            + (", upgrading the one already there" if older_directory else ""),
            f"`{self.family.version_command}` after `install.sh host` with only INTERNKIM_INSTALL_RELEASE_URL set",
            "install.sh exiting 0 says the script ended; the package database is what upgrade and remove act on",
        ).record(
            attempt.returncode == 0 and bool(installed_version) and installed_version != older_version,
            f"install.sh exited {attempt.returncode}; {older_version or 'nothing'} -> {installed_version or 'nothing'}\n"
            f"{(attempt.stdout + attempt.stderr).strip()[-900:]}",
        )
        again = self.run_the_line()
        step.observe(
            "running the line again against the same release changes nothing and succeeds",
            f"the exit status of a second `install.sh host` and `{self.family.version_command}` after it",
            "re-running the line is how a host is upgraded, so on a host that is current it has to be harmless",
        ).record(
            again.returncode == 0 and self.installed_version() == installed_version,
            f"install.sh exited {again.returncode}; {installed_version} -> {self.installed_version()}\n"
            f"{(again.stdout + again.stderr).strip()[-400:]}",
        )
        added = self.shell_value(
            "ls /etc/apt/sources.list.d /etc/apt/preferences.d /etc/yum.repos.d /usr/share/keyrings 2>/dev/null "
            "| grep -i -e postgresql -e internkim; grep -n internkim /etc/pacman.conf; true"
        )
        if not self.family.postgresql_major_from_its_own_repository:
            step.observe(
                "the install adds no repository, key or pin, ours or anyone's PostgreSQL's",
                "the apt, yum and keyring directories and /etc/pacman.conf after the install",
                "the package is a file the manager installs and its dependencies come from the distribution, "
                "so a source added on the way is an unrequested trust",
            ).record(not added, added or "nothing was added")
            return
        self.observe_postgresqls_own_repository(step, added)

    def observe_postgresqls_own_repository(self, step, added):
        major = self.family.postgresql_major_from_its_own_repository
        step.observe(
            "the install adds PostgreSQL's own apt repository, its key and its pin, and nothing else",
            "the apt, yum and keyring directories and /etc/pacman.conf after the install",
            "this archive carries no pgvector, so the repository is the one source the package needed; anything "
            "more is an unrequested trust",
        ).record(
            sorted(added.split()) == sorted(POSTGRESQL_REPOSITORY_FILES),
            added or "nothing was added",
        )
        candidates = self.shell_value(
            "for name in postgresql-18-pgvector postgresql-17-pgvector postgresql-16-pgvector "
            f"postgresql-{major}-pgvector postgresql-{major} postgresql-18; do "
            "printf '%s=%s\\n' $name \"$(apt-cache policy $name | sed -n 's/^ *Candidate: //p')\"; done"
        )
        offered = dict(line.split("=", 1) for line in candidates.splitlines() if "=" in line)
        step.observe(
            f"the pin lets PostgreSQL's repository supply PostgreSQL {major} and its pgvector and no other major",
            "`apt-cache policy` candidates for the pgvector of every major the package accepts and for two servers",
            "the repository's own `postgresql` points at its newest major, and an unpinned source would move "
            "the host's database onto it at the next install",
        ).record(
            all(offered.get(name, "") in ("", "(none)") for name in
                ("postgresql-18-pgvector", "postgresql-17-pgvector", "postgresql-16-pgvector", "postgresql-18"))
            and "pgdg" in offered.get(f"postgresql-{major}-pgvector", "")
            and "pgdg" in offered.get(f"postgresql-{major}", ""),
            candidates,
        )

    def observe_tampering(self, step, installed_before):
        name = self.family.asset_name
        package = self.release.published(name)
        middle = len(package) // 2
        flipped = package[:middle] + bytes([package[middle] ^ 0xFF]) + package[middle + 1 :]
        listed = self.release.published(CHECKSUMS_NAME).decode()
        relisted = listed.replace(hashlib.sha256(package).hexdigest(), hashlib.sha256(b"another package").hexdigest())
        for label, changed_name, contents in [
            ("a package changed after the release was written", name, flipped),
            ("a SHA256SUMS that lists another checksum for the package", CHECKSUMS_NAME, relisted.encode()),
        ]:
            restore = self.release.replace(changed_name, contents)
            refused = self.run_the_line()
            restore()
            left = self.installed_version()
            step.observe(
                f"{label} is refused and the package database is left as it was",
                f"the exit status and output of `install.sh host`, and `{self.family.version_command}` after it",
                "the manager installing the file anyway would mean the checksum was never compared",
            ).record(
                refused.returncode != 0 and "hashes to" in refused.stderr and left == installed_before,
                f"exit {refused.returncode}; installed {installed_before or 'nothing'} -> {left or 'nothing'}\n"
                f"{(refused.stdout + refused.stderr).strip()[-500:]}",
            )

    def observe_package_state(self, step):
        verified = self.machine.shell(self.family.verify_command)
        step.observe(
            "every file the package shipped is present and unmodified",
            f"`{self.family.verify_command}`, which re-checks each shipped file against the package database",
            "a manifest listing proves the manifest exists; this reads the files on disk",
        ).record(
            verified.returncode == 0 and not [
                line
                for line in verified.stdout.splitlines()
                if line.strip() and not any(ignored in line for ignored in self.family.verify_ignored_lines)
            ],
            verified.stdout.strip() or "no differences",
        )
        accounts = self.shell_value(
            "for user in %s; do getent passwd \"$user\" | cut -d: -f1,7; done" % " ".join(
                [AGENT_USER, RELAY_USER, DATABASE_USER, CACHE_USER]
            )
        )
        step.observe(
            "the four service accounts exist and none can log in",
            "`getent passwd` for blueclaw, internkim, internkim-postgres and internkim-cache",
            "a package that runs a service as an account it never created starts nothing, and an account with "
            "a login shell is one more way in",
        ).record(
            len(accounts.splitlines()) == 4 and all(
                line.split(":")[1].endswith(("nologin", "false")) for line in accounts.splitlines()
            ),
            accounts,
        )
        modes = self.shell_value(
            f"stat -c '%n %a %U:%G' {HELPER_PATH} {STATE_DIRECTORY} {DATA_SERVICE_PATH}"
        )
        expected = {
            HELPER_PATH: ["4755", "root:root"],
            STATE_DIRECTORY: ["700", "root:root"],
            DATA_SERVICE_PATH: ["755", "root:root"],
        }
        found = {line.split()[0]: line.split()[1:] for line in modes.splitlines()}
        step.observe(
            "the setuid helper, the state tree and the data-service script carry the modes the boundary rests on",
            f"`stat` of {HELPER_PATH}, {STATE_DIRECTORY} and {DATA_SERVICE_PATH}",
            "the POSIX permission boundary is these bits, and a package format that drops the setuid bit does "
            "it without an error",
        ).record(found == expected, modes)
        self.unit_names = [
            name for name in self.shell_value(
                f"{self.family.files_command} | grep -E '^/(usr/)?lib/systemd/system/.*\\.service$' | xargs -r -n1 basename | sort -u"
            ).split()
        ]
        enabled = self.machine.shell(f"systemctl is-enabled {' '.join(self.unit_names)} 2>&1")
        step.observe(
            "every unit the package ships is enabled",
            "`systemctl is-enabled` for each unit in the package's file list",
            "a unit file under the unit directory says the file was copied; the symlink decides whether it "
            "comes back after a reboot",
        ).record(
            bool(self.unit_names) and enabled.returncode == 0
            and all(line.strip() == "enabled" for line in enabled.stdout.splitlines()),
            " ".join(f"{name}={state}" for name, state in zip(self.unit_names, enabled.stdout.split())),
        )
        judge.observe_the_conversion_environment(self.machine, step)
        company_units = [name for name in self.unit_names if name != judge.BOX_UNIT_NAME]
        declined = self.machine.shell(judge.UNIT_STATE_COMMAND % " ".join(company_units))
        states = dict(line.split("=", 1) for line in declined.stdout.split() if "=" in line)
        step.observe(
            "with no company every unit but the box, the database and the cache included, declined to start rather than failing",
            "ConditionResult, ActiveState, Result and NRestarts for each unit",
            "inactive because the condition was unmet and inactive because the process died are different "
            "machine states, and only these four fields together tell them apart",
        ).record(
            bool(states) and all(state == judge.DECLINED_STATE for state in states.values()),
            "\n".join(f"{name}={state}" for name, state in sorted(states.items())),
        )

    def give_the_guest_a_company(self, step):
        connection = connection_document(f"http://{self.machine.host_gateway()}:{self.app.server_address[1]}")
        StubApp.issued = connection
        self.company_id = connection["company"]["id"]
        installed = install_the_company(self.machine, connection)
        pointed = self.machine.shell(
            f"readlink -f {STATE_DIRECTORY}/current; test -s {COMPANY_CONDITION_PATH} && echo condition-met"
        )
        step.observe(
            "`internkim install` gives the box a company and waits until PostgreSQL, the cache, the messenger, "
            "the agent and the admin gateway all answer",
            f"the exit status of `internkim install` and {COMPANY_CONDITION_PATH}",
            "its last step polls PostgreSQL on the socket, the cache on its socket, and the messenger's "
            "readiness, which pings both; a success here is each client having opened its socket",
        ).record(
            installed.returncode == 0 and self.company_id in pointed.stdout and "condition-met" in pointed.stdout,
            (pointed.stdout.strip() or "nothing was written")
            + f"\ninternkim install exited {installed.returncode}\n"
            + (installed.stdout + installed.stderr).strip()[-1500:],
        )
        running_units = [name for name in self.unit_names if name != judge.RELAY_UNIT_NAME]
        states = dict(
            line.split("=", 1)
            for line in self.machine.shell(judge.UNIT_STATE_COMMAND % " ".join(running_units)).stdout.split()
            if "=" in line
        )
        unsettled = sorted(
            name for name, state in states.items() if state.split("/")[1] != "active" or state.split("/")[3] != "0"
        )
        journals = "".join(
            f"\n--- journalctl -u {name}\n"
            + self.machine.shell(f"journalctl -u {name} --no-pager -o short-monotonic | tail -40").stdout.strip()
            for name in unsettled
        )
        step.observe(
            "every unit but the relay is running and none is restarting in a loop",
            "ActiveState and NRestarts for each unit, and the journal of any unit that is not",
            "a unit that dies and is restarted reports active for most of every second; the relay is left out "
            "because its gateway is an address that answers nothing in this rig",
        ).record(
            bool(states) and not unsettled,
            "\n".join(f"{name}={state}" for name, state in sorted(states.items())) + journals,
        )
        probes = "; ".join(
            f"printf '%s %s\\n' {port}{path} "
            f"\"$(curl -s -o /dev/null -w '%{{http_code}}' --max-time 10 http://127.0.0.1:{port}{path})\""
            for port, path in READINESS_PROBES
        )
        answers = self.machine.shell(probes)
        judge.observe_a_real_conversion(self.machine, step)
        step.observe(
            "the messenger, the agent and the admin gateway answer their readiness endpoints",
            "an HTTP GET inside the guest to " + ", ".join(f"127.0.0.1:{port}{path}" for port, path in READINESS_PROBES),
            "the messenger's readiness pings its database and its cache, the agent's health opens its "
            "database; so a 200 is sqlx, redis and pgx each having reached their socket",
        ).record(
            bool(answers.stdout.strip()) and all(line.split()[-1] == "200" for line in answers.stdout.splitlines() if line.strip()),
            answers.stdout.strip() or "nothing answered",
        )

    def observe_the_data_services(self, step):
        owners = self.shell_value(
            f"for unit in internkim-postgresql internkim-cache; do "
            f"pid=\"$(systemctl show -p MainPID --value $unit)\"; printf '%s=%s\\n' $unit \"$(ps -o user= -p $pid | tr -d ' ')\"; done"
        )
        step.observe(
            "the database and the cache run as their own accounts",
            "the owner of the main process of each unit",
            "a database that runs as root is one bug away from owning the machine, and one that runs as the "
            "distribution's own account is sharing a cluster the company did not make",
        ).record(
            owners.splitlines() == [f"internkim-postgresql={DATABASE_USER}", f"internkim-cache={CACHE_USER}"], owners
        )
        modes = self.shell_value(
            f"stat -c '%n %a %U:%G' {DATABASE_DATA_DIRECTORY} {DATABASE_SOCKET_DIRECTORY} "
            f"{DATABASE_SOCKET_DIRECTORY}/.s.PGSQL.5432 /run/internkim-cache {CACHE_SOCKET_PATH}"
        )
        expected = {
            DATABASE_DATA_DIRECTORY: ["700", f"{DATABASE_USER}:{DATABASE_USER}"],
            DATABASE_SOCKET_DIRECTORY: ["750", f"{DATABASE_USER}:{DATABASE_USER}"],
            f"{DATABASE_SOCKET_DIRECTORY}/.s.PGSQL.5432": ["660", f"{DATABASE_USER}:{DATABASE_USER}"],
            "/run/internkim-cache": ["750", f"{CACHE_USER}:{CACHE_USER}"],
            CACHE_SOCKET_PATH: ["660", f"{CACHE_USER}:{CACHE_USER}"],
        }
        found = {line.split()[0]: line.split()[1:] for line in modes.splitlines()}
        step.observe(
            "the data directory is 0700 and each socket is reachable by its own group alone",
            "`stat` of the data directory, both socket directories and both sockets",
            "the modes are the whole boundary: a socket directory any account can enter is a database any "
            "account can try",
        ).record(found == expected, modes)
        listeners = self.shell_value("ss -H -ltnp; ss -H -lunp")
        data_service_processes = self.shell_value(
            "for unit in internkim-postgresql internkim-cache; do "
            "cat /sys/fs/cgroup$(systemctl show -p ControlGroup --value $unit.service)/cgroup.procs; done"
        ).split()
        own_listeners = [
            line
            for line in listeners.splitlines()
            if any(f"pid={process}," in line for process in data_service_processes)
        ]
        step.observe(
            "neither of the host's two services listens on any network port",
            "every listening TCP and UDP socket on the guest, filtered to the processes in the two units' cgroups",
            "that they answer on a Unix socket says how they are reached, not that nothing else can reach them; "
            "the listener table is what says no port is open. The distribution's own PostgreSQL and cache may "
            "listen on this machine, and they are not the host's to stop or to judge",
        ).record(
            len(data_service_processes) > 0 and not own_listeners,
            f"processes in the two units: {' '.join(data_service_processes)}\n"
            f"their listeners: {' '.join(own_listeners) or 'none'}\nall listeners:\n{listeners or 'none'}",
        )
        schema = self.shell_value(
            f"runuser -u {DATABASE_USER} -- {DATA_SERVICE_PATH} psql --dbname blueclaw --tuples-only --no-align "
            "--command \"select count(*) > 0 from information_schema.tables where table_schema = 'public'\""
        )
        step.observe(
            "the agent applied its migrations to its own database",
            "`information_schema.tables` in the blueclaw database, read as the cluster's own account",
            "the agent's health answering says it opened a connection; tables say its schema was made in this cluster",
        ).record(schema == "t", schema)
        self.observe_vector_search(step)

        self.machine.shell(f"id {TASK_USER} >/dev/null 2>&1 || useradd --system --shell /bin/false {TASK_USER}")
        agent_groups = self.shell_value(
            "ps -o supgrp= -p \"$(systemctl show -p MainPID --value blueclaw.service)\" | tr ',' ' '"
        )
        task_groups = self.shell_value(f"id -Gn {TASK_USER}")
        as_task_user = self.machine.shell(
            f"runuser -u {TASK_USER} -- psql --host {DATABASE_SOCKET_DIRECTORY} --dbname postgres --command 'select 1' 2>&1"
        )
        step.observe(
            "the agent's process holds the database's group and a task user's account does not",
            f"the supplementary groups of blueclaw.service's main process, and of {TASK_USER}, "
            "which stands for a bc_person_* identity, and what `psql` gives that account",
            "the agent's terminal runs as the person who asked; if that account could open the socket, a "
            "person could read the company's whole store by asking for a shell",
        ).record(
            DATABASE_USER in agent_groups.split() and DATABASE_USER not in task_groups.split()
            and as_task_user.returncode != 0 and "ermission denied" in as_task_user.stdout,
            f"agent process groups: {agent_groups}\ntask user groups: {task_groups}\n"
            f"task user psql: exit {as_task_user.returncode} {as_task_user.stdout.strip()[-200:]}",
        )
        client = "valkey-cli"
        cache_as_task_user = self.machine.shell(
            f"client=\"$(command -v valkey-cli || command -v redis-cli)\"; "
            f"runuser -u {TASK_USER} -- \"$client\" -s {CACHE_SOCKET_PATH} ping 2>&1"
        )
        cache_as_root = self.shell_value(
            f"client=\"$(command -v valkey-cli || command -v redis-cli)\"; \"$client\" -s {CACHE_SOCKET_PATH} ping"
        )
        step.observe(
            "the cache answers on its socket and a task user cannot open it",
            f"`{client} -s {CACHE_SOCKET_PATH} ping` as root and as {TASK_USER}",
            "the messenger's presence and fan-out pass through the cache",
        ).record(
            cache_as_root == "PONG"
            and "PONG" not in cache_as_task_user.stdout
            and cache_as_task_user.returncode != 0,
            f"root: {cache_as_root}\ntask user: {cache_as_task_user.stdout.strip()[-200:]}",
        )

    def observe_vector_search(self, step):
        answer = self.machine.shell(
            f"printf '%s' {shlex.quote(VECTOR_ROUND_TRIP)} | runuser -u {DATABASE_USER} -- {DATA_SERVICE_PATH} psql "
            "--dbname blueclaw --quiet --tuples-only --no-align --set ON_ERROR_STOP=1 2>&1"
        )
        fields = answer.stdout.strip().split("|")
        major = self.family.postgresql_major_from_its_own_repository
        step.observe(
            "the agent's database has the vector extension, the memory store's embedding table and its HNSW index, "
            "and a stored embedding is found again by its nearest neighbour"
            + (f", on PostgreSQL {major}" if major else ""),
            "the extension's version in pg_extension, to_regclass of memory_fact_embedding and its index, and the "
            "fact a cosine-distance query ranks first among two written in a transaction that is rolled back",
            "the memory store's migration skips its embedding tables when the server has no vector extension and "
            "recall then matches words alone with nothing failing; the table is what its search checks for, and the "
            "ranking is the operator its hybrid search orders by",
        ).record(
            answer.returncode == 0 and len(fields) == 5 and fields[1] != "" and fields[2:] == ["t", "t", "rig-near"]
            and (not major or fields[0] == major),
            answer.stdout.strip() or f"exit {answer.returncode}",
        )

    def observe_a_requesters_python(self, step):
        """What the agent hands a requester's command, without the agent: its own PATH, through the helper."""
        agent_path = self.shell_value(
            "tr '\\0' '\\n' < /proc/\"$(systemctl show -p MainPID --value blueclaw.service)\"/environ "
            "| sed -n 's/^PATH=//p'"
        )
        home = f"/tmp/{TASK_USER}"
        self.machine.shell(
            f"id {TASK_USER} >/dev/null 2>&1 || useradd --system --shell /bin/false {TASK_USER}; "
            f"rm -rf {home} && install -d -o {TASK_USER} -g {TASK_USER} -m 0700 {home}"
        )
        requester_script = (
            "command -v python3; python3 -c 'import sys; print(sys.version.split()[0])'; "
            f"{OFFICE_COMMAND_PATH} doc create {home}/rig.docx --title rig --paragraph rig; "
            f"stat -c '%U %s' {home}/rig.docx; "
            f"sed -n 's/^home = //p' {home}/.cache/internkim-skills/environments/office/pyvenv.cfg"
        )
        ran = self.machine.shell(
            f"env -i HOME={home} PATH={shlex.quote(agent_path)} XDG_CACHE_HOME={home}/.cache UV_PYTHON_DOWNLOADS=never "
            f"{HELPER_PATH} exec --uid \"$(id -u {TASK_USER})\" --gid \"$(id -g {TASK_USER})\" --groups '' --cwd {home} "
            f"-- /bin/sh -c {shlex.quote(requester_script)} 2>&1",
            timeout_seconds=1800,
        )
        lines = ran.stdout.strip().splitlines()
        distribution_python = self.shell_value("ls /usr/bin/python3 2>/dev/null || echo none")
        step.observe(
            f"a requester's python3 is the host's CPython {HOST_PYTHON_VERSION}",
            f"`command -v python3` and its version, run as {TASK_USER} through {HELPER_PATH} with the PATH "
            "blueclaw.service's main process carries",
            "blueclaw hands every command a requester runs its own PATH, so the unit's PATH is what decides which "
            "interpreter a skill gets; a distribution python3 there would build every skill environment on it",
        ).record(
            agent_path.startswith(HOST_PYTHON_PATH.rsplit("/", 1)[0] + ":") and lines[:2] == [HOST_PYTHON_PATH, HOST_PYTHON_VERSION],
            f"agent PATH: {agent_path or 'none'}\nrequester saw: {' | '.join(lines[:2])}\n"
            f"the distribution's /usr/bin/python3: {distribution_python}",
        )
        office_result = next((line for line in lines if '"status"' in line), "")
        step.observe(
            "the office skill builds a fresh environment on that interpreter, downloads no interpreter, and writes a .docx",
            f"`office doc create` as {TASK_USER} with UV_PYTHON_DOWNLOADS=never, the file's owner, and the "
            "`home` its skill environment's pyvenv.cfg names",
            "skill_runtime makes the skill's environment with `uv venv --python <sys.executable>`, so an interpreter "
            "the requester cannot read, or one uv would have to fetch, fails here first",
        ).record(
            '"ok"' in office_result
            and any(line.startswith(f"{TASK_USER} ") for line in lines)
            and lines[-1:] != [] and lines[-1].startswith(DOCUMENT_ENVIRONMENT_PATHS[0] + "/"),
            "\n".join(lines[-12:]) or "nothing ran",
        )

    def observe_removal(self, step):
        shipped = [path for path in self.shell_value(self.family.files_command).split() if path.startswith(("/usr/", "/lib/"))]
        removed = self.machine.shell(self.family.remove_command, timeout_seconds=900)
        status = self.machine.shell(self.family.installed_status_command)
        step.observe(
            "the package manager removes the package",
            f"`{self.family.installed_status_command}` after `{self.family.remove_command}`",
            "a removal printing success is the manager's account of its own run",
        ).record(
            removed.returncode == 0 and self.family.installed_answer not in status.stdout,
            (removed.stdout + removed.stderr).strip()[-300:],
        )
        after = self.machine.shell(
            "; ".join(
                f"enablement=$(systemctl is-enabled {name} 2>/dev/null | head -n 1); "
                f"activity=$(systemctl is-active {name} 2>/dev/null | head -n 1); "
                f"printf '%s=%s/%s\\n' {name} \"${{enablement:-not-found}}\" \"${{activity:-inactive}}\""
                for name in self.unit_names
            )
        )
        states = dict(line.split("=", 1) for line in after.stdout.splitlines() if "=" in line)
        step.observe(
            "the units are neither enabled nor running any more",
            "`systemctl is-enabled` and `is-active` for every unit the package had shipped",
            "removing the unit file leaves a still-running process and a still-present enable symlink",
        ).record(
            bool(states) and all(
                enablement in ("not-found", "disabled", "masked") and activity != "active"
                for enablement, activity in (value.split("/", 1) for value in states.values())
            ),
            after.stdout.strip(),
        )
        survivors = self.shell_value(
            "for path in " + " ".join(shipped) + "; do [ -f \"$path\" ] && echo \"$path\"; done; true"
        )
        step.observe(
            "the files the package owned are off the disk",
            "a stat of every regular file in the package's file list before the removal",
            "the package database reporting the package removed is its bookkeeping; these are the files",
        ).record(not survivors, survivors or f"{len(shipped)} paths gone")
        environment = self.shell_value(
            "for path in " + " ".join(DOCUMENT_ENVIRONMENT_PATHS) + "; do [ -e \"$path\" ] && echo \"$path\"; done; true"
        )
        step.observe(
            "removal takes the conversion environment the install step built",
            "a stat of " + " and ".join(DOCUMENT_ENVIRONMENT_PATHS) + " after the removal",
            "the package manager owns none of it, so only the package's own removal script can take it, and "
            "nothing else would",
        ).record(not environment, environment or "both gone")
        kept = self.shell_value(
            f"test -d {STATE_DIRECTORY}/companies/{self.company_id} && echo company-kept; "
            f"test -s {DATABASE_DATA_DIRECTORY}/PG_VERSION && echo database-kept"
        )
        step.observe(
            "removal keeps the company's directory and its database",
            f"{STATE_DIRECTORY}/companies/<id> and {DATABASE_DATA_DIRECTORY}/PG_VERSION after removal",
            "the agent key and the company's data cannot be reissued, so removing the package must not delete them",
        ).record(kept.split() == ["company-kept", "database-kept"], kept)

    def report(self):
        lines = []
        for step in sorted(self.steps, key=lambda step: step.number):
            marker = {"PASS": "✓", "FAIL": "✗", "BLOCKED": "—"}[step.verdict]
            lines.append(f"{marker} step {step.number} · {step.name}")
            if step.blocked_because:
                lines.append(f"    blocked: {step.blocked_because}")
            for observation in step.observations:
                lines.append(f"    {'✓' if observation.passed else '✗'} {observation.name}")
                lines.append(f"        observes: {observation.observes}")
                if not observation.passed and observation.not_a_proxy:
                    lines.append(f"        why that and not a stand-in: {observation.not_a_proxy}")
                if observation.detail:
                    for detail_line in observation.detail.splitlines():
                        lines.append(f"        | {detail_line}")
        return "\n".join(lines)

    def verdict(self):
        return all(step.verdict == "PASS" for step in self.steps)


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--family", choices=sorted(FAMILIES), required=True, help="the distribution the guest runs")
    parser.add_argument(
        "--package-directory", default=".artifacts/native-package",
        help="the release under test, as `internkim release packages` writes it (default: %(default)s)",
    )
    parser.add_argument(
        "--older-package-directory", metavar="DIRECTORY",
        help="a release built from an earlier commit; it is installed first, so the line is judged as an upgrade",
    )
    parser.add_argument("--name", default=f"internkim-familyrig-{uuid.uuid4().hex[:8]}")
    parser.add_argument("--keep", action="store_true", help="leave the guest running for autopsy")
    parser.add_argument(
        "--stop-after", type=int, default=6, metavar="STEP",
        help="stop once this step has run, so a guest can be examined before the next one changes it",
    )
    parser.add_argument("--kernel", default=str(RUNTIME_KERNEL if ARCHITECTURE == "amd64" else KERNEL_IMAGE_PATH), help="the guest kernel (default: %(default)s)")
    options = parser.parse_args()

    rig = FamilyRig(options)
    directory = Path(options.package_directory)
    package = rig.family.package_in(directory) if directory.exists() else None
    if package is None:
        print(
            f"✗ native install rig ({options.family})\n"
            f"    No {rig.family.asset_name} under {directory}.\n"
            f"    Build it with `internkim release packages`.",
            file=sys.stderr,
        )
        return 1

    with tempfile.TemporaryDirectory(prefix="internkim-family-rig-") as temporary:
        working_directory = Path(temporary)
        print(f"the machine: {options.family}, image {rig.family.image}, named {options.name}")
        print(f"under test:  {package.name}\n")
        try:
            rig.serve(working_directory)
            rig.start_machine(working_directory)
            rig.observe_install(
                rig.step(1, "one command installs the release, refuses one that was changed, and upgrades on a re-run"),
                directory, options.older_package_directory,
            )
            rig.observe_package_state(rig.step(2, "the machine is in the state the package manager would have left it"))
            if options.stop_after >= 3:
                rig.give_the_guest_a_company(rig.step(3, "the box takes a company and every service answers"))
            if options.stop_after >= 4:
                rig.observe_the_data_services(rig.step(4, "the database and the cache keep to their sockets and their accounts"))
            if options.stop_after >= 5:
                rig.observe_a_requesters_python(rig.step(5, "a requester's python3 is the host's, and a skill runs on it"))
            if options.stop_after >= 6:
                rig.observe_removal(rig.step(6, "removing the package leaves the company"))
        except RigFailure as failure:
            print(f"✗ native install rig ({options.family})\n    {failure}", file=sys.stderr)
            return 2
        finally:
            if rig.app:
                rig.app.shutdown()
            if rig.release:
                rig.release.stop()
            if rig.machine and not options.keep:
                rig.machine.destroy()
            elif rig.machine:
                print(f"the guest is still up: container exec {options.name} bash")
        print(rig.report())
        print()
        passed = rig.verdict()
        print(f"{'✓' if passed else '✗'} native install rig ({options.family})")
        return 0 if passed else 1


if __name__ == "__main__":
    sys.exit(main())
