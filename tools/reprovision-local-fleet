#!/usr/bin/env bash
# Reprovision the local fleet VM in place from the current working tree.
#
# This is the only way Blueclaw, skill, prompt, and runtime changes reach the
# Firecracker guest: the guest runs from a baked rootfs, so copying files onto the
# host and restarting the service does not update it (and breaks the guest). Only
# capabilityd/admind are host binaries that can be scp'd and restarted directly.
#
# GO_MOD_CACHE must point at the real module cache; without it the build defaults
# to an empty isolated cache and prepare-blueclaw-payload fails with missing
# x/text, x/crypto, and uuid sources. INTERNKIM_BLUECLAW_USE_LOCAL builds Blueclaw
# from the working tree (uncommitted changes included). Reprovision resets the
# policy people and the guest Postgres, so each run starts from a clean directory.
#
# Usage: tools/reprovision-local-fleet
#   Bring up a fleet first (internkim test --keep ...). INTERNKIM_E2E_CONFIG
#   overrides the fleet run config path.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
CONFIG_PATH="${INTERNKIM_E2E_CONFIG:-$(ls -dt "$ROOT"/.local/local-fleet/runs/*/config.json 2>/dev/null | head -1)}"
[ -n "${CONFIG_PATH:-}" ] && [ -f "$CONFIG_PATH" ] || { echo "no fleet run config found; bring up a fleet first" >&2; exit 1; }

vmInternetProtocolAddress="$("$ROOT/internkim" lab vm-ip --config "$CONFIG_PATH" 2>/dev/null | tail -1)"
[ -n "$vmInternetProtocolAddress" ] || { echo "could not resolve fleet VM IP from $CONFIG_PATH" >&2; exit 1; }
echo "reprovisioning local fleet at $vmInternetProtocolAddress from the working tree"

GO_MOD_CACHE="$(go env GOMODCACHE)" \
INTERNKIM_BLUECLAW_USE_LOCAL=1 \
INTERNKIM_SKIP_PAGES_DEPLOY_FOR_LAB=1 \
INTERNKIM_TEST_MODEL='google/gemini-2.5-flash-lite' \
	"$ROOT/internkim" setup --board lab --ssh --host "$vmInternetProtocolAddress" \
		--user admin --password admin \
		--admin-email local-fleet-admin@internkim.test \
		--force --skip wifi,local-llm,cloudflare-access,tunnel,google,slack,mattermost
