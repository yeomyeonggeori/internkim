#!/usr/bin/env bash
set -euo pipefail

root_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
blueclaw_dir="$root_dir/.dependency/blueclaw"
temporary_dir="$(mktemp -d "${TMPDIR:-/tmp}/internkim-graphiti-local.XXXXXX")"

cleanup() {
  if [ -n "${capability_pid:-}" ]; then
    kill "$capability_pid" 2>/dev/null || true
  fi
  if [ -n "${graphiti_pid:-}" ]; then
    kill "$graphiti_pid" 2>/dev/null || true
  fi
  rm -rf "$temporary_dir"
}
trap cleanup EXIT

openrouter_key="${OPENROUTER_API_KEY:-}"
if [ -z "$openrouter_key" ] && [ -f "$root_dir/.env" ]; then
  openrouter_key="$(python3 - "$root_dir/.env" <<'PY'
import pathlib
import shlex
import sys

for line in pathlib.Path(sys.argv[1]).read_text().splitlines():
    if not line.strip().startswith("OPENROUTER_API_KEY="):
        continue
    value = line.split("=", 1)[1].strip()
    try:
        print(shlex.split(value)[0])
    except Exception:
        print(value.strip("\"'"))
    raise SystemExit
PY
)"
fi

if [ -z "$openrouter_key" ]; then
  echo "OPENROUTER_API_KEY is required in the environment or .env" >&2
  exit 1
fi

if ! command -v uv >/dev/null 2>&1; then
  echo "uv is required. Install it first, then rerun make verify-graphiti-local." >&2
  exit 1
fi

venv_path="$blueclaw_dir/.venv-graphiti"
socket_path="$temporary_dir/capability.sock"
key_path="$temporary_dir/openrouter-api-key"
kuzu_path="$temporary_dir/kuzu"
port="$(python3 - <<'PY'
import socket

socket_value = socket.socket()
socket_value.bind(("127.0.0.1", 0))
print(socket_value.getsockname()[1])
socket_value.close()
PY
)"
encoded_socket_path="$(python3 - "$socket_path" <<'PY'
import sys
import urllib.parse

print(urllib.parse.quote(sys.argv[1], safe=""))
PY
)"

printf '%s' "$openrouter_key" > "$key_path"
chmod 600 "$key_path"

echo "building internkim-capabilityd"
GOCACHE="${GOCACHE:-/tmp/internkim-go-cache}" go build -o "$temporary_dir/internkim-capabilityd" "$root_dir/cmd/internkim-capabilityd"

echo "installing graphiti local environment"
cd "$blueclaw_dir"
if [ ! -x "$venv_path/bin/python" ]; then
  uv venv "$venv_path" >/dev/null
fi
uv pip install --python "$venv_path/bin/python" -r "$blueclaw_dir/tools/graphiti_memoryd/requirements.txt" >/dev/null

echo "starting capabilityd"
"$temporary_dir/internkim-capabilityd" \
  -socket "$socket_path" \
  -openrouter-key "$key_path" \
  -llamacpp-embedding-url "${LLAMACPP_EMBEDDING_URL:-http://127.0.0.1:18082}" \
  -llamacpp-embedding-model "${LLAMACPP_EMBEDDING_MODEL:-baai/bge-m3}" &
capability_pid="$!"

for _ in $(seq 1 80); do
  if [ -S "$socket_path" ]; then
    break
  fi
  sleep 0.1
done
if [ ! -S "$socket_path" ]; then
  echo "capabilityd did not create its Unix socket" >&2
  exit 1
fi

echo "starting graphiti-memoryd"
PYTHONPATH="$blueclaw_dir/tools" \
INTERNKIM_CAPABILITY_ENDPOINT="http+unix://$encoded_socket_path" \
BLUECLAW_GRAPHITI_KUZU_PATH="$kuzu_path" \
BLUECLAW_GRAPHITI_EXECUTION_MODE="remote" \
BLUECLAW_GRAPHITI_EMBEDDING_EXECUTION_MODE="${BLUECLAW_GRAPHITI_EMBEDDING_EXECUTION_MODE:-device}" \
BLUECLAW_GRAPHITI_LISTEN_ADDRESS="127.0.0.1" \
BLUECLAW_GRAPHITI_PORT="$port" \
"$venv_path/bin/python" -m graphiti_memoryd &
graphiti_pid="$!"

python3 - "$port" <<'PY'
import json
import sys
import time
import urllib.request

port = sys.argv[1]
url = f"http://127.0.0.1:{port}/health"
for _ in range(240):
    try:
        with urllib.request.urlopen(url, timeout=1) as response:
            if json.load(response).get("status") == "ok":
                raise SystemExit
    except Exception:
        time.sleep(0.25)
print("graphiti-memoryd did not become healthy", file=sys.stderr)
raise SystemExit(1)
PY

echo "adding and searching a Graphiti episode"
python3 - "$port" <<'PY'
import datetime
import json
import sys
import urllib.error
import urllib.request

port = sys.argv[1]
base_url = f"http://127.0.0.1:{port}"
namespace = {
    "namespaceID": "user:person-local",
    "scopeType": "user",
    "scopePersonID": "person-local",
    "securityLevelRank": 0,
    "requiredClasses": [],
}
episode = {
    "episodeID": "local-smoke-episode-1",
    "platform": "mattermost",
    "messageID": "local-smoke-message-1",
    "conversationID": "dm:local",
    "senderPersonID": "person-local",
    "prompt": "My name is Minsu. Please remember that my name is Minsu.",
    "occurredAt": datetime.datetime.now(datetime.UTC).isoformat(),
    "namespaces": [namespace],
    "source": "message",
    "sourceReference": "local-smoke",
}
update_episode = {
    "episodeID": "local-smoke-episode-2",
    "platform": "mattermost",
    "messageID": "local-smoke-message-2",
    "conversationID": "dm:local",
    "senderPersonID": "person-local",
    "prompt": "Correction: my preferred name is Jisu now.",
    "occurredAt": datetime.datetime.now(datetime.UTC).isoformat(),
    "namespaces": [namespace],
    "source": "message",
    "sourceReference": "local-smoke",
}
search = {
    "query": "What is my name?",
    "namespaces": [namespace],
    "limit": 5,
}
update_search = {
    "query": "What is my preferred name now?",
    "namespaces": [namespace],
    "limit": 5,
}

def post_json(path, document):
    request = urllib.request.Request(
        base_url + path,
        data=json.dumps(document).encode(),
        headers={"Content-Type": "application/json"},
        method="POST",
    )
    try:
        with urllib.request.urlopen(request, timeout=180) as response:
            return json.loads(response.read().decode())
    except urllib.error.HTTPError as error:
        print(error.read().decode(), file=sys.stderr)
        raise

post_json("/v1/episodes", episode)
post_json("/v1/episodes", update_episode)
result = post_json("/v1/search", search)
facts = result.get("facts", [])
content = json.dumps(facts, ensure_ascii=False)
if not facts:
    print("Graphiti returned no facts", file=sys.stderr)
    raise SystemExit(1)
if not any(fact.get("sourceKind") for fact in facts):
    print("Graphiti facts did not include sourceKind:", content, file=sys.stderr)
    raise SystemExit(1)
if "Minsu" not in content:
    print("Graphiti facts did not recall the seeded name:", content, file=sys.stderr)
    raise SystemExit(1)
update_result = post_json("/v1/search", update_search)
update_facts = update_result.get("facts", [])
update_content = json.dumps(update_facts, ensure_ascii=False)
if "Jisu" not in update_content:
    print("Graphiti facts did not recall the updated preferred name:", update_content, file=sys.stderr)
    raise SystemExit(1)
print("graphiti local smoke: ok")
PY
